          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">EncyclopediaController</string>
              <string name="Source">-- src/client/UI/EncyclopediaController.luau
local EncyclopediaController = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local BaseItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BaseItemConfig"))

-- [🌟 万能 3D 模型渲染引擎]
local function RenderToViewport(viewport, modelName, itemType, isSilhouette)
    if not viewport or not viewport:IsA("ViewportFrame") then return end
    
    for _, c in pairs(viewport:GetChildren()) do
        if c:IsA("Model") or c:IsA("Camera") then c:Destroy() end
    end

    viewport.Ambient = Color3.fromRGB(200, 200, 200)
    viewport.LightColor = Color3.fromRGB(255, 255, 255)

    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    if not itemModelsFolder then return nil end

    local targetModel = nil
    if itemType == "Seed" then
        targetModel = itemModelsFolder:FindFirstChild("Seed")
    elseif itemType == "Plant" then
        targetModel = itemModelsFolder:FindFirstChild(modelName .. "_Plant") or itemModelsFolder:FindFirstChild(modelName)
    elseif itemType == "Tool" or itemType == "System" then
        targetModel = itemModelsFolder:FindFirstChild(modelName)
    end

    if targetModel then
        local displayModel = targetModel:Clone()
        for _, desc in pairs(displayModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then desc:Destroy() end
        end
        
        if isSilhouette then
           for _, p in pairs(displayModel:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Color = Color3.fromRGB(0, 0, 0)
                    -- 🌟 核心修复：改为 Neon 材质，消除所有反光和阴影，实现纯粹的死黑
                    p.Material = Enum.Material.Neon
                end
            end
        end

        if not displayModel.PrimaryPart then
            displayModel.PrimaryPart = displayModel:FindFirstChildWhichIsA("BasePart", true)
        end
        if displayModel.PrimaryPart then
            displayModel:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(210), 0))
        end
        
        displayModel.Parent = viewport

        local camera = Instance.new("Camera")
        camera.FieldOfView = 40
        viewport.CurrentCamera = camera
        camera.Parent = viewport

        local cframe, size = displayModel:GetBoundingBox()
        local maxDim = math.max(size.X, size.Y, size.Z)
        if maxDim == 0 then maxDim = 2 end 
        local zDist = maxDim * 1.5 + 1

        local cameraPos = Vector3.new(cframe.Position.X, cframe.Position.Y + size.Y/6, cframe.Position.Z + zDist)
        camera.CFrame = CFrame.lookAt(cameraPos, cframe.Position)
        
        return displayModel
    end
    return nil
end

function EncyclopediaController.Init()
    local currentCodexLoadTicket = 0
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    
    local playProperty = basicGui:WaitForChild("PlayProperty")
    local openCodexBtn = playProperty:WaitForChild("Codex")
    
    local codexGui = basicGui:WaitForChild("Codex")
    -- 【🌟 核心路径修正】：现在直接找 MainFrame
    local mainFrame = codexGui:WaitForChild("MainFrame")

    local descriptionFrame = mainFrame:WaitForChild("DescriptionFrame")
    local descPlantImage = descriptionFrame:WaitForChild("Plant")
    local descBgImage = descriptionFrame:WaitForChild("BG")
    local descNameText = descriptionFrame:WaitForChild("NameText")
    local descQualityText = descriptionFrame:WaitForChild("QualityText")
    local descSourceText = descriptionFrame:WaitForChild("SourceText")
    local descHpText = descriptionFrame:WaitForChild("HPText")
    local descAtkText = descriptionFrame:WaitForChild("ATKText")
    local descDetails = descriptionFrame:WaitForChild("Details")
    
    descriptionFrame.ZIndex = 100
    for _, desc in pairs(descriptionFrame:GetDescendants()) do
        if desc:IsA("GuiObject") then desc.ZIndex = desc.ZIndex + 100 end
    end
    descriptionFrame.Visible = false

    local scrollingFrames = {}
    local categoryBtns = {}
    for i = 1, 4 do
        scrollingFrames[i] = mainFrame:WaitForChild("ScrollingFrame" .. i)
        categoryBtns[i] = mainFrame:WaitForChild("Category" .. i)
    end
    
    local uiTemplates = ReplicatedStorage:WaitForChild("UITemplates")
    local itemTemplate = uiTemplates:WaitForChild("ItemTemplate")

    local function LoadCodexItems(tabIndex)
        local currentScroll = scrollingFrames[tabIndex]
        if not currentScroll then return end

        -- 🌟 [修复 1]：每次调用生成一个新的专属令牌
        currentCodexLoadTicket = currentCodexLoadTicket + 1
        local myTicket = currentCodexLoadTicket

        -- (注意：这里不要过早清理UI，等数据回来了再清理，防闪烁)

        local mutationLabel = ItemConfig.MutationName and ItemConfig.MutationName[tabIndex] 
        local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF", 5)
        
        -- 👉 这里线程会挂起，等待服务器响应
        local playerData = getPlayerDataRF and getPlayerDataRF:InvokeServer() or {}
        local unlockedMutations = playerData.UnlockedMutations or {}

        -- 🌟 [修复 2]：数据返回后，检查当前令牌是否过期。
        -- 如果在等待网络请求期间，玩家又切了别的Tab或触发了新刷新，直接废弃这次的渲染！
        if myTicket ~= currentCodexLoadTicket then return end

        -- 🌟 [修复 3]：确认是最新请求后，再安全地清空旧 UI 节点
        for _, child in pairs(currentScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local sortedPlants = {}
        for plantId, plantDetail in pairs(ItemConfig.Plants) do
            -- 从 Seeds 配置中获取数字 ID 用于排序。如果找不到则默认给 9999 放到最后
            local numericId = (ItemConfig.Seeds[plantId] and ItemConfig.Seeds[plantId].Id) or 9999
            
            table.insert(sortedPlants, {
                plantId = plantId,
                plantDetail = plantDetail,
                quality = plantDetail.Quality or 1,
                numericId = numericId
            })
        end

        -- 排序逻辑：优先比较品质（从小到大），品质相同则比较 ID（从小到大）
        table.sort(sortedPlants, function(a, b)
            if a.quality == b.quality then
                return a.numericId &lt; b.numericId
            end
            return a.quality &lt; b.quality
        end)

        -- ==========================================
        -- [🌟 修改：使用排序后的数组遍历生成槽位]
        -- ==========================================
        for index, data in ipairs(sortedPlants) do
            local plantId = data.plantId
            local plantDetail = data.plantDetail

            local slot = itemTemplate:Clone()
            slot.Name = plantId
            slot.Visible = true
            
            -- 🌟 关键点：利用 LayoutOrder 决定在 UI 网格/列表中的实际显示顺序
            slot.LayoutOrder = index 
            
            -- [下方保持你原有的渲染逻辑不变]
            -- 获取品质颜色并设置槽位中 BGImag 的描边
            local qualityId = plantDetail.Quality or 1
            local qColor = (ItemConfig.QualityColor and ItemConfig.QualityColor[qualityId]) or Color3.fromRGB(255, 255, 255)
            local bgImag = slot:FindFirstChild("BGImag")
            if bgImag then
                local stroke = bgImag:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Color = qColor
                end
            end
            
            if slot:FindFirstChild("ItemName") then
                slot.ItemName.Text = plantDetail.Name or plantId
            end
            
            local isOwned = (unlockedMutations[plantId] and unlockedMutations[plantId][tabIndex]) and true or false
            
            local icomNode = slot:FindFirstChild("Icom")
            if icomNode then
                if icomNode:IsA("ViewportFrame") then
                    RenderToViewport(icomNode, plantId, "Plant", not isOwned)
                elseif icomNode:IsA("ImageLabel") or icomNode:IsA("ImageButton") then
                    icomNode.Image = plantDetail.IconId or ""
                    icomNode.ImageColor3 = isOwned and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
                end
                
                icomNode.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        local qualityConfig = BaseItemConfig.Item and BaseItemConfig.Item[qualityId]
                        
                        -- [🌟 新增：点击后设置详情页 BG 的描边颜色]
                        if descBgImage then
                            local bgStroke = descBgImage:FindFirstChildOfClass("UIStroke")
                            if bgStroke then
                                bgStroke.Color = qColor
                            end
                        end
                        
                        if descPlantImage:IsA("ViewportFrame") then
                            RenderToViewport(descPlantImage, plantId, "Plant", not isOwned)
                        elseif descPlantImage:IsA("ImageLabel") then
                            descPlantImage.Image = plantDetail.IconId or ""
                            descPlantImage.ImageColor3 = isOwned and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
                        end

                        if descBgImage:IsA("ImageLabel") then
                            descBgImage.Image = qualityConfig and qualityConfig.IconId or ""
                        end
                        
                        descNameText.Text = plantDetail.Name or plantId
                        descQualityText.Text = (qualityConfig and qualityConfig.Name or "Unknown")
                        descSourceText.Text = "Source: " .. (plantDetail.Source or "Shop / Seeds")
                        
                        -- 🌟 修复：获取当前变异等级的属性乘区 (tabIndex 对应 1:Normal, 2:Shiny, 3:Thunder, 4:Divine)
                        local mutationStat = ItemConfig.MutationStats[tabIndex] or {DamageMul = 1.0, HealthMul = 1.0}
                        
                        -- 🌟 修复：计算变异后的血量并取整
                        local finalHp = math.floor((plantDetail.HP or 0) * mutationStat.HealthMul)
                        descHpText.Text = "HP:" .. tostring(finalHp)
                        
                        local baseAttack = plantDetail.Attack
                        local intervalValue = plantDetail.AttackInterval
    
                        if baseAttack then
                            -- 🌟 修复：计算变异后的攻击力并取整
                            local finalAttack = math.floor(baseAttack * mutationStat.DamageMul)
                            
                            if intervalValue then
                                -- 如果两者都有，显示为攻击力/间隔（即 DPS 模式）
                                descAtkText.Text = "DPS: " .. tostring(finalAttack) .. "/" .. tostring(intervalValue)
                            else
                                -- 如果只有攻击力没有间隔（如土豆雷、辣椒等瞬发植物），仅显示攻击力
                                descAtkText.Text = "ATK: " .. tostring(finalAttack)
                            end
                        else
                            -- 如果完全没有攻击力配置（如坚果墙），显示默认占位符
                            descAtkText.Text = "ATK: --"
                        end
                        
                        descDetails.Text = plantDetail.Description or "No description available."
                        descDetails.TextWrapped = true -- [建议新增] 确保长篇描述可以正确换行
                        descDetails.TextXAlignment = Enum.TextXAlignment.Left -- [建议] 左对齐更美观
                        descDetails.TextYAlignment = Enum.TextYAlignment.Top  -- [建议] 顶部对齐
                        descriptionFrame.Visible = true
                    end
                end)
            end
            
            if slot:FindFirstChild("Quantity") then
                slot.Quantity.Text = mutationLabel
                slot.Quantity.Visible = true
                if tabIndex == 1 then slot.Quantity.TextColor3 = Color3.fromRGB(255, 255, 255)
                elseif tabIndex == 2 then slot.Quantity.TextColor3 = Color3.fromRGB(85, 170, 255)
                elseif tabIndex == 3 then slot.Quantity.TextColor3 = Color3.fromRGB(170, 85, 255)
                elseif tabIndex == 4 then slot.Quantity.TextColor3 = Color3.fromRGB(255, 170, 0)
                end
            end
            
            if slot:FindFirstChild("Index") then slot.Index.Visible = false end
            slot.Parent = currentScroll
        end
    end

    local function SwitchTab(tabIndex)
        descriptionFrame.Visible = false 
        for i = 1, 4 do
            scrollingFrames[i].Visible = (i == tabIndex)
            local btn = categoryBtns[i]
            local stroke = btn:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = (i == tabIndex) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0) end
        end
        LoadCodexItems(tabIndex)
    end

    for i = 1, 4 do categoryBtns[i].MouseButton1Click:Connect(function() SwitchTab(i) end) end

    local function handleOpenCodex()
        codexGui.Enabled = true
        -- 【🌟 核心路径修正】
        mainFrame.Visible = true
        SwitchTab(1) 
    end

    if openCodexBtn:IsA("GuiButton") then openCodexBtn.Activated:Connect(handleOpenCodex)
    else openCodexBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then handleOpenCodex() end end) end
    
    local updateInventoryRE = ReplicatedStorage:WaitForChild("UpdateInventoryRE", 5)
    if updateInventoryRE then
        updateInventoryRE.OnClientEvent:Connect(function()
            if codexGui.Enabled then for i = 1, 4 do if scrollingFrames[i].Visible then LoadCodexItems(i) break end end end
        end)
    end

    -- 【🌟 核心路径修正】：关闭按钮直接在 MainFrame 下
    local closeBtn = mainFrame:FindFirstChild("Close") or mainFrame:FindFirstChild("CloseBtn", true)
    if closeBtn then
        local function handleCloseCodex() codexGui.Enabled = false; descriptionFrame.Visible = false end
        if closeBtn:IsA("GuiButton") then closeBtn.Activated:Connect(handleCloseCodex)
        else closeBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then handleCloseCodex() end end) end
    end 
    print("图典模块：已适配统一后的层级结构（不再寻找 Plant，改找 mainFrame）！")
end

return EncyclopediaController</string>
            </Properties>
          </Item>
          <Item class="Folder" referent="52">
            <Properties>
              <string name="Name">EventUI</string>
            </Properties>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">AchievePage</string>
                <string name="Source">local AchievePage = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UIEffectUtil = require(script.Parent.Parent.Parent:WaitForChild("Utils"):WaitForChild("UIEffectUtil"))
-- 引入奖励配置表
local LevelRewardConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("LevelRewardConfig"))
function AchievePage.Init(achieveFrame)
    if not achieveFrame then return end
    
    -- 🌟 获取服务器玩家真实数据
    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    local playerData = getPlayerDataRF:InvokeServer()
    local unlockedLevel = playerData and playerData.UnlockedLevel or 1
    
    -- 1. 绑定关闭按钮
    local closeBtn = achieveFrame:FindFirstChild("CloseButton", true)
    if closeBtn then 
        closeBtn.MouseButton1Click:Connect(function() 
            achieveFrame.Visible = false 
        end) 
    end
    
    -- 2. 查找滚动列表和模板
    local scrollFrame = achieveFrame:FindFirstChild("AchievePage", true)
    local templates = ReplicatedStorage:FindFirstChild("UITemplates")
    local achieveItemTemplate = templates and templates:FindFirstChild("AchieveItem")
    
    if not scrollFrame or not achieveItemTemplate then return end
    
    scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    for _, child in pairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    -- 3. 获取并排序关卡序列
    local levelKeys = {}
    for level, _ in pairs(LevelRewardConfig) do
        table.insert(levelKeys, level)
    end
    table.sort(levelKeys)
    
    -- 4. 遍历配置生成 UI
    for _, level in ipairs(levelKeys) do
        local rewardData = LevelRewardConfig[level]
        local item = achieveItemTemplate:Clone()
        item.Name = "Level_" .. tostring(level)
        
        local descText = item:FindFirstChild("DescriptionText", true)
        if descText then descText.Text = "Level " .. tostring(level) .. " Reward" end
        
        local detailsText = item:FindFirstChild("DetailsText", true)
        if detailsText then detailsText.Text = "Reach Level " .. tostring(level) .. " to get rewards" end

        -- 获取关键UI组件
        local progressBar = item:FindFirstChild("ProgressBarImage", true)
        local fillBar = item:FindFirstChild("Fill", true) 
        local claimBtn = item:FindFirstChild("ClaimBattle", true)
        local btnText = claimBtn and claimBtn:FindFirstChild("TextLabel", true)

        if progressBar and not fillBar then
            warn("【UI警告】关卡 " .. level .. " 的进度条中找不到名为 'Fill' 的组件，进度条将无法变长！")
        end
        
        -- 记录模板的默认颜色
        local defaultItemBgColor = item.BackgroundColor3
        local defaultProgressColor = Color3.new(1, 1, 1)
        local defaultFillColor = Color3.new(1, 1, 1)
        if progressBar then defaultProgressColor = progressBar.ImageColor3 end
        if fillBar then 
            if fillBar:IsA("ImageLabel") then defaultFillColor = fillBar.ImageColor3 
            elseif fillBar:IsA("Frame") then defaultFillColor = fillBar.BackgroundColor3 end
        end
        
        -- 计算真实进度与百分比
        local currentProgress = math.clamp(unlockedLevel, 0, level)
        local percent = currentProgress / level

        -- 读取服务端记录的领取状态
        local isClaimed = playerData.ClaimedAchieve and playerData.ClaimedAchieve[tostring(level)]
        
        -- 🌟 蒙版判定标志
        local shouldAddMask = false

        -- ===========================
        -- 🌟 核心逻辑：颜色、透明度与百分比进度条
        -- ===========================
        if isClaimed then
            -- 【状态：已领取 (溢出)】
            shouldAddMask = true -- 🌟 已领取的也要加黑色蒙版
            
            if claimBtn then
                claimBtn.BackgroundColor3 = Color3.fromRGB(130, 130, 130)
                if btnText then btnText.Text = "Claimed" end
            end
            
            if progressBar then
                if progressBar:IsA("ImageLabel") then progressBar.ImageTransparency = 0
                elseif progressBar:IsA("Frame") then progressBar.BackgroundTransparency = 0 end
                
                local pText = progressBar:FindFirstChild("TextLabel", true)
                if pText then pText.Text = level .. " / " .. level end
                
                if fillBar then 
                    fillBar.Size = UDim2.new(1, 0, 1, 0)
                    if fillBar:IsA("ImageLabel") then fillBar.ImageTransparency = 0
                    elseif fillBar:IsA("Frame") then fillBar.BackgroundTransparency = 0 end
                end
            end

        elseif unlockedLevel &gt; level then
            -- 【状态：可领取 (溢出)】
            item.BackgroundColor3 = Color3.fromRGB(140, 140, 140) 
            
            if claimBtn then
                -- 🌟 【修改】：不再更改 claimBtn 的颜色，让它保持默认的亮色
                if btnText then btnText.Text = "Claim" end
                
                claimBtn.MouseButton1Click:Connect(function()
                    if claimBtn:GetAttribute("IsClaiming") then return end
                    claimBtn:SetAttribute("IsClaiming", true)
                    
                    local claimLevelRewardRF = ReplicatedStorage:WaitForChild("ClaimLevelRewardRF")
                    local success, msg = claimLevelRewardRF:InvokeServer(level)
                    
                    if success then
                        item.BackgroundColor3 = defaultItemBgColor
                        if progressBar then 
                            if progressBar:IsA("ImageLabel") then progressBar.ImageColor3 = defaultProgressColor
                            elseif progressBar:IsA("Frame") then progressBar.BackgroundColor3 = defaultProgressColor end
                        end
                        if fillBar then 
                            if fillBar:IsA("ImageLabel") then fillBar.ImageColor3 = defaultFillColor
                            elseif fillBar:IsA("Frame") then fillBar.BackgroundColor3 = defaultFillColor end
                        end
                        claimBtn.BackgroundColor3 = Color3.fromRGB(130, 130, 130)
                        if btnText then btnText.Text = "Claimed" end
                        
                        -- 🌟 领取成功后，动态给当前条目盖上黑蒙版
                        local lockMask = Instance.new("Frame")
                        lockMask.Name = "LockMask"
                        lockMask.Size = UDim2.new(1, 0, 1, 0)
                        lockMask.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        lockMask.BackgroundTransparency = 0.6
                        lockMask.BorderSizePixel = 0
                        lockMask.ZIndex = 99
                        local uiCorner = item:FindFirstChildOfClass("UICorner")
                        if uiCorner then uiCorner:Clone().Parent = lockMask end
                        lockMask.Parent = item
                        
                        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Success", Text = msg, Duration = 3 })
                    else
                        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Failed", Text = msg, Duration = 3 })
                    end
                    task.wait(0.5)
                    claimBtn:SetAttribute("IsClaiming", nil)
                end)
            end
            
            if progressBar then
                if progressBar:IsA("ImageLabel") then 
                    progressBar.ImageColor3 = Color3.fromRGB(110, 110, 110)
                    progressBar.ImageTransparency = 0 
                elseif progressBar:IsA("Frame") then 
                    progressBar.BackgroundColor3 = Color3.fromRGB(110, 110, 110)
                    progressBar.BackgroundTransparency = 0 
                end
                
                local pText = progressBar:FindFirstChild("TextLabel", true)
                if pText then pText.Text = level .. " / " .. level end
                
                if fillBar then 
                    fillBar.Size = UDim2.new(1, 0, 1, 0)
                    if fillBar:IsA("ImageLabel") then 
                        fillBar.ImageColor3 = Color3.fromRGB(110, 110, 110)
                        fillBar.ImageTransparency = 0
                    elseif fillBar:IsA("Frame") then
                        fillBar.BackgroundColor3 = Color3.fromRGB(110, 110, 110)
                        fillBar.BackgroundTransparency = 0
                    end
                end
            end

        else
            -- 【状态：不可领取 (未溢出)】
            shouldAddMask = true -- 🌟 不可领取的加黑色蒙版
            
            if claimBtn then
                claimBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100) 
                if btnText then btnText.Text = "Locked" end
            end
            
            if progressBar then
                if progressBar:IsA("ImageLabel") then progressBar.ImageTransparency = 0.5
                elseif progressBar:IsA("Frame") then progressBar.BackgroundTransparency = 0.5 end
                
                local pText = progressBar:FindFirstChild("TextLabel", true)
                if pText then pText.Text = currentProgress .. " / " .. level end
                
                if fillBar then 
                    fillBar.Size = UDim2.new(percent, 0, 1, 0) 
                    if fillBar:IsA("ImageLabel") then fillBar.ImageTransparency = 0.5
                    elseif fillBar:IsA("Frame") then fillBar.BackgroundTransparency = 0.5 end
                end
            end
        end
        
        -- ===========================
        -- 🌟 统一生成黑色蒙版
        -- ===========================
        if shouldAddMask then
            local lockMask = Instance.new("Frame")
            lockMask.Name = "LockMask"
            lockMask.Size = UDim2.new(1, 0, 1, 0) -- 撑满整个 Item
            lockMask.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- 纯黑
            lockMask.BackgroundTransparency = 0.6 -- 透明度 60%
            lockMask.BorderSizePixel = 0
            lockMask.ZIndex = 99 -- 层级盖住内部元素
            
            -- 自适应圆角
            local uiCorner = item:FindFirstChildOfClass("UICorner")
            if uiCorner then uiCorner:Clone().Parent = lockMask end
            
            lockMask.Parent = item
        end

        -- ===========================
        -- 🌟 设置奖励图标 (Reward_1 / Reward_2)
        -- ===========================
        local reward1 = item:FindFirstChild("Reward_1", true)
        if reward1 then
            if rewardData.Seed then
                reward1.Visible = true
                local countLabel = reward1:FindFirstChild("TextLabel", true)
                if countLabel then countLabel.Text = tostring(rewardData.SeedCount or 1) end
                
                local vp = reward1:FindFirstChild("ViewportFrame", true)
                if vp and vp:IsA("ViewportFrame") then
                    vp:ClearAllChildren()
                    local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
                    local seedModel = itemModels and itemModels:FindFirstChild(rewardData.Seed .. "_Plant")
                    if seedModel then
                        local cloneModel = seedModel:Clone()
                        cloneModel:PivotTo(cloneModel:GetPivot() * CFrame.Angles(0, math.rad(-160), 0))
                        cloneModel.Parent = vp
                        local camera = Instance.new("Camera")
                        vp.CurrentCamera = camera
                        camera.Parent = vp
                        local cf, size = cloneModel:GetBoundingBox()
                        local dist = size.Magnitude * 0.3
                        camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist, dist*0.6, dist), cf.Position)
                    end
                end
            else
                reward1.Visible = false
            end
        end
        
        local reward2 = item:FindFirstChild("Reward_2", true)
        if reward2 then
            if rewardData.Sun then
                reward2.Visible = true
                local sunLabel = reward2:FindFirstChild("TextLabel", true)
                if sunLabel then sunLabel.Text = UIEffectUtil.FormatNumber(rewardData.Sun) end
            else
                reward2.Visible = false
            end
        end
        
        item.Parent = scrollFrame
    end
end

return AchievePage</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">EventUIManager</string>
                <string name="Source">-- src/client/UI/EventUI/EventUIManager.luau
local EventUIManager = {}

local Players = game:GetService("Players")
local SevenDayPage = require(script.Parent.SevenDayPage)
local AchievePage = require(script.Parent.AchievePage) 
local UIEffectUtil = require(script.Parent.Parent.Parent.Utils.UIEffectUtil)

function EventUIManager.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    
    local eventPage = basicGui:WaitForChild("EventPage")
    -- 🌟 修复延迟：还原为 FindFirstChild，去掉等待时间，解决开局加载慢的问题！
    local overlay = eventPage:FindFirstChild("Overlay") 
    local sevenDayFrame = eventPage:FindFirstChild("7Day")
    local achieveFrame = eventPage:FindFirstChild("Achieve") 
    
    local playProperty = basicGui:FindFirstChild("PlayProperty")
    local achieveBtn = playProperty and playProperty:FindFirstChild("Achieve") 

    -- 🌟 状态锁：记录当前大容器是否处于打开状态，防止虚化请求重复叠加
    local isContainerOpen = false

    -- 统一打开容器的封装
    local function OpenEventContainer(targetPage)
        if not eventPage:IsA("ScreenGui") then return end
        
        -- 1. 开启大界面
        eventPage.DisplayOrder = 100
        eventPage.Enabled = true
        
        -- 2. 隐藏下方金币/属性栏
        if playProperty then
            if playProperty:IsA("ScreenGui") then playProperty.Enabled = false
            else playProperty.Visible = false end
        end

        -- 3. 激活遮罩
        if overlay then
            overlay.Visible = true
            overlay.BackgroundTransparency = 1
            overlay.Active = true
        end

        -- 4. 精准控制子页面显示：先开目标页，再关其他页，防止闪烁
        if targetPage then targetPage.Visible = true end
        if sevenDayFrame and targetPage ~= sevenDayFrame then sevenDayFrame.Visible = false end
        if achieveFrame and targetPage ~= achieveFrame then achieveFrame.Visible = false end

        -- 5. 调用虚化（安全锁：只有之前没开过虚化，这次才调用）
        if not isContainerOpen then
            isContainerOpen = true
            UIEffectUtil.SetScreenBlur(true, overlay)
        end
    end

    -- 统一关闭容器的封装
    local function CloseEventContainer()
        -- 撤销虚化
        if isContainerOpen then
            isContainerOpen = false
            UIEffectUtil.SetScreenBlur(false, overlay)
        end

        -- 恢复下方栏
        if playProperty then
            if playProperty:IsA("ScreenGui") then playProperty.Enabled = true
            else playProperty.Visible = true end
        end

        -- 延迟关闭大容器，等待虚化动画平滑消失
        task.delay(0.3, function()
            eventPage.Enabled = false
        end)
    end

    -- 监听子界面的关闭事件
    local function OnPageClosed()
        -- 只要有任何一个页面还在显示，就不关大容器；只有两个都关了才彻底撤销虚化
        local isSevenOpen = sevenDayFrame and sevenDayFrame.Visible
        local isAchieveOpen = achieveFrame and achieveFrame.Visible
        
        if not isSevenOpen and not isAchieveOpen then
            CloseEventContainer()
        end
    end

    if sevenDayFrame then
        sevenDayFrame:GetPropertyChangedSignal("Visible"):Connect(OnPageClosed)
    end

    if achieveFrame then
        achieveFrame:GetPropertyChangedSignal("Visible"):Connect(OnPageClosed)
    end

    -- 绑定大厅成就按钮
    if achieveBtn then
        achieveBtn.MouseButton1Click:Connect(function()
            OpenEventContainer(achieveFrame)
        end)
    end

    -- ==========================================
    -- 🌟 完全还原你原版代码开局秒出的执行逻辑！
    -- ==========================================
    -- 1. 游戏一启动，瞬间强制打开签到页容器与虚化（0延迟！）
    if eventPage:IsA("ScreenGui") then
        OpenEventContainer(sevenDayFrame)
    end

    -- 2. 初始化签到逻辑，加载网络数据
    if sevenDayFrame then
        SevenDayPage.Init(sevenDayFrame)
    end

    -- 3. 初始化成就逻辑（并确保开局时被隐藏，不遮挡签到页）
    if achieveFrame then
        AchievePage.Init(achieveFrame)
        achieveFrame.Visible = false
    end
end

return EventUIManager</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">NewbieGiftController</string>
                <string name="Source">-- src/client/UI/NewbieGiftController.luau
local NewbieGiftController = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local PRODUCT_ID = 3594585526
local TIME_LIMIT_SECONDS = 24 * 60 * 60 -- 24 小时

function NewbieGiftController.Init()
    local player = Players.LocalPlayer
    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    local startNewbieGiftRF = ReplicatedStorage:WaitForChild("StartNewbieGiftRF")
    local updateInventoryRE = ReplicatedStorage:WaitForChild("UpdateInventoryRE")
    
    task.spawn(function()
        local data = getPlayerDataRF:InvokeServer()
        
        -- 1. 等待玩家打完新手教程（TutorialStep &gt;= 9）
        while (data.TutorialStep or 0) &lt; 9 do
            task.wait(2)
            data = getPlayerDataRF:InvokeServer()
        end

        -- 2. 如果已经买过了，直接退出
        if data.NewbieGiftPurchased then return end

        -- 3. 如果倒计时没开始过，通知服务器记录开始时间
        local startTime = data.NewbieGiftStartTime
        if not startTime or startTime == 0 then
            local success, realStartTime = startNewbieGiftRF:InvokeServer()
            if success then startTime = realStartTime end
        end

        -- 4. 计算剩余时间并检查是否过期
        local function getTimeLeft()
            return TIME_LIMIT_SECONDS - (os.time() - startTime)
        end
        if getTimeLeft() &lt;= 0 then return end -- 已经过期，不再出现

        -- 5. 克隆并配置 UI
        local playerGui = player:WaitForChild("PlayerGui")
        local basicGui = playerGui:WaitForChild("BasicGui")
        local playProperty = basicGui:WaitForChild("PlayProperty")
        local template = ReplicatedStorage:WaitForChild("UITemplates"):WaitForChild("Newbie_TimeLimitGift")
        
        local giftUI = template:Clone()
        giftUI.Position = UDim2.new(0.938, 0, 0.482, 0)
        giftUI.Parent = playProperty
        
        local timeTextLabel = giftUI:FindFirstChild("TimeText", true)
        
        -- 6. 绑定点击事件，拉起支付
        local clickBtn = giftUI:IsA("GuiButton") and giftUI or giftUI:FindFirstChildWhichIsA("GuiButton", true)
        local clickConn
        if clickBtn then
            clickConn = clickBtn.MouseButton1Click:Connect(function()
                MarketplaceService:PromptProductPurchase(player, PRODUCT_ID)
            end)
        end

        -- 7. 监听数据变化 (检测是否已付款)
        local isPurchased = false
        local dataConn = updateInventoryRE.OnClientEvent:Connect(function(newData)
            if newData.NewbieGiftPurchased then
                isPurchased = true
            end
        end)

        -- 8. 倒计时核心循环
        local loopConn
        local lastTick = tick()
        loopConn = RunService.Heartbeat:Connect(function()
            -- 每1秒刷新一次UI，节省性能
            if tick() - lastTick &gt;= 1 then
                lastTick = tick()
                
                local timeLeft = getTimeLeft()
                
                -- 如果已经购买，或者时间到了 -&gt; 销毁 UI
                if isPurchased or timeLeft &lt;= 0 then
                    giftUI:Destroy()
                    if loopConn then loopConn:Disconnect() end
                    if clickConn then clickConn:Disconnect() end
                    if dataConn then dataConn:Disconnect() end
                    return
                end

                -- 格式化时间并更新 Text
                if timeTextLabel then
                    local h = math.floor(timeLeft / 3600)
                    local m = math.floor((timeLeft % 3600) / 60)
                    local s = timeLeft % 60
                    timeTextLabel.Text = string.format("%02d:%02d:%02d", h, m, s)
                end
            end
        end)
    end)
end

return NewbieGiftController</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="56">
              <Properties>
                <string name="Name">SevenDayPage</string>
                <string name="Source">-- src/client/UI/EventUI/SevenDayPage.luau
local SevenDayPage = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local PRODUCT_ID = 3582734340 -- 内购 ID

-- 封装埋点上报函数
local function ReportAnalytics(eventName, eventData)
    local analyticsRE = ReplicatedStorage:FindFirstChild("AnalyticsRE")
    if analyticsRE then
        analyticsRE:FireServer("Custom", eventName, eventData)
    end
end

-- 引入 Viewport 渲染工具
local UIEffectUtil = require(script.Parent.Parent.Parent.Utils.UIEffectUtil)

-- 👇 新增：引入签到奖励统一配置
local SignInRewardConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SignInRewardConfig"))

-- 定义颜色渐变
local GREEN_GRADIENT = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(85, 255, 127)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 170, 0))
}
local GREY_GRADIENT = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 180, 180)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 100, 100))
}
-- 已领取按钮的专属渐变（清爽蓝）
local CLAIMED_GRADIENT = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 200, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 100, 200))
}
local CLAIMED_STROKE = Color3.fromRGB(0, 50, 100) -- 按钮描边颜色

-- 辅助函数：格式化倒计时
local function GetFormattedRemainingTime()
    local now = os.date("*t", os.time())
    local tomorrowMidnight = os.time({
        year = now.year, month = now.month, day = now.day + 1, 
        hour = 0, min = 0, sec = 0
    })
    local diff = tomorrowMidnight - os.time()
    
    local hours = math.floor(diff / 3600)
    local minutes = math.floor((diff % 3600) / 60)
    local seconds = diff % 60
    
    return string.format("%02d:%02d:%02d", hours, minutes, seconds)
end

local function RenderUI(sevenDayFrame, playerData)
    if not playerData then return end
    
    local timeText = sevenDayFrame:FindFirstChild("TimeText", true)
    local signInDays = playerData.SignInDays or 0
    local lastTime = playerData.LastSignInTime or 0
    
    local isClaimedToday = false
    if lastTime &gt; 0 then
        local lastDate = os.date("*t", lastTime)
        local currDate = os.date("*t", os.time())
        isClaimedToday = (lastDate.year == currDate.year and lastDate.month == currDate.month and lastDate.day == currDate.day)
    end

    if timeText then timeText.Visible = isClaimedToday end
    
    -- ==========================================
    -- 控制内购按钮的显示与隐藏
    local claimAllBtn = sevenDayFrame:FindFirstChild("ClaimAllBattle", true)
    if claimAllBtn then
        --“7天奖励全部领完后，才隐藏内购按钮”
         claimAllBtn.Visible = (signInDays &lt; 7)
    end
    -- ==========================================

    local BLACK_STROKE = Color3.new(0, 0, 0)
    local GREEN_STROKE = Color3.fromRGB(0, 100, 0)

    for i = 1, 7 do
        local dayNode = sevenDayFrame:FindFirstChild("Day_" .. i, true)
        if not dayNode then continue end
        
        -- ==========================================
        -- [🌟 修正：读取统一配置来渲染 3D 植物]
        -- ==========================================
        local rewardCfg = SignInRewardConfig[i]
        
        if rewardCfg and rewardCfg.IsSpecial then
            -- 找到你那个名字叫 ImageLabel，但其实是 ViewportFrame 的节点
            local viewport = dayNode:FindFirstChild("ImageLabel", true)
           
            if viewport and viewport:IsA("ViewportFrame") then
                -- 直接将配置里的 ItemId 渲染进去
                UIEffectUtil.RenderToViewport(viewport, rewardCfg.ItemId, "Plant")

                -- 执行平滑旋转动画
                if not viewport:GetAttribute("IsRotating") then
                    viewport:SetAttribute("IsRotating", true)
                    task.spawn(function()
                        while viewport and viewport.Parent do
                            local dt = RunService.RenderStepped:Wait()
                            local model = viewport:FindFirstChildOfClass("Model")
                            if model then
                                -- 以每秒 60 度的速度旋转
                                model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(60 * dt), 0))
                            end
                        end
                    end)
                end
            end
        end

        local claimBtn = dayNode:FindFirstChild("ImageButton")
        if not claimBtn then continue end
        
        local btnText = claimBtn:FindFirstChild("TextLabel")
        local gradient = claimBtn:FindFirstChildOfClass("UIGradient")
        local btnStroke = claimBtn:FindFirstChildOfClass("UIStroke")

        local targetText, targetGradient, targetStrokeColor, isActive = "", nil, nil, false

        if i &lt;= signInDays then
            -- 已领取状态
            targetText = "Claimed"; targetGradient = CLAIMED_GRADIENT; targetStrokeColor = CLAIMED_STROKE; isActive = false
        elseif i == signInDays + 1 and not isClaimedToday then
            -- 可领取状态
            targetText = "Claim"; targetGradient = GREEN_GRADIENT; targetStrokeColor = GREEN_STROKE; isActive = true
        else
            -- 锁定状态
            targetText = "Locked"; targetGradient = GREY_GRADIENT; targetStrokeColor = BLACK_STROKE; isActive = false
        end

        if btnText then 
            btnText.Text = targetText; btnText.TextStrokeColor3 = targetStrokeColor; btnText.TextStrokeTransparency = 0 
            local textUIStroke = btnText:FindFirstChildOfClass("UIStroke")
            if textUIStroke then textUIStroke.Enabled = true; textUIStroke.Color = targetStrokeColor end
        end
        if gradient then gradient.Color = targetGradient end
        if btnStroke then btnStroke.Enabled = true; btnStroke.Color = targetStrokeColor; btnStroke.Thickness = 2 end

        claimBtn.Active = isActive; claimBtn.AutoButtonColor = isActive

        if isActive and not claimBtn:GetAttribute("IsBound") then
            claimBtn:SetAttribute("IsBound", true)
            claimBtn.MouseButton1Click:Connect(function()
                -- 埋点：玩家尝试领取第几天的奖励
                ReportAnalytics("SignIn_ClaimAttempt", {
                    DayIndex = i,
                    IsPremium = false
                })

                local claimSignInRF = ReplicatedStorage:WaitForChild("ClaimSignInRF")
                local success = claimSignInRF:InvokeServer()
                if success then
                    -- 埋点：领取成功
                    ReportAnalytics("SignIn_ClaimSuccess", {
                        DayIndex = i,
                        CurrentTotalDays = signInDays + 1
                    })
                    
                    -- 👇 改为：直接从配置表里读取 Tip
                    local currentReward = SignInRewardConfig[i]
                    if currentReward and currentReward.Tip then
                        UIEffectUtil.ShowTip(currentReward.Tip)
                    else
                        UIEffectUtil.ShowTip("领取成功！")
                    end
                end
            end)
        end
    end
end

function SevenDayPage.Init(sevenDayFrame)
    if not sevenDayFrame then return end
    
    local closeBtn = sevenDayFrame:FindFirstChild("CloseBtn", true)
    local timeText = sevenDayFrame:FindFirstChild("TimeText", true)
    local claimAllBtn = sevenDayFrame:FindFirstChild("ClaimAllBattle", true)
    
    sevenDayFrame.Visible = true
    if closeBtn then closeBtn.MouseButton1Click:Connect(function() sevenDayFrame.Visible = false end) end
    
    task.spawn(function()
        while true do
            if sevenDayFrame.Visible and timeText and timeText.Visible then
                timeText.Text = "Next reward will appear in " .. GetFormattedRemainingTime()
            end
            task.wait(1)
        end
    end)
    
    task.spawn(function()
        local data = ReplicatedStorage:WaitForChild("GetPlayerDataRF"):InvokeServer(Players.LocalPlayer)
        RenderUI(sevenDayFrame, data)
    end)

   if claimAllBtn then
       claimAllBtn.MouseButton1Click:Connect(function()
            -- 🌟 新增：向服务器发送主动购买信号，证明这是新订单，不需要发补偿！
            local markIntentRE = ReplicatedStorage:FindFirstChild("MarkPurchaseIntentRE")
            if markIntentRE then markIntentRE:FireServer() end

            -- 埋点：点击内购按钮（追踪付费意向）
            ReportAnalytics("SignIn_PurchaseClick", {
                ProductId = PRODUCT_ID,
                Price = 4 -- 这里填入你的实际定价
            })
            MarketplaceService:PromptProductPurchase(Players.LocalPlayer, PRODUCT_ID)
        end)
    end

    -- 监听内购结果回调
    MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
        if productId == PRODUCT_ID then
            -- 埋点：内购最终状态（成功或取消）
            ReportAnalytics("SignIn_PurchaseResult", {
                ProductId = productId,
                Status = isPurchased and "Success" or "Cancelled/Failed"
            })
            
            if isPurchased then
                -- 埋点：成功一键解锁 7 天奖励
                ReportAnalytics("SignIn_BatchUnlockSuccess", {
                    UnlockType = "AllSevenDays"
                })
            end
        end
    end)
        
    ReplicatedStorage:WaitForChild("UpdateInventoryRE").OnClientEvent:Connect(function(newData)
        if sevenDayFrame.Visible then RenderUI(sevenDayFrame, newData) end
    end)
end

return SevenDayPage</string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">HotbarController</string>
              <string name="Source">-- src/client/UI/HotbarController.luau
local HotbarController = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService") 

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local BaseItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BaseItemConfig"))
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil) 

function HotbarController.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
  
    local basicGui = playerGui:WaitForChild("BasicGui")
    local playProperty = basicGui:WaitForChild("PlayProperty")
    local hotbarFrame = playProperty:WaitForChild("HotbarFrame")
    
    local uiTemplates = ReplicatedStorage:WaitForChild("UITemplates", 5)
    local slotTemplate = uiTemplates:WaitForChild("ItemTemplate", 5)
    local closeBtnTemplate = uiTemplates:WaitForChild("CloseBtn", 5)
    
    local currentEquippedId = nil
    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if not slotTemplate:FindFirstChild("UIScale") then Instance.new("UIScale", slotTemplate) end

    local function toggleEquip(targetSlot)
        local activeSlots = {}
        for _, child in pairs(hotbarFrame:GetChildren()) do 
            if child:IsA("Frame") then table.insert(activeSlots, child) end 
        end
        local targetId = targetSlot and targetSlot.Name or nil

        if currentEquippedId == targetId then
            currentEquippedId = nil;
            ReplicatedStorage:WaitForChild("HoldItemRE"):FireServer(nil)
        else
            currentEquippedId = targetId;
            ReplicatedStorage:WaitForChild("HoldItemRE"):FireServer(targetId)
        end
        
        for _, slot in pairs(activeSlots) do
            local isSelected = (slot.Name == currentEquippedId)
            local scaleObj = slot:FindFirstChild("UIScale")
            if scaleObj then TweenService:Create(scaleObj, tweenInfo, {Scale = isSelected and 1.15 or 1.0}):Play() end
        end
    end

    local function RefreshHotbar(newData)
        if not newData or not newData.Inventory then return end
        local currentItems, hotbarList = {}, newData.Hotbar or {} 
        local seedQuantityMap, plantQuantityMap = {}, {}
        
        if newData.Inventory.Seeds then 
            for _, s in ipairs(newData.Inventory.Seeds) do seedQuantityMap[s.ID] = s.Quantity end 
        end
        
        if newData.Inventory.Plants then 
            for _, p in ipairs(newData.Inventory.Plants) do 
                local mut = p.Mutation or 1
                plantQuantityMap[p.ID .. "_" .. mut] = p.Quantity 
            end 
        end

        local displayIndex = 1
        for index, compositeId in ipairs(hotbarList) do
            if compositeId == "System_Backpack" then continue end 

            local parts = string.split(compositeId, "_")
            local itemType, realId = parts[1], parts[2]
            local mutLvl = tonumber(parts[3]) or 1

            local qty, itemDetail = 0, nil

            if itemType == "Seed" then 
                qty = seedQuantityMap[realId] or 0;
                itemDetail = ItemConfig.Seeds and ItemConfig.Seeds[realId]
            elseif itemType == "Plant" then 
                qty = plantQuantityMap[realId .. "_" .. mutLvl] or 0;
                itemDetail = ItemConfig.Plants and ItemConfig.Plants[realId]
            elseif itemType == "Tool" then 
                qty = "∞";
                itemDetail = BaseItemConfig.Tools and BaseItemConfig.Tools[realId] 
            end

            if (type(qty) == "string" or qty &gt; 0) and itemDetail then
                local targetLayoutOrder, keyHint
                if displayIndex == 1 then 
                    targetLayoutOrder = 1;
                    keyHint = "1" 
                else 
                    targetLayoutOrder = displayIndex + 1 
                    local hintNum = displayIndex + 1
                    keyHint = (hintNum == 10) and "0" or tostring(hintNum) 
                end

                if displayIndex &gt;= 10 then break end 
                
                currentItems[compositeId] = true
                local targetSlot = hotbarFrame:FindFirstChild(compositeId)
        
                local lastClickTick = 0
                local function onSlotClicked() 
                    if os.clock() - lastClickTick &lt; 0.1 then return end;
                    lastClickTick = os.clock(); toggleEquip(targetSlot) 
                end

                if not targetSlot then
                    targetSlot = slotTemplate:Clone();
                    targetSlot.Name = compositeId; targetSlot.Visible = true; targetSlot.Parent = hotbarFrame

                    local isHoveringSlot = false;
                    local isHoveringBtn = false

                    if itemType == "Seed" or itemType == "Plant" then
                        local cBtn = closeBtnTemplate:Clone()
                        cBtn.Name = "CloseBtn"
                        cBtn.AnchorPoint = Vector2.new(0.5, 1) 
                        cBtn.Position = UDim2.new(0.5, 0, 0, 0) 
                        cBtn.ZIndex = 0;
                        cBtn.Visible = false; cBtn.Parent = targetSlot
                        
                        local function updateVisibility()
                            task.delay(0.05, function() if cBtn and cBtn.Parent then cBtn.Visible = (isHoveringSlot or isHoveringBtn) end end)
                        end

                        targetSlot.MouseEnter:Connect(function() isHoveringSlot = true; updateVisibility() end)
                        targetSlot.MouseLeave:Connect(function() isHoveringSlot = false; updateVisibility() end)
                        cBtn.MouseEnter:Connect(function() isHoveringBtn = true; updateVisibility() end)
                        cBtn.MouseLeave:Connect(function() isHoveringBtn = false; updateVisibility() end)

                        local function handleRemove()
                            ReplicatedStorage:WaitForChild("RemoveHotbarRE"):FireServer(compositeId)
                            if currentEquippedId == compositeId then toggleEquip(nil) end
                        end

                        if cBtn:IsA("GuiButton") then cBtn.Activated:Connect(handleRemove)
                        else
                            cBtn.InputBegan:Connect(function(input)
                                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then handleRemove() end
                            end)
                        end
                    end
                    
                    targetSlot.InputBegan:Connect(function(input) 
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                            if isHoveringBtn then return end;
                            onSlotClicked() 
                        end 
                    end)
                end

                targetSlot.LayoutOrder = targetLayoutOrder
                local bgImag = targetSlot:FindFirstChild("BGImag", true)
                local icomNode = targetSlot:FindFirstChild("Icom", true)
                local customIcon = targetSlot:FindFirstChild("CustomIcon", true)

                if itemType == "Tool" then
                    if bgImag then bgImag.Visible = true; bgImag.ZIndex = 1 end
                    if icomNode then icomNode.Visible = false end
                    if not customIcon then
                        customIcon = Instance.new("ImageLabel")
                        customIcon.Name = "CustomIcon";
                        customIcon.Size = UDim2.new(1, -10, 1, -10)
                        customIcon.Position = UDim2.new(0.5, 0, 0.5, 0);
                        customIcon.AnchorPoint = Vector2.new(0.5, 0.5)
                        customIcon.BackgroundTransparency = 1;
                        customIcon.ScaleType = Enum.ScaleType.Fit
                        customIcon.ZIndex = 2; customIcon.Active = false; customIcon.Parent = targetSlot
                    end
                    if itemDetail and itemDetail.IconId then
                        customIcon.Image = itemDetail.IconId
                    else
                        customIcon.Image = "rbxthumb://type=Asset&amp;id=129146573433376&amp;w=150&amp;h=150"
                    end
                    customIcon.Visible = true
                else
                    if customIcon then customIcon.Visible = false end
                    if bgImag then bgImag.Visible = true; bgImag.ZIndex = 1 end
                    if icomNode then
                        icomNode.Visible = true
                        if icomNode:IsA("ViewportFrame") then 
                            UIEffectUtil.RenderToViewport(icomNode, realId, itemType, mutLvl)
                        elseif icomNode:IsA("ImageLabel") or icomNode:IsA("ImageButton") then 
                            icomNode.Image = itemDetail.IconId or "" 
                        end
                        if not icomNode:GetAttribute("ClickBound") then
                            icomNode:SetAttribute("ClickBound", true)
                            icomNode.InputBegan:Connect(function(input) end)
                        end
                    end
                end

                local nameLabel = targetSlot:FindFirstChild("ItemName", true)
                if nameLabel then 
                    local mutPrefix = ""
                    if itemType == "Plant" and mutLvl &gt; 1 then 
                        mutPrefix = "[" .. (ItemConfig.MutationName and ItemConfig.MutationName[mutLvl] or "Variant") .. "] " 
                    end
                    nameLabel.Text = mutPrefix .. (itemDetail.Name or "")
                    nameLabel.TextWrapped = true
                    nameLabel.TextScaled = true
                    nameLabel.ZIndex = 3
                    nameLabel.Visible = true
                end
                
                local indexLabel = targetSlot:FindFirstChild("Index")
                if indexLabel then indexLabel.Text = keyHint; indexLabel.ZIndex = 3; indexLabel.Visible = true end
                
                if targetSlot:FindFirstChild("Quantity") then
                    if itemType == "Tool" then targetSlot.Quantity.Visible = false
                    else targetSlot.Quantity.Text = (type(qty) == "number" and "x" or "") .. tostring(qty); targetSlot.Quantity.ZIndex = 3; targetSlot.Quantity.Visible = true end
                end

                -- ==========================================
                -- 👇 [🌟 核心修复：兼容种子和植物，只要本体可投掷，就显示角标]
                -- ==========================================
                local isExplosive = false
                local plantRef = ItemConfig.Plants and ItemConfig.Plants[realId]
                if plantRef and plantRef.IsThrowable then
                    isExplosive = true
                end

                local expIcon = targetSlot:FindFirstChild("ExplosionIcon")
                if isExplosive then
                    if not expIcon then
                        expIcon = Instance.new("ImageLabel")
                        expIcon.Name = "ExplosionIcon"
                        expIcon.Size = UDim2.new(0, 24, 0, 24)
                        expIcon.Position = UDim2.new(0, 4, 0, 4) -- 统一左上角
                        expIcon.BackgroundTransparency = 1
                        expIcon.Image = "rbxassetid://5652766180"
                        expIcon.ZIndex = 100 -- 确保渲染在最顶层
                        expIcon.Parent = targetSlot
                    end
                    expIcon.Visible = true
                else
                    if expIcon then expIcon.Visible = false end
                end

                displayIndex += 1 
            end
        end
        
        local backpackId = "System_Backpack"
        local backpackDetail = BaseItemConfig.System and BaseItemConfig.System.Backpack
        currentItems[backpackId] = true 
        
        local backpackSlot = hotbarFrame:FindFirstChild(backpackId)
        local lastBpClickTick = 0
        local function onBackpackClicked()
            if os.clock() - lastBpClickTick &lt; 0.1 then return end;
            lastBpClickTick = os.clock()
            local scaleObj = backpackSlot and backpackSlot:FindFirstChild("UIScale")
            if scaleObj then TweenService:Create(scaleObj, tweenInfo, {Scale = 0.9}):Play(); task.delay(0.1, function() TweenService:Create(scaleObj, tweenInfo, {Scale = 1}):Play() end) end
            local invGui = basicGui:FindFirstChild("InventoryGui")
            if invGui then invGui.Enabled = not invGui.Enabled end
        end

        if not backpackSlot then
            backpackSlot = slotTemplate:Clone();
            backpackSlot.Name = backpackId; backpackSlot.Visible = true; backpackSlot.Parent = hotbarFrame
            backpackSlot.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then onBackpackClicked() end end)
        end
        
        local bpBgImag = backpackSlot:FindFirstChild("BGImag", true)
        if bpBgImag then bpBgImag.Visible = true; bpBgImag.ZIndex = 1 end
        local bpIcom = backpackSlot:FindFirstChild("Icom", true)
        if bpIcom then bpIcom.Visible = false end
        local bpCustomIcon = backpackSlot:FindFirstChild("CustomIcon", true)
        if not bpCustomIcon then
            bpCustomIcon = Instance.new("ImageLabel")
            bpCustomIcon.Name = "CustomIcon";
            bpCustomIcon.Size = UDim2.new(1, -10, 1, -10)
            bpCustomIcon.Position = UDim2.new(0.5, 0, 0.5, 0);
            bpCustomIcon.AnchorPoint = Vector2.new(0.5, 0.5)
            bpCustomIcon.BackgroundTransparency = 1;
            bpCustomIcon.ScaleType = Enum.ScaleType.Fit
            bpCustomIcon.ZIndex = 2; bpCustomIcon.Active = false;
            bpCustomIcon.Parent = backpackSlot
        end
        bpCustomIcon.Image = "rbxthumb://type=Asset&amp;id=108540025723786&amp;w=150&amp;h=150"
        bpCustomIcon.Visible = true;
        backpackSlot.LayoutOrder = 2
        local bpIndexLabel = backpackSlot:FindFirstChild("Index")
        if bpIndexLabel then bpIndexLabel.Text = "2"; bpIndexLabel.ZIndex = 3; bpIndexLabel.Visible = true end
        if backpackSlot:FindFirstChild("Quantity") then backpackSlot.Quantity.Visible = false end
        local bpNameLabel = backpackSlot:FindFirstChild("ItemName", true)
        if bpNameLabel then 
            bpNameLabel.Text = (backpackDetail and backpackDetail.Name) or "Backpack"
            bpNameLabel.TextWrapped = true 
            bpNameLabel.TextScaled = true  
            bpNameLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
            bpNameLabel.ZIndex = 3
            bpNameLabel.Visible = true
        end
        
        for _, slot in pairs(hotbarFrame:GetChildren()) do
            if slot:IsA("Frame") and not currentItems[slot.Name] then
                if currentEquippedId == slot.Name then toggleEquip(nil) end
                slot:Destroy()
            end
         end

         for _, slot in pairs(hotbarFrame:GetChildren()) do
             if slot:IsA("Frame") then
                 local scaleObj = slot:FindFirstChild("UIScale")
                 if scaleObj then
                     scaleObj.Scale = (slot.Name == currentEquippedId) and 1.15 or 1.0
                 end
             end
         end
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end 
        
        local keyMap = {
            [Enum.KeyCode.One] = "1", [Enum.KeyCode.Two] = "2", [Enum.KeyCode.Three] = "3",
            [Enum.KeyCode.Four] = "4", [Enum.KeyCode.Five] = "5", [Enum.KeyCode.Six] = "6",
            [Enum.KeyCode.Seven] = "7", [Enum.KeyCode.Eight] = "8", [Enum.KeyCode.Nine] = "9",
            [Enum.KeyCode.Zero] = "0"
        }
        
        local pressedNum = keyMap[input.KeyCode]
        if not pressedNum then return end

        for _, slot in pairs(hotbarFrame:GetChildren()) do
            if slot:IsA("Frame") then
                local indexLabel = slot:FindFirstChild("Index")
                
                if indexLabel and indexLabel.Text == pressedNum and slot.Visible then
                    if slot.Name == "System_Backpack" then
                        local scaleObj = slot:FindFirstChild("UIScale")
                        if scaleObj then 
                            TweenService:Create(scaleObj, tweenInfo, {Scale = 0.9}):Play()
                            task.delay(0.1, function() TweenService:Create(scaleObj, tweenInfo, {Scale = 1}):Play() end) 
                        end
                        local invGui = basicGui:FindFirstChild("InventoryGui")
                        if invGui then invGui.Enabled = not invGui.Enabled end
                    else
                        toggleEquip(slot)
                    end
                    break 
                end
            end
        end
    end)

    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    RefreshHotbar(getPlayerDataRF:InvokeServer())
    ReplicatedStorage:WaitForChild("UpdateInventoryRE").OnClientEvent:Connect(RefreshHotbar)

    local forceSelectRE = ReplicatedStorage:WaitForChild("ForceSelectRE", 5)
    if forceSelectRE then
        forceSelectRE.OnClientEvent:Connect(function(compositeId)
            local targetSlot = hotbarFrame:FindFirstChild(compositeId)
            if targetSlot then
                if currentEquippedId ~= compositeId then
                    toggleEquip(targetSlot)
                end
            end
        end)
    end

    local function onEquipChanged()
        local char = player.Character
        if not char then return end
        
        local realEquipped = char:GetAttribute("EquippedSeed")
        currentEquippedId = realEquipped
        
        for _, slot in pairs(hotbarFrame:GetChildren()) do
            if slot:IsA("Frame") then
                local isSelected = (slot.Name == currentEquippedId)
                local scaleObj = slot:FindFirstChild("UIScale")
                if scaleObj then
                    TweenService:Create(scaleObj, tweenInfo, {Scale = isSelected and 1.15 or 1.0}):Play()
                end
            end
        end
    end

    local function bindCharacter(char)
        char:GetAttributeChangedSignal("EquippedSeed"):Connect(onEquipChanged)
        onEquipChanged()
    end

    if player.Character then bindCharacter(player.Character) end
    player.CharacterAdded:Connect(bindCharacter)

    print("客户端：HotbarController 已修复！彻底兼容所有爆破类物品图标。")
end

return HotbarController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source">-- src/client/UI/InventoryController.luau
local InventoryController = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil) 

function InventoryController.Init()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

    local BasicGui = playerGui:WaitForChild("BasicGui")
    local inventoryGui = BasicGui:WaitForChild("InventoryGui")
    local mainFrame = inventoryGui:WaitForChild("MainFrame")
    local openButton = inventoryGui:FindFirstChild("OpenButton")
    local closeButton = mainFrame:WaitForChild("CloseButton")
    local tabButtons = mainFrame:WaitForChild("TabButtons")
    local pages = mainFrame:WaitForChild("Pages")

    local PlayProperty = BasicGui:FindFirstChild("PlayProperty")
    local CoinLabel = PlayProperty and PlayProperty:FindFirstChild("CoinLabel")
    
    local uiTemplatesFolder = ReplicatedStorage:WaitForChild("UITemplates")
    local itemTemplate = uiTemplatesFolder:WaitForChild("ItemTemplate")
    local seedPage = pages:WaitForChild("SeedPage")
    local plantPage = pages:WaitForChild("PlantPage")

    mainFrame.Visible = true;
    mainFrame.Active = true 
    local rootGui = mainFrame:FindFirstAncestorOfClass("ScreenGui")
    if rootGui then rootGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
        rootGui.DisplayOrder = 100 
    end

    mainFrame.ZIndex = mainFrame.ZIndex + 10000
    for _, uiElement in pairs(mainFrame:GetDescendants()) do if uiElement:IsA("GuiObject") then uiElement.ZIndex = uiElement.ZIndex + 10000 end end

    local function RefreshInventory(newData)
        if not newData or not newData.Inventory then return end
        
        if CoinLabel and (CoinLabel:IsA("TextLabel") or CoinLabel:IsA("TextButton")) then 
            UIEffectUtil.RollNumber(CoinLabel, newData.Coins, "") 
        end
        
        local currentSeedItems, currentPlantItems = {}, {}

        if newData.Inventory.Seeds then
            for _, seedData in ipairs(newData.Inventory.Seeds) do
                currentSeedItems[seedData.ID] = true 
                local existingSlot = seedPage:FindFirstChild(seedData.ID)
                if existingSlot then existingSlot.Quantity.Text = "x" .. tostring(seedData.Quantity)
                else
                    local itemDetail = ItemConfig.Seeds[seedData.ID]
                    if itemDetail then
                        local newSlot = itemTemplate:Clone()
                        newSlot.Index.Visible = false
                        newSlot.Name = seedData.ID 
                        newSlot.ItemName.Text = itemDetail.Name
                        newSlot.ItemName.TextWrapped = true  
                        newSlot.ItemName.TextScaled = true   
                        newSlot.Quantity.Text = "x" .. tostring(seedData.Quantity)
                    
                        local lastClickTick = 0
                        local function onSeedEquip() 
                            if os.clock() - lastClickTick &lt; 0.1 then return end;
                            lastClickTick = os.clock(); 
                            ReplicatedStorage:WaitForChild("EquipItemRE"):FireServer("Seed_" .. seedData.ID) 
                        end
                        newSlot.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then onSeedEquip() end end)

                        local icomNode = newSlot:FindFirstChild("Icom")
                        if icomNode then
                            if icomNode:IsA("ViewportFrame") then 
                                UIEffectUtil.RenderToViewport(icomNode, seedData.ID, "Seed") 
                            elseif icomNode:IsA("ImageLabel") or icomNode:IsA("ImageButton") then icomNode.Image = itemDetail.IconId or "" end
                            
                            if icomNode:IsA("GuiButton") then icomNode.Activated:Connect(onSeedEquip)
                            else icomNode.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then onSeedEquip() end end) end
                        end
                        newSlot.Parent = seedPage
                    end
                end
            end
        end

        if newData.Inventory.Plants then
            for _, plantData in ipairs(newData.Inventory.Plants) do
                local mutLevel = plantData.Mutation or 1
                local uniqueSlotId = plantData.ID .. "_" .. mutLevel
                currentPlantItems[uniqueSlotId] = true 
                
                local existingSlot = plantPage:FindFirstChild(uniqueSlotId)
                if existingSlot then existingSlot.Quantity.Text = "x" .. tostring(plantData.Quantity)
                else
                    local itemDetail = ItemConfig.Plants[plantData.ID]
                    if itemDetail then
                        local newSlot = itemTemplate:Clone()
                        newSlot.Index.Visible = false
                        newSlot.Name = uniqueSlotId 
                        newSlot.ItemName.TextWrapped = true  
                        newSlot.ItemName.TextScaled = true   
                      
                        local mutName = ItemConfig.MutationName and ItemConfig.MutationName[mutLevel] or "Unknown"
                        if mutLevel &gt; 1 then newSlot.ItemName.Text = "[" .. mutName .. "] " .. itemDetail.Name
                        else 
                            newSlot.ItemName.Text = itemDetail.Name 
                        end
                        newSlot.Quantity.Text = "x" .. tostring(plantData.Quantity)
                        
                        -- ==========================================
                        -- 👇 [🌟 精准修改：仅给可投掷植物(樱桃炸弹)加角标]
                        -- ==========================================
                        if itemDetail.IsThrowable then
                            local expIcon = Instance.new("ImageLabel")
                            expIcon.Name = "ExplosionIcon"
                            expIcon.Size = UDim2.new(0, 24, 0, 24)
                            expIcon.Position = UDim2.new(0, 4, 0, 4) -- 左上角
                            expIcon.BackgroundTransparency = 1
                            expIcon.Image = "rbxassetid://5652766180"
                            expIcon.ZIndex = 10
                            expIcon.Parent = newSlot
                        end
                        
                        local lastClickTick = 0
                        local function onPlantEquip() 
                            if os.clock() - lastClickTick &lt; 0.1 then return end;
                            lastClickTick = os.clock();
                            ReplicatedStorage:WaitForChild("EquipItemRE"):FireServer("Plant_" .. plantData.ID .. "_" .. mutLevel) 
                        end
                        newSlot.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then onPlantEquip() end end)

                        local icomNode = newSlot:FindFirstChild("Icom")
                        if icomNode then
                            if icomNode:IsA("ViewportFrame") then 
                                UIEffectUtil.RenderToViewport(icomNode, plantData.ID, "Plant", mutLevel) 
                            elseif icomNode:IsA("ImageLabel") or icomNode:IsA("ImageButton") then icomNode.Image = itemDetail.IconId or "" end
                            
                            if icomNode:IsA("GuiButton") then icomNode.Activated:Connect(onPlantEquip)
                            else icomNode.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then onPlantEquip() end end) end
                        end
                        newSlot.Parent = plantPage
                    end
                end
            end
        end
        
        for _, slot in pairs(seedPage:GetChildren()) do if slot:IsA("Frame") and not currentSeedItems[slot.Name] then slot:Destroy() end end
        for _, slot in pairs(plantPage:GetChildren()) do if slot:IsA("Frame") and not currentPlantItems[slot.Name] then slot:Destroy() end end
    end

    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    RefreshInventory(getPlayerDataRF:InvokeServer())
    ReplicatedStorage:WaitForChild("UpdateInventoryRE").OnClientEvent:Connect(RefreshInventory)

    if openButton then openButton.MouseButton1Click:Connect(function() inventoryGui.Enabled = true end) end
    closeButton.MouseButton1Click:Connect(function() inventoryGui.Enabled = false end)

    local function switchTab(targetPageName)
        for _, page in pairs(pages:GetChildren()) do
            if page:IsA("Frame") or page:IsA("ScrollingFrame") then page.Visible = (page.Name == targetPageName) end
        end
        for _, btn in pairs(tabButtons:GetChildren()) do
            if btn:IsA("GuiObject") then
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then
                    local isSelected = (btn.Name == "SeedTabBtn" and targetPageName == "SeedPage") or (btn.Name == "PlantTabBtn" and targetPageName == "PlantPage")
                    stroke.Color = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
                end
            end
        end
    end

    local openInvRE = ReplicatedStorage:WaitForChild("OpenInventoryRE", 5)
    if openInvRE then
        openInvRE.OnClientEvent:Connect(function(targetPageName)
            inventoryGui.Enabled = true
            local pageToOpen = targetPageName or "SeedPage"
            switchTab(pageToOpen)
            
            local titleStr = (pageToOpen == "PlantPage") and "⚔️ Deploy Notice" or "🌱 Plant Notice"
            local textStr = (pageToOpen == "PlantPage") and "Please select a combat plant from your inventory to deploy!" or "Please select a seed from your inventory to plant!"
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = titleStr,
                    Text = textStr,
                    Duration = 4,
                })
            end)
        end)
    end

    switchTab("SeedPage")
    tabButtons:WaitForChild("SeedTabBtn").MouseButton1Click:Connect(function() switchTab("SeedPage") end)
    tabButtons:WaitForChild("PlantTabBtn").MouseButton1Click:Connect(function() switchTab("PlantPage") end)

    print("客户端：InventoryController 精简版加载完毕！带有炸弹专属角标！")
end

return InventoryController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">PlantHoverController</string>
              <string name="Source">-- src/client/UI/PlantHoverController.luau
local PlantHoverController = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

function PlantHoverController.Init()
    local player = Players.LocalPlayer
    local mouse = player:GetMouse()
    local playerGui = player:WaitForChild("PlayerGui")

    -- ==========================================
    -- [🎨 UI 核心容器 - 1.5倍整体放大]
    -- ==========================================
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlantHoverUI"
    billboard.Size = UDim2.new(0, 195, 0, 130)
    billboard.StudsOffset = Vector3.new(0, 6, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 50
    billboard.Enabled = false
    
    -- 🌟 1. 变异图标：移除描边防止“黑框”干扰，直接显示图片内容
    local mutIcon = Instance.new("ImageLabel")
    mutIcon.Name = "MutationIcon"
    mutIcon.Size = UDim2.new(0, 45, 0, 45) 
    mutIcon.Position = UDim2.new(0.5, -22, 0, 0) -- 位于容器最顶部
    mutIcon.BackgroundTransparency = 1 
    mutIcon.Visible = false 
    mutIcon.ScaleType = Enum.ScaleType.Fit 
    mutIcon.ZIndex = 10
    mutIcon.Parent = billboard

    -- 🌟 2. 名称/血条底板
    local bgFrame = Instance.new("Frame")
    bgFrame.Name = "MainPanel"
    bgFrame.Size = UDim2.new(1, 0, 0, 83)
    bgFrame.Position = UDim2.new(0, 0, 1, -83) -- 底部对齐
    bgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bgFrame.BackgroundTransparency = 0.5
    Instance.new("UICorner", bgFrame).CornerRadius = UDim.new(0, 8)
    bgFrame.Parent = billboard

    -- ⚔️ DPS 显示标签
    local dpsLabel = Instance.new("TextLabel")
    dpsLabel.Name = "DPSLabel"
    dpsLabel.Size = UDim2.new(1, 0, 0.25, 0)
    dpsLabel.Position = UDim2.new(0, 0, 0.08, 0)
    dpsLabel.BackgroundTransparency = 1
    -- 🌟 修复 1：必须设为白色，渐变色 UIGradient 才能正确显示！
    dpsLabel.TextColor3 = Color3.new(1, 1, 1) 
    dpsLabel.TextScaled = true
    dpsLabel.Font = Enum.Font.SourceSansBold
    dpsLabel.Parent = bgFrame

    local dpsGradient = Instance.new("UIGradient")
    dpsGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(134, 255, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(37, 205, 9))
    })
    dpsGradient.Rotation = 90
    dpsGradient.Parent = dpsLabel

    local dpsStroke = Instance.new("UIStroke")
    dpsStroke.Thickness = 1.5
    dpsStroke.Color = Color3.fromRGB(0, 0, 0)
    dpsStroke.Parent = dpsLabel

    -- 📛 植物名称
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0.35, 0)
    nameLabel.Position = UDim2.new(0, 0, 0.35, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = bgFrame

    local nameStroke = Instance.new("UIStroke")
    nameStroke.Thickness = 1.5
    nameStroke.Color = Color3.fromRGB(0, 0, 0)
    nameStroke.Parent = nameLabel

    -- ❤️ 血条区域
    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(0.85, 0, 0.15, 0)
    barBg.Position = UDim2.new(0.075, 0, 0.75, 0)
    barBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    barBg.BackgroundTransparency = 0.5
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 6)
    barBg.Parent = bgFrame

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(85, 255, 127) 
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 6)
    barFill.Parent = barBg

    -- 👇 [🌟 新增：生命值数值文本]
    local hpText = Instance.new("TextLabel")
    hpText.Name = "HPText"
    
    -- 【核心修改】：将 Y 轴的 Scale 调大到 1.8，让文本框高度达到血条的 1.8 倍
    hpText.Size = UDim2.new(1, 0, 1.8, 0) 
    -- 【核心修改】：因为高度变大了，为了让文字依然在血条中间，往上偏移 -0.4
    hpText.Position = UDim2.new(0, 0, -0.4, 0)
    hpText.BackgroundTransparency = 1
    hpText.TextColor3 = Color3.fromRGB(255, 255, 255) -- 白色文字
    hpText.TextStrokeTransparency = 0.2 -- 添加微微的黑边，防止文字和绿色进度条融为一体
    hpText.TextScaled = true
    hpText.Font = Enum.Font.SourceSansBold
    hpText.ZIndex = 2 -- 确保显示在血条的最上层
    hpText.Parent = barBg
    -- 👆 新增结束

    billboard.Parent = playerGui

    -- ==========================================
    -- [🌟 图片素材配置]
    -- ==========================================
    local MUTATION_ICONS = {
        [2] = "rbxassetid://89526577666854", -- 闪耀
        [3] = "rbxassetid://101706251051471", -- 雷电
        [4] = "rbxassetid://14507112520",  -- 圣光
    }

    -- ==========================================
    -- [🌟 动态逻辑处理]
    -- ==========================================
    local currentTarget = nil
    local hpConnection = nil

    local function updateUI()
        if not currentTarget or not currentTarget.Parent then return end
        
        local currentHP = currentTarget:GetAttribute("Health") or 0
        local maxHP = currentTarget:GetAttribute("MaxHealth") or 1
        local mutationLevel = currentTarget:GetAttribute("MutationLevel") or 1
        local ratio = math.clamp(currentHP / maxHP, 0, 1)

        TweenService:Create(barFill, TweenInfo.new(0.2), { Size = UDim2.new(ratio, 0, 1, 0) }):Play()
        
        -- 👇 [🌟 新增：更新生命值文本显示 (向下取整以防出现小数)]
        hpText.Text = math.floor(currentHP) .. " / " .. math.floor(maxHP)
        -- 👆 新增结束

        local plantId = currentTarget.Name
        local plantConfig = ItemConfig.Plants[plantId]
        nameLabel.Text = plantConfig and plantConfig.Name or plantId

        -- 🌟 更新图标：如果图片 ID 正确，现在会正常显示
        local iconId = MUTATION_ICONS[mutationLevel]
        if iconId then
            -- 获取品质颜色
            local mutColor =  Color3.fromRGB(255, 255, 255)
            mutIcon.Image = iconId
            -- 🌟 修复 2：如果图标本身带颜色，建议先将 ImageColor3 设为白色观察效果
            mutIcon.ImageColor3 = mutColor 
            mutIcon.Visible = true
        else
            mutIcon.Visible = false
        end

        -- [🌟 布局自适应判定]
        local canAttack = plantConfig and plantConfig.CanAttack and plantConfig.Attack and plantConfig.AttackInterval
        
       if canAttack then
            -- 🟢 有攻击力：显示 DPS，维持面板原高度 (83)
            
            -- [🌟 修复：严格读取 ItemConfig 中的变异攻击乘区]
            local stats = ItemConfig.MutationStats[mutationLevel] or ItemConfig.MutationStats[1]
            local finalAttack = math.floor(plantConfig.Attack * stats.DamageMul)
            local dpsValue = finalAttack / plantConfig.AttackInterval
            
            dpsLabel.Text = string.format("DPS: %.1f", dpsValue)
            dpsLabel.Visible = true
            
            -- 恢复默认高度与布局
            bgFrame.Size = UDim2.new(1, 0, 0, 83)
            bgFrame.Position = UDim2.new(0, 0, 1, -83)
            nameLabel.Position = UDim2.new(0, 0, 0.35, 0)
            barBg.Position = UDim2.new(0.075, 0, 0.75, 0)
        else
            -- 🔴 无攻击力（如向日葵）：隐藏 DPS，缩减面板高度 (58)
            dpsLabel.Visible = false
            
            -- 动态调整面板大小与位置，消除空白
            bgFrame.Size = UDim2.new(1, 0, 0, 58) 
            bgFrame.Position = UDim2.new(0, 0, 1, -58) -- 面板整体上移
            
            -- 内部组件向上微调，保持紧凑
            nameLabel.Position = UDim2.new(0, 0, 0.15, 0) 
            barBg.Position = UDim2.new(0.075, 0, 0.62, 0) 
        end
    end

    -- [雷达扫描]
    RunService.RenderStepped:Connect(function()
        local targetPart = mouse.Target
        local foundPlant = nil
        if targetPart then
            local currentObj = targetPart
            while currentObj and currentObj ~= Workspace do
                if currentObj:IsA("Model") and currentObj:GetAttribute("IsCombatPlant") then
                    foundPlant = currentObj
                    break
                end
                currentObj = currentObj.Parent
            end
        end

        if foundPlant then
            if currentTarget ~= foundPlant then
                currentTarget = foundPlant
                billboard.Adornee = foundPlant.PrimaryPart or foundPlant:FindFirstChildWhichIsA("BasePart") or foundPlant
                billboard.Enabled = true
                if hpConnection then hpConnection:Disconnect() end
                hpConnection = currentTarget:GetAttributeChangedSignal("Health"):Connect(updateUI)
                updateUI()
            end
        else
            if currentTarget then
                currentTarget = nil
                billboard.Enabled = false
                billboard.Adornee = nil
                if hpConnection then hpConnection:Disconnect(); hpConnection = nil end
            end
        end
    end)
end

return PlantHoverController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">RollController</string>
              <string name="Source"><![CDATA[-- src/client/UI/RollController.luau
local RollController = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local RollConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RollConfig"))
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil)

local TAB1_CASH_ROLL_COST_TEXT = "200K"
local SUN_ICON_IMAGE = "rbxassetid://102426033120992"
local TAB2_RARE_ROLL_PRODUCT_ID = 3599579545
local TAB2_RARE_ROLL_COST_TEXT = "39"
local ROBUX_ICON_IMAGE = "rbxassetid://98579817733785"

function RollController.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    
    local playProperty = basicGui:WaitForChild("PlayProperty")
    local openPageBtn = playProperty:WaitForChild("Roll") 
    
    local rollPage = basicGui:WaitForChild("RollPage")
    rollPage.DisplayOrder = 999
    local bgFrame = rollPage:WaitForChild("BGFrame") 
    local page1 = bgFrame:FindFirstChild("Page_1") or rollPage:WaitForChild("Page_1")
    local page2 = bgFrame:FindFirstChild("Page_2") or rollPage:WaitForChild("Page_2")
    local pages = {page1, page2}
    local currentPage = pages[1]
    local cashFrame = nil
    local maskFrame = nil
    local scrollList = nil
    
    -- 🌟 获取倒计时文本标�?
    local getTimeText = nil
    
    -- 🌟 本地倒计时缓�?
    local localRollTimer = 300
    -- 👇 开启背景阻挡层，防止穿透点�?
    bgFrame.Active = true 
    
    -- 🌟【修复穿�?】创建一个全屏透明拦截网！放在最底层，绝对拦截所有穿透点�?
    if not rollPage:FindFirstChild("ClickBlockerWall") then
        local blocker = Instance.new("TextButton")
        blocker.Name = "ClickBlockerWall"
        blocker.Size = UDim2.new(1, 0, 1, 0)
        blocker.BackgroundTransparency = 1
        blocker.Text = ""
        blocker.ZIndex = -999 
        blocker.Parent = rollPage
    end
    local tab1Btn = bgFrame:WaitForChild("Tab_1")
    local tab2Btn = bgFrame:WaitForChild("Tab_2")

    tab1Btn.AnchorPoint = Vector2.new(0, 0.5)
    tab2Btn.AnchorPoint = Vector2.new(0, 0.5)
    
    local tab1OriginalPos = tab1Btn.Position
    local tab2OriginalPos = tab2Btn.Position

    local closeBtn = rollPage:WaitForChild("CloseBtn") 
    local drawBtn = nil
    
    local uiTemplates = ReplicatedStorage:WaitForChild("UITemplates")
    local rollItemTemplate = uiTemplates:WaitForChild("RollItemTemplate")
    
    local ITEM_HEIGHT = rollItemTemplate.Size.Y.Offset
    if ITEM_HEIGHT == 0 then ITEM_HEIGHT = 130 end 

    local PADDING = 10
    local FIXED_SCROLL_SLOT_COUNT = 30

    local isRolling = false
    local idleConnection = nil 
    local currentIdleY = 0
    local currentTab = 1 
    local currentTickets = {0, 0} -- 本地缓存当前的抽奖次�?
    local hasSyncedRollTickets = false

    local TAB_SELECTED_SCALE = 1.3 
    local TAB_SELECTED_OFFSET_X = 35 
    local TAB_TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local scrollSlotsByPage = {}

    local function SortSlots(slots)
        table.sort(slots, function(a, b)
            if a.LayoutOrder ~= b.LayoutOrder then
                return a.LayoutOrder < b.LayoutOrder
            end

            if a.Position.Y.Offset ~= b.Position.Y.Offset then
                return a.Position.Y.Offset < b.Position.Y.Offset
            end

            return a.Name < b.Name
        end)
    end

    local function EnsureScrollListSlots(page)
        if not page then return end

        local pageMaskFrame = page:WaitForChild("MaskFrame")
        local pageScrollList = pageMaskFrame:WaitForChild("ScrollList")
        local slots = {}

        for _, child in ipairs(pageScrollList:GetChildren()) do
            if child:IsA("GuiObject") then
                table.insert(slots, child)
            end
        end

        if #slots > 0 then
            SortSlots(slots)
            scrollSlotsByPage[page] = slots
            return
        end

        local layout = pageScrollList:FindFirstChildOfClass("UIListLayout")
        local pagePadding = layout and layout.Padding.Offset or PADDING

        for i = 1, FIXED_SCROLL_SLOT_COUNT do
            local slot = rollItemTemplate:Clone()
            slot.Name = "Slot_" .. i
            slot.LayoutOrder = i
            slot.AnchorPoint = Vector2.new(0.5, 0.5)
            slot.Position = UDim2.new(0.5, 0, 0, ((i - 1) * (ITEM_HEIGHT + pagePadding)) + (ITEM_HEIGHT / 2))
            slot.Parent = pageScrollList
            table.insert(slots, slot)
        end

        scrollSlotsByPage[page] = slots
    end

    for _, page in ipairs(pages) do
        EnsureScrollListSlots(page)
    end

    local function RefreshCurrentPageRefs()
        currentPage = pages[currentTab]
        if not currentPage then return end

        for index, page in ipairs(pages) do
            if page then
                page.Visible = index == currentTab
            end
        end

        cashFrame = currentPage:FindFirstChild("Cash")
        maskFrame = currentPage:WaitForChild("MaskFrame")
        scrollList = maskFrame:WaitForChild("ScrollList")
        drawBtn = currentPage:WaitForChild("DrawBtn")
        getTimeText = currentPage:WaitForChild("GetTimeText")

        local layout = scrollList:FindFirstChildOfClass("UIListLayout")
        PADDING = layout and layout.Padding.Offset or 10
    end

    RefreshCurrentPageRefs()

    local function RefreshDrawButtonText()
        if not drawBtn then return end

        local drawText = drawBtn:FindFirstChildWhichIsA("TextLabel")
        if drawText then
            drawText.Text = "Pull (" .. (currentTickets[currentTab] or 0) .. ")"
        else
            drawBtn.Text = "Pull (" .. (currentTickets[currentTab] or 0) .. ")"
        end
    end

    local function RefreshCashUI()
        if not cashFrame then return end

        if not hasSyncedRollTickets then
            cashFrame.Visible = false
            cashFrame.Active = false
            return
        end

        local shouldShowCash = (currentTab == 1 and (currentTickets[1] or 0) <= 0)
            or (currentTab == 2 and (currentTickets[2] or 0) <= 0)
        cashFrame.Visible = shouldShowCash
        cashFrame.Active = shouldShowCash

        if cashFrame:IsA("ImageLabel") or cashFrame:IsA("ImageButton") then
            cashFrame.Image = currentTab == 2 and ROBUX_ICON_IMAGE or SUN_ICON_IMAGE
        end

        local priceLabel = cashFrame:FindFirstChild("Price")
        if priceLabel and priceLabel:IsA("TextLabel") then
            priceLabel.Text = currentTab == 2 and TAB2_RARE_ROLL_COST_TEXT or TAB1_CASH_ROLL_COST_TEXT
        end
    end

    -- ==========================================
    -- [🌟 新增：红点通知生成器]
    -- ==========================================
    local function CreateOrUpdateRedDot(parent, count)
        if not parent then return end
        local dot = parent:FindFirstChild("RedDotNotification")
        
        if count > 0 then
            if not dot then
                -- 创建背景容器（透明�?
                dot = Instance.new("Frame")
                dot.Name = "RedDotNotification"
                dot.Size = UDim2.new(0, 15, 0, 15) -- 稍微放大一点，保证图片够清�?
                
                -- 👇 [🌟 位置修复：中心点对准按钮的最右上角像素点]
                dot.Position = UDim2.new(1, 0, 0, 0) 
                dot.AnchorPoint = Vector2.new(0.5, 0.5) 
                
                -- 👇 [🌟 背景修复：完全透明，去除原本的红色方块底色]
                dot.BackgroundTransparency = 1 
                dot.ZIndex = 50
                
                -- 直接放入你的感叹号图�?
                local icon = Instance.new("ImageLabel")
                icon.Size = UDim2.new(1, 0, 1, 0) -- 图片撑满整个透明容器
                icon.Position = UDim2.new(0.5, 0, 0.5, 0)
                icon.AnchorPoint = Vector2.new(0.5, 0.5)
                icon.BackgroundTransparency = 1 -- 内部图片的背景同样透明
                icon.Image = "rbxassetid://24228463"
                icon.ZIndex = 51
                icon.Parent = dot
                
                dot.Parent = parent
            end
            dot.Visible = true
        else
            if dot then
                dot.Visible = false
            end
        end
    end

    -- ==========================================
    -- [🌟 新增：刷�?UI 文本与红点显示]
    -- ==========================================
    local function RefreshUI(data)
        if not data then return end
        currentTickets = data.RollTickets or {0, 0}
        hasSyncedRollTickets = true

        -- 🌟 从服务端同步最新剩余时�?
        if data.OnlineRollTimer then
            localRollTimer = data.OnlineRollTimer
        end
        
        -- 更新各个 Tab 上的红点
        CreateOrUpdateRedDot(tab1Btn, currentTickets[1])
        CreateOrUpdateRedDot(tab2Btn, currentTickets[2])
        
        -- 如果任意一个池子有次数，就在外部的总入口按钮亮起红�?
        local totalTickets = currentTickets[1] + currentTickets[2]
        CreateOrUpdateRedDot(openPageBtn, totalTickets)
        
        -- 更新抽奖按钮�?Pull (x) 文字
        RefreshDrawButtonText()

        RefreshCashUI()
    end

    -- 监听数据更新事件，随时刷新红�?
    local updateInventoryRE = ReplicatedStorage:WaitForChild("UpdateInventoryRE")
    updateInventoryRE.OnClientEvent:Connect(RefreshUI)

    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    local function SyncRollTicketsFromServer()
        local success, data = pcall(function()
            return getPlayerDataRF:InvokeServer()
        end)

        if success and data then
            RefreshUI(data)
        else
            RefreshCashUI()
        end
    end
    task.spawn(SyncRollTicketsFromServer)

    -- ==========================================
    -- [🌟 新增：独立更�?UI 倒计时循环]
    -- ==========================================
    -- ==========================================
    -- [🌟 优化：即时文本刷新函�?+ 倒计时驱动]
    -- ==========================================
    local function UpdateGetTimeText()
        if not getTimeText then return end
        
        if currentTab == 1 then
            -- 页面 1 显示精确的倒计�?
            local m = math.floor(localRollTimer / 60)
            local s = localRollTimer % 60
            getTimeText.Text = string.format("(%02d:%02d) Get one chance", m, s)
        elseif currentTab == 2 then
            -- 页面 2 立刻切换为更新提�?
            getTimeText.Text = "Ultra Rare Prize Pool"
        end
    end
    task.spawn(function()
        while task.wait(1) do
            -- 本地自己先递减，保�?UI 看起来是连贯�?
            if localRollTimer > 0 then
                localRollTimer = localRollTimer - 1
            else
                localRollTimer = 300 -- 等待服务端同步期间的本地假循�?
            end
            
            -- 如果抽奖页面开着，就刷新文字
            if rollPage.Enabled and getTimeText then
                if currentTab == 1 then
                    -- 计算分和�?
                    local m = math.floor(localRollTimer / 60)
                    local s = localRollTimer % 60
                    getTimeText.Text = string.format("(%02d:%02d) Get one chance", m, s)
                elseif currentTab == 2 then
                    getTimeText.Text = "Ultra Rare Prize Pool"
                end
            end
        end
    end)

    -- ==========================================
    -- [统一装配格子的核心逻辑]
    -- ==========================================
    local function ConfigureSlot(slot, itemId)
        local viewport = slot:FindFirstChild("Icom") or slot:FindFirstChildWhichIsA("ViewportFrame")
        if viewport then
            UIEffectUtil.RenderToViewport(viewport, itemId, "Plant", 1)
        end

        local plantConfig = ItemConfig.Plants[itemId]
        local quality = plantConfig and plantConfig.Quality or 1
        local rateStr = RollConfig.GetDisplayRate(currentTab, itemId)

        local bg = slot:FindFirstChild("BG")
        if bg then
            for i = 1, 5 do
                local qNode = bg:FindFirstChild(tostring(i))
                if qNode then
                    if qNode:IsA("UIGradient") then
                        qNode.Enabled = (i == quality)
                    elseif qNode:IsA("GuiObject") then
                        qNode.Visible = (i == quality)
                    end
                end
            end
            
            local rateText = bg:FindFirstChild("RateText")
            if rateText and rateText:IsA("TextLabel") then
                rateText.Text = rateStr
            end
        end
    end

    local function GetExistingSlot(container)
        if not container then return nil end
        if container:FindFirstChild("Icom") or container:FindFirstChild("BG") or container:FindFirstChildWhichIsA("ViewportFrame") then
            return container
        end

        local namedSlot = container:FindFirstChild("Slot") or container:FindFirstChild("RollItemTemplate")
        if namedSlot and namedSlot:IsA("GuiObject") then
            return namedSlot
        end

        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("GuiObject") then
                return child
            end
        end

        return nil
    end

    local function GetScrollSlots()
        if currentPage and scrollSlotsByPage[currentPage] then
            return scrollSlotsByPage[currentPage]
        end

        local slots = {}
        if not scrollList then return slots end

        for _, child in ipairs(scrollList:GetChildren()) do
            if child:IsA("GuiObject") then
                table.insert(slots, child)
            end
        end

        SortSlots(slots)

        if currentPage then
            scrollSlotsByPage[currentPage] = slots
        end

        return slots
    end

    local function GetSlotCenterY(slot)
        if not slot then return 0 end

        local height = slot.AbsoluteSize.Y
        if height <= 0 then
            height = slot.Size.Y.Offset
        end

        return slot.Position.Y.Offset + (height * (0.5 - slot.AnchorPoint.Y))
    end

    local function GetAverageSlotSpacing(slots)
        if #slots <= 1 then
            return ITEM_HEIGHT + PADDING
        end

        local totalSpacing = 0
        local spacingCount = 0

        for i = 2, #slots do
            local spacing = GetSlotCenterY(slots[i]) - GetSlotCenterY(slots[i - 1])
            if spacing > 0 then
                totalSpacing += spacing
                spacingCount += 1
            end
        end

        if spacingCount <= 0 then
            return ITEM_HEIGHT + PADDING
        end

        return totalSpacing / spacingCount
    end

    local function GetIdleLoopHeight(slots, poolCount)
        if #slots <= 0 then
            return ITEM_HEIGHT + PADDING
        end

        -- Studio 里建议按奖池顺序预摆至少两轮 Slot；这样这里可以用第 1 轮到第 2 轮的实际距离做无缝循环。
        if poolCount > 0 and #slots >= poolCount + 1 then
            local repeatedSetHeight = GetSlotCenterY(slots[poolCount + 1]) - GetSlotCenterY(slots[1])
            if repeatedSetHeight > 0 then
                return repeatedSetHeight
            end
        end

        local averageSpacing = GetAverageSlotSpacing(slots)
        return math.max(averageSpacing, (GetSlotCenterY(slots[#slots]) - GetSlotCenterY(slots[1])) + averageSpacing)
    end

    -- ==========================================
    -- [大奖展示引擎]
    -- ==========================================
    local function SetupLowestProbShowcase()
        if not currentPage then return end
        
        local targetPool = RollConfig.Pools[currentTab] or RollConfig.Pools[1]
        local sortedPool = {}
        for _, item in ipairs(targetPool) do
            table.insert(sortedPool, item)
        end
        
        table.sort(sortedPool, function(a, b)
            return a.Weight < b.Weight 
        end)
        
        for i = 1, 3 do
            local showContainer = currentPage:FindFirstChild("Show_" .. i)
            local prizeData = sortedPool[i]

            if showContainer and prizeData then
                local slot = GetExistingSlot(showContainer)
                if slot then
                    ConfigureSlot(slot, prizeData.Id)
                end
            end
        end
    end

    -- ==========================================
    -- [3D 视觉引擎]
    -- ==========================================
    local function Update3DVisuals()
        if not maskFrame or not scrollList then return end

        local maskCenterY = maskFrame.AbsoluteSize.Y / 2 
        local listOffsetY = scrollList.Position.Y.Offset 
        local maxDist = maskCenterY + (ITEM_HEIGHT / 2) 

        for _, slot in pairs(scrollList:GetChildren()) do
            if slot:IsA("GuiObject") then
                local slotCenterY = listOffsetY + GetSlotCenterY(slot)
                local dist = math.abs(slotCenterY - maskCenterY)
                local ratio = math.clamp(dist / maxDist, 0, 1)

                local uiScale = slot:FindFirstChildOfClass("UIScale")
                if not uiScale then
                    uiScale = Instance.new("UIScale")
                    uiScale.Parent = slot
                end

                uiScale.Scale = 1 - (ratio * ratio * 0.4) 
                
                local fadeAmount = ratio * ratio * 0.9 
                slot.BackgroundTransparency = fadeAmount
                local vp = slot:FindFirstChildWhichIsA("ViewportFrame")
                if vp then
                    vp.ImageTransparency = fadeAmount
                end
                
                local bg = slot:FindFirstChild("BG")
                if bg and bg:IsA("GuiObject") then
                    bg.BackgroundTransparency = fadeAmount
                    for _, child in pairs(bg:GetDescendants()) do
                        if child:IsA("TextLabel") then
                            child.TextTransparency = fadeAmount
                            child.TextStrokeTransparency = fadeAmount 
                        elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                            child.ImageTransparency = fadeAmount
                        end
                    end
                end
            end
        end
    end
-- ==========================================
    -- [🌟 新增：展示植�?3D 自转引擎]
    -- ==========================================
    local showcaseSpinConnection = nil
    
    local function StartShowcaseSpin()
        if showcaseSpinConnection then showcaseSpinConnection:Disconnect() end
        
        -- 使用渲染步进保证 60�?144�?极致顺滑
        showcaseSpinConnection = RunService.RenderStepped:Connect(function(dt)
            if not currentPage then return end
            -- 遍历那三个展示框 (Show_1, Show_2, Show_3)
            for i = 1, 3 do
                local showContainer = currentPage:FindFirstChild("Show_" .. i)
                if showContainer then
                    for _, slot in pairs(showContainer:GetChildren()) do
                        if slot:IsA("GuiObject") then
                            local vp = slot:FindFirstChild("Icom") or slot:FindFirstChildWhichIsA("ViewportFrame")
                            if vp then
                                -- 查找 ViewportFrame 里的真实 3D 模型并进行自�?
                                for _, child in ipairs(vp:GetChildren()) do
                                    if child:IsA("Model") and child.PrimaryPart then
                                        -- 速度: 每秒转动 60 度，想快点把 60 改大
                                        child:PivotTo(child:GetPivot() * CFrame.Angles(0, dt * math.rad(60), 0))
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    local function StopShowcaseSpin()
        if showcaseSpinConnection then
            showcaseSpinConnection:Disconnect()
            showcaseSpinConnection = nil
        end
    end
    -- ==========================================
    -- [状�?1]：开启无限循环滚�?
    -- ==========================================
    local function StartIdleScroll()
        if idleConnection then idleConnection:Disconnect() end

        local pool = RollConfig.Pools[currentTab] or RollConfig.Pools[1]
        local poolCount = #pool
        local slots = GetScrollSlots()

        if #slots <= 0 then
            warn("RollController: current page ScrollList has no fixed Slot. It should be initialized from RollItemTemplate once during RollController.Init().")
            return
        end

        for index, slot in ipairs(slots) do
            if poolCount > 0 then
                local poolIndex = ((index - 1) % poolCount) + 1
                ConfigureSlot(slot, pool[poolIndex].Id)
            end
        end

        local setHeight = GetIdleLoopHeight(slots, poolCount)
        currentIdleY = 0

        idleConnection = RunService.RenderStepped:Connect(function(dt)
            local speed = 80 
            currentIdleY = currentIdleY - speed * dt
            
            if currentIdleY <= -setHeight then
                currentIdleY = currentIdleY + setHeight
            end
            
            scrollList.Position = UDim2.new(0, 0, 0, currentIdleY)
            Update3DVisuals()
        end)
    end

    -- ==========================================
    -- [状�?2]：玩家点击抽�?
    -- ==========================================
    local function StartDraw()
        if isRolling then return end
        
        -- �?1 页没有免费次数时允许服务端走 200K 阳光付费抽奖；第 2 页没有次数时先引导购买稀有抽奖次数�?
        if (currentTickets[currentTab] or 0) <= 0 and currentTab ~= 1 then
            MarketplaceService:PromptProductPurchase(player, TAB2_RARE_ROLL_PRODUCT_ID)
            return
        end
        
        isRolling = true

        if idleConnection then 
            idleConnection:Disconnect() 
            idleConnection = nil
        end
        
        -- 🌟 ========================================================
        -- 【核心联动】：向服务端发送抽奖请求，真正扣除次数并下发种子！
        local success, result = ReplicatedStorage:WaitForChild("PerformRollRF"):InvokeServer(currentTab)
        if not success then
            UIEffectUtil.ShowTip(result or "Error")
            isRolling = false
            StartIdleScroll()
            return
        end
        
        -- 服务器返回了真实验证过扣除了票据的最终奖�?
        local finalPrize = result
        -- 🌟 ========================================================
        
        local ADD_ITEMS = 20
        local EXTRA_PADDING = 5
        local MIN_RECOMMENDED_SLOT_COUNT = ADD_ITEMS + EXTRA_PADDING + 1
        local slots = GetScrollSlots()
        local slotCount = #slots

        if slotCount <= 0 then
            UIEffectUtil.ShowTip("Roll slots are not configured")
            isRolling = false
            StartIdleScroll()
            return
        end

        if slotCount < MIN_RECOMMENDED_SLOT_COUNT then
            warn("RollController: current page ScrollList has " .. slotCount .. " fixed Slots; recommend at least " .. MIN_RECOMMENDED_SLOT_COUNT .. " Slots for a longer draw animation.")
        end

        local WIN_INDEX = math.clamp(ADD_ITEMS, 1, math.max(1, slotCount - EXTRA_PADDING))

        for i, slot in ipairs(slots) do
            local itemId = i == WIN_INDEX and finalPrize or RollConfig.GetRandomPrize(currentTab)
            ConfigureSlot(slot, itemId)
        end

        local maskCenterY = maskFrame.AbsoluteSize.Y / 2
        local winSlot = slots[WIN_INDEX]
        local winItemCenterY = GetSlotCenterY(winSlot)
        local targetY = maskCenterY - winItemCenterY
        
        targetY = targetY + math.random(-25, 25) 

        local drawTweenInfo = TweenInfo.new(4.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local drawTween = TweenService:Create(scrollList, drawTweenInfo, {
            Position = UDim2.new(0, 0, 0, targetY)
        })

        drawTween:Play()

        local drawVisualConnection = RunService.RenderStepped:Connect(function()
            Update3DVisuals()
        end)

        drawTween.Completed:Connect(function()
            drawVisualConnection:Disconnect()
            print("🎊 抽奖结束！玩家抽到了: " .. finalPrize .. " 🎊")

            local getFrameTemp = uiTemplates:FindFirstChild("GetFrame")
            if getFrameTemp then
                local getFrame = getFrameTemp:Clone()
                
                local vp = getFrame:FindFirstChild("GetViewport")
                if vp and vp:IsA("ViewportFrame") then
                    UIEffectUtil.RenderToViewport(vp, finalPrize, "Plant", 1)
                end
                
                getFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                getFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
                getFrame.Parent = rollPage
                
                local uiScale = getFrame:FindFirstChildOfClass("UIScale")
                if not uiScale then
                    uiScale = Instance.new("UIScale")
                    uiScale.Parent = getFrame
                end
                uiScale.Scale = 0.5 

                local popTween = TweenService:Create(uiScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Scale = 2
                })
                popTween:Play()

                local bg = getFrame:FindFirstChild("BG")
                local rotConnection
                if bg then
                    rotConnection = RunService.RenderStepped:Connect(function(dt)
                        bg.Rotation = bg.Rotation + (120 * dt) 
                    end)
                end

                task.wait(0.8)
                
                -- 👇 [🌟 核心联动：在收起动画时播放客户端满屏的礼花和通知！]
                local itemDetail = ItemConfig.Plants[finalPrize] or ItemConfig.Seeds[finalPrize]
                local itemName = itemDetail and itemDetail.Name or finalPrize
                UIEffectUtil.PlayConfettiEffect()
                UIEffectUtil.ShowTip("Congratulations, you obtained 1x " .. itemName)
                -- 👆 =========================================================

                local flyTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                local flyTween = TweenService:Create(getFrame, flyTweenInfo, {
                    Position = UDim2.new(0.5, 0, 1, -50) 
                })
                local scaleDownTween = TweenService:Create(uiScale, flyTweenInfo, {
                    Scale = 0 
                })

                flyTween:Play()
                scaleDownTween:Play()

                flyTween.Completed:Connect(function()
                    if rotConnection then rotConnection:Disconnect() end
                    getFrame:Destroy()
                    
                    isRolling = false
                    StartIdleScroll() 
                end)
            else
                task.wait(2)
                isRolling = false
                StartIdleScroll() 
            end
        end)
    end

    -- ==========================================
    -- [处理按钮放大和移动的补间函数]
    -- ==========================================
    local function AnimateTab(button, isSelected, originalPos)
        if not button then return end
        
        local uiScale = button:FindFirstChildOfClass("UIScale")
        if not uiScale then
            uiScale = Instance.new("UIScale")
            uiScale.Parent = button
        end

        local targetScale, targetPositionXOffset

        if isSelected then
            targetScale = TAB_SELECTED_SCALE
            targetPositionXOffset = originalPos.X.Offset + TAB_SELECTED_OFFSET_X 
        else
            targetScale = 1 
            targetPositionXOffset = originalPos.X.Offset 
        end

        TweenService:Create(button, TAB_TWEEN_INFO, {
            Position = UDim2.new(originalPos.X.Scale, targetPositionXOffset, originalPos.Y.Scale, originalPos.Y.Offset)
        }):Play()

        TweenService:Create(uiScale, TAB_TWEEN_INFO, {
            Scale = targetScale
        }):Play()
    end

    -- ==========================================
    -- [多页签切换逻辑]
    -- ==========================================
    local function SwitchTab(tabIndex)
        if isRolling then return end 
        if currentTab == tabIndex then return end 
        
        currentTab = tabIndex
        RefreshCurrentPageRefs()
        print("切换抽奖池至：Tab_" .. currentTab)
        
        -- 🌟【关键修改】在这里加入主动调用，切换的一瞬间立刻换字�?延迟�?
        UpdateGetTimeText()
        
        AnimateTab(tab1Btn, currentTab == 1, tab1OriginalPos)
        AnimateTab(tab2Btn, currentTab == 2, tab2OriginalPos)
        
        -- 刷新文字 (Pull 数量)
        RefreshDrawButtonText()
        RefreshCashUI()
        
        SetupLowestProbShowcase()
        StartIdleScroll()
    end

    if tab1Btn and tab1Btn:IsA("GuiButton") then
        tab1Btn.MouseButton1Click:Connect(function() SwitchTab(1) end)
    end

    if tab2Btn and tab2Btn:IsA("GuiButton") then
        tab2Btn.MouseButton1Click:Connect(function() SwitchTab(2) end)
    end

    -- ==========================================
    -- [按键事件绑定]
    -- ==========================================
    openPageBtn.MouseButton1Click:Connect(function()
        rollPage.Enabled = true
        rollPage.DisplayOrder = 999 
        task.wait() 
        SyncRollTicketsFromServer()
        
        local targetTab = 1
        currentTab = targetTab
        RefreshCurrentPageRefs()
        
        -- 🌟【关键修改】页面被玩家点开时，根据判定好的 targetTab 立刻刷一次文�?
        UpdateGetTimeText()
        
        RefreshDrawButtonText()
        RefreshCashUI()
        
        AnimateTab(tab1Btn, currentTab == 1, tab1OriginalPos)
        AnimateTab(tab2Btn, currentTab == 2, tab2OriginalPos)
        
        SetupLowestProbShowcase()
        StartShowcaseSpin() -- 🌟【动画接入】打开页面，三个植物立刻开始自�?
        
        if not isRolling then
            StartIdleScroll()
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        if isRolling then return end 
        rollPage.Enabled = false
        StopShowcaseSpin() -- 🌟【动画释放】关闭页面，立刻停止旋转，杜绝吃电脑性能
        
        if idleConnection then 
            idleConnection:Disconnect()
            idleConnection = nil
        end
    end)

    for _, page in ipairs(pages) do
        local pageDrawBtn = page and page:FindFirstChild("DrawBtn")
        if pageDrawBtn and pageDrawBtn:IsA("GuiButton") then
            pageDrawBtn.MouseButton1Click:Connect(function()
                StartDraw()
            end)
        end
    end
    print("客户端：RollController (真实扣费红点校验系统) 加载完毕�?)")
end

return RollController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source">-- src/client/UI/ShopController.luau
local ShopController = {}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil) 

local function GetConfiguredProductId(itemDetail)
    if type(itemDetail.ProductId) == "number" and itemDetail.ProductId &gt; 0 then
        return itemDetail.ProductId
    end
    if type(itemDetail.IAPProductId) == "number" and itemDetail.IAPProductId &gt; 0 then
        return itemDetail.IAPProductId
    end
    return nil
end

function ShopController.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    
    -- 商店界面
    local shopGui = basicGui:WaitForChild("ShopGui") 
    local shopFrame = shopGui:WaitForChild("ShopFrame")
    local closeBtn = shopFrame:WaitForChild("CloseBtn")
    local itemList = shopFrame:WaitForChild("ItemList")
    local timerLabel = shopFrame:WaitForChild("HeadUp"):WaitForChild("TimeText")

    -- 对话框及按钮
    local dialogPage = basicGui:WaitForChild("DialogPage")
    local shopDialog = dialogPage:WaitForChild("ShopDialog")
    local openShopBtn = shopDialog:WaitForChild("OpenShop")
    local closeDialogBtn = shopDialog:WaitForChild("Close")
    
    -- 获取 Sell, SellAll, Price 按钮
    local sellBtn = shopDialog:WaitForChild("Sell")
    local sellAllBtn = shopDialog:WaitForChild("SellAll")
    local priceBtn = shopDialog:WaitForChild("Price")

    -- 🌟 新增：追踪当前正在交互的戴夫模型和最大距离阈值
    local currentInteractingDave = nil
    local MAX_DISTANCE = 15 

    local shopSlotTemplate = itemList:WaitForChild("ShopSlot")
    shopSlotTemplate.Visible = false 

    local currentStockData = {}
    local targetRefreshTime = 0
    local localPlayerData = nil

    -- [渲染逻辑]
    local function RenderShop()
        if not localPlayerData or not currentStockData then return end
        for _, child in pairs(itemList:GetChildren()) do
            if child:IsA("Frame") and child ~= shopSlotTemplate then child:Destroy() end
        end

        for i = 1, #currentStockData do
            local slotData = currentStockData[i]
            local slot = shopSlotTemplate:Clone()
            slot.Name = string.format("%02d_Slot", i)
            slot.LayoutOrder = i
            
            if not slotData or not slotData.SeedId then
                slot.Visible = true
                slot.Parent = itemList; continue
            end

            local itemDetail = ItemConfig.Seeds[slotData.SeedId]
            if not itemDetail then continue end

            local reqLvl = itemDetail.UnlockLevel or 1
            local isUnlocked = localPlayerData.UnlockedLevel &gt;= reqLvl
            local displayStock = isUnlocked and slotData.Stock or 0
            
            if slot:FindFirstChild("ItemName") then slot.ItemName.Text = itemDetail.Name end
            if slot:FindFirstChild("StockText") then slot.StockText.Text = "x" .. displayStock end
            
            local icomNode = slot:FindFirstChild("Icom")
            if icomNode and icomNode:IsA("ViewportFrame") then
                UIEffectUtil.RenderToViewport(icomNode, slotData.SeedId, "Seed")
            end
            
            local buyBtn = slot:FindFirstChild("BuyBtn")
            if buyBtn then
                local inPriceText = buyBtn:FindFirstChild("PriceText")
                if not isUnlocked then
                    if inPriceText then inPriceText.Text = "Unlock Lv".. reqLvl end
                    buyBtn.ImageColor3 = Color3.fromRGB(150, 150, 150)
                elseif displayStock &lt;= 0 then
                    if inPriceText then inPriceText.Text = "Sold Out" end
                    buyBtn.ImageColor3 = Color3.fromRGB(200, 50, 50)
                else
                    if inPriceText then inPriceText.Text = UIEffectUtil.FormatNumber(itemDetail.BuyPrice or 0) end
                    buyBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
                    buyBtn.Activated:Connect(function()
                        local success, msg = ReplicatedStorage:WaitForChild("BuyItemRF"):InvokeServer(i, 1)
                        if success then 
                            UIEffectUtil.ShowTip("Obtained " .. itemDetail.Name)
                            
                            -- 👇 [🌟 新增：购买成功后自动装备]
                            -- 商店购买的都是 Seed 类型，拼接出真实的物品 ID
                            local compositeId = "Seed_" .. tostring(slotData.SeedId)
                            
                            -- 延迟 0.15 秒，确保服务端已经把物品塞进你的快捷栏并且 UI 更新完毕
                            task.delay(0.15, function()
                                -- 发送装备请求给服务端，模拟玩家点击了快捷栏
                                ReplicatedStorage:WaitForChild("HoldItemRE"):FireServer(compositeId)
                            end)
                            -- 👆 新增结束
                            
                        else 
                            UIEffectUtil.ShowTip(msg)
                        end
                    end)
                end
            end

            local iapBuyBtn = slot:FindFirstChild("IAPBuyBtn")
            if iapBuyBtn then
                local productId = GetConfiguredProductId(itemDetail)
                local hasProduct = productId ~= nil
                local iapPriceText = iapBuyBtn:FindFirstChild("PriceText")

                iapBuyBtn.Visible = hasProduct
                iapBuyBtn.Active = hasProduct
                iapBuyBtn.AutoButtonColor = hasProduct

                if iapPriceText then
                    iapPriceText.Text = UIEffectUtil.FormatNumber(itemDetail.IAPPrice or 0)
                end

                if hasProduct then
                    iapBuyBtn.Activated:Connect(function()
                        MarketplaceService:PromptProductPurchase(player, productId)
                    end)
                end
            end

            slot.Visible = true
            slot.Parent = itemList
        end
    end

    local getShopDataRF = ReplicatedStorage:WaitForChild("GetShopDataRF")
    local function UpdateData() 
        currentStockData, targetRefreshTime = getShopDataRF:InvokeServer()
        localPlayerData = ReplicatedStorage:WaitForChild("GetPlayerDataRF"):InvokeServer()
        RenderShop() 
    end
    UpdateData()

    RunService.RenderStepped:Connect(function()
        if shopGui.Enabled and targetRefreshTime &gt; 0 then
            local timeLeft = math.max(0, targetRefreshTime - os.time())
            timerLabel.Text = string.format("%02d:%02d", math.floor(timeLeft / 60), timeLeft % 60)
        end
    end)

    -- 🌟 新增：每帧检测距离，过远自动关闭页面
    RunService.Heartbeat:Connect(function()
        if (shopDialog.Visible or shopGui.Enabled) and currentInteractingDave then
            local char = player.Character
            if char then
                local playerPart = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
                local davePart = currentInteractingDave.PrimaryPart or currentInteractingDave:FindFirstChild("HumanoidRootPart") or currentInteractingDave:FindFirstChild("Head")
                
                if playerPart and davePart then
                    local distance = (playerPart.Position - davePart.Position).Magnitude
                    if distance &gt; MAX_DISTANCE then
                        -- 距离超过阈值，关闭页面并清理状态
                        shopDialog.Visible = false
                        shopGui.Enabled = false
                        currentInteractingDave = nil
                    end
                end
            end
        end
    end)

    ReplicatedStorage:WaitForChild("UpdateShopRE").OnClientEvent:Connect(function(stock, rTime) 
        currentStockData = stock; targetRefreshTime = rTime; RenderShop() 
    end)
    ReplicatedStorage:WaitForChild("UpdateInventoryRE").OnClientEvent:Connect(function(pData) 
        localPlayerData = pData; RenderShop()
    end)

    -- 🌟 修改：主动关闭页面时，重置 currentInteractingDave
    closeBtn.MouseButton1Click:Connect(function() 
        shopGui.Enabled = false 
        currentInteractingDave = nil 
    end)

    openShopBtn.MouseButton1Click:Connect(function()
        shopDialog.Visible = false 
        shopGui.Enabled = true     
    end)

    -- 🌟 修改：主动关闭页面时，重置 currentInteractingDave
    closeDialogBtn.MouseButton1Click:Connect(function()
        shopDialog.Visible = false 
        currentInteractingDave = nil
    end)

    -- 价格计算核心函数
    local function GetEquippedPrice(compositeId)
        if not compositeId or compositeId == "" then return nil end
        
        local parts = string.split(compositeId, "_")
        local itemType = parts[1]
        local realId = parts[2]
        local mutLvl = tonumber(parts[3]) or 1

        if itemType ~= "Seed" and itemType ~= "Plant" then return nil end

        local seedDetail = ItemConfig.Seeds[realId]
        if not seedDetail then return nil end

        local baseBuyPrice = seedDetail.BuyPrice or 0

        if itemType == "Seed" then
            return math.floor(baseBuyPrice * 0.3)
        elseif itemType == "Plant" then
            local price = baseBuyPrice * 0.4
            if mutLvl == 2 then price = price * 2
            elseif mutLvl == 3 then price = price * 3
            elseif mutLvl == 4 then price = price * 4
            end
            return math.floor(price)
        end
        return nil
    end

    -- 戴夫头顶的文字 BillboardGui 生成器
    local priceTagGui = nil
    local function ShowTagAboveDave(daveModel, textStr)
        if not priceTagGui then
            priceTagGui = Instance.new("BillboardGui")
            priceTagGui.Name = "PriceTag"
            priceTagGui.Size = UDim2.new(0, 200, 0, 50)
            priceTagGui.StudsOffset = Vector3.new(0, 3, 0)
            priceTagGui.AlwaysOnTop = true

            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextScaled = true
            textLabel.Font = Enum.Font.FredokaOne
            textLabel.Parent = priceTagGui
        end
        priceTagGui.TextLabel.Text = textStr
        priceTagGui.Parent = daveModel:FindFirstChild("Head") or daveModel.PrimaryPart
    end

    -- Sell 按钮逻辑
    sellBtn.MouseButton1Click:Connect(function()
        local char = player.Character
        local equippedId = char and char:GetAttribute("EquippedSeed")

        if not equippedId or equippedId == "" or string.find(equippedId, "Tool") then
            UIEffectUtil.ShowTip("Please equip a plant or seed")
            return
        end

        local success, msg = ReplicatedStorage:WaitForChild("SellEquippedRF"):InvokeServer()
        if success then
            UIEffectUtil.ShowTip(msg)
            if priceTagGui then priceTagGui:Destroy(); priceTagGui = nil end
        else
            UIEffectUtil.ShowTip(msg)
        end
    end)

    -- SellAll 按钮逻辑
    sellAllBtn.MouseButton1Click:Connect(function()
        local success, msg = ReplicatedStorage:WaitForChild("SellAllHotbarRF"):InvokeServer()
        if success then
            UIEffectUtil.ShowTip(msg)
            if priceTagGui then priceTagGui:Destroy(); priceTagGui = nil end
        else
            UIEffectUtil.ShowTip(msg)
        end
    end)

    -- Price 按钮逻辑
    priceBtn.MouseButton1Click:Connect(function()
        local char = player.Character
        local equippedId = char and char:GetAttribute("EquippedSeed")

        local myDave = nil
        local plots = Workspace:WaitForChild("Plots")
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:GetAttribute("OwnerId") == player.UserId then
                myDave = plot:FindFirstChild("CrazyDave")
                break
            end
        end

        if not myDave then return end

        if not equippedId or equippedId == "" or string.find(equippedId, "Tool") then
            ShowTagAboveDave(myDave, "Not Equipped")
            return
        end

        local price = GetEquippedPrice(equippedId)
        if price then
            ShowTagAboveDave(myDave, "Price: $" .. UIEffectUtil.FormatNumber(price))
        end
    end)

    -- 🌟 修改：交互绑定戴夫时，记录当前的戴夫对象
    local function bindDave(daveModel)
        task.spawn(function()
            local prompt = nil
            for i = 1, 50 do
                prompt = daveModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then break end
                task.wait(0.2)
            end

            if prompt then
                prompt.ActionText = "Talk to Dave"
                prompt.Triggered:Connect(function() 
                    currentInteractingDave = daveModel -- 记录交互对象
                    shopDialog.Visible = true 
                    if priceTagGui then priceTagGui:Destroy(); priceTagGui = nil end 
                end)
            end
            
            local clicker = daveModel:FindFirstChildWhichIsA("ClickDetector", true)
            if clicker then
                clicker.MouseClick:Connect(function() 
                    currentInteractingDave = daveModel -- 记录交互对象
                    shopDialog.Visible = true 
                    if priceTagGui then priceTagGui:Destroy(); priceTagGui = nil end
                end)
            end
        end)
    end

    local function searchMyDave()
        local plots = Workspace:WaitForChild("Plots")
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:GetAttribute("OwnerId") == player.UserId then
                local dave = plot:FindFirstChild("CrazyDave")
                if dave then bindDave(dave); return true end
            end
        end
        return false
    end

    if not searchMyDave() then
        Workspace:WaitForChild("Plots").DescendantAdded:Connect(function(desc)
            if desc.Name == "CrazyDave" and desc.Parent:GetAttribute("OwnerId") == player.UserId then
                bindDave(desc)
            end
        end)
    end
end

return ShopController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source">-- src/client/UI/TutorialController.luau
local TutorialController = {}

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TutorialEffect = require(script.Parent.Parent.Utils.TutorialEffect) 

function TutorialController.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    local inventoryGui = basicGui:WaitForChild("InventoryGui")
    local overlayGui = playerGui:WaitForChild("GlobalOverlayGui")
    local seedPage = inventoryGui:WaitForChild("MainFrame"):WaitForChild("Pages"):WaitForChild("SeedPage")
    local closeButton = inventoryGui:WaitForChild("MainFrame"):WaitForChild("CloseButton") 
    local playProperty = basicGui:WaitForChild("PlayProperty")
    local hotbarFrame = playProperty:WaitForChild("HotbarFrame")
    local battleBtn = playProperty:WaitForChild("StartBattle") -- 战斗按钮

    local getPlayerDataRF = ReplicatedStorage:WaitForChild("GetPlayerDataRF")
    local playerData = getPlayerDataRF:InvokeServer()
    local currentStep = playerData.TutorialStep or 0

    -- 教程总步数从 9 步减少到 8 步
    if currentStep &gt;= 8 then return end

    -- ==========================================
    -- 通用函数：创建提示文本
    -- ==========================================
    local function showTutorialTip(text)
        local bgFrame = Instance.new("Frame")
        bgFrame.Name = "TutorialTipBg"
        bgFrame.Position = UDim2.new(0.5, 0, 0.25, 0)
        bgFrame.AnchorPoint = Vector2.new(0.5, 0.5)
        bgFrame.AutomaticSize = Enum.AutomaticSize.X
        bgFrame.Size = UDim2.new(0, 0, 0, 80)
        bgFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bgFrame.BackgroundTransparency = 1 
        bgFrame.BorderSizePixel = 0
        bgFrame.Parent = overlayGui

        local gradient = Instance.new("UIGradient")
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.4),
            NumberSequenceKeypoint.new(1, 1)
        })
        gradient.Parent = bgFrame

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 100)
        padding.PaddingRight = UDim.new(0, 100)
        padding.Parent = bgFrame

        local label = Instance.new("TextLabel")
        label.Name = "TutorialText"
        label.Size = UDim2.new(0, 0, 1, 0)
        label.AutomaticSize = Enum.AutomaticSize.X
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextSize = 40
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextTransparency = 1
        label.Parent = bgFrame

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.Transparency = 1
        stroke.Parent = label

        TweenService:Create(bgFrame, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
        TweenService:Create(label, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.5), {Transparency = 0}):Play()

        return function()
            TweenService:Create(bgFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
            TweenService:Create(label, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
            task.delay(0.3, function() bgFrame:Destroy() end)
        end
    end

    local function getPlantOnPosition(plot, positionName)
        local plantsFolder = plot:FindFirstChild("Plants")
        if plantsFolder then
            for _, plant in ipairs(plantsFolder:GetChildren()) do
                if plant:GetAttribute("PlantedOn") == positionName then
                    return plant
                end
            end
        end
        return nil
    end

    -- ==========================================
    -- 【第 8 步】：战斗结束后引导去商店 (原第 9 步)
    -- ==========================================
    local function startStepEight()
        print("进入教程第 8 步：引导前往商店")
        local removeTip = showTutorialTip("You are not strong enough. Buy more seeds!")
        
        -- 寻找玩家自己的地块，并在里面寻找 CrazyDave
        local plotsFolder = Workspace:WaitForChild("Plots", 10)
        local targetPlot = nil
        
        if plotsFolder then
            for _, plot in ipairs(plotsFolder:GetChildren()) do
                if plot:GetAttribute("OwnerId") == player.UserId then
                    targetPlot = plot
                    break
                end
            end
        end

        local shopNPC = targetPlot and targetPlot:FindFirstChild("CrazyDave")
        local targetPart = shopNPC and (shopNPC.PrimaryPart or shopNPC:FindFirstChildWhichIsA("BasePart"))
        
        if not targetPart then
            warn("未找到商店 NPC (CrazyDave)，直接结束教程。")
            ReplicatedStorage.UpdateTutorialRE:FireServer(8)
            removeTip()
            return
        end

        local character = player.Character or player.CharacterAdded:Wait()
        -- 橙色引导线指向 CrazyDave
        local stopGuide = TutorialEffect.AddGuideBeam(character, targetPart, Color3.fromRGB(255, 170, 0))

        -- 寻找 CrazyDave 身上的 ProximityPrompt
        local shopPrompt = shopNPC:FindFirstChildWhichIsA("ProximityPrompt", true)
        if shopPrompt then
            local connection
            connection = shopPrompt.Triggered:Connect(function()
                connection:Disconnect()
                stopGuide()
                removeTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(8)
                print("🎉 玩家打开了商店，全套新手教程圆满结束！")
            end)
        else
            -- 备用方案：距离检测（靠近 CrazyDave 10格内即可完成）
            task.spawn(function()
                local completed = false
                while not completed do
                    local charRoot = character:FindFirstChild("HumanoidRootPart")
                    if charRoot and (charRoot.Position - targetPart.Position).Magnitude &lt; 10 then
                        completed = true
                        stopGuide()
                        removeTip()
                        ReplicatedStorage.UpdateTutorialRE:FireServer(8)
                        print("🎉 玩家抵达商店，新手教程结束！")
                    end
                    task.wait(0.5)
                end
            end)
        end
    end

    -- ==========================================
    -- 监听战斗结束并过渡到第 8 步
    -- ==========================================
    local function handleStepSevenToEight()
        task.spawn(function()
            local plotsFolder = Workspace:WaitForChild("Plots", 10)
            local targetPlot = nil
            for _, plot in ipairs(plotsFolder:GetChildren()) do
                if plot:GetAttribute("OwnerId") == player.UserId then
                    targetPlot = plot
                    break
                end
            end
            
            if targetPlot then
                -- 等待服务端开启战斗状态 (最多等2秒防错)
                local waitTime = 0
                while not targetPlot:GetAttribute("IsLevelActive") and waitTime &lt; 2 do
                    task.wait(0.1)
                    waitTime += 0.1
                end
                
                -- 等待战斗结束 (IsLevelActive 变回 false)
                while targetPlot:GetAttribute("IsLevelActive") do
                    targetPlot:GetAttributeChangedSignal("IsLevelActive"):Wait()
                end
            end
            
            -- 等待战斗结算面板关闭后再弹出商店引导
            local resultGui = playerGui:FindFirstChild("BattleResultGui")
            if resultGui then
                local bgOverlay = resultGui:FindFirstChildOfClass("Frame")
                if bgOverlay and bgOverlay.Visible then
                    bgOverlay:GetPropertyChangedSignal("Visible"):Wait()
                end
            end
            
            task.wait(0.5)
            startStepEight()
        end)
    end

    -- ==========================================
    -- 【第 7 步】：引导开始战斗 (原第 8 步)
    -- ==========================================
    local function startStepSeven()
      print("进入教程第 7 步：点击战斗按钮")
        local removeTip = showTutorialTip("Here are some Peashooters! Click BATTLE to start!")
        
        local stopFlash = TutorialEffect.AddFlash(battleBtn)
        local stopArrow = TutorialEffect.AddUIArrow(battleBtn) 

        local connection
        connection = battleBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                connection:Disconnect()
                stopFlash()
                stopArrow() 
                removeTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(7)
                
                -- 触发战斗后，开启后台监听，等打完过渡到第 8 步
                handleStepSevenToEight()
            end
        end)
    end

    -- ==========================================
    -- 【第 6 步】：引导种植到草坪 Lawn1_1 并自动铺满一列 (原第 7 步)
    -- ==========================================
    local function startStepSix()
        print("进入教程第 6 步：引导战斗部署")
        local removeTip = showTutorialTip("Deploy the Peashooter on the lawn.")

        local plotsFolder = Workspace:WaitForChild("Plots", 10)
        local targetPlot, targetLawn = nil, nil
        
        if plotsFolder then
            for _, plot in ipairs(plotsFolder:GetChildren()) do
                if plot:GetAttribute("OwnerId") == player.UserId then
                    targetPlot = plot
                    local lawnFolder = plot:FindFirstChild("Lawn")
                    if lawnFolder then
                        -- 定位起始战斗格
                        targetLawn = lawnFolder:FindFirstChild("Lawn1_1")
                    end
                    break
                end
            end
        end

        if not targetPlot or not targetLawn then return end

        local character = player.Character or player.CharacterAdded:Wait()
        local stopGuide = TutorialEffect.AddGuideBeam(character, targetLawn, Color3.fromRGB(85, 255, 127))

        local function onPlanted()
            stopGuide()
            removeTip()
            ReplicatedStorage.UpdateTutorialRE:FireServer(6)
            
            local tutorialDeployRE = ReplicatedStorage:WaitForChild("TutorialDeployRE", 3)
            if tutorialDeployRE then
                for i = 2, 6 do
                    -- 拼接出 Lawn2_1, Lawn3_1 ... Lawn6_1
                    local nextLawn = "Lawn" .. i .. "_1"
                    tutorialDeployRE:FireServer(nextLawn, "Peashooter")
                    task.wait(0.15) 
                end
            else
                warn("教程错误：找不到服务端的 TutorialDeployRE 事件")
            end
            
            task.wait(0.5)
            startStepSeven() -- 进入点击 Battle 的引导
        end

        task.spawn(function()
            local isPlanted = false
            while not isPlanted do
                local lawnFolder = targetPlot:FindFirstChild("Lawn")
                if lawnFolder then
                    for _, lawn in ipairs(lawnFolder:GetChildren()) do
                        if lawn:GetAttribute("OccupiedBy") then
                            isPlanted = true
                            break
                        end
                    end
                end
                
                if isPlanted then break end
                task.wait(0.5)
            end
            onPlanted()
        end)
    end


    -- ==========================================
    -- 第 5 步：引导收获
    -- ==========================================
    local function startStepFive(targetPlot, targetSoil)
        local removeWaitTip = showTutorialTip("Plant is growing, please wait...")
        
        local maturePlant = nil
        while true do
            local currentPlant = getPlantOnPosition(targetPlot, targetSoil.Name)
            if currentPlant and currentPlant:GetAttribute("IsMature") then
                maturePlant = currentPlant
                break
            end
            task.wait(0.5)
        end
        
        if removeWaitTip then removeWaitTip() end

        local removeHarvestTip = showTutorialTip("Plant is mature! Follow the arrow and press [E] to harvest.")
        local character = player.Character or player.CharacterAdded:Wait()
        local stopGuide = TutorialEffect.AddGuideBeam(character, targetSoil, Color3.fromRGB(255, 255, 0))

        local plantsFolder = targetPlot:WaitForChild("Plants")
        local connection
        connection = plantsFolder.ChildRemoved:Connect(function(child)
            if child == maturePlant then
                connection:Disconnect()
                stopGuide()
                removeHarvestTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(5)
                
                task.wait(0.5)
                -- 🚀【核心修改】：删除了之前的 startStepSix (装备植物)，收获后直接跳入现在的战斗部署引导
                startStepSix()
            end
        end)
    end

    -- ==========================================
    -- 第 4 步：引导种植到农田
    -- ==========================================
   local function startStepFour()
        local removeTip = showTutorialTip("Follow the guide to the soil and press [E] to plant.")

        local plotsFolder = Workspace:WaitForChild("Plots", 10)
        local targetPlot, targetSoil = nil, nil
        for _, plot in ipairs(plotsFolder:GetChildren()) do
             if plot:GetAttribute("OwnerId") == player.UserId then
                local soils = plot:FindFirstChild("Soils")
                targetSoil = soils and (soils:FindFirstChild("Soil1") or soils:FindFirstChild("Soil_1"))
                targetPlot = plot
                break
            end
        end

        if not targetPlot or not targetSoil then return end

        local existingPlant = targetPlot:WaitForChild("Plants"):FindFirstChildWhichIsA("Model")
        if existingPlant and existingPlant:GetAttribute("PlantedOn") then
            removeTip()
            ReplicatedStorage.UpdateTutorialRE:FireServer(4)
            local actualSoilName = existingPlant:GetAttribute("PlantedOn")
            local actualSoil = targetPlot.Soils:FindFirstChild(actualSoilName) or targetSoil
            task.wait(0.5)
            startStepFive(targetPlot, actualSoil)
            return
        end

        local character = player.Character or player.CharacterAdded:Wait()
        local stopGuide = TutorialEffect.AddGuideBeam(character, targetSoil, Color3.fromRGB(85, 255, 127))

        local plantsFolder = targetPlot:WaitForChild("Plants")
         local connection
        connection = plantsFolder.ChildAdded:Connect(function(child)
            task.wait(0.1) 
            if child:IsA("Model") and child:GetAttribute("PlantedOn") then
                connection:Disconnect()
                stopGuide()
                removeTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(4)
                
                local actualSoilName = child:GetAttribute("PlantedOn")
                local actualSoil = targetPlot.Soils:FindFirstChild(actualSoilName) or targetSoil
                
                task.wait(0.5)
                startStepFive(targetPlot, actualSoil)
            end
        end)
    end
    -- ==========================================
    -- 第 3 步：引导退出背包
    -- ==========================================
    local function startStepThree()
        local removeTip = showTutorialTip("Click the Close button to exit.")
        local stopFlash = TutorialEffect.AddFlash(closeButton)
        local stopArrow = TutorialEffect.AddUIArrow(closeButton)

        local connection
        connection = inventoryGui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if not inventoryGui.Enabled then
                connection:Disconnect()
                stopFlash()
                stopArrow() 
                removeTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(3)
                task.wait(0.5)
                startStepFour()
            end
        end)
    end

    -- ==========================================
    -- 第 2 步：引导装备种子
    -- ==========================================
   local function startStepTwo()
        local removeTip = showTutorialTip("Click a seed to equip it.")

        local function getFirstSeed()
            for _, child in ipairs(seedPage:GetChildren()) do
                if child:IsA("Frame") or child:IsA("GuiButton") then return child end
            end
            return nil
        end

        local targetSeed = getFirstSeed()
        if not targetSeed then
            seedPage.ChildAdded:Wait()
            targetSeed = getFirstSeed()
        end

        if targetSeed then
             local stopFlash = TutorialEffect.AddFlash(targetSeed)
            local stopArrow = TutorialEffect.AddUIArrow(targetSeed) 
            local isStepCompleted = false
            local connection
            
            local closeConn
            closeConn = inventoryGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                 if not inventoryGui.Enabled and not isStepCompleted then
                    removeTip()
                    if stopFlash then stopFlash() end
                    if stopArrow then stopArrow() end 
                    if connection then connection:Disconnect() end
                    closeConn:Disconnect()
                    
                    local warningTip = showTutorialTip("Please open Inventory to continue!")
                   
                    local reopenConn
                    reopenConn = inventoryGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                        if inventoryGui.Enabled then
                             reopenConn:Disconnect()
                            warningTip()
                            startStepTwo()
                        end
                     end)
                end
            end)

            connection = targetSeed.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                     isStepCompleted = true
                    connection:Disconnect()
                    if closeConn then closeConn:Disconnect() end
                    stopFlash()
                    stopArrow() 
                    removeTip()
                    ReplicatedStorage.UpdateTutorialRE:FireServer(2)
                    task.wait(0.5)
                    startStepThree()
                end
            end)
        end
    end
    -- ==========================================
    -- 第 1 步及恢复逻辑入口
    -- ==========================================
    if currentStep == 0 then
        local backpackBtn = hotbarFrame:WaitForChild("System_Backpack")
        local removeTip = showTutorialTip("Click the flashing icon to open Inventory.")
        local stopFlash = TutorialEffect.AddFlash(backpackBtn)
        local stopArrow = TutorialEffect.AddUIArrow(backpackBtn) 

        local conn
        conn = inventoryGui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if inventoryGui.Enabled then
                conn:Disconnect()
                stopFlash()
                stopArrow() 
                removeTip()
                ReplicatedStorage.UpdateTutorialRE:FireServer(1)
                task.wait(0.5)
                startStepTwo()
            end
        end)
    elseif currentStep == 1 then
        if inventoryGui.Enabled then startStepTwo() else
            inventoryGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                if inventoryGui.Enabled then startStepTwo() end
            end)
        end
    elseif currentStep == 2 then
        if inventoryGui.Enabled then startStepThree() else
            ReplicatedStorage.UpdateTutorialRE:FireServer(3)
            task.wait(0.5)
            startStepFour()
        end
    elseif currentStep == 3 then
        startStepFour()
    elseif currentStep == 4 then
        task.spawn(function()
            local plotsFolder = Workspace:WaitForChild("Plots", 10)
            local targetPlot, targetSoil = nil, nil
            for _, plot in ipairs(plotsFolder:GetChildren()) do
                if plot:GetAttribute("OwnerId") == player.UserId then
                    local soils = plot:FindFirstChild("Soils")
                    targetSoil = soils and (soils:FindFirstChild("Soil1") or soils:FindFirstChild("Soil_1"))
                    targetPlot = plot
                    break
                 end
            end
            
            if targetPlot and targetSoil then
                startStepFive(targetPlot, targetSoil)
            else
                ReplicatedStorage.UpdateTutorialRE:FireServer(5)
            end
        end)
    elseif currentStep == 5 then
        startStepSix()
    elseif currentStep == 6 then
        startStepSeven()
    elseif currentStep == 7 then
        handleStepSevenToEight()
    end
end

return TutorialController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">UnlockAnimController</string>
              <string name="Source">-- src/client/UI/UnlockAnimController.luau
local UnlockAnimController = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local RunService = game:GetService("RunService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

-- [🌟 新增：创建 3D ViewportFrame 并自动适配模型大小与旋转]
local function CreateViewportForModel(plantId, parentFrame)
    -- 1. 创建 ViewportFrame
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "ModelViewport"
    viewport.Size = UDim2.new(1, 0, 1, 0)
    viewport.Position = UDim2.new(0.5, 0, 0.5, 0)
    viewport.AnchorPoint = Vector2.new(0.5, 0.5)
    viewport.BackgroundTransparency = 1
    viewport.Parent = parentFrame

    -- 2. 从 ReplicatedStorage 获取真实模型
    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    if not itemModelsFolder then return viewport end
    
    -- 尝试寻找对应的植物模型 (支持带后缀或者不带后缀)
    local modelTemplate = itemModelsFolder:FindFirstChild(plantId .. "_Plant") or itemModelsFolder:FindFirstChild(plantId)
    
    if not modelTemplate then 
        warn("⚠️ 找不到用于 ViewportFrame 展示的 3D 模型: " .. tostring(plantId))
        return viewport 
    end

    -- 3. 克隆模型
    local displayModel = modelTemplate:Clone()
    
    -- 清理可能影响 UI 渲染的杂物（比如特效、声音、脚本）
    for _, child in ipairs(displayModel:GetDescendants()) do
        if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("ParticleEmitter") or child:IsA("Light") or child:IsA("Sound") then
            child:Destroy()
        end
    end
    displayModel.Parent = viewport

    -- 4. 设置专属摄像机
    local camera = Instance.new("Camera")
    viewport.CurrentCamera = camera
    camera.Parent = viewport

    -- 5. 计算模型的碰撞箱，自动调整镜头距离，防止模型太大出框或太小看不见
    local cframe, size = displayModel:GetBoundingBox()
    local maxDim = math.max(size.X, size.Y, size.Z)
    local cameraDistance = maxDim * 1.5 -- 1.5 倍的距离刚刚好
    
    -- 将相机摆放在模型正前方偏上一点，看向模型中心
    local cameraPos = cframe.Position + Vector3.new(0, maxDim * 0.2, cameraDistance)
    camera.CFrame = CFrame.lookAt(cameraPos, cframe.Position)

    -- 6. 开启帅气的自转效果！
    local connection
    connection = RunService.RenderStepped:Connect(function()
        -- 如果 UI 被关闭（ViewportFrame 被销毁），立刻停止旋转循环，防止内存泄漏
        if not viewport or not viewport.Parent then
            if connection then connection:Disconnect() end
            return
        end
        -- 每帧旋转一点点
        displayModel:PivotTo(displayModel:GetPivot() * CFrame.Angles(0, math.rad(1), 0))
    end)

    return viewport
end

function UnlockAnimController.PlayUnlockAnim(plantId, itemName, qualityColor, subText)
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TempUnlockUI"
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = 9999 
    screenGui.Parent = playerGui

    -- ==========================================
    -- [🌟 调整：回归正的长方形与水平位移]
    -- ==========================================
    local horizontalBand = Instance.new("Frame")
    horizontalBand.Name = "HorizontalBand"
    horizontalBand.AnchorPoint = Vector2.new(0.5, 0.5)
    
    -- 初始位置：屏幕左侧外 (水平居中对齐 0.5 Y轴)
    horizontalBand.Position = UDim2.new(-1, 0, 0.5, 0) 
    horizontalBand.Size = UDim2.new(1.5, 0, 0.5, 0) -- 恢复标准厚度，宽度略长
    horizontalBand.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    horizontalBand.BackgroundTransparency = 0.3
    horizontalBand.Rotation = 0 -- 保持水平，不倾斜
    horizontalBand.BorderSizePixel = 0
    horizontalBand.Parent = screenGui

    local contentContainer = Instance.new("Frame")
    contentContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    contentContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    contentContainer.Size = UDim2.new(0, 500, 0, 250)
    contentContainer.BackgroundTransparency = 1
    contentContainer.Rotation = 0 -- 容器同样不旋转
    contentContainer.Parent = horizontalBand

    -- 物品图标
    local itemIcon = CreateViewportForModel(plantId, contentContainer)
    itemIcon.Position = UDim2.new(0.5, 0, 0.35, 0)
    itemIcon.Size = UDim2.new(0, 0, 0, 0) -- 初始大小为0，靠弹出的Tween动画

    -- 物品名称
    local nameLabel = Instance.new("TextLabel")
    nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    nameLabel.Position = UDim2.new(0.5, 0, 0.75, 0)
    nameLabel.Size = UDim2.new(1, 0, 0, 50)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.Text = itemName or "New Plant"
    nameLabel.TextColor3 = qualityColor or Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 40
    nameLabel.TextTransparency = 1 
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Parent = contentContainer

    -- 副标题
    local subLabel = Instance.new("TextLabel")
    subLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    subLabel.Position = UDim2.new(0.5, 0, 0.9, 0)
    subLabel.Size = UDim2.new(1, 0, 0, 30)
    subLabel.BackgroundTransparency = 1
    subLabel.Font = Enum.Font.SourceSansBold
    subLabel.Text = subText or "Collection Updated"
    subLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    subLabel.TextSize = 26
    subLabel.TextTransparency = 1
    subLabel.Parent = contentContainer

    -- ==========================================
    -- 动画定义
    -- ==========================================
    -- 1. 从左向右切入屏幕中心
    local bandSlideIn = TweenService:Create(horizontalBand, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { 
        Position = UDim2.new(0.5, 0, 0.5, 0) 
    })
    
    -- 2. 继续向右滑出屏幕
    local bandSlideOut = TweenService:Create(horizontalBand, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { 
        Position = UDim2.new(2, 0, 0.5, 0) 
    })
    
    local iconPop = TweenService:Create(itemIcon, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { 
        Size = UDim2.new(0, 180, 0, 180) 
    })
    
    local function PlayShakeAnim()
        local shakeAngles = {10, -10, 7, -7, 4, -4, 0}
        for _, angle in ipairs(shakeAngles) do
            local shakeTween = TweenService:Create(itemIcon, TweenInfo.new(0.04, Enum.EasingStyle.Linear), { Rotation = angle })
            shakeTween:Play()
            shakeTween.Completed:Wait()
        end
    end

    local textFadeIn = TweenService:Create(nameLabel, TweenInfo.new(0.35), { TextTransparency = 0 })
    local subFadeIn = TweenService:Create(subLabel, TweenInfo.new(0.35), { TextTransparency = 0 })

    task.spawn(function()
        -- 第 1 幕：横条从左侧滑入
        bandSlideIn:Play()
        bandSlideIn.Completed:Wait()
        
        -- 第 2 幕：内容弹出并轻微抖动
        iconPop:Play()
        iconPop.Completed:Wait() 
        PlayShakeAnim()
        
        -- 第 3 幕：文字显示
        textFadeIn:Play()
        subFadeIn:Play()
        
        -- 第 4 幕：定格
        task.wait(2.5) 
        
        -- 第 5 幕：内容先消失，让路给滑出动画
        TweenService:Create(itemIcon, TweenInfo.new(0.2), { Size = UDim2.new(0, 0, 0, 0) }):Play()
        TweenService:Create(nameLabel, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
        TweenService:Create(subLabel, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
        task.wait(0.2)
        
        -- 第 6 幕：横条继续向右滑出销毁
        bandSlideOut:Play()
        bandSlideOut.Completed:Wait()
        
        screenGui:Destroy()
    end)
end

function UnlockAnimController.Init()
    local playUnlockAnimRE = ReplicatedStorage:WaitForChild("PlayUnlockAnimRE")
    playUnlockAnimRE.OnClientEvent:Connect(function(plantId, mutationLevel)
        local plantDetail = ItemConfig.Plants[plantId]
        if not plantDetail then return end

        local mutName = ItemConfig.MutationName[mutationLevel] or "Normal"
        local itemName = mutName .. "·" .. (plantDetail.Name or plantId)
        local iconId = plantDetail.IconId or ""

        local qualityColor = Color3.fromRGB(255, 255, 255)
        if mutationLevel == 2 then qualityColor = Color3.fromRGB(85, 170, 255)
        elseif mutationLevel == 3 then qualityColor = Color3.fromRGB(170, 85, 255)
        elseif mutationLevel == 4 then qualityColor = Color3.fromRGB(255, 170, 0) end

        local subText = mutationLevel &gt; 1 and "⭐ Rare Mutation Discovered!" or "📖 New Species Discovered!"
        UnlockAnimController.PlayUnlockAnim(plantId, itemName, qualityColor, subText)
    end)
end

return UnlockAnimController</string>
            </Properties>
          </Item>
        </Item>
