          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">AirdropUIController</string>
              <string name="Source">local AirdropUIController = {}

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

function AirdropUIController.Init()
    local player = Players.LocalPlayer

    -- 1. 动态生成 ScreenGui
    local pointerGui = Instance.new("ScreenGui")
    pointerGui.Name = "AirdropPointerGui"
    pointerGui.ResetOnSpawn = false
    -- [🌟 修复]：层级调到 100，防止被游戏原本的黑底遮罩挡住
    pointerGui.DisplayOrder = 100 
    pointerGui.Parent = player:WaitForChild("PlayerGui")

    -- [🌟 新增]：容器框架，方便文字和箭头整体移动和缩放
    local container = Instance.new("Frame")
    container.Name = "PointerContainer"
    container.Size = UDim2.new(0, 80, 0, 80)
    container.BackgroundTransparency = 1
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.Visible = false
    container.Parent = pointerGui

    -- 2. 箭头图标
    local arrow = Instance.new("ImageLabel")
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(0, 45, 0, 45)
    arrow.Position = UDim2.new(0.5, 0, 0.4, 0) -- 稍微往上提一点，给文字留空间
    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.BackgroundTransparency = 1
    -- [🌟 保留]：使用你自己设定的图片 ID
    arrow.Image = "rbxassetid://3145534143" 
    arrow.ImageColor3 = Color3.fromRGB(255, 215, 0) -- 金色
    arrow.Parent = container

    -- [🌟 新增]：绿色英文提示文字 "CLAIM"
    local label = Instance.new("TextLabel")
    label.Name = "ClaimLabel"
    label.Size = UDim2.new(1, 20, 0, 20)
    label.Position = UDim2.new(0.5, 0, 1, 0)
    label.AnchorPoint = Vector2.new(0.5, 1)
    label.BackgroundTransparency = 1
    label.Text = "CLAIM"
    label.TextColor3 = Color3.fromRGB(0, 255, 0) -- 绿色
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = container

    -- 👇 [🌟 本次新增]：给文字加上黑色描边
    local textStroke = Instance.new("UIStroke")
    textStroke.Color = Color3.fromRGB(0, 0, 0) -- 黑色
    textStroke.Thickness = 3 -- 描边粗细可以自己微调
    textStroke.Parent = label
    -- ==========================================
    -- [🌟 核心]：无限循环的呼吸动画效果 (作用于容器)
    -- ==========================================
    local uiScale = Instance.new("UIScale")
    uiScale.Scale = 1
    uiScale.Parent = container -- 放在 Container 下，箭头和字一起缩放

    local scaleTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local scaleTween = TweenService:Create(uiScale, scaleTweenInfo, {Scale = 1.3})
    scaleTween:Play()

    -- 3. 实时渲染循环
    RunService.RenderStepped:Connect(function()
        -- [🌟 修复]：必须在循环内部获取 Camera，防止玩家死亡/重置时旧 Camera 失效报错
        local camera = Workspace.CurrentCamera
        if not camera then return end

        local airdrops = CollectionService:GetTagged("AirdropBox")
        local targetBox = nil

        -- 👇 [🌟 核心修改]：寻找一个当前不是由“我”携带的空投进行追踪
        for _, box in ipairs(airdrops) do
            local carrierId = box:GetAttribute("Carrier")
            if carrierId ~= player.UserId then
                targetBox = box
                break
            end
        end

        -- 如果没有找到符合条件的空投（说明唯一的空投在自己头上，或者没空投），隐藏 UI
        if not targetBox or not targetBox.PrimaryPart or not targetBox.Parent then
            container.Visible = false
            return
        end

        local targetPos = targetBox.PrimaryPart.Position
        local vector, onScreen = camera:WorldToViewportPoint(targetPos)
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

        container.Visible = true

        if onScreen then
            -- 【情况 A：空投在屏幕视野内】
            container.Position = UDim2.new(0, vector.X, 0, vector.Y - 70)
            arrow.Rotation = 270 
        else
            -- 【情况 B：空投在视野外】
            local offset = Vector2.new(vector.X - center.X, vector.Y - center.Y)
            if vector.Z &lt; 0 then offset = -offset end 

            local angle = math.atan2(offset.Y, offset.X)
            
            -- 设置屏幕边缘的内边距 
            local paddingX, paddingY = 50, 50
            local edgeX = center.X - paddingX
            local edgeY = center.Y - paddingY

            local cosAngle = math.cos(angle)
            local sinAngle = math.sin(angle)
            local screenX, screenY

            -- 边缘碰撞检测算法
            if math.abs(cosAngle) * edgeY &gt; math.abs(sinAngle) * edgeX then
                screenX = math.sign(cosAngle) * edgeX
                screenY = math.tan(angle) * screenX
            else
                screenY = math.sign(sinAngle) * edgeY
                screenX = screenY / math.tan(angle)
            end

            container.Position = UDim2.new(0, center.X + screenX, 0, center.Y + screenY)
            arrow.Rotation = math.deg(angle) 
        end
    end)
    
    print("客户端：AirdropUIController 加载完毕！带 'CLAIM' 提示的呼吸箭头已激活。")
end

return AirdropUIController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">CoinDropController</string>
              <string name="Source">-- src/client/Services/CoinDropController.luau
local CoinDropController = {}

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local MarketplaceService = game:GetService("MarketplaceService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil) 

local COIN_IMAGE_ID = "rbxassetid://102426033120992"
local EXPLOSION_IMAGE_ID = "rbxassetid://123456" 
local SUN_PICKUP_SOUND_ID = "rbxassetid://116731565409481"
local X2_SUN_GAME_PASS_ID = 1856661235
local ownsX2SunCache = false

local function ownsX2SunPass()
    if ownsX2SunCache then
        return true
    end

    local player = Players.LocalPlayer
    local success, result = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(player.UserId, X2_SUN_GAME_PASS_ID)
    end)

    if success and result == true then
        ownsX2SunCache = true
        return true
    end

    return false
end

local function getSunPickupDisplayText(amount, isX2)
    if isX2 then
        return "+" .. UIEffectUtil.FormatNumber(amount) .. "x2"
    end
    return nil
end

local function playSunPickupSound()
    -- 直接用音效 AssetId 创建本地 Sound，避免 SoundService 中对象名/路径不一致导致找不到或不响。
    local pickupSound = Instance.new("Sound")
    pickupSound.Name = "LocalSunPickupSound"
    pickupSound.SoundId = SUN_PICKUP_SOUND_ID
    pickupSound.Volume = 1
    pickupSound.Parent = SoundService
    SoundService:PlayLocalSound(pickupSound)
    Debris:AddItem(pickupSound, 3)
end

function CoinDropController.Init()
    local playDropRE = ReplicatedStorage:WaitForChild("PlayCoinDropRE")
    local pickupRE = ReplicatedStorage:WaitForChild("PickupCoinRE")

    local harvestRE = ReplicatedStorage:FindFirstChild("HarvestSunRE")
    if harvestRE then
        harvestRE.OnClientEvent:Connect(function(amount, startPos, isX2Sun)
            local displayText = getSunPickupDisplayText(amount, isX2Sun == true)
            -- 如果服务端传来了起点坐标，就播放 3D 飞行特效
            if startPos then
                local char = Players.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                if root then
                    -- 1. 创建一个用于飞行的视觉阳光
                    local sunPart = Instance.new("Part")
                    sunPart.Anchored = true
                    sunPart.CanCollide = false
                    sunPart.Transparency = 1
                    -- 让阳光从底座稍微偏上的位置冒出来
                    sunPart.Position = startPos + Vector3.new(0, 4, 0) 
                    
                    local gui = Instance.new("BillboardGui")
                    gui.Size = UDim2.new(3, 0, 3, 0)
                    gui.AlwaysOnTop = true
                    gui.Parent = sunPart
                    
                    local img = Instance.new("ImageLabel")
                    img.Size = UDim2.new(1, 0, 1, 0)
                    img.BackgroundTransparency = 1
                    img.Image = COIN_IMAGE_ID -- 使用模块顶部的统一阳光/金币图标
                    img.Parent = gui
                    
                    sunPart.Parent = workspace
                    
                    -- 2. 让阳光飞向玩家的身体
                    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                    local tween = TweenService:Create(sunPart, tweenInfo, {Position = root.Position})
                    tween:Play()
                    
                    -- 3. 飞行结束（击中玩家）后销毁实体，再呼出 UI 动画
                    tween.Completed:Connect(function()
                        playSunPickupSound()
                        sunPart:Destroy()
                        UIEffectUtil.Play2DCollectEffect(amount, nil, displayText) 
                    end)
                    return
                end
            end
            
            -- 如果没有获取到位置，作为兜底直接播放 UI 动画
            UIEffectUtil.Play2DCollectEffect(amount, nil, displayText) 
        end)
    end

    playDropRE.OnClientEvent:Connect(function(dropPosition, coinCount, totalValue)
        local valuePerCoin = math.floor(totalValue / coinCount)
        if valuePerCoin &lt; 1 then valuePerCoin = 1 end

        local explosionPart = Instance.new("Part")
        explosionPart.Anchored = true; explosionPart.CanCollide = false; explosionPart.Transparency = 1; explosionPart.Position = dropPosition; explosionPart.Parent = workspace
        local emitter = Instance.new("ParticleEmitter")
        emitter.Texture = EXPLOSION_IMAGE_ID; emitter.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0)); emitter.LightEmission = 1; emitter.ZOffset = 1         
        emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 3), NumberSequenceKeypoint.new(1, 0)})
        emitter.Speed = NumberRange.new(20, 50); emitter.Lifetime = NumberRange.new(0.3, 0.6); emitter.SpreadAngle = Vector2.new(180, 180); emitter.Drag = 5; emitter.Parent = explosionPart
        emitter:Emit(30); Debris:AddItem(explosionPart, 2) 

        for i = 1, coinCount do
            local coin = Instance.new("Part")
            coin.Name = "LocalDroppedCoin"; coin.Size = Vector3.new(1.2, 1.2, 1.2); coin.Shape = Enum.PartType.Ball; coin.Transparency = 1; coin.CanCollide = true
            local offsetX = (math.random() - 0.5) * 3; local offsetY = math.random() * 2; local offsetZ = (math.random() - 0.5) * 3
            coin.Position = dropPosition + Vector3.new(offsetX, offsetY, offsetZ)
            coin.CustomPhysicalProperties = PhysicalProperties.new(1, 0.6, 0.5, 100, 100)

            local gui = Instance.new("BillboardGui")
            gui.Size = UDim2.new(2.5, 0, 2.5, 0); gui.AlwaysOnTop = false; gui.Parent = coin
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(1, 0, 1, 0); img.BackgroundTransparency = 1; img.Image = COIN_IMAGE_ID; img.Parent = gui

            local att0 = Instance.new("Attachment", coin); att0.Position = Vector3.new(0, 0.5, 0)
            local att1 = Instance.new("Attachment", coin); att1.Position = Vector3.new(0, -0.5, 0)
            local trail = Instance.new("Trail"); trail.Attachment0 = att0; trail.Attachment1 = att1
            trail.Color = ColorSequence.new(Color3.fromRGB(255, 230, 80)); trail.Lifetime = 0.3; trail.LightEmission = 1 
            trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }); trail.Parent = coin

            local sensor = Instance.new("Part")
            sensor.Name = "PickupSensor"; sensor.Shape = Enum.PartType.Ball; sensor.Size = Vector3.new(24, 24, 24)
            sensor.Transparency = 1; sensor.CanCollide = false; sensor.CanQuery = false; sensor.Massless = true     
            local weld = Instance.new("WeldConstraint"); weld.Part0 = coin; weld.Part1 = sensor; weld.Parent = coin
            sensor.CFrame = coin.CFrame; sensor.Parent = coin

            coin.Parent = workspace
            coin.AssemblyLinearVelocity = Vector3.new(math.random(-20, 20), math.random(15, 35), math.random(-20, 20))

            task.delay(1, function() 
                if trail then trail.Enabled = false end 
                if coin and coin.Parent then coin.Anchored = true; coin.CanCollide = false end
            end)

            local canPickup = false; local isCollected = false 
            task.delay(0.8, function() canPickup = true end) 

           local connection
            connection = sensor.Touched:Connect(function(hit)
                if not canPickup or isCollected then return end
                local localPlayer = Players.LocalPlayer
         
                local character = localPlayer.Character
                if hit:IsDescendantOf(character) then
                    local humanoid = character:FindFirstChild("Humanoid")
                    local rootPart = character:FindFirstChild("HumanoidRootPart") 
                    if humanoid and humanoid.Health &gt; 0 and rootPart then
                        isCollected = true; canPickup = false; connection:Disconnect() 
                        
                        -- [🌟 新增：让阳光/金币飞向玩家身体]
                        coin.Anchored = true 
                        if trail then trail.Enabled = true end -- 开启拖尾让飞行更好看
                        
                        -- 目标位置设定在玩家胸口处 (RootPart 稍微偏上一点)
                        local targetPos = rootPart.Position + Vector3.new(0, 1, 0)
                        
                        -- 创建一个 0.3 秒的快速飞行 Tween (吸入身体的感觉)
                        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                        local tween = TweenService:Create(coin, tweenInfo, {Position = targetPos})
                        
                        -- 让图片在飞行的同时逐渐变透明
                        if img then TweenService:Create(img, TweenInfo.new(0.3), {ImageTransparency = 1}):Play() end
                        
                        tween:Play()
                        
                        -- [🌟 重点：等待飞行结束接触到玩家身体后，再弹出 UI 动画]
                        tween.Completed:Connect(function()
                            playSunPickupSound()
                            coin.Transparency = 1
                            if gui then gui.Enabled = false end
                            if trail then trail.Enabled = false end
                            
                            -- 呼出屏幕上的 UI 增加动画，并通知服务端真正加钱
                            local displayText = getSunPickupDisplayText(valuePerCoin, ownsX2SunPass())
                            UIEffectUtil.Play2DCollectEffect(valuePerCoin, function() 
                                pickupRE:FireServer(valuePerCoin, false)
                                coin:Destroy()
                            end, displayText)
                        end)
                    end
                end
            end)

            task.delay(5, function()
                if isCollected or not coin or not coin.Parent then return end
                local localPlayer = Players.LocalPlayer; local targetSunflower = nil
                local plotsFolder = workspace:FindFirstChild("Plots")
                if plotsFolder then
                    for _, plot in ipairs(plotsFolder:GetChildren()) do
                        local baseSun = plot:FindFirstChild("BaseSunflower")
                        if baseSun and baseSun:GetAttribute("OwnerId") == localPlayer.UserId then targetSunflower = baseSun; break end
                    end
                end

                if targetSunflower then
                    isCollected = true; canPickup = false; if connection then connection:Disconnect() end
                    coin.Anchored = true; if trail then trail.Enabled = true end

                    -- ==========================================
                    -- [🌟 修复：彻底移除了向日葵的张嘴动画逻辑]
                    -- 动画引擎太脆弱了，我们不播动画了，直接让金币飞过去即可。
                    -- 向日葵本身就在播放待机动画，金币吸入效果不受影响！
                    -- ==========================================

                    local targetPos = targetSunflower:GetPivot().Position
                    local tweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                    local tween = TweenService:Create(coin, tweenInfo, {Position = targetPos})
                    if img then TweenService:Create(img, TweenInfo.new(0.8), {ImageTransparency = 1}):Play() end
                    tween:Play()
                    tween.Completed:Connect(function()
                        pickupRE:FireServer(valuePerCoin, true)
                        coin:Destroy()
                    end)
                end
            end)
            Debris:AddItem(coin, 300) 
        end
    end)
    print("客户端：CoinDropController 精简版已实装，不再调用向日葵动画！")
end

return CoinDropController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">FreeRewardClientController</string>
              <string name="Source">-- src/client/Services/FreeRewardClientController.luau
local FreeRewardClientController = {}
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local REWARD_ITEM_NAME = "Threepeater" 
local GROUP_ID = 229662289 -- ⚠️⚠️⚠️ 保持与服务端一致，填入你的群组 ID！

function FreeRewardClientController.Init()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    local eventPage = basicGui:WaitForChild("EventPage")
    
    local freeRewardUI = eventPage:WaitForChild("FreeRewardUI")
    local closeBtn = freeRewardUI:WaitForChild("CloseButton")
    local claimBtn = freeRewardUI:WaitForChild("ClaimBattle")
    local claimBtnText = claimBtn:WaitForChild("TextLabel")
    local node1 = freeRewardUI:WaitForChild("Node_1")
    local node2 = freeRewardUI:WaitForChild("Node_2")
    
    local viewportFrame = freeRewardUI:WaitForChild("ViewportFrame") 
    
    local rewardPart = Workspace:WaitForChild("FreeReward")
    local claimRE = ReplicatedStorage:WaitForChild("ClaimFreeRewardRE")
    local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil)

    local hasLiked = true -- 点赞依然是假验证
    local isDebounce = false

    freeRewardUI.Visible = false
    local rotateConnection = nil

    local function SetupViewportModel()
        viewportFrame:ClearAllChildren()
        local plantsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
        local modelName = REWARD_ITEM_NAME .. "_Plant"
        local modelTemplate = plantsFolder and plantsFolder:FindFirstChild(modelName)
        
        if not modelTemplate then
            warn("【FreeReward】找不到奖励模型: " .. tostring(modelName))
            return
        end

        local displayModel = modelTemplate:Clone()
        displayModel.Parent = viewportFrame

        -- 背包同款摄像机参数
        local camera = Instance.new("Camera")
        camera.FieldOfView = 40 
        camera.Parent = viewportFrame
        viewportFrame.CurrentCamera = camera

        local cframe, size = displayModel:GetBoundingBox()
        local maxDim = math.max(size.X, size.Y, size.Z)
        if maxDim == 0 then maxDim = 2 end 
        
        displayModel:PivotTo(CFrame.new(0, 0, 0))
        
        camera.CFrame = CFrame.lookAt(
           Vector3.new(0, 0, maxDim * 1.5 + 1),
            Vector3.new(0, size.Y / 3, 0)
        )

        if rotateConnection then
            rotateConnection:Disconnect()
            rotateConnection = nil
        end

        local currentAngle = 0
        rotateConnection = RunService.RenderStepped:Connect(function(dt)
            if freeRewardUI.Visible then
                currentAngle = currentAngle + math.rad(60 * dt) 
                displayModel:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, currentAngle, 0))
            end
        end)
    end

    rewardPart.Touched:Connect(function(hit)
        if isDebounce then return end
        local character = player.Character
        if character and hit:IsDescendantOf(character) then
            isDebounce = true
            
            -- 🌟 核心修改：真实向 Roblox 请求玩家是否在群组中
            local inGroup = false
            pcall(function()
                inGroup = player:IsInGroup(GROUP_ID)
            end)

            -- 更新文本状态：根据群组状态切换 1/1 或 0/1
            node1.Text = hasLiked and "1/1" or "0/1"
            node2.Text = inGroup and "1/1" or "0/1"
            
            if player:GetAttribute("HasClaimedFreeReward") then
                claimBtnText.Text = "Claimed"
                claimBtn.BackgroundColor3 = Color3.fromRGB(128, 128, 128)
                claimBtn.Interactable = false
            else
                claimBtnText.Text = "Claim"
                claimBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                claimBtn.Interactable = true
            end
            
            if eventPage:IsA("ScreenGui") then eventPage.Enabled = true end
            SetupViewportModel()
            freeRewardUI.Visible = true
            
            task.wait(1)
            isDebounce = false
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        freeRewardUI.Visible = false
        if rotateConnection then
            rotateConnection:Disconnect()
            rotateConnection = nil
        end
        viewportFrame:ClearAllChildren()
    end)

    claimBtn.MouseButton1Click:Connect(function()
        if player:GetAttribute("HasClaimedFreeReward") then return end
        
        if node1.Text == "1/1" and node2.Text == "1/1" then
            claimRE:FireServer()
        else
            -- 🌟 修改了提示文字
            UIEffectUtil.ShowTip("Please Like and Join our Group first!")
        end
    end)

    claimRE.OnClientEvent:Connect(function(success)
        if success then
            claimBtnText.Text = "Claimed"
            claimBtn.BackgroundColor3 = Color3.fromRGB(128, 128, 128)
            claimBtn.Interactable = false
            UIEffectUtil.ShowTip("Successfully claimed " .. REWARD_ITEM_NAME .. " x1!")
        end
    end)
end

return FreeRewardClientController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">GroupJoinPromptController</string>
              <string name="Source">-- src/client/Services/GroupJoinPromptController.luau
-- 进入游戏一段时间后，使用 Roblox 官方原生群组加入弹窗提示未入群玩家。

local GroupJoinPromptController = {}

local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")

local GROUP_ID = 229662289
local PROMPT_DELAY_SECONDS = 60

local hasStarted = false

local function setPromptResult(player, statusName, isJoined, wasPrompted)
    player:SetAttribute("GroupJoinPromptStatus", statusName)
    player:SetAttribute("GroupJoinPromptJoined", isJoined)
    player:SetAttribute("GroupJoinPromptShown", wasPrompted)
end

local function isPlayerInGroup(player)
    local success, inGroup = pcall(function()
        return player:IsInGroup(GROUP_ID)
    end)

    return success and inGroup == true
end

local function promptJoinGroup(player)
    if isPlayerInGroup(player) then
        setPromptResult(player, "AlreadyInGroup", true, false)
        return
    end

    local success, membershipStatus = pcall(function()
        return GroupService:PromptJoinAsync(GROUP_ID)
    end)

    if not success then
        warn("[GroupJoinPrompt] PromptJoinAsync failed: " .. tostring(membershipStatus))
        setPromptResult(player, "PromptFailed", false, false)
        return
    end

    local statusName = membershipStatus and membershipStatus.Name or "Unknown"
    local joined = statusName == "Joined" or statusName == "AlreadyMember" or isPlayerInGroup(player)
    setPromptResult(player, statusName, joined, true)
end

function GroupJoinPromptController.Init()
    if hasStarted then
        return
    end
    hasStarted = true

    local player = Players.LocalPlayer

    task.delay(PROMPT_DELAY_SECONDS, function()
        if not player or player.Parent ~= Players then
            return
        end

        promptJoinGroup(player)
    end)
end

return GroupJoinPromptController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">HighlightController</string>
              <string name="Source">-- src/client/Services/HighlightController.luau
local HighlightController = {}

local ProximityPromptService = game:GetService("ProximityPromptService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- ==========================================
-- [🌟 核心逻辑：为本地玩家专属地块添加半透明覆盖层]
-- ==========================================
local function applyPlotOwnershipHighlight(plot)
    local localPlayer = Players.LocalPlayer
    if not localPlayer then return end

    -- 1. 清理该地块上可能存在的旧特效（包含自己和其他人的）
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("SelectionBox") and obj.Name == "MyPlotOverlay" then
            obj:Destroy()
        end
    end

    local ownerId = plot:GetAttribute("OwnerId")
    
    -- 2. 判断该地块当前的归属者是否为客户端本地玩家
    if ownerId == localPlayer.UserId then
        -- print("【地块高亮】👉 识别到本地玩家的地块: " .. plot.Name .. "，开始铺设黄色高亮...")
        
        local areasToHighlight = {}
        
        -- 🌟 【修改点】：直接移除了收集 Soils(泥土) 的代码，现在仅收集 Lawn(草坪)

        -- 收集草坪
        local lawn = plot:FindFirstChild("Lawn")
        if lawn then
            for _, part in ipairs(lawn:GetChildren()) do
                if part:IsA("BasePart") then 
                    table.insert(areasToHighlight, part) 
                end
            end
        end

        -- print("【地块高亮】✅ 共找到 " .. #areasToHighlight .. " 个草坪零件，正在上色...")

        -- 3. 强化版 SelectionBox 附加颜色
        for _, part in ipairs(areasToHighlight) do
            local overlay = Instance.new("SelectionBox")
            overlay.Name = "MyPlotOverlay"
            
            -- 表面填充：明亮的黄色
            overlay.SurfaceColor3 = Color3.fromRGB(85, 255, 127)
            -- 🌟 将透明度保持为 0.5（50%透明）
            overlay.SurfaceTransparency = 0.85
            
            -- 🌟 加入微弱的边框，防止纯表面在特定材质下被渲染引擎吞掉
            overlay.Color3 = Color3.fromRGB(85, 255, 127)
            overlay.Transparency = 0.6      -- ✅ 正确的属性名
            
            overlay.Adornee = part
            overlay.Parent = part
        end
    end
end

function HighlightController.Init()
    -- ==========================================
    -- [🌟 系统一：全局监听玩家眼前的交互提示框]
    -- ==========================================
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        local targetPart = prompt.Parent
        
        if targetPart and (targetPart:IsA("BasePart") or targetPart:IsA("Model")) then
            local existingHighlight = targetPart:FindFirstChild("InteractFocusHighlight")
            if not existingHighlight then
                local hl = Instance.new("Highlight")
                hl.Name = "InteractFocusHighlight"
                hl.FillColor = Color3.fromRGB(85, 255, 127)
                hl.FillTransparency = 0.95 
                hl.OutlineColor = Color3.fromRGB(85, 255, 127)
                hl.OutlineTransparency = 0.3
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop 
                hl.Adornee = targetPart
                hl.Parent = targetPart
            end
        end
    end)

    ProximityPromptService.PromptHidden:Connect(function(prompt, inputType)
        local targetPart = prompt.Parent
        if targetPart then
            local hl = targetPart:FindFirstChild("InteractFocusHighlight")
            if hl then hl:Destroy() end
        end
    end)

    -- ==========================================
    -- [🌟 系统二：监听地块分配状态，生成专属地块识别颜色]
    -- ==========================================
    task.spawn(function()
        local plotsFolder = Workspace:WaitForChild("Plots")

        -- 1. 初始化当前场上已有的地块
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if string.match(plot.Name, "Plot") then
                applyPlotOwnershipHighlight(plot)

                -- 监听属性变化
                plot:GetAttributeChangedSignal("OwnerId"):Connect(function()
                    applyPlotOwnershipHighlight(plot)
                end)
            end
        end

        -- 2. 监听未来动态加载的新地块
        plotsFolder.ChildAdded:Connect(function(plot)
            if string.match(plot.Name, "Plot") then
                -- 稍微延迟一点点，等待内部组件加载
                task.wait(0.5) 
                applyPlotOwnershipHighlight(plot)
                
                plot:GetAttributeChangedSignal("OwnerId"):Connect(function()
                    applyPlotOwnershipHighlight(plot)
                end)
            end
        end)
    end)

    print("客户端：HighlightController (智能焦点高亮 + 本地专属草坪领地色) 加载完毕！")
end

return HighlightController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">PlantUIController</string>
              <string name="Source">-- src/client/Services/PlantUIController.luau
local PlantUIController = {}
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

function PlantUIController.Init()
    local localPlayer = Players.LocalPlayer

    local function updatePlantUI(plant)
        local ownerId = plant:GetAttribute("OwnerId")
        local isMine = (ownerId == localPlayer.UserId)
        
        -- ==========================================
        -- [🌟 修复 Bug：开启递归查找 (true)]
        -- 因为 UI 面板被放在了 PrimaryPart(孙子层级) 里，不能直接 WaitForChild！
        -- 我们用一个安全的小循环，不断深入查找它是否加载出来了。
        -- ==========================================
        local matureUI = nil
        for i = 1, 50 do -- 最多等 5 秒 (50 * 0.1)
            matureUI = plant:FindFirstChild("MatureUI", true)
            if matureUI then break end
            task.wait(0.1)
        end
        
        if matureUI then
            local statusLabel = matureUI:FindFirstChild("StatusLabel", true)
            if statusLabel then
                -- 身份识别变装！
                if isMine then
                    statusLabel.Text = "✅ Mature"
                    statusLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
                else
                    statusLabel.Text = "✋ Stealable"
                    statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
                end
            end
        end

        -- 2. 悄悄修改按键 F 的提示框文字 (仅对本地玩家生效)
        local soilName = plant:GetAttribute("PlantedOn")
        if soilName and plant.Parent and plant.Parent.Parent then
            local plot = plant.Parent.Parent 
            local soilsFolder = plot:FindFirstChild("Soils")
            if soilsFolder then
                local soil = soilsFolder:FindFirstChild(soilName)
                if soil then
                    -- 同样的安全等待逻辑，确保找到按键
                    local prompt = nil
                    for i = 1, 50 do
                        prompt = soil:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then break end
                        task.wait(0.1)
                    end
                    
                    if prompt then
                        if isMine then
                            prompt.ActionText = "Harvest"
                        else
                            prompt.ActionText = "Steal"
                        end
                    end
                end
            end
        end
    end

    -- 监听游戏中途新长出来的植物
    Workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("Model") and desc:GetAttribute("IsMature") then 
            updatePlantUI(desc) 
        end
    end)

    -- 玩家刚上线时，扫描地图上已经存在的成熟植物并替换视觉
    task.spawn(function()
    local plotsFolder = Workspace:WaitForChild("Plots", 5)
        if plotsFolder then
            for _, desc in pairs(plotsFolder:GetDescendants()) do
                if desc:IsA("Model") and desc:GetAttribute("IsMature") then
                    updatePlantUI(desc)
                end
            end
        end
    end)

    print("客户端：PlantUIController (植物状态显示) 加载完毕！偷菜视角已分配！")
end

return PlantUIController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">StealWarningUIController</string>
              <string name="Source">-- src/client/Services/StealWarningUIController.luau
local StealWarningUIController = {}

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

function StealWarningUIController.Init()
    local player = Players.LocalPlayer

    -- 1. 创建 UI 容器
    local pointerGui = Instance.new("ScreenGui")
    pointerGui.Name = "StealWarningPointerGui"
    pointerGui.ResetOnSpawn = false
    pointerGui.DisplayOrder = 105 -- 层级拉高
    pointerGui.Parent = player:WaitForChild("PlayerGui")

    local container = Instance.new("Frame")
    container.Name = "PointerContainer"
    container.Size = UDim2.new(0, 80, 0, 80)
    container.BackgroundTransparency = 1
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.Visible = false
    container.Parent = pointerGui

    -- 2. 红色指向箭头
    local arrow = Instance.new("ImageLabel")
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(0, 50, 0, 50)
    arrow.Position = UDim2.new(0.5, 0, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.BackgroundTransparency = 1
    arrow.Image = "rbxassetid://3145534143" -- 复用空投的箭头形状
    arrow.ImageColor3 = Color3.fromRGB(255, 0, 0) -- 纯红色
    arrow.Parent = container

    -- 3. 红色醒目叹号
    local label = Instance.new("TextLabel")
    label.Name = "Exclamation"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Position = UDim2.new(0.5, 0, 0.5, 0)
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.BackgroundTransparency = 1
    label.Text = "!"
    label.TextColor3 = Color3.fromRGB(255, 0, 0)
    label.Font = Enum.Font.GothamBlack
    label.TextScaled = true
    label.Parent = container

    -- 黑色描边增强可视度
    local textStroke = Instance.new("UIStroke")
    textStroke.Color = Color3.fromRGB(0, 0, 0)
    textStroke.Thickness = 4
    textStroke.Parent = label

    -- ==========================================
    -- [🌟 核心]：急促的闪烁警告动画
    -- ==========================================
    local uiScale = Instance.new("UIScale")
    uiScale.Scale = 1
    uiScale.Parent = container

    -- 相比空投的 0.6 秒，这里改成 0.25 秒，让它像警报一样快速闪烁缩放
    local scaleTweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local scaleTween = TweenService:Create(uiScale, scaleTweenInfo, {Scale = 1.5})
    scaleTween:Play()

    -- ==========================================
    -- [🌟 雷达追踪算法]
    -- ==========================================
    RunService.RenderStepped:Connect(function()
        local camera = Workspace.CurrentCamera
        if not camera then return end

        -- 寻找场景中被打上 "被偷" 标签的植物
        local stolenPlants = CollectionService:GetTagged("BeingStolen")
        local targetPlant = nil

        -- 遍历确认这颗植物是不是属于 "我" 的
        for _, plant in ipairs(stolenPlants) do
            if plant:GetAttribute("OwnerId") == player.UserId then
                targetPlant = plant
                break
            end
        end

        -- 如果没有我的植物正在被偷，立刻隐藏 UI
        if not targetPlant or not targetPlant.PrimaryPart then
            container.Visible = false
            return
        end

        local targetPos = targetPlant.PrimaryPart.Position + Vector3.new(0, 5, 0)
        local vector, onScreen = camera:WorldToViewportPoint(targetPos)
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

        container.Visible = true

        if onScreen then
            -- 【情况 A：植物已经在屏幕视野内】
            container.Position = UDim2.new(0, vector.X, 0, vector.Y)
            arrow.Visible = false -- 在屏幕内不需要箭头指引，只留一个巨大的闪烁叹号在植物头上
            label.Position = UDim2.new(0.5, 0, 0.5, 0)
        else
            -- 【情况 B：植物在视野外，开启屏幕边缘贴边算法】
            arrow.Visible = true
            local offset = Vector2.new(vector.X - center.X, vector.Y - center.Y)
            if vector.Z &lt; 0 then offset = -offset end 

            local angle = math.atan2(offset.Y, offset.X)
            
            local paddingX, paddingY = 80, 80
            local edgeX = center.X - paddingX
            local edgeY = center.Y - paddingY

            local cosAngle = math.cos(angle)
            local sinAngle = math.sin(angle)
            local screenX, screenY

            if math.abs(cosAngle) * edgeY &gt; math.abs(sinAngle) * edgeX then
                screenX = math.sign(cosAngle) * edgeX
                screenY = math.tan(angle) * screenX
            else
                screenY = math.sign(sinAngle) * edgeY
                screenX = screenY / math.tan(angle)
            end

            container.Position = UDim2.new(0, center.X + screenX, 0, center.Y + screenY)
            arrow.Rotation = math.deg(angle)
            
            -- 将叹号稍微偏移一点，别挡住箭头本身
            label.Position = UDim2.new(0.5, 0, 0.5, -20)
        end
    end)
    
    print("客户端：StealWarningUIController 加载完毕！防偷菜雷达启动。")
end

return StealWarningUIController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">StealablePointerUIController</string>
              <string name="Source">-- src/client/Services/StealablePointerUIController.luau
local StealablePointerUIController = {}

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

function StealablePointerUIController.Init()
    local player = Players.LocalPlayer

    -- 1. 创建 UI 容器
    local pointerGui = Instance.new("ScreenGui")
    pointerGui.Name = "StealablePointerGui"
    pointerGui.ResetOnSpawn = false
    pointerGui.DisplayOrder = 104 -- 略低于防偷警报
    pointerGui.Parent = player:WaitForChild("PlayerGui")

    -- 用于存储当前屏幕上所有高品质植物的 UI 状态
    local activeUIs = {}

    -- 2. 核心雷达追踪算法
    RunService.RenderStepped:Connect(function()
        local camera = Workspace.CurrentCamera
        if not camera then return end

        -- 寻找场景中被打上 "可偷取" 标签的高级植物
        local stealablePlants = CollectionService:GetTagged("StealableHighQuality")
        
        -- 标记本帧是否被处理
        for _, uiData in pairs(activeUIs) do
            uiData.updated = false
        end

        for _, plant in ipairs(stealablePlants) do
            -- 【核心判断】：必须是别人的植物，才能显示"可偷取"
            if plant:GetAttribute("OwnerId") ~= player.UserId and plant.PrimaryPart then
                
                -- 如果还没有为这颗植物生成 UI，则动态生成
                local uiData = activeUIs[plant]
                if not uiData then
                    local container = Instance.new("Frame")
                    container.Size = UDim2.new(0, 80, 0, 80)
                    container.BackgroundTransparency = 1
                    container.AnchorPoint = Vector2.new(0.5, 0.5)
                    container.Parent = pointerGui

                    -- 金色指示箭头
                    local arrow = Instance.new("ImageLabel")
                    arrow.Size = UDim2.new(0, 50, 0, 50)
                    arrow.Position = UDim2.new(0.5, 0, 0.5, 0)
                    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
                    arrow.BackgroundTransparency = 1
                    arrow.Image = "rbxassetid://3145534143" 
                    arrow.ImageColor3 = Color3.fromRGB(255, 215, 0) -- 金色
                    arrow.Parent = container

                    -- "可偷取" 文本
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1.5, 0, 0.5, 0)
                    label.Position = UDim2.new(0.5, 0, 0.5, 0)
                    label.AnchorPoint = Vector2.new(0.5, 0.5)
                    label.BackgroundTransparency = 1
                    label.Text = "Stealable"
                    label.TextColor3 = Color3.fromRGB(255, 215, 0) -- 金色
                    label.Font = Enum.Font.GothamBlack
                    label.TextScaled = true
                    label.Parent = container

                    local textStroke = Instance.new("UIStroke")
                    textStroke.Color = Color3.fromRGB(0, 0, 0)
                    textStroke.Thickness = 3
                    textStroke.Parent = label

                    -- 呼吸缩放动画
                    local uiScale = Instance.new("UIScale")
                    uiScale.Parent = container
                    local scaleTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
                    TweenService:Create(uiScale, scaleTweenInfo, {Scale = 1.15}):Play()

                    uiData = { container = container, arrow = arrow, label = label }
                    activeUIs[plant] = uiData
                end

                uiData.updated = true

                -- 【贴边雷达运算】
                local targetPos = plant.PrimaryPart.Position + Vector3.new(0, 5, 0)
                local vector, onScreen = camera:WorldToViewportPoint(targetPos)
                local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

                if onScreen then
                    -- 在屏幕内：直接显示在植物头上，不显示箭头
                    uiData.container.Position = UDim2.new(0, vector.X, 0, vector.Y)
                    uiData.arrow.Visible = false
                    uiData.label.Position = UDim2.new(0.5, 0, 0.5, 0)
                else
                    -- 在屏幕外：开启边缘贴边计算
                    uiData.arrow.Visible = true
                    local offset = Vector2.new(vector.X - center.X, vector.Y - center.Y)
                    if vector.Z &lt; 0 then offset = -offset end 

                    local angle = math.atan2(offset.Y, offset.X)
                    local paddingX, paddingY = 80, 80
                    local edgeX = center.X - paddingX
                    local edgeY = center.Y - paddingY

                    local cosAngle = math.cos(angle)
                    local sinAngle = math.sin(angle)
                    local screenX, screenY

                    if math.abs(cosAngle) * edgeY &gt; math.abs(sinAngle) * edgeX then
                        screenX = math.sign(cosAngle) * edgeX
                        screenY = math.tan(angle) * screenX
                    else
                        screenY = math.sign(sinAngle) * edgeY
                        screenX = screenY / math.tan(angle)
                    end

                    uiData.container.Position = UDim2.new(0, center.X + screenX, 0, center.Y + screenY)
                    uiData.arrow.Rotation = math.deg(angle)
                    uiData.label.Position = UDim2.new(0.5, 0, 0.5, -20)
                end
            end
        end

        -- 3. 销毁已经失效的 UI (例如植物已经被偷走销毁、被收获)
        for plant, uiData in pairs(activeUIs) do
            if not uiData.updated or not plant.Parent then
                uiData.container:Destroy()
                activeUIs[plant] = nil
            end
        end
    end)
    
    print("客户端：StealablePointerUIController 加载完毕！寻宝雷达启动。")
end

return StealablePointerUIController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source">-- src/client/Services/ToolController.luau
local ToolController = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local UIEffectUtil = require(script.Parent.Parent.Utils.UIEffectUtil)
local PopupUtil = require(script.Parent.Parent.Utils.PopupUtil)

local activePrompts = {} -- 保存对 Prompt 的引用，方便随时清理
local activeGiftPopup = nil
local activeGiftRequestId = nil
local weaponAttackAnimId = "rbxassetid://135432663541165"
local weaponAttackTrackCache = setmetatable({}, { __mode = "k" })

local function stopAndDestroyWeaponAttackTrack(animator)
    local track = weaponAttackTrackCache[animator]
    if track then
        pcall(function()
            track:Stop(0.05)
            track:Destroy()
        end)
        weaponAttackTrackCache[animator] = nil
    end
end

local function getWeaponAttackTrack(animator)
    local cached = weaponAttackTrackCache[animator]
    if cached then
        return cached
    end

    local attackAnim = Instance.new("Animation")
    attackAnim.AnimationId = weaponAttackAnimId

    local track = animator:LoadAnimation(attackAnim)
    track.Name = "WeaponBlockAttackAnim"
    track.Priority = Enum.AnimationPriority.Action3
    weaponAttackTrackCache[animator] = track

    attackAnim:Destroy()
    return track
end

local function getLocalPlayerPlot(player)
    local plotsFolder = Workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot:GetAttribute("OwnerId") == player.UserId then
            return plot
        end
    end

    return nil
end

local function getCombatEditCost(player, fallbackPlot)
    local plot = fallbackPlot or getLocalPlayerPlot(player)
    local currentLevel = plot and plot:GetAttribute("CurrentLevel") or 1
    currentLevel = math.max(1, tonumber(currentLevel) or 1)
    return 100 + (currentLevel - 1) * 100
end

function ToolController.Init()
    local player = Players.LocalPlayer
    local mouse = player:GetMouse()
    
    local shovelRE = ReplicatedStorage:WaitForChild("ShovelActionRE")
    local giftItemRE = ReplicatedStorage:WaitForChild("GiftItemRE")
    local weaponAttackRE = ReplicatedStorage:WaitForChild("WeaponAttackRE", 5)
    
    -- 🌟 注册交换植物的远程事件
    local swapRE = ReplicatedStorage:WaitForChild("SwapCombatPlantRE", 5) 
    if not swapRE then
        -- 本地伪造一个防止报错，等待服务端真正创建
        swapRE = Instance.new("RemoteEvent")
        swapRE.Name = "SwapCombatPlantRE"
        swapRE.Parent = ReplicatedStorage
    end

   --=====================================
    -- [🌟 樱桃炸弹：爆炸范围指示球设置]
    -- ==========================================
   local throwBombRE = ReplicatedStorage:FindFirstChild("ThrowBombRE") or Instance.new("RemoteEvent")
    throwBombRE.Name = "ThrowBombRE"
    throwBombRE.Parent = ReplicatedStorage

    -- 恢复为红色的警示球，加深颜色
    local rangeSphere = Instance.new("Part")
    rangeSphere.Shape = Enum.PartType.Ball -- 保持球体
    rangeSphere.Material = Enum.Material.ForceField
    rangeSphere.Color = Color3.fromRGB(255, 20, 20)
    rangeSphere.Transparency = 0.4 -- 🌟 关键修改：透明度从0.8降到0.4，颜色会变得非常深且明显
    rangeSphere.Anchored = true
    rangeSphere.CanCollide = false
    rangeSphere.CastShadow = false
    rangeSphere.CanQuery = false
    rangeSphere.CanTouch = false

    RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then rangeSphere.Parent = nil return end
        
        local equippedItem = char:GetAttribute("EquippedSeed")
        
        if type(equippedItem) == "string" and string.match(equippedItem, "Plant_CherryBomb") then
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                -- 🌟 大小完全由配置决定
                local radius = ItemConfig.Plants["CherryBomb"].ExplosionRadius or 18
                rangeSphere.Size = Vector3.new(radius * 2, radius * 2, radius * 2)

                -- 🌟 稍微推远一点，从 15 改为 22 格，防止离玩家太近挡视野
                local forwardPos = rootPart.CFrame.Position + rootPart.CFrame.LookVector * 22
                
                local rayOrigin = forwardPos + Vector3.new(0, 20, 0)
                local rayDir = Vector3.new(0, -40, 0)
                local rayParams = RaycastParams.new()
                rayParams.FilterDescendantsInstances = {char, rangeSphere}
                rayParams.FilterType = Enum.RaycastFilterType.Exclude

                local result = Workspace:Raycast(rayOrigin, rayDir, rayParams)
                if result then
                    rangeSphere.Position = result.Position
                else
                    rangeSphere.Position = forwardPos - Vector3.new(0, rootPart.Size.Y / 2, 0)
                end

                if rangeSphere.Parent ~= Workspace then
                    rangeSphere.Parent = Workspace
                end
            end
        else
            if rangeSphere.Parent ~= nil then
                rangeSphere.Parent = nil
            end
        end
    end)

    -- ==========================================
    -- [E键交互：提示框逻辑 (铲子/植物交换)]
    -- ==========================================
    local function clearAllPrompts()
        for plant, prompt in pairs(activePrompts) do
            if prompt and prompt.Parent then prompt:Destroy() end
        end
        table.clear(activePrompts)
    end

    local function checkAndAddPrompt(plant, equippedItem)
        -- 排除已经生成提示的植物
        if activePrompts[plant] then return end

        local isCombat = plant:GetAttribute("IsCombatPlant")
        local isFarm = plant:GetAttribute("PlantedOn")
        local isMature = plant:GetAttribute("IsMature")
        
        local actionName = nil
        
        -- [🌟 核心判定：手里拿的是铲子 还是 植物？]
        if equippedItem == "Tool_Shovel" then
            -- 铲子逻辑：战斗植物可回收，农田植物必须【未成熟】
            if isCombat or (isFarm and not isMature) then
                actionName = "Recycle to Backpack"
            end
        elseif type(equippedItem) == "string" and string.match(equippedItem, "^Plant_") then
            -- 拿着植物！开启交换逻辑，只能交换阵地上的战斗植物
            -- 【樱桃炸弹例外】：拿在手里不触发交换植物的功能
            if isCombat and not string.match(equippedItem, "Plant_CherryBomb") then
                actionName = "Swap Plant"
            end
        end
        
        if actionName then
            local prompt = Instance.new("ProximityPrompt")
            prompt.ActionText = actionName
            prompt.ObjectText = plant.Name or "Plant"
            prompt.KeyboardKeyCode = Enum.KeyCode.E
            prompt.HoldDuration = 0.2 -- 稍微加一点长按时间，防止误触
            prompt.MaxActivationDistance = 12
            prompt.RequiresLineOfSight = false
            
            local attachPart = plant.PrimaryPart or plant:FindFirstChildWhichIsA("BasePart", true)
            if attachPart then
                prompt.Parent = attachPart
                activePrompts[plant] = prompt
                
                prompt.Triggered:Connect(function()
                    if isCombat then
                        local lawnPart = plant.Parent
                        local plot = lawnPart and lawnPart.Parent and lawnPart.Parent.Parent
                        if plot and plot:GetAttribute("IsLevelActive") then
                            
                            -- [🌟 战斗中的置换/回收确认弹窗]
                            if actionName == "Swap Plant" or actionName == "Recycle to Backpack" then
                                local cost = getCombatEditCost(player, plot)
                                local costText = UIEffectUtil.FormatNumber(cost)
                                local detailText = if actionName == "Swap Plant"
                                    then "Swapping plants during combat costs " .. costText .. " Sun."
                                    else "Removing plants during combat costs " .. costText .. " Sun."

                                local shown = PopupUtil.ShowConfirm(detailText, function()
                                    -- 传入 true 代表这是战斗中的操作
                                    if actionName == "Swap Plant" then
                                        swapRE:FireServer(plant, equippedItem, true)
                                    else
                                        shovelRE:FireServer(plant, true)
                                    end
                                end)

                                if not shown then
                                    UIEffectUtil.ShowTip("Popup is unavailable right now")
                                end

                                return -- 拦截到底
                            else
                                UIEffectUtil.ShowTip("Cannot interact with plants during battle")
                                return
                            end
                        end
                    end

                    -- [🌟 根据动作发送给不同的服务端接口 (非战斗状态走这里)]
                    if actionName == "Swap Plant" then
                        swapRE:FireServer(plant, equippedItem, false)
                    else
                        shovelRE:FireServer(plant, false)
                    end
                    
                    -- 先隐藏，防闪烁
                    if activePrompts[plant] then
                        local currentPrompt = activePrompts[plant]
                        currentPrompt.Enabled = false 
                        activePrompts[plant] = nil
                        
                        task.delay(0.1, function()
                            if currentPrompt and currentPrompt.Parent then 
                                currentPrompt:Destroy() 
                            end
                        end)
                    end
                end)
            end
        end
    end

    local function updateToolState()
        local char = player.Character
        if not char then return end
        
        local equippedItem = char:GetAttribute("EquippedSeed")
        
        -- 每次切换装备，先清理旧的提示框
        clearAllPrompts()
        
        -- 如果拿起了铲子，或者举起了成熟的植物(Plant_开头)
        if equippedItem == "Tool_Shovel" or (type(equippedItem) == "string" and string.match(equippedItem, "^Plant_")) then
            local plot = getLocalPlayerPlot(player)
            if not plot then return end

            -- 只扫描本地玩家自己的基地，避免每次切换工具都遍历整张地图。
            for _, obj in ipairs(plot:GetDescendants()) do
                if obj:IsA("Model") and (obj:GetAttribute("IsCombatPlant") or obj:GetAttribute("PlantedOn")) then
                    checkAndAddPrompt(obj, equippedItem)
                end
            end
        end
    end

    local function getGiftItemDisplayName(compositeId)
        local parts = string.split(compositeId, "_")
        local itemType = parts[1]
        local realId = parts[2]

        if itemType == "Seed" then
            local seedConfig = ItemConfig.Seeds[realId]
            return (seedConfig and seedConfig.Name) or realId
        elseif itemType == "Plant" then
            local plantConfig = ItemConfig.Plants[realId]
            return (plantConfig and plantConfig.Name) or realId
        end
        return nil
    end

    local function tryGiftEquippedItem(targetPlayer)
        if not targetPlayer or targetPlayer == player then return false end

        local char = player.Character
        if not char then return false end

        local equippedItem = char:GetAttribute("EquippedSeed")
        if type(equippedItem) ~= "string" then return false end
        if not string.match(equippedItem, "^Seed_") and not string.match(equippedItem, "^Plant_") then
            return false
        end

        local itemName = getGiftItemDisplayName(equippedItem)
        if not itemName then return false end

        local confirmText = string.format("Do you want to gift %s to %s?", itemName, targetPlayer.Name)
        local popupHandle = PopupUtil.ShowManaged(confirmText, {
            closeOnConfirm = false,
            closeOnCancel = true,
            onConfirm = function(handle)
                handle.SetWaiting("Waiting for the other player to confirm ...")
                activeGiftPopup = handle
                activeGiftRequestId = "PENDING"
                UIEffectUtil.ShowTip("Waiting...")
                giftItemRE:FireServer("CreateRequest", targetPlayer, equippedItem)
            end,
            onCancel = function()
                activeGiftPopup = nil
                activeGiftRequestId = nil
            end,
        })

        if not popupHandle then
            UIEffectUtil.ShowTip("Popup is unavailable right now")
            return true
        end
        return true
    end

    giftItemRE.OnClientEvent:Connect(function(action, ...)
        local args = { ... }

        if action == "RequesterWaiting" then
            local requestId = args[1]
            activeGiftRequestId = requestId

            if activeGiftPopup then
                activeGiftPopup.SetWaiting("Waiting for the other player to confirm ...")
                activeGiftPopup.SetButtons({
                    onCancel = function()
                        giftItemRE:FireServer("CancelRequest", requestId)
                        activeGiftPopup = nil
                        activeGiftRequestId = nil
                    end,
                    closeOnCancel = true,
                })
            end
        elseif action == "ReceiveRequest" then
            local requestId = args[1]
            local fromPlayerName = args[2]
            local itemName = args[3]

            activeGiftRequestId = requestId
            activeGiftPopup = PopupUtil.ShowManaged(
                string.format("Player %s gifts %s to you.\nDo you accept?", fromPlayerName, itemName),
                {
                    closeOnConfirm = true,
                    closeOnCancel = true,
                    onConfirm = function()
                        giftItemRE:FireServer("RespondRequest", requestId, true)
                        activeGiftPopup = nil
                        activeGiftRequestId = nil
                    end,
                    onCancel = function()
                        giftItemRE:FireServer("RespondRequest", requestId, false)
                        activeGiftPopup = nil
                        activeGiftRequestId = nil
                    end,
                }
            )

            if not activeGiftPopup then
                giftItemRE:FireServer("RespondRequest", requestId, false)
                UIEffectUtil.ShowTip("Popup is unavailable right now")
            end
        elseif action == "ClosePopup" then
            local requestId = args[1]
            local tipText = args[2]

            if activeGiftRequestId == requestId or requestId == nil then
                PopupUtil.Hide()
                activeGiftPopup = nil
                activeGiftRequestId = nil
            end

            if tipText and tipText ~= "" then
                UIEffectUtil.ShowTip(tipText)
            end
        end
    end)

    local function bindCharacter(char)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid)

        char:GetAttributeChangedSignal("EquippedSeed"):Connect(function()
            local equippedItem = char:GetAttribute("EquippedSeed")
            if equippedItem ~= "Tool_WeaponBlock" and animator then
                stopAndDestroyWeaponAttackTrack(animator)
            end
            updateToolState()
        end)

        if humanoid and animator then
            humanoid.Died:Connect(function()
                stopAndDestroyWeaponAttackTrack(animator)
            end)
        end

        char.AncestryChanged:Connect(function(_, parent)
            if not parent and animator then
                stopAndDestroyWeaponAttackTrack(animator)
            end
        end)

        updateToolState()
    end

    if player.Character then bindCharacter(player.Character) end
    player.CharacterAdded:Connect(bindCharacter)

    Workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("Model") then
            task.delay(0.1, function() 
                local char = player.Character
                if char then
                    local equippedItem = char:GetAttribute("EquippedSeed")
                    if equippedItem == "Tool_Shovel" or (type(equippedItem) == "string" and string.match(equippedItem, "^Plant_")) then
                        local plot = getLocalPlayerPlot(player)
                        if plot and desc:IsDescendantOf(plot) and (desc:GetAttribute("IsCombatPlant") or desc:GetAttribute("PlantedOn")) then
                            checkAndAddPrompt(desc, equippedItem)
                        end
                    end
                end
            end)
        end
    end)
    
    task.spawn(function()
        while task.wait(1) do
            for plant, prompt in pairs(activePrompts) do
                if not plant or not plant.Parent or plant:GetAttribute("IsMature") then
                    -- 仅铲子状态下才清理农田成熟的 Bug（交换只能对草坪使用，不受农田成熟影响）
                    if prompt and prompt.ActionText == "Recycle to Backpack" then
                        prompt:Destroy()
                        activePrompts[plant] = nil
                    end
                end
            end
        end
    end)
  
    -- ==========================================
    -- [鼠标点击行为中枢：投掷 / 近战攻击 / 赠送]
    -- ==========================================
    local isAttacking = false 
    local isThrowingBomb = false
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
       if gameProcessed then return end 

        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local char = player.Character
            if not char then return end

            local equippedItem = char:GetAttribute("EquippedSeed")

            -- 👇 [🌟 行为 1：樱桃炸弹投掷动作 (支持连续投掷)]
            if type(equippedItem) == "string" and string.match(equippedItem, "Plant_CherryBomb") then
                -- 确保范围球存在，且当前不在冷却中
                if rangeSphere.Parent == Workspace and not isThrowingBomb then
                    isThrowingBomb = true
                    
                    -- 发送投掷请求给服务端
                    throwBombRE:FireServer(equippedItem, rangeSphere.Position)
                    
                    -- 🌟 赋予 0.5 秒的投掷冷却，冷却结束后可以无缝扔出下一个！
                    task.delay(0.5, function()
                        isThrowingBomb = false
                    end)
                end
                return -- 拦截到底，直接返回
            end
            -- 行为 2：检测是否尝试点击玩家进行赠送
            local target = mouse.Target
            if target then
                local targetModel = target:FindFirstAncestorOfClass("Model")
                local targetPlayer = targetModel and Players:GetPlayerFromCharacter(targetModel)
                if tryGiftEquippedItem(targetPlayer) then
                    return
                end
            end

            -- 行为 3：普通武器近战挥舞逻辑
            if equippedItem == "Tool_WeaponBlock" then
                if isAttacking then return end
                isAttacking = true

                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
                    local track = getWeaponAttackTrack(animator)
                    track:Play(0.05)

                    task.spawn(function()
                        local hitTargets = {}
                        local processed = {}
                        local checkDuration = 0.35 
                        local startTime = tick()

                        while tick() - startTime &lt; checkDuration and isAttacking do
                            local rootPart = char:FindFirstChild("HumanoidRootPart")
                            if not rootPart then break end

                            local checkCFrame = rootPart.CFrame * CFrame.new(0, 0, -3.5)
                            local checkSize = Vector3.new(6.5, 6, 7.5) 
                            local overlapParams = OverlapParams.new()

                            local hitParts = Workspace:GetPartBoundsInBox(checkCFrame, checkSize, overlapParams)

                            for _, part in ipairs(hitParts) do
                                local targetModel = part:FindFirstAncestorOfClass("Model")
                                if targetModel and targetModel ~= char and not processed[targetModel] then
                                    local hum = targetModel:FindFirstChildOfClass("Humanoid")
                                    if hum and hum.Health &gt; 0 then
                                        processed[targetModel] = true
                                        table.insert(hitTargets, targetModel)
                                    end
                                end
                            end

                            if #hitTargets &gt; 0 and weaponAttackRE then
                                weaponAttackRE:FireServer(hitTargets)
                                table.clear(hitTargets) 
                            end
                            task.wait(0.05) 
                        end
                    end)

                    task.delay(0.5, function()
                        isAttacking = false
                    end)
                else
                    isAttacking = false
                end
            end
        end
    end)
   
    print("客户端：ToolController (抛物线/交互/战斗武器联动) 加载完毕！")
end

return ToolController</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">ZombieBoxController</string>
              <string name="Source">-- src/client/Services/ZombieBoxController.luau
local ZombieBoxController = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer
local itemModels = ReplicatedStorage:WaitForChild("ItemModels")
local zombieBoxRE = ReplicatedStorage:WaitForChild("ZombieBoxRE")

-- 用于假抽奖滚动动画的模型库
local fakeItemPool = {}

function ZombieBoxController.Init()
    -- 初始化假抽奖池
    for _, template in pairs(itemModels:GetChildren()) do
        if template:IsA("Model") and template.Name ~= "Box" then
            table.insert(fakeItemPool, template.Name)
        end
    end

    -- 监听服务端要求生成盲盒的指令
    zombieBoxRE.OnClientEvent:Connect(function(action, dropPos, finalItem)
        if action == "SpawnBox" then
            ZombieBoxController.SpawnLocalBox(dropPos, finalItem)
        end
    end)
end
function ZombieBoxController.SpawnLocalBox(dropPos, finalItem)
    local luckyTemplate = itemModels:FindFirstChild("Box")
    if not luckyTemplate then return end

    local box = luckyTemplate:Clone()

    box:PivotTo(CFrame.new(dropPos))
    
    for _, part in pairs(box:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false 
        end
    end
    
    box.Parent = Workspace

    -- 2. 开箱动画
    task.spawn(function()
        for _, p in pairs(box:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Color = Color3.fromRGB(255, 255, 255)
                p.Material = Enum.Material.Neon
            elseif p:IsA("ParticleEmitter") or p:IsA("Light") then
                p.Enabled = true
            end
        end

        task.wait(0.3) 
        
        local boxPos = box:GetPivot().Position
        box:Destroy() 

        local displayModel
        local iterations = 15 
        for i = 1, iterations do
            if displayModel then displayModel:Destroy() end
            
            local randomName = fakeItemPool[math.random(1, #fakeItemPool)] or "Seed"
            local template = itemModels:FindFirstChild(randomName) or itemModels:FindFirstChild("Seed")
            
            if template then
                displayModel = template:Clone()
                for _, p in pairs(displayModel:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Color = Color3.new(0, 0, 0)
                        p.Material = Enum.Material.SmoothPlastic
                        p.Anchored = true
                        p.CanCollide = false
                    end
                end
                displayModel:PivotTo(CFrame.new(boxPos + Vector3.new(0, 3, 0)))
                displayModel.Parent = Workspace
            end
            task.wait(0.12)
        end
        if displayModel then displayModel:Destroy() end

        local templateName = finalItem.type == "Plant" and (finalItem.id .. "_Plant") or finalItem.id
        local finalTemplate = itemModels:FindFirstChild(templateName) or itemModels:FindFirstChild("Seed")

        if finalTemplate then
            local finalModel = finalTemplate:Clone()
            for _, p in pairs(finalModel:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Anchored = true
                    p.CanCollide = false
                end
            end
            finalModel:PivotTo(CFrame.new(boxPos + Vector3.new(0, 3, 0)))
            finalModel.Parent = Workspace
            
            local glow = Instance.new("Highlight")
            glow.FillColor = Color3.fromRGB(255, 215, 0)
            glow.Parent = finalModel

            task.wait(0.5) 

            local flightTime = 0.6 
            local startTime = os.clock()
            local startPos = finalModel:GetPivot().Position
            
            local connection
            connection = RunService.Heartbeat:Connect(function()
                local elapsedTime = os.clock() - startTime
                local t = math.clamp(elapsedTime / flightTime, 0, 1)
                
                if t &gt;= 1 then
                    connection:Disconnect()
                    finalModel:Destroy()
                    
                    zombieBoxRE:FireServer("GiveReward", finalItem)
                else
                    local targetChar = localPlayer.Character
                    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                    local endPos = targetHRP and targetHRP.Position or startPos
                    
                    local p0 = startPos
                    local p2 = endPos
                    local p1 = p0:Lerp(p2, 0.5) + Vector3.new(0, 15, 0) 
                    
                    local currentPos = ((1 - t)^2 * p0) + (2 * (1 - t) * t * p1) + (t^2 * p2)
                    finalModel:PivotTo(CFrame.new(currentPos))
                end
            end)
        end
    end)
end

return ZombieBoxController</string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="50">
          <Properties>
            <string name="Name">UI</string>
