          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">PopupUtil</string>
              <string name="Source">local Players = game:GetService("Players")

local PopupUtil = {
	_okConn = nil,
	_cancelConn = nil,
	_popup = nil,
	_popupFrame = nil,
	_detail = nil,
	_btnOk = nil,
	_btnCancel = nil,
}

local function disconnectConnection(connection)
	if connection then
		connection:Disconnect()
	end
end

local function getButtonLabel(button)
	if not button then
		return nil
	end

	if button:IsA("TextButton") or button:IsA("TextLabel") or button:IsA("TextBox") then
		return button
	end

	for _, descendant in ipairs(button:GetDescendants()) do
		if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
			return descendant
		end
	end

	return nil
end

local function getPopupRefs()
	local player = Players.LocalPlayer
	if not player then
		warn("PopupUtil: LocalPlayer 不存在")
		return nil
	end

	local playerGui = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui")
	local basicGui = playerGui:FindFirstChild("BasicGui")
	local popup = basicGui and basicGui:FindFirstChild("Popup")
	local popupFrame = popup and popup:FindFirstChild("PopupFrame")
	local detail = popupFrame and popupFrame:FindFirstChild("Detail")
	local btnOk = popupFrame and popupFrame:FindFirstChild("OK")
	local btnCancel = popupFrame and popupFrame:FindFirstChild("Cancel")

	if not (popup and popupFrame and detail and btnOk and btnCancel) then
		warn("PopupUtil: 找不到完整的 Popup UI 结构")
		return nil
	end

	PopupUtil._popup = popup
	PopupUtil._popupFrame = popupFrame
	PopupUtil._detail = detail
	PopupUtil._btnOk = btnOk
	PopupUtil._btnCancel = btnCancel

	return popup, popupFrame, detail, btnOk, btnCancel
end

local function setButtonEnabled(button, enabled)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.Selectable = enabled
	if button:IsA("GuiButton") then
		button.Modal = false
	end
	if button:IsA("GuiObject") then
		button.BackgroundTransparency = enabled and 0 or 0.35
	end

	local label = getButtonLabel(button)
	if label then
		label.TextTransparency = enabled and 0 or 0.25
	end
end

local function setButtonText(button, text)
	local label = getButtonLabel(button)
	if label and text ~= nil then
		label.Text = text
	end
end

function PopupUtil.Hide()
	disconnectConnection(PopupUtil._okConn)
	disconnectConnection(PopupUtil._cancelConn)
	PopupUtil._okConn = nil
	PopupUtil._cancelConn = nil

	local popup = PopupUtil._popup
	if not popup then
		popup = getPopupRefs()
	end

	if not popup then
		return
	end

	if popup then
		popup.Enabled = false
	end
end

function PopupUtil.ShowManaged(detailText: string, options)
	PopupUtil.Hide()

	local popup, _, detail, btnOk, btnCancel = getPopupRefs()
	if not popup then
		return false
	end

	options = options or {}
	detail.Text = detailText
	setButtonText(btnOk, options.okText or "OK")
	setButtonText(btnCancel, options.cancelText or "Cancel")
	btnOk.Visible = options.showOk ~= false
	btnCancel.Visible = options.showCancel ~= false
	setButtonEnabled(btnOk, options.okEnabled ~= false)
	setButtonEnabled(btnCancel, options.cancelEnabled ~= false)
	popup.Enabled = true

	local handle = {}

	PopupUtil._okConn = btnOk.MouseButton1Click:Connect(function()
		if options.closeOnConfirm ~= false then
			PopupUtil.Hide()
		end
		if options.onConfirm then
			options.onConfirm(handle)
		end
	end)

	PopupUtil._cancelConn = btnCancel.MouseButton1Click:Connect(function()
		if options.closeOnCancel ~= false then
			PopupUtil.Hide()
		end
		if options.onCancel then
			options.onCancel(handle)
		end
	end)

	function handle.Update(newDetailText: string)
		if PopupUtil._detail then
			PopupUtil._detail.Text = newDetailText
		end
	end

	function handle.SetButtons(newOptions)
		newOptions = newOptions or {}
		if PopupUtil._btnOk then
			if newOptions.okText ~= nil then setButtonText(PopupUtil._btnOk, newOptions.okText) end
			if newOptions.showOk ~= nil then PopupUtil._btnOk.Visible = newOptions.showOk end
			if newOptions.okEnabled ~= nil then setButtonEnabled(PopupUtil._btnOk, newOptions.okEnabled) end
		end
		if PopupUtil._btnCancel then
			if newOptions.cancelText ~= nil then setButtonText(PopupUtil._btnCancel, newOptions.cancelText) end
			if newOptions.showCancel ~= nil then PopupUtil._btnCancel.Visible = newOptions.showCancel end
			if newOptions.cancelEnabled ~= nil then setButtonEnabled(PopupUtil._btnCancel, newOptions.cancelEnabled) end
		end
		if newOptions.closeOnConfirm ~= nil then options.closeOnConfirm = newOptions.closeOnConfirm end
		if newOptions.closeOnCancel ~= nil then options.closeOnCancel = newOptions.closeOnCancel end
		if newOptions.onConfirm ~= nil then options.onConfirm = newOptions.onConfirm end
		if newOptions.onCancel ~= nil then options.onCancel = newOptions.onCancel end
		if newOptions.okText ~= nil or newOptions.cancelText ~= nil then
			-- no-op, handled above; keeps method symmetric
		end
	end

	function handle.SetWaiting(newDetailText: string)
		handle.Update(newDetailText)
		handle.SetButtons({
			showOk = true,
			okEnabled = false,
			cancelText = "Cancel",
			cancelEnabled = true,
			closeOnConfirm = false,
			closeOnCancel = true,
		})
	end

	function handle.Close()
		PopupUtil.Hide()
	end

	return handle
end

function PopupUtil.ShowConfirm(detailText: string, onConfirm: () -&gt; ())
	return PopupUtil.ShowManaged(detailText, {
		onConfirm = function()
			onConfirm()
		end,
	}) ~= false
end

return PopupUtil</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">TutorialEffect</string>
              <string name="Source">-- src/client/Utils/TutorialEffect.luau
local TutorialEffect = {}
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- ==========================================
-- 1. UI 闪烁特效 (保持不变)
-- ==========================================
function TutorialEffect.AddFlash(object, color, thickness)
    local existing = object:FindFirstChild("TutorialFlash")
    if existing then existing:Destroy() end

    local stroke = Instance.new("UIStroke")
    stroke.Name = "TutorialFlash"
    stroke.Color = color or Color3.fromRGB(255, 255, 255)
    stroke.Thickness = thickness or 8
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Transparency = 1
    stroke.Parent = object
    
    local info = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tween = TweenService:Create(stroke, info, {Transparency = 0})
    tween:Play()
    
    return function()
        tween:Cancel()
        stroke:Destroy()
    end
end

-- ==========================================
-- 2. 3D 滚动引导线特效 (优化版)
-- ==========================================
function TutorialEffect.AddGuideBeam(character, targetPart, beamColor)
    if not character or not targetPart then return function() end end
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not rootPart then return function() end end

    beamColor = beamColor or Color3.fromRGB(85, 255, 127)

    -- 创建附着点
    local attPlayer = Instance.new("Attachment")
    attPlayer.Name = "TutorialAttPlayer"
    attPlayer.Parent = rootPart

    local attTarget = Instance.new("Attachment")
    attTarget.Name = "TutorialAttTarget"
    attTarget.Parent = targetPart

    -- 创建引导光束 (Beam)
    local guideBeam = Instance.new("Beam")
    guideBeam.Name = "TutorialGuideBeam"
    guideBeam.Attachment0 = attPlayer
    guideBeam.Attachment1 = attTarget
    guideBeam.FaceCamera = true
    guideBeam.Width0 = 1.5
    guideBeam.Width1 = 1.5
    guideBeam.Color = ColorSequence.new(beamColor)
    
    -- 【关键修改】：使用你提供的滚动贴图 ID
    guideBeam.Texture = "rbxassetid://6661208797" 
    guideBeam.TextureMode = Enum.TextureMode.Wrap
    guideBeam.TextureSpeed = 2 -- 滚动速度
    
    -- 增强可见度
    guideBeam.LightEmission = 1
    guideBeam.LightInfluence = 0
    guideBeam.Transparency = NumberSequence.new(0)
    guideBeam.Enabled = true
    guideBeam.Parent = targetPart

    -- 目标高亮
    local highlight = Instance.new("Highlight")
    highlight.Name = "TutorialHighlight"
    highlight.FillColor = beamColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.Parent = targetPart

    return function()
        if attPlayer then attPlayer:Destroy() end
        if attTarget then attTarget:Destroy() end
        if guideBeam then guideBeam:Destroy() end
        if highlight then highlight:Destroy() end
    end
end

function TutorialEffect.AddUIArrow(targetUI)
    if not targetUI then return function() end end

    local player = game:GetService("Players").LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    -- 创建一个独立的 ScreenGui，确保箭头永远在最上层，不会被遮挡
    local screenGui = playerGui:FindFirstChild("TutorialArrowGui")
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "TutorialArrowGui"
        screenGui.DisplayOrder = 9999 
        screenGui.Parent = playerGui
    end

    local arrow = Instance.new("ImageLabel")
    arrow.Name = "TutorialUIArrow"
    arrow.Size = UDim2.new(0, 40, 0, 40)
    arrow.AnchorPoint = Vector2.new(0.5, 1) -- 锚点设为底部居中
    arrow.BackgroundTransparency = 1
    arrow.Image = "rbxassetid://120753408134411" -- 🌟 这是一个通用向下箭头的素材ID，你可以自行替换
    arrow.ImageColor3 = Color3.fromRGB(255, 215, 0) -- 显眼的金色

    arrow.Rotation = - 90
    arrow.Parent = screenGui

    local startTime = tick()
    local connection
    
    -- 实时跟随目标 UI 并加上下浮动的动画
    connection = RunService.RenderStepped:Connect(function()
        -- 确保目标 UI 仍然存在并且可见
        if targetUI and targetUI.Parent and targetUI.AbsoluteSize.X &gt; 0 then
            arrow.Visible = true
            -- 计算浮动偏移量 (上下浮动 8 像素)
            local bounceOffset = math.sin((tick() - startTime) * 6) * 8
            
            -- 定位在目标 UI 的正上方
            arrow.Position = UDim2.new(
                0, targetUI.AbsolutePosition.X + (targetUI.AbsoluteSize.X / 2),
                0, targetUI.AbsolutePosition.Y - 5 + bounceOffset
            )
        else
            arrow.Visible = false
        end
    end)

    -- 返回清理函数
    return function()
        if connection then connection:Disconnect() end
        if arrow then arrow:Destroy() end
    end
end

return TutorialEffect</string>
