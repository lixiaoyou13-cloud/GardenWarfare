      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[

-- src/server/init.server.luau
print("服务端启动！准备加载核心模块...")

-- ==========================================
-- [🌟 新增：全局碰撞组设定]
-- ==========================================
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

-- 1. 注册两个组：玩家组、僵尸组
pcall(function()
    PhysicsService:RegisterCollisionGroup("Players")
    PhysicsService:RegisterCollisionGroup("Zombies")
end)

-- 2. 设定规则：玩家穿透僵尸(false)，僵尸穿透僵尸(false)
PhysicsService:CollisionGroupSetCollidable("Players", "Zombies", false)
PhysicsService:CollisionGroupSetCollidable("Zombies", "Zombies", false)

-- 3. 玩家一出生，就把他的身体扔进 "Players" 组里，并挂载头衔
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(character)
        -- ==========================================
        -- [🌟 新增：设置玩家初始移动速度]
        -- ==========================================
        local humanoid = character:WaitForChild("Humanoid")
        humanoid.WalkSpeed = 30 -- 👈 将 24 修改为你想要的移动速度 (默认是16)
        
        -- 给身体所有的手脚、躯干打上玩家组标签
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CollisionGroup = "Players" end
        end
        -- 如果玩家中途穿了新装备，也立刻打上标签
        character.DescendantAdded:Connect(function(desc)
            if desc:IsA("BasePart") then desc.CollisionGroup = "Players" end
        end)

        -- ==========================================
        -- [🌟 新增：玩家头顶最高通关层数头衔 (英文)]
        -- ==========================================
        task.spawn(function()
            local head = character:WaitForChild("Head", 5)
            if not head then return end
            
            -- 获取数据管理器 (动态 require 确保安全)
            local PDManager = require(script.PlayerDataManager)
            
            -- 等待玩家真实数据从 DataStore 中加载完毕
            local data = nil
            while not data do
                data = PDManager.GetPlayerData(player)
                if not data then task.wait(0.5) end
            end

            -- 直接显示当前解锁层数
            local maxCleared = data.UnlockedLevel or 1
            
            -- 清理旧头衔（防止角色重置时重复生成）
            local oldTitle = head:FindFirstChild("PlayerTitleGui")
            if oldTitle then oldTitle:Destroy() end

            -- 创建一个悬浮 GUI (BillboardGui)
            local titleGui = Instance.new("BillboardGui")
            titleGui.Name = "PlayerTitleGui"
            titleGui.Size = UDim2.new(0, 140, 0, 30)
            titleGui.StudsOffset = Vector3.new(0, 2.5, 0) -- 悬浮在头顶上方 2.5 格
            titleGui.AlwaysOnTop = true
            titleGui.MaxDistance = 80 -- 超过 80 米不可见

            -- 创建文字标签
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = "MAX  " .. tostring(maxCleared)
            
            textLabel.TextColor3 = Color3.fromRGB(255, 215, 0) -- 亮金色文字
            textLabel.TextStrokeTransparency = 0.2
            textLabel.TextStrokeColor3 = Color3.fromRGB(60, 30, 0) -- 深棕色描边，提升质感
            textLabel.TextScaled = true
            textLabel.Font = Enum.Font.LuckiestGuy
            textLabel.Parent = titleGui

            -- 将 GUI 挂载到玩家头部
            titleGui.Parent = head
        end)
    end)
end)
-- =========================================

local PlayerDataManager = require(script.PlayerDataManager)
PlayerDataManager.Init()

local InventoryService = require(script.Services.InventoryService)
InventoryService.Init()

local EquipmentService = require(script.Services.EquipmentService)
EquipmentService.Init()

local ShopService = require(script.Services.ShopService)
ShopService.Init()

local PlotService = require(script.Services.PlotService)
PlotService.Init()

local CoinDropService = require(script.Services.CoinDropService)
CoinDropService.Init()

local PlantService = require(script.Services.PlantService)
PlantService.Init()

local BaseMerchantService = require(script.Services.BaseMerchantService)
BaseMerchantService.Init()

local CombatService = require(script.Services.CombatService)
CombatService.Init()

local ZombieService = require(script.Services.ZombieService)
ZombieService.Init()
local FreeRewardService = require(script.Services.FreeRewardService)
FreeRewardService.Init()

local LevelService = require(script.Services.LevelService)
LevelService.Init()

local ToolService = require(script.Services.ToolService)
ToolService.Init()
local LuckyDropService = require(script.Services.LuckyDropService)
LuckyDropService.Init()
-- 找到你原来 require 其他 Service 的地方，加上这一句：
local RankingService = require(script.Services.RankingService)

-- 然后在下方的执行区域，加上初始化：
RankingService.Init()

require(script.Services.IAPService).Init()

require(script.Services.BaseSunflowerService).Init()

require(script.Services.ZombieBoxService)
--[[Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(msg)
        if msg == "/testbomb" then
            -- 给发消息的玩家直接塞 20 个樱桃炸弹
            local PDManager = require(script.PlayerDataManager)
            PDManager.GivePlant(player, "CobCannon", 20, 1)
            
            -- 在控制台打印提示
            print("【开发者测试】已发放 20 个樱桃炸弹给: " .. player.Name)
            
            -- 给客户端弹个提示框
            local showTipRE = game:GetService("ReplicatedStorage"):FindFirstChild("ShowTipRE")
            if showTipRE then
                showTipRE:FireClient(player, "获得测试道具：樱桃炸弹 x20！")
            end
        end
    end)
end)]]

print("所有服务端模块加载完毕！")]]></string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">PlayerDataManager</string>
          <string name="Source">-- src/server/PlayerDataManager.luau
local PlayerDataManager = {}

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnalyticsService = game:GetService("AnalyticsService")
local MarketplaceService = game:GetService("MarketplaceService")
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
-- 👇 新增：引入签到奖励配置
local SignInRewardConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SignInRewardConfig"))

local PlayerDataStore = DataStoreService:GetDataStore("MyGameData_V18")
local sessionData = {}
local X2_SUN_GAME_PASS_ID = 1856661235
local x2SunOwnershipCache = {}
local ROLL_TAB1_CASH_COST = 200000
local onlineRollTimerStarted = false

local analyticsRE = ReplicatedStorage:FindFirstChild("AnalyticsRE") or Instance.new("RemoteEvent")
analyticsRE.Name = "AnalyticsRE"
analyticsRE.Parent = ReplicatedStorage

analyticsRE.OnServerEvent:Connect(function(player, eventType, eventName, extraData)
    print(string.format("[Analytics] Player: %s | Type: %s | Event: %s", player.Name, tostring(eventType), tostring(eventName)))
    if eventType == "Custom" then
        local logValue = 1
        if type(extraData) == "number" then logValue = extraData end
        AnalyticsService:LogCustomEvent(player, eventName, logValue)
    elseif eventType == "Funnel" then
        if type(extraData) == "table" then
            local sessionId = extraData.SessionId
            local stepIndex = extraData.StepIndex or 1
            AnalyticsService:LogFunnelStepEvent(player, eventName, sessionId, stepIndex, extraData.StepName)
        end
    end
end)

local function GetDefaultData()
   return {
        Coins = 1000, Level = 1, UnlockedLevel = 1,
        TotalSun = 0,
        UnlockedPlots = 4,
        SignInDays = 0,       
        LastSignInTime = 0,   
        
        -- 👇 新增：签到重置标记（新玩家默认已经重置）
        SignInReset_V1 = true,
        
        Hotbar = {"Tool_Shovel","System_Backpack", "Tool_WeaponBlock"},  
        Inventory = { Seeds = { { ID = "Peashooter", Quantity = 1 } }, Plants = {} },
        PlantedPlants = {}, CombatPlants = {},
        UnlockedSeeds = { ["Peashooter"] = true }, 
        TutorialStep = 0,
        UnlockedMutations = {},
        ClaimedAchieve = {},
        RollTickets = {0, 0},
        
        NewbieGiftStartTime = 0,     
        NewbieGiftPurchased = false, 
        OnlineRollTimer = 300 
    }
end
local function saveWithRetry(userId, dataToSave)
    local dataForSave = table.clone(dataToSave)
    dataForSave.Hotbar = {} 
    for attempt = 1, 3 do
        local success = pcall(function() PlayerDataStore:SetAsync(userId, dataForSave) end)
        if success then return true else task.wait(2) end
    end
    return false
end

local function startGlobalOnlineRollTimer()
    if onlineRollTimerStarted then return end
    onlineRollTimerStarted = true

    task.spawn(function()
        while true do
            task.wait(1)

            local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
            for _, plr in ipairs(Players:GetPlayers()) do
                local pData = sessionData[plr.UserId]
                if pData then
                    pData.OnlineRollTimer = (pData.OnlineRollTimer or 300) - 1

                    if pData.OnlineRollTimer &lt;= 0 then
                        pData.OnlineRollTimer = 300
                        pData.RollTickets = pData.RollTickets or {0, 0}
                        pData.RollTickets[1] = (pData.RollTickets[1] or 0) + 1

                        if updateInventoryRE then
                            updateInventoryRE:FireClient(plr, pData)
                        end
                    end
                end
            end
        end
    end)
end

local function onPlayerAdded(player)
    local isLoaded = false

    task.spawn(function()
        local success, savedData = pcall(function() return PlayerDataStore:GetAsync(player.UserId) end)
        if not isLoaded then
            isLoaded = true
            if success and savedData  then
                savedData.Hotbar = {"Tool_Shovel", "System_Backpack", "Tool_WeaponBlock"}
                if not savedData.PlantedPlants then savedData.PlantedPlants = {} end 
                if not savedData.CombatPlants then savedData.CombatPlants = {} end 
                if type(savedData.UnlockedSeeds) ~= "table" then savedData.UnlockedSeeds = { ["Peashooter"] = true } end
                if type(savedData.UnlockedMutations) ~= "table" then savedData.UnlockedMutations = {} end
                if type(savedData.ClaimedAchieve) ~= "table" then savedData.ClaimedAchieve = {} end
                if type(savedData.NewbieGiftStartTime) ~= "number" then savedData.NewbieGiftStartTime = 0 end
                if type(savedData.NewbieGiftPurchased) ~= "boolean" then savedData.NewbieGiftPurchased = false end
                if type(savedData.RollTickets) ~= "table" then savedData.RollTickets = {0, 0} end 
                
                -- 🌟 兼容老玩家数据
                if type(savedData.OnlineRollTimer) ~= "number" then savedData.OnlineRollTimer = 300 end
                -- ====================================================
                -- 👇 新增：强制重置所有老玩家的七日签到进度（只触发一次）
                -- ====================================================
                if not savedData.SignInReset_V1 then
                    savedData.SignInDays = 0       -- 签到天数归零
                    savedData.LastSignInTime = 0   -- 签到时间归零
                    savedData.SignInReset_V1 = true -- 打上标记，防止下次登录再次被重置
                    print("🔄 [数据系统] 玩家 " .. player.Name .. " 的七日签到已强制重置！")
                end
                -- ====================================================

                sessionData[player.UserId] = savedData
                print("✅ [数据系统] 玩家 " .. player.Name .. " 数据拉取成功！")
                
                if (savedData.TutorialStep or 0) == 0 then
                    AnalyticsService:LogFunnelStepEvent(player, "Onboarding", nil, 1, "Step_1_Enter_Game")
                end
            else
                sessionData[player.UserId] = GetDefaultData()
                print("🆕 [数据系统] 玩家 " .. player.Name .. " 无存档，发放初始数据。")
                AnalyticsService:LogFunnelStepEvent(player, "Onboarding", nil, 1, "Step_1_Enter_Game")
            end
        end
    end)
    
    task.delay(5, function()
        if not isLoaded then
            isLoaded = true
            warn("⚠️ [数据系统] Roblox数据请求超时！已下发初始数据，保护游戏进程不崩溃！")
            sessionData[player.UserId] = GetDefaultData()
        end
    end)
end

local function onPlayerRemoving(player)
    local dataToSave = sessionData[player.UserId]
    if dataToSave then
        sessionData[player.UserId] = nil 
        if (dataToSave.TutorialStep or 0) &lt; 8 then -- 🟢 改成 8
            return
        end
        task.spawn(function() saveWithRetry(player.UserId, dataToSave) end)
    end
end

function PlayerDataManager.Init()
    startGlobalOnlineRollTimer()

    Players.PlayerAdded:Connect(onPlayerAdded)
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(function() onPlayerAdded(player) end)
    end
    Players.PlayerRemoving:Connect(onPlayerRemoving)

    game:BindToClose(function()
        for _, player in ipairs(Players:GetPlayers()) do
            local dataToSave = sessionData[player.UserId]
            if dataToSave then 
                if (dataToSave.TutorialStep or 0) &gt;= 8 then -- 8
                   task.spawn(function() saveWithRetry(player.UserId, dataToSave) end) 
                end
            end
        end
        task.wait(2)
    end)

    local getPlayerDataRF = Instance.new("RemoteFunction")
    getPlayerDataRF.Name = "GetPlayerDataRF"
    getPlayerDataRF.Parent = ReplicatedStorage
    getPlayerDataRF.OnServerInvoke = function(player)
        while not sessionData[player.UserId] do task.wait(0.1) end
        return sessionData[player.UserId]
    end
  
    if not ReplicatedStorage:FindFirstChild("UpdateInventoryRE") then
        local updateInventoryRE = Instance.new("RemoteEvent")
        updateInventoryRE.Name = "UpdateInventoryRE"
        updateInventoryRE.Parent = ReplicatedStorage
    end

    if not ReplicatedStorage:FindFirstChild("PlayUnlockAnimRE") then
        local animRE = Instance.new("RemoteEvent")
        animRE.Name = "PlayUnlockAnimRE"
        animRE.Parent = ReplicatedStorage
    end
  
    if not ReplicatedStorage:FindFirstChild("UpdateTutorialRE") then
        local tutorialRE = Instance.new("RemoteEvent")
        tutorialRE.Name = "UpdateTutorialRE"
        tutorialRE.Parent = ReplicatedStorage
        tutorialRE.OnServerEvent:Connect(function(plr, step)
            local data = sessionData[plr.UserId]
            if data then
                if step &gt; (data.TutorialStep or 0) then
                    data.TutorialStep = step
                end
            end
        end)
    end

    if not ReplicatedStorage:FindFirstChild("PlayObtainEffectRE") then
        local effectRE = Instance.new("RemoteEvent")
        effectRE.Name = "PlayObtainEffectRE"
        effectRE.Parent = ReplicatedStorage
    end
    
    -- ==========================================
    -- [🌟 新增：处理服务端抽奖扣除与发奖逻辑]
    -- ==========================================
    local performRollRF = ReplicatedStorage:FindFirstChild("PerformRollRF")
    if not performRollRF then
        performRollRF = Instance.new("RemoteFunction")
        performRollRF.Name = "PerformRollRF"
        performRollRF.Parent = ReplicatedStorage
    end
    
    performRollRF.OnServerInvoke = function(player, tabIndex)
        tabIndex = tonumber(tabIndex) or 1
        if tabIndex ~= 1 and tabIndex ~= 2 then
            return false, "Invalid roll tab"
        end

        local data = sessionData[player.UserId]
        if not data then return false, "数据仍在加载中..." end
        if not data.RollTickets then data.RollTickets = {0, 0} end
        
        -- 兼容旧数据/异常数据里 RollTickets 使用字符串键的情况，避免误判为 0 后先扣阳光。
        local tickets = tonumber(data.RollTickets[tabIndex]) or tonumber(data.RollTickets[tostring(tabIndex)]) or 0
        data.RollTickets[tabIndex] = tickets
        data.RollTickets[tostring(tabIndex)] = nil

        if tickets &gt; 0 then
            -- 1. 永远优先扣除对应池子的免费次数；只有没有免费次数时才会进入阳光扣费分支。
            data.RollTickets[tabIndex] = tickets - 1
        elseif tabIndex == 1 then
            -- 第 1 页没有免费次数时，允许消耗 200K 阳光继续抽奖
            if (data.Coins or 0) &lt; ROLL_TAB1_CASH_COST then
                return false, "Not enough Sun!"
            end
            data.Coins -= ROLL_TAB1_CASH_COST
        else
            return false, "抽奖次数不足！"
        end
        
        -- 2. 获取真正的随机奖励
        local RollConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RollConfig"))
        local finalPrize = RollConfig.GetRandomPrize(tabIndex)
        
        -- 3. 发放种子奖励 (传入 suppressEffect = true，抑制立即弹出提示，让客户端在动画播完后再自己弹)
        PlayerDataManager.GiveSeed(player, finalPrize, 1, true)
        
        -- 4. 同步最新数据（更新 UI 上的次数和红点）
        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
        
        -- 5. 将结果返回给客户端用于播放转盘动画
        return true, finalPrize
    end
    local startNewbieGiftRF = ReplicatedStorage:FindFirstChild("StartNewbieGiftRF")
    if not startNewbieGiftRF then
        startNewbieGiftRF = Instance.new("RemoteFunction")
        startNewbieGiftRF.Name = "StartNewbieGiftRF"
        startNewbieGiftRF.Parent = ReplicatedStorage
    end
    startNewbieGiftRF.OnServerInvoke = function(player)
        local data = sessionData[player.UserId]
        -- 如果玩家存在，且计时未开始，则记录当前真实服务器时间
        if data and data.NewbieGiftStartTime == 0 then
            data.NewbieGiftStartTime = os.time()
            
            local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
            if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
            
            return true, data.NewbieGiftStartTime
        end
        return false, data and data.NewbieGiftStartTime or 0
    end
end

function PlayerDataManager.GetPlayerData(player) return sessionData[player.UserId] end

function PlayerDataManager.WaitForPlayerData(player, timeout)
    timeout = timeout or 10
    local startTime = os.clock()

    while player and player.Parent do
        local data = sessionData[player.UserId]
        if data then
            return data
        end

        if os.clock() - startTime &gt;= timeout then
            break
        end

        task.wait(0.1)
    end

    return sessionData[player.UserId]
end

function PlayerDataManager.ClearTransientPlotData(player)
    local data = sessionData[player.UserId]
    if not data then return end
    data.PlantedPlants = {}
    data.CombatPlants = {}
end

function PlayerDataManager.UpdatePlantedPlant(player, soilName, seedId, plantedTime)
    local data = sessionData[player.UserId]
    if not data then return end
    
    local existingPlant = data.PlantedPlants[soilName]
    local mutationLevel = existingPlant and existingPlant.Mutation
    
    if not mutationLevel then
        mutationLevel = 1
        if ItemConfig.MutationProb then
            local totalWeight = 0
            for _, weight in pairs(ItemConfig.MutationProb) do totalWeight += weight end
            local roll = math.random() * totalWeight
            local currentWeight = 0
            for level, weight in pairs(ItemConfig.MutationProb) do
                currentWeight += weight
                if roll &lt;= currentWeight then
                    mutationLevel = level
                    break
                end
            end
        end
    end

    data.PlantedPlants[soilName] = { 
        SeedId = seedId, 
        PlantedTime = plantedTime, 
        Mutation = mutationLevel 
    }
end

function PlayerDataManager.MarkPlantAsDropped(player, soilName)
    local data = sessionData[player.UserId]
    if not data or not data.PlantedPlants[soilName] then return end
    data.PlantedPlants[soilName].HasDropped = true
end

function PlayerDataManager.RemovePlantedPlant(player, soilName)
    local data = sessionData[player.UserId]
    if not data then return end
    data.PlantedPlants[soilName] = nil
end

-- 👇 增加了一个可选参数 suppressEffect 
function PlayerDataManager.GiveSeed(player, seedId, amount, suppressEffect)
    local data = sessionData[player.UserId]
    if not data then return end
 
    local found = false
    for _, seedData in ipairs(data.Inventory.Seeds) do
        if seedData.ID == seedId then 
            seedData.Quantity += amount
            found = true
            break 
        end
    end
    
    if not found then 
        table.insert(data.Inventory.Seeds, { ID = seedId, Quantity = amount }) 
    end

    if data.Hotbar then
        local itemKey = "Seed_" .. seedId
        local alreadyEquipped = false
        for _, v in ipairs(data.Hotbar) do
            if v == itemKey then
                alreadyEquipped = true
                break
            end
        end
        if not alreadyEquipped and #data.Hotbar &lt; 9 then
            table.insert(data.Hotbar, itemKey)
        end
    end

    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    
    -- 👇 如果被抑制了，就不在这里触发特效（比如抽奖需要等转盘转完再触发）
    if not suppressEffect then
        local effectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
        if effectRE then
            local itemDetail = ItemConfig.Seeds[seedId]
            local itemName = itemDetail and itemDetail.Name or seedId
            effectRE:FireClient(player, "Congratulations, you obtained " .. amount .. "x " .. itemName)
        end
    end
end

function PlayerDataManager.ConsumeSeed(player, seedId, amount)
    local data = sessionData[player.UserId]
    if not data or not data.Inventory or not data.Inventory.Seeds then return false end
    for i, seedData in ipairs(data.Inventory.Seeds) do
        if seedData.ID == seedId then
            if seedData.Quantity &gt;= amount then
                seedData.Quantity -= amount
                if seedData.Quantity &lt;= 0 then 
                    table.remove(data.Inventory.Seeds, i) 
                    if data.Hotbar then
                        for j = #data.Hotbar, 1, -1 do
                            local parts = string.split(data.Hotbar[j], "_")
                            if parts[1] == "Seed" and parts[2] == seedId then
                                table.remove(data.Hotbar, j)
                            end
                        end
                    end
                end
                local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
                return true
            end
            break
        end
    end
    return false
end

function PlayerDataManager.GivePlant(player, plantId, amount, mutationLevel)
   local data = sessionData[player.UserId]
    if not data then return end
    mutationLevel = mutationLevel or 1 
    
    local found = false
    for _, plantData in ipairs(data.Inventory.Plants) do
        if plantData.ID == plantId and (plantData.Mutation or 1) == mutationLevel then 
            plantData.Quantity += amount
            found = true
            break 
        end
    end
    
    if not found then 
        table.insert(data.Inventory.Plants, { ID = plantId, Quantity = amount, Mutation = mutationLevel }) 
    end
    
    if data.Hotbar then
        local itemKey = "Plant_" .. plantId .. "_" .. mutationLevel
        local alreadyEquipped = false
        for _, v in ipairs(data.Hotbar) do
            if v == itemKey then
                alreadyEquipped = true
                break
            end
        end
        if not alreadyEquipped and #data.Hotbar &lt; 9 then
            table.insert(data.Hotbar, itemKey)
        end
    end

    PlayerDataManager.UnlockMutation(player, plantId, mutationLevel)
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
end

function PlayerDataManager.UnlockMutation(player, plantId, mutationLevel)
    local data = sessionData[player.UserId]
    if not data then return end
    
    if not data.UnlockedMutations then data.UnlockedMutations = {} end
    if not data.UnlockedMutations[plantId] then data.UnlockedMutations[plantId] = {} end
    
    local isFirstTimeUnlock = not data.UnlockedMutations[plantId][mutationLevel]
    data.UnlockedMutations[plantId][mutationLevel] = true
    
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end

    if isFirstTimeUnlock then
        local playUnlockAnimRE = ReplicatedStorage:FindFirstChild("PlayUnlockAnimRE")
        if playUnlockAnimRE then 
            playUnlockAnimRE:FireClient(player, plantId, mutationLevel) 
        end
    end
end

function PlayerDataManager.ConsumeCoins(player, amount)
    local data = sessionData[player.UserId];
    if not data then return false end
    if data.Coins &gt;= amount then
        data.Coins -= amount
        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
        return true 
    end
    return false 
end

function PlayerDataManager.GiveCoins(player, amount)
    local data = sessionData[player.UserId];
    if not data then return end
    local finalAmount = amount
    if PlayerDataManager.IsX2SunActive(player) then
        finalAmount = amount * 2
    end
    data.Coins += finalAmount
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    return finalAmount
end

function PlayerDataManager.GiveCoinsRaw(player, amount)
    local data = sessionData[player.UserId];
    if not data then return end
    data.Coins += amount
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    return amount
end

function PlayerDataManager.IsX2SunActive(player)
    if not player then return false end
    if x2SunOwnershipCache[player.UserId] == true then
        return true
    end

    local ownsPass = false
    local success, result = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(player.UserId, X2_SUN_GAME_PASS_ID)
    end)
    if success then
        ownsPass = result == true
        if ownsPass then
            x2SunOwnershipCache[player.UserId] = true
        end
    else
        warn("[PlayerDataManager] Failed to check X2Sun game pass ownership for " .. player.Name .. ": " .. tostring(result))
    end

    return ownsPass
end

function PlayerDataManager.ConsumePlant(player, plantId, amount, mutationLevel)
    local data = sessionData[player.UserId]
    if not data or not data.Inventory or not data.Inventory.Plants then return false end
    mutationLevel = mutationLevel or 1
    
    for i, plantData in ipairs(data.Inventory.Plants) do
        if plantData.ID == plantId and (plantData.Mutation or 1) == mutationLevel then
            if plantData.Quantity &gt;= amount then
                plantData.Quantity -= amount
                if plantData.Quantity &lt;= 0 then 
                    table.remove(data.Inventory.Plants, i) 
                    if data.Hotbar then
                        for j = #data.Hotbar, 1, -1 do
                            local parts = string.split(data.Hotbar[j], "_")
                            local mLevel = tonumber(parts[3]) or 1
                            if parts[1] == "Plant" and parts[2] == plantId and mLevel == mutationLevel then
                                table.remove(data.Hotbar, j)
                            end
                        end
                    end
                end
                local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
                return true
            end
            break
        end
    end
    return false
end

function PlayerDataManager.UnlockNextLevel(player, completedLevelId)
    local data = sessionData[player.UserId]
    if not data then return end
    
    -- 只有当玩家打通了他们当前的最高关卡时，才需要升级和更新 UI
    if completedLevelId &gt;= (data.UnlockedLevel or 1) then
        data.UnlockedLevel = completedLevelId + 1
        
        -- 🌟 【新增：实时更新玩家头顶的最高关卡 UI】
        local character = player.Character
        if character then
            local head = character:FindFirstChild("Head")
            if head then
                local titleGui = head:FindFirstChild("PlayerTitleGui")
                if titleGui then
                    local textLabel = titleGui:FindFirstChildWhichIsA("TextLabel")
                    if textLabel then
                        -- 直接显示当前解锁层数
                        local maxCleared = data.UnlockedLevel or 1
                        textLabel.Text = "MAX  " .. tostring(maxCleared)
                    end
                end
            end
        end

        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    end
end

function PlayerDataManager.AddCombatPlant(player, gridName, plantId, hp, mutationLevel)
    local data = sessionData[player.UserId]
    if data and data.CombatPlants then
        data.CombatPlants[gridName] = { PlantId = plantId, Mutation = mutationLevel or 1 }
    end
end

function PlayerDataManager.UpdateCombatPlantHP(player, gridName, hp) end

function PlayerDataManager.RemoveCombatPlant(player, gridName)
    local data = sessionData[player.UserId]
    if data and data.CombatPlants then data.CombatPlants[gridName] = nil end
end

function PlayerDataManager.UnlockSeed(player, seedId)
    local data = sessionData[player.UserId]
    if not data then return end
    if not data.UnlockedSeeds then data.UnlockedSeeds = {} end
    data.UnlockedSeeds[seedId] = true
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
end

function PlayerDataManager.ApplyBattleRewards(player, coins, seeds)
    local data = sessionData[player.UserId]
    if not data then return end
    PlayerDataManager.GiveCoins(player, coins)
    if seeds &gt; 0 then PlayerDataManager.GiveSeed(player, "RandomSeed", seeds) end
end

function PlayerDataManager.AddTotalSun(player, amount)
    local data = sessionData[player.UserId]
    if data then
        data.TotalSun = (data.TotalSun or 0) + amount
        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    end
end

function PlayerDataManager.CollectAllSun(player)
    local data = sessionData[player.UserId]
    if data and data.TotalSun and data.TotalSun &gt; 0 then
        local amount = data.TotalSun
        local finalAmount = amount
        if PlayerDataManager.IsX2SunActive(player) then
            finalAmount = amount * 2
        end
        data.Coins += finalAmount 
        data.TotalSun = 0    
        
        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
        
        AnalyticsService:LogEconomyEvent(
            player, 
            Enum.AnalyticsEconomyFlowType.Source, 
            "Coins", 
            finalAmount, 
            data.Coins,
            Enum.AnalyticsEconomyTransactionType.Gameplay.Name, 
            "Sunflower_Collect" 
        )
        return finalAmount
    end
    return 0
end

function PlayerDataManager.GetUnlockedPlots(player)
    local data = sessionData[player.UserId]
    return data and data.UnlockedPlots or 4
end

function PlayerDataManager.IncrementUnlockedPlots(player)
    local data = sessionData[player.UserId]
    if data then
        data.UnlockedPlots = (data.UnlockedPlots or 4) + 1
        local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
        if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    end
end

function PlayerDataManager.GrantSignInReward(player, day)
    local rewardData = SignInRewardConfig[day]
    if not rewardData then return end
    
    -- 根据配置的 RewardType 发放对应的奖励
    if rewardData.RewardType == "Coins" then
        PlayerDataManager.GiveCoins(player, rewardData.Amount)
    elseif rewardData.RewardType == "Seed" then
        PlayerDataManager.GiveSeed(player, rewardData.ItemId, rewardData.Amount)
    elseif rewardData.RewardType == "Sun" then
        PlayerDataManager.AddTotalSun(player, rewardData.Amount)
    end
end

local claimAllBattleRF = Instance.new("RemoteFunction")
claimAllBattleRF.Name = "ClaimAllBattleRF"
claimAllBattleRF.Parent = ReplicatedStorage

claimAllBattleRF.OnServerInvoke = function(player)
    local data = PlayerDataManager.GetPlayerData(player)
    if not data then return false, "Loading data..." end
    
    local currentDays = data.SignInDays or 0
    if currentDays &gt;= 7 then return false, "Already claimed all" end
    
    for day = currentDays + 1, 7 do
        PlayerDataManager.GrantSignInReward(player, day)
    end
    
    data.SignInDays = 7
    data.LastSignInTime = os.time()
    
    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
    
    return true, "Claim successful with one click!"
end

local claimSignInRF = ReplicatedStorage:FindFirstChild("ClaimSignInRF")
if not claimSignInRF then
    claimSignInRF = Instance.new("RemoteFunction")
    claimSignInRF.Name = "ClaimSignInRF"
    claimSignInRF.Parent = ReplicatedStorage
end

claimSignInRF.OnServerInvoke = function(player)
    local data = sessionData[player.UserId]
    if not data then return false end

    local signInDays = data.SignInDays or 0
    if signInDays &gt;= 7 then return false end 

    local lastTime = data.LastSignInTime or 0
    local isClaimedToday = false
    
    if lastTime &gt; 0 then
        local lastDate = os.date("*t", lastTime)
        local currDate = os.date("*t", os.time())
        isClaimedToday = (lastDate.year == currDate.year and lastDate.month == currDate.month and lastDate.day == currDate.day)
    end

    if isClaimedToday then return false end 

    data.SignInDays = signInDays + 1
    data.LastSignInTime = os.time()
    
    PlayerDataManager.GrantSignInReward(player, data.SignInDays)

    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end

    return true
end

local claimLevelRewardRF = ReplicatedStorage:FindFirstChild("ClaimLevelRewardRF")
if not claimLevelRewardRF then
    claimLevelRewardRF = Instance.new("RemoteFunction")
    claimLevelRewardRF.Name = "ClaimLevelRewardRF"
    claimLevelRewardRF.Parent = ReplicatedStorage
end

claimLevelRewardRF.OnServerInvoke = function(player, targetLevel)
    local data = sessionData[player.UserId]
    if not data then return false, "Data still loading..." end

    if not data.ClaimedAchieve then data.ClaimedAchieve = {} end

    local currentUnlocked = data.UnlockedLevel or 1
    if currentUnlocked &lt;= targetLevel then
        return false, "Progress not enough to claim!"
    end

    if data.ClaimedAchieve[tostring(targetLevel)] then
        return false, "You have already claimed this reward！"
    end

    local LevelRewardConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("LevelRewardConfig"))
    local rewardData = LevelRewardConfig[targetLevel]
    if not rewardData then return false, "Configuration does not exist" end

    local msg = "Reward Claimed: "
    if rewardData.Seed then
        PlayerDataManager.GiveSeed(player, rewardData.Seed, rewardData.SeedCount or 1)
        msg = msg .. (rewardData.SeedCount or 1) .. "x " .. rewardData.Seed .. " "
    end
    if rewardData.Sun then
        PlayerDataManager.AddTotalSun(player, rewardData.Sun)
        msg = msg .. rewardData.Sun .. " Sun"
    end

    data.ClaimedAchieve[tostring(targetLevel)] = true

    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end

    return true, msg
end


return PlayerDataManager</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BaseMerchantService</string>
            <string name="Source">-- src/server/Services/BaseMerchantService.luau
local BaseMerchantService = {}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local PlayerDataManager = require(script.Parent.Parent:WaitForChild("PlayerDataManager"))

local REFRESH_INTERVAL = 180 -- 3分钟 (180秒)
local COIN_ICON_ID = "rbxassetid://102426033120992" -- 价格图标 ID

-- 记录每个玩家基地的商人状态
local activeMerchants = {}

-- 价格数字缩写格式化函数
local function FormatPrice(n)
    if not n then return "0" end
    if n &gt;= 1e9 then
        local v = n / 1e9
        return (v == math.floor(v) and tostring(v) or string.format("%.1f", v)) .. "B"
    elseif n &gt;= 1e6 then
        local v = n / 1e6
        return (v == math.floor(v) and tostring(v) or string.format("%.1f", v)) .. "M"
    elseif n &gt;= 1e3 then
        local v = n / 1e3
        return (v == math.floor(v) and tostring(v) or string.format("%.1f", v)) .. "K"
    else
        return tostring(n)
    end
end

-- 辅助函数：获取玩家当前的地块
local function GetPlayerPlot(userId)
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:GetAttribute("OwnerId") == userId then
            return plot
        end
    end
    return nil
end

-- 核心函数：在基地生成随机植物
local function SpawnMerchant(player, plot)
    -- 清理旧模型
    if activeMerchants[player.UserId] and activeMerchants[player.UserId].Model then
        activeMerchants[player.UserId].Model:Destroy()
    end

    local baseModel = plot:FindFirstChild("Base")
    if not baseModel or not baseModel:IsA("Model") then 
        return 
    end

    for _, child in ipairs(baseModel:GetChildren()) do
        if string.find(child.Name, "BaseMerchant_") then
            child:Destroy()
        end
    end
    
-- 1. 随机选择一个植物 (改为从限时稀有池 BaseLimitedSaleKey 中精准抽取)
    local seedKeys = ItemConfig.BaseLimitedSaleKey
    if not seedKeys or #seedKeys == 0 then return end
    
    local randomSeedId = seedKeys[math.random(1, #seedKeys)]
    local seedDetail = ItemConfig.Seeds[randomSeedId]
    
    -- 获取该植物对应的待机动画配置
    local plantConfig = ItemConfig.Plants[randomSeedId]
    local targetAnimId = plantConfig and plantConfig.IdleAnimId

    -- 2. 获取植物模型
    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    local realModel = itemModelsFolder and (itemModelsFolder:FindFirstChild(randomSeedId .. "_Plant") or itemModelsFolder:FindFirstChild(randomSeedId))
    
    local displayModel
    if realModel then
        displayModel = realModel:Clone()
    else
        displayModel = Instance.new("Part")
        displayModel.Size = Vector3.new(2, 2, 2)
        displayModel.Color = Color3.fromRGB(85, 255, 127)
    end
    displayModel.Name = "BaseMerchant_" .. player.UserId

    -- 处理物理状态与动画兼容
    for _, node in ipairs(displayModel:GetDescendants()) do
        if node:IsA("BasePart") then
            node.CanCollide = false
            node.CanQuery = false
            
            if targetAnimId and displayModel.PrimaryPart and node ~= displayModel.PrimaryPart then
                node.Anchored = false
            else
                node.Anchored = true
            end

        elseif node:IsA("ParticleEmitter") or node:IsA("Light") or node:IsA("Beam") or node:IsA("Highlight") or node:IsA("Trail") then
            node.Enabled = false 
        end
    end

    -- 3. 移动至 Base 正上方
    local baseCFrame, baseSize = baseModel:GetBoundingBox()
    local spawnCFrame = CFrame.new(baseCFrame.Position + Vector3.new(0, baseSize.Y / 2 + 1.2, 0))
    displayModel:PivotTo(spawnCFrame)
    displayModel.Parent = baseModel

    local modelRoot = displayModel.PrimaryPart or (displayModel:IsA("BasePart") and displayModel) or displayModel:FindFirstChildWhichIsA("BasePart")
    if not modelRoot then displayModel:Destroy(); return end

    -- 4. 加载并播放待机动画
    if targetAnimId then
        local animController = displayModel:FindFirstChildOfClass("AnimationController") or displayModel:FindFirstChildOfClass("Humanoid")
        if not animController then 
            animController = Instance.new("AnimationController")
            animController.Parent = displayModel 
        end
        local animator = animController:FindFirstChildOfClass("Animator")
        if not animator then 
            animator = Instance.new("Animator")
            animator.Parent = animController 
        end
        
        local anim = Instance.new("Animation")
        anim.AnimationId = targetAnimId
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Idle
        track.Looped = true
        track:Play() 
    end

    -- 5. 计算价格
    local price = math.floor((seedDetail.BuyPrice or 100) * 0.8)
    local isSpecial = (seedDetail.IsSellable == false)

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Buy " .. (seedDetail.Name or randomSeedId)
    prompt.ObjectText = "Price: " .. FormatPrice(price)
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.MaxActivationDistance = 6
    prompt.RequiresLineOfSight = false
    prompt.Parent = modelRoot

    -- 6. UI改为固定物理大小（近大远小）
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(4.5, 0, 3, 0) 
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 60 
    billboard.Parent = modelRoot

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = billboard

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Padding = UDim.new(0.02, 0)
    layout.Parent = frame

    -- 植物名称
    local nameTag = Instance.new("TextLabel")
    nameTag.Size = UDim2.new(1, 0, 0.25, 0)
    nameTag.BackgroundTransparency = 1
    nameTag.Text = seedDetail.Name or randomSeedId
    nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameTag.TextStrokeTransparency = 0
    nameTag.TextScaled = true
    nameTag.Font = Enum.Font.FredokaOne
    nameTag.LayoutOrder = 0
    nameTag.Parent = frame

    -- 特殊标签
    if isSpecial then
        local specialTag = Instance.new("TextLabel")
        specialTag.Size = UDim2.new(1, 0, 0.2, 0)
        specialTag.BackgroundTransparency = 1
        specialTag.Text = "★ SPECIAL ★"
        specialTag.TextColor3 = Color3.fromRGB(170, 85, 255)
        specialTag.TextStrokeTransparency = 0
        specialTag.TextScaled = true
        specialTag.Font = Enum.Font.FredokaOne
        specialTag.LayoutOrder = 1
        specialTag.Parent = frame
    end

    -- 图标与价格容器
    local priceContainer = Instance.new("Frame")
    priceContainer.Size = UDim2.new(1, 0, 0.25, 0)
    priceContainer.BackgroundTransparency = 1
    priceContainer.LayoutOrder = 2
    priceContainer.Parent = frame

    local priceLayout = Instance.new("UIListLayout")
    priceLayout.FillDirection = Enum.FillDirection.Horizontal
    priceLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    priceLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    priceLayout.Padding = UDim.new(0.05, 0)
    priceLayout.Parent = priceContainer

    local coinIcon = Instance.new("ImageLabel")
    coinIcon.Size = UDim2.new(1, 0, 1, 0)
    coinIcon.SizeConstraint = Enum.SizeConstraint.RelativeYY 
    coinIcon.BackgroundTransparency = 1
    coinIcon.Image = COIN_ICON_ID
    coinIcon.Parent = priceContainer

    local priceText = Instance.new("TextLabel")
    priceText.Size = UDim2.new(0.6, 0, 1, 0)
    priceText.BackgroundTransparency = 1
    priceText.Text = FormatPrice(price)
    priceText.TextColor3 = Color3.fromRGB(255, 215, 0)
    priceText.TextStrokeTransparency = 0
    priceText.TextScaled = true
    priceText.Font = Enum.Font.FredokaOne
    priceText.Parent = priceContainer

    -- 倒计时
    local timerTag = Instance.new("TextLabel")
    timerTag.Size = UDim2.new(1, 0, 0.25, 0)
    timerTag.BackgroundTransparency = 1
    timerTag.Text = "03:00 Post update"
    timerTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    timerTag.TextStrokeTransparency = 0
    timerTag.TextScaled = true
    timerTag.Font = Enum.Font.FredokaOne
    timerTag.LayoutOrder = 3
    timerTag.Parent = frame

    -- 保存商人状态
    activeMerchants[player.UserId] = {
        Model = displayModel,
        SeedId = randomSeedId,
        Price = price,
        EndTime = os.time() + REFRESH_INTERVAL,
        TimerText = timerTag,
        PriceText = priceText, -- 🌟 记录价格UI以便购买后修改
        CoinIcon = coinIcon,   -- 🌟 记录图标UI以便购买后隐藏
        IsRefreshing = false,
        IsSold = false         -- 🌟 新增售罄状态
    }

    -- 7. 购买逻辑
    prompt.Triggered:Connect(function(triggerPlayer)
        if triggerPlayer.UserId ~= player.UserId then return end 
        
        local currentShop = activeMerchants[player.UserId]
        if not currentShop or currentShop.Model ~= displayModel then return end
        if currentShop.IsSold then return end -- 🌟 防止连点

        if PlayerDataManager.ConsumeCoins(player, currentShop.Price) then
            -- 扣费成功，给种子
            PlayerDataManager.GiveSeed(player, currentShop.SeedId, 1)
            
            -- ==========================================
            -- 🌟 核心修改：购买后不直接销毁，而是进入“售罄并等待”状态
            -- ==========================================
            currentShop.IsSold = true
            prompt:Destroy() -- 销毁交互按键，防止重复购买

            -- 隐藏植物实体模型 (但保留结构让UI继续显示)
            for _, part in ipairs(displayModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = 1
                end
            end

            -- 隐藏金币图标，并将价格文字改为 "SOLD OUT"
            if currentShop.CoinIcon then currentShop.CoinIcon.Visible = false end
            if currentShop.PriceText then 
                currentShop.PriceText.Text = "SOLD OUT"
                currentShop.PriceText.TextColor3 = Color3.fromRGB(180, 180, 180) -- 变成灰色
            end
            
            -- 📢 注意：这里不再将 activeMerchants[player.UserId] 设为 nil！
            -- 底下的 Init() 心跳循环会自动接管，等到倒计时结束时它才会触发刷新机制！
        else
            -- 余额不足提示
            local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
            if showNotifRE then
                showNotifRE:FireClient(player, "Notice", "Not enough coins!")
            end
        end
    end)
end

function BaseMerchantService.Init()
    task.spawn(function()
        while task.wait(1) do
            local currentTime = os.time()
            for _, player in ipairs(Players:GetPlayers()) do
                local plot = GetPlayerPlot(player.UserId)
                local mData = activeMerchants[player.UserId]

                if plot then
                    if not mData then
                        SpawnMerchant(player, plot)
                    elseif currentTime &gt;= mData.EndTime then
                        if not mData.IsRefreshing then
                            mData.IsRefreshing = true
                            if mData.TimerText then mData.TimerText.Text = "Refreshing..." end
                            task.delay(1, function()
                                SpawnMerchant(player, plot)
                            end)
                        end
                    else
                        -- 🌟 只要还没到时间，就会一直更新倒计时！即使已经买空了！
                        local timeLeft = math.max(0, mData.EndTime - currentTime)
                        if mData.TimerText then
                            mData.TimerText.Text = string.format("%02d:%02d Post update", math.floor(timeLeft / 60), timeLeft % 60)
                        end
                    end
                else
                    if mData and mData.Model then mData.Model:Destroy() end
                    activeMerchants[player.UserId] = nil
                end
            end
        end
    end)
    
    print("服务端：BaseMerchantService (延迟刷新版) 加载完毕！")
end

return BaseMerchantService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BaseSunflowerService</string>
            <string name="Source">-- src/server/Services/BaseSunflowerService.luau
local BaseSunflowerService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

-- 专门用来追踪所有玩家的基地向日葵，方便实时更新
local activeSunflowers = {}

-- ==========================================
-- [核心算法] 计算缩放并更新悬浮 UI
-- ==========================================
local function UpdateSunflowerScale(sunflower, totalSun)
    if not sunflower or not sunflower:IsA("Model") then return end
    local minScale = 1
    local maxScale = 50
    local threshold = 1000000
    
    -- 太阳数量为0时，自动缩回1倍
    local scale = minScale + (math.min(totalSun, threshold) / threshold) * (maxScale - minScale)
    
    if sunflower.PrimaryPart then
        sunflower:ScaleTo(scale)
    end

    -- 🌟 修复：去我们创建的虚拟独立 UI 锚点方块上寻找 UI
    local plot = sunflower.Parent
    if not plot then return end
    
    local collectSunPart = nil
    local elementBtn = plot:FindFirstChild("ElementButton", true)
    if elementBtn then collectSunPart = elementBtn:FindFirstChild("CollectSun") end
    
    if not collectSunPart then
        collectSunPart = plot:FindFirstChild("CollectSun")
    end
    
    if collectSunPart then
        local guiAnchor = collectSunPart:FindFirstChild("SunGuiAnchor")
        if guiAnchor then
            -- 🌟 遍历前后两面的 SurfaceGui 同步更新数值
            for _, gui in ipairs(guiAnchor:GetChildren()) do
                if gui:IsA("SurfaceGui") and gui.Name == "SunCounterGui" then
                    local container = gui:FindFirstChild("Container")
                    local textLabel = container and container:FindFirstChild("SunText")
                    if textLabel then
                        local displaySun = totalSun
                        -- 大数值转换 (K, M)
                        if totalSun &gt;= 1000000 then
                            displaySun = string.format("%.1fM", totalSun / 1000000)
                        elseif totalSun &gt;= 1000 then
                            displaySun = string.format("%.1fK", totalSun / 1000)
                        end
                        textLabel.Text = tostring(displaySun)
                    end
                end
            end
        end
    end
end

-- ==========================================
-- [杀毒软件] 强行隐藏特效外壳
-- ==========================================
local function HideAllMutations(model)
    local effectNames = { "Glow", "Lightning", "HolyLight" }
    for _, fxName in ipairs(effectNames) do
        for _, node in ipairs(model:GetDescendants()) do
            if node.Name == fxName then
                if node:IsA("BasePart") then node.Transparency = 1
                elseif node:IsA("ParticleEmitter") or node:IsA("Light") or node:IsA("Beam") or node:IsA("Highlight") or node:IsA("Trail") then node.Enabled = false end
                for _, child in ipairs(node:GetDescendants()) do
                    if child:IsA("BasePart") then child.Transparency = 1
                    elseif child:IsA("ParticleEmitter") or child:IsA("Light") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("Trail") then child.Enabled = false end
                end
            end
        end
    end
end

-- ==========================================
-- [主入口] 生成基地向日葵
-- ==========================================
function BaseSunflowerService.SpawnSunflower(player, plot)
    local collectSunPart = nil
    local elementBtn = plot:FindFirstChild("ElementButton", true)
    if elementBtn then collectSunPart = elementBtn:FindFirstChild("CollectSun") end
    
    if not collectSunPart then
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc.Name == "CollectSun" and desc:IsA("BasePart") then collectSunPart = desc; break end
        end
    end

    if collectSunPart then
        collectSunPart.Anchored = true

        local sunflowerConfig = ItemConfig.Plants and ItemConfig.Plants["Sunflower"]
        local itemModels = ReplicatedStorage:WaitForChild("ItemModels")
        local modelTemplate = itemModels:FindFirstChild("Sunflower_Plant") or itemModels:FindFirstChild("Sunflower")
        
        if modelTemplate then
            local sunflower = modelTemplate:Clone()
            sunflower.Name = "BaseSunflower"
            sunflower:SetAttribute("OwnerId", player.UserId)
            
            if not sunflower.PrimaryPart then sunflower.PrimaryPart = sunflower:FindFirstChildWhichIsA("BasePart", true) end

            local hasAnim = sunflowerConfig and sunflowerConfig.IdleAnimId and sunflowerConfig.IdleAnimId ~= ""
            
            -- [打钢筋] 防掉落与动画适配
            for _, part in ipairs(sunflower:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    if hasAnim and sunflower.PrimaryPart and part == sunflower.PrimaryPart then
                        part.Anchored = true
                    else
                        part.Anchored = not hasAnim
                    end
                end
            end
            
            HideAllMutations(sunflower)
            if sunflower.PrimaryPart then sunflower.PrimaryPart.Transparency = 1 end

            local targetCFrame = collectSunPart.CFrame * CFrame.new(0, 1.5, 0)
            sunflower:PivotTo(targetCFrame) 
            sunflower.Parent = plot
            
            -- ==========================================
            -- [创建悬浮UI (🌟 完美静止挂载中枢：悬空+防遮挡+双面显示)]
            -- ==========================================
            if collectSunPart then
                -- 1. 销毁可能存在的旧独立锚点
                local oldAnchor = collectSunPart:FindFirstChild("SunGuiAnchor")
                if oldAnchor then oldAnchor:Destroy() end

                -- 2. 创建一个绝对静止、透明的不碰撞看板部件
                local guiAnchor = Instance.new("Part")
                guiAnchor.Name = "SunGuiAnchor"
                guiAnchor.Size = Vector3.new(4, 1.5, 0.05) 
                guiAnchor.Transparency = 1       -- 隐形
                guiAnchor.Anchored = true        -- 静止不动
                guiAnchor.CanCollide = false     -- 无碰撞
                guiAnchor.CanQuery = false       -- 防鼠标点击拦截
                guiAnchor.CanTouch = false

                -- 3. 悬浮在 CollectSun 上方固定 5 格高空（可根据视线随意微调高度）
                guiAnchor.CFrame = collectSunPart.CFrame * CFrame.new(0, 5, 0)
                guiAnchor.Parent = collectSunPart

                -- 4. 🌟 双面渲染渲染逻辑：同时渲染正面和背面，防止转镜头时转到反面看不见
                local renderFaces = { Enum.NormalId.Front, Enum.NormalId.Back }
                
                for _, faceDirection in ipairs(renderFaces) do
                    local sGui = Instance.new("SurfaceGui")
                    sGui.Name = "SunCounterGui"
                    sGui.Face = faceDirection
                    sGui.LightInfluence = 0          -- 纯亮发光字，不受全地图阴影影响
                    
                    -- 🌟 核心修复：开启 AlwaysOnTop！
                    -- 这样即便向日葵模型膨胀把这个锚点Part整个吞进肚子里，UI 依然会雷打不动地穿透渲染在最前面！
                    sGui.AlwaysOnTop = true 
                    sGui.CanvasSize = Vector2.new(400, 150)
                    
                    local container = Instance.new("Frame")
                    container.Name = "Container"
                    container.Size = UDim2.new(1, 0, 1, 0)
                    container.BackgroundTransparency = 1
                    container.Parent = sGui
                    
                    local icon = Instance.new("ImageLabel")
                    icon.Name = "SunIcon"
                    icon.Size = UDim2.new(0, 100, 0, 100)
                    icon.Position = UDim2.new(0, 30, 0.5, -50)
                    icon.BackgroundTransparency = 1
                    icon.Image = "rbxassetid://102426033120992"
                    icon.ScaleType = Enum.ScaleType.Fit
                    icon.Parent = container
                    
                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "SunText"
                    textLabel.Size = UDim2.new(1, -150, 1, 0)
                    textLabel.Position = UDim2.new(0, 140, 0, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.Text = "0"
                    textLabel.TextColor3 = Color3.fromRGB(255, 230, 50)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.TextScaled = true
                    textLabel.TextXAlignment = Enum.TextXAlignment.Left
                    textLabel.Parent = container
                    
                    sGui.Parent = guiAnchor
                end
            end

            -- ==========================================
            -- [🌟 修改核心：自动靠近底座方块收割]
            -- ==========================================
            local oldPrompt = collectSunPart:FindFirstChild("HarvestPrompt")
            if oldPrompt then oldPrompt:Destroy() end

            task.spawn(function()
                local isHarvesting = false
                local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
                local TweenService = game:GetService("TweenService")
                local Debris = game:GetService("Debris")
                local harvestRE = ReplicatedStorage:FindFirstChild("HarvestSunRE")
                
                while collectSunPart and collectSunPart.Parent and sunflower and sunflower.Parent do
                    task.wait(0.3)

                    if isHarvesting then continue end

                    local character = player.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    if not rootPart then continue end

                    local distance = (rootPart.Position - collectSunPart.Position).Magnitude
                    
                    if distance &lt;= 15 then 
                        local pData = PlayerDataManager.GetPlayerData(player)
                        
                        -- 如果累积了阳光，开启由浅入深的丰收演出
                        if pData and (pData.TotalSun or 0) &gt; 0 then
                            isHarvesting = true
                            local amount = pData.TotalSun
                            
                            -- 1. 立即清空基地的暂存阳光，让向日葵头顶的 3D 看板计数器立刻归零
                            pData.TotalSun = 0
                            local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                            if updateInventoryRE then updateInventoryRE:FireClient(player, pData) end
                            
                            -- 2. 计算阳光切片数量 (最少切成 5 个，最多 20 个)
                            local numSuns = math.clamp(math.floor(amount / 50), 5, 20) 
                            local rewardPerSun = math.floor(amount / numSuns) -- 每一个球代表的实际面值
                            local remainder = amount % numSuns -- 无法整除的余数留给最后一个球
                            
                            local sunParts = {}
                            
                            for i = 1, numSuns do
                                -- 创建隐形的物理外壳，用来承载碰撞和弹跳效果
                                local sunPart = Instance.new("Part")
                                sunPart.Size = Vector3.new(1.3, 1.3, 1.3)
                                sunPart.Shape = Enum.PartType.Ball
                                sunPart.Transparency = 1 -- 🌟 【核心修改】：完全隐藏原本丑陋的黄球外壳
                                sunPart.CanCollide = true -- 允许在地上由于重力自然弹跳
                                sunPart.Position = collectSunPart.Position + Vector3.new(0, 3, 0)
                                
                                -- 🌟 【核心修改】：挂载 BillboardGui，渲染你提供的专属 2D 阳光图片
                                local billboard = Instance.new("BillboardGui")
                                billboard.Size = UDim2.new(2.5, 0, 2.5, 0) -- 在 3D 世界中的渲染大小
                                billboard.AlwaysOnTop = true -- 穿透植物和方块，防止被埋进地里
                                billboard.Parent = sunPart
                                
                                local imageLabel = Instance.new("ImageLabel")
                                imageLabel.Size = UDim2.new(1, 0, 1, 0)
                                imageLabel.BackgroundTransparency = 1
                                imageLabel.Image = "rbxassetid://102426033120992" -- 🌟 使用你提供的阳光材质图片
                                imageLabel.Parent = billboard
                                
                                -- 给阳光赋予一个向上和向四周喷涌开来的 Velocity 物理爆发力
                                local rx = (math.random() - 0.5) * 35
                                local ry = math.random(25, 55)
                                local rz = (math.random() - 0.5) * 35
                                sunPart.Velocity = Vector3.new(rx, ry, rz)
                                
                                sunPart.Parent = Workspace
                                table.insert(sunParts, sunPart)
                                Debris:AddItem(sunPart, 7) -- 防残留垃圾清理锁
                                
                                -- 产生一个极短的间隔，做出源源不断往外“吐”阳光的喷泉喷发感
                                task.wait(0.06) 
                            end
                            
                            -- 3. 让这一地金灿灿的 2D 阳光在地上自然散落并逗留 2 秒钟
                            task.wait(2)
                            
                            -- 4. 🌟【核心修改】：让阳光像小蛇一样排成一列，逐一吸附到玩家身上，并分批加钱！
                            for i, sun in ipairs(sunParts) do
                                if sun and sun.Parent then
                                    local charNow = player.Character
                                    local rootNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
                                    
                                    if rootNow then
                                        sun.CanCollide = false -- 关闭物理碰撞，准备凌空飞行
                                        sun.Anchored = true 
                                        
                                        -- 精确计算当前这颗阳光到身体时要加的额度
                                        local currentReward = rewardPerSun
                                        if i == numSuns then
                                            currentReward = rewardPerSun + remainder -- 最后一颗补齐余数，确保一分不差
                                        end
                                        
                                        -- 播放飞向玩家胸口的丝滑动画
                                        local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                                        local tween = TweenService:Create(sun, tweenInfo, {Position = rootNow.Position})
                                        tween:Play()
                                        
                                        -- 重点：当该颗阳光“触碰”到玩家身体的瞬间，立刻结算这一部分的金币
                                        tween.Completed:Connect(function()
                                            sun:Destroy()
                                            if player and player.Parent then
                                                -- 🌟【核心重构】：逐个递增金币，而不是一次性给完！屏幕上的数字会疯狂跳动！
                                                local finalReward = PlayerDataManager.GiveCoins(player, currentReward)
                                                local isX2Sun = finalReward == currentReward * 2
                                                
                                                -- 通知客户端播放单次加钱的飘字音效和动效
                                                if harvestRE then 
                                                    harvestRE:FireClient(player, currentReward, rootNow.Position, isX2Sun) 
                                                end
                                            end
                                        end)
                                        
                                        -- 🌟 每颗阳光出发飞行的间隔时间。这个时间能产生“流水般吸入身体”的连贯节奏
                                        task.wait(0.08) 
                                    else
                                        sun:Destroy()
                                    end
                                end
                            end
                            
                            -- 5. 等待最后一颗阳光也安全到账，并记录一次总的后台埋点
                            task.wait(0.4)
                            local AnalyticsService = game:GetService("AnalyticsService")
                            AnalyticsService:LogEconomyEvent(
                                player, 
                                Enum.AnalyticsEconomyFlowType.Source, 
                                "Coins", 
                                amount, 
                                pData.Coins,
                                Enum.AnalyticsEconomyTransactionType.Gameplay.Name, 
                                "Sunflower_Collect" 
                            )
                            
                            isHarvesting = false
                        end
                    end
                end
            end)

            -- ==========================================
            -- [装载动画]
            -- ==========================================
            if hasAnim then
                local animController = sunflower:FindFirstChildOfClass("AnimationController") or sunflower:FindFirstChildOfClass("Humanoid")
                if not animController then animController = Instance.new("AnimationController"); animController.Parent = sunflower end
                
                local animator = animController:FindFirstChildOfClass("Animator")
                if not animator then animator = Instance.new("Animator"); animator.Parent = animController end

                local anim = Instance.new("Animation")
                anim.AnimationId = sunflowerConfig.IdleAnimId
                local track = animator:LoadAnimation(anim)
                track.Looped = true;
                track:Play()
            end
            
            local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
            local pData = PlayerDataManager.GetPlayerData(player)
            UpdateSunflowerScale(sunflower, pData and pData.TotalSun or 0)
            
            -- 加入追踪列表
            activeSunflowers[player.UserId] = sunflower
            print("【向日葵系统】✅ 生成成功！自动收割功能已实装！")
        end
    end
end

function BaseSunflowerService.Init()
    if not ReplicatedStorage:FindFirstChild("HarvestSunRE") then
        local re = Instance.new("RemoteEvent")
        re.Name = "HarvestSunRE"
        re.Parent = ReplicatedStorage
    end

    task.spawn(function()
        local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
        while true do
            task.wait(1)
            for userId, sunflower in pairs(activeSunflowers) do
                local player = Players:GetPlayerByUserId(userId)
                if player and sunflower and sunflower.Parent then
                    local pData = PlayerDataManager.GetPlayerData(player)
                    if pData then
                        UpdateSunflowerScale(sunflower, pData.TotalSun or 0)
                    end
                else
                    activeSunflowers[userId] = nil
                end
            end
        end
    end)
    print("服务端：BaseSunflowerService 独立模块加载完毕！")
end

return BaseSunflowerService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">CoinDropService</string>
            <string name="Source">-- src/server/Services/CoinDropService.luau
local CoinDropService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local AnalyticsService = game:GetService("AnalyticsService")
function CoinDropService.Init()
    local playDropRE = Instance.new("RemoteEvent")
    playDropRE.Name = "PlayCoinDropRE"
    playDropRE.Parent = ReplicatedStorage

    local pickupRE = Instance.new("RemoteEvent")
    pickupRE.Name = "PickupCoinRE"
    pickupRE.Parent = ReplicatedStorage

    -- [🌟 核心修改：接收布尔值，判断是向日葵收集的还是玩家收集的]
   pickupRE.OnServerEvent:Connect(function(player, amount, isSunflowerCollect)
        if type(amount) == "number" and amount &gt; 0 then
            if isSunflowerCollect then
                -- 如果是向日葵自动吸纳的，增加阳光总量
                PlayerDataManager.AddTotalSun(player, amount)
            else
                -- 玩家手动捡起的，加金币
                PlayerDataManager.GiveCoins(player, amount)
                
                -- 👇 =================【新增埋点代码】================= 👇
                local data = PlayerDataManager.GetPlayerData(player)
                local currentCoins = data and data.Coins or 0
                AnalyticsService:LogEconomyEvent(
                    player, 
                    Enum.AnalyticsEconomyFlowType.Source, 
                    "Coins", 
                    amount, 
                    currentCoins, 
                    Enum.AnalyticsEconomyTransactionType.Gameplay.Name, 
                    "ZombieDrop_Pickup" 
                )
                -- 👆 ================================================== 👆
            end
        end
    end)

    print("服务端：CoinDropService 加载完毕！阳光吸纳与金币区分已实装！")
end

function CoinDropService.DropCoins(player, dropPosition, coinCount, totalValue)
    if not player then return end
    
    local playDropRE = ReplicatedStorage:FindFirstChild("PlayCoinDropRE")
    if playDropRE then
        playDropRE:FireClient(player, dropPosition, coinCount, totalValue)
    end
end

return CoinDropService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source">-- src/server/Services/CombatService.luau
local CombatService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local EffectUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EffectUtil"))
local PlantCombatAI = require(script.Parent.PlantCombatAI)

-- ==========================================
-- [核心：生成战斗植物]
-- ==========================================
function CombatService.SpawnCombatPlant(lawnPart, plantId, currentHP, maxHP, mutationLevel)
	local itemDetail = ItemConfig.Plants[plantId]
	local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
	if not itemModelsFolder then return nil end
	local combatModel = itemModelsFolder:FindFirstChild(plantId .. "_Plant") or itemModelsFolder:FindFirstChild(plantId)
	
	if not combatModel or not itemDetail then return nil end

	local newFighter = combatModel:Clone()
	newFighter.Name = plantId
	newFighter:SetAttribute("IsCombatPlant", true)
	newFighter:SetAttribute("Health", currentHP)
	newFighter:SetAttribute("MaxHealth", maxHP)
	newFighter:SetAttribute("MutationLevel", mutationLevel or 1)
	
	newFighter:SetAttribute("GridName", lawnPart.Name)
	if newFighter.PrimaryPart then newFighter.PrimaryPart:SetAttribute("GridName", lawnPart.Name) end

    -- 👇 [🌟 统一死亡结算中枢]
    -- 所有的死亡、复活标记、爆炸起爆全部在这里完成
	newFighter:GetAttributeChangedSignal("Health"):Connect(function()
		if (newFighter:GetAttribute("Health") or 0) &lt;= 0 then
            -- 1. 标记需要重建（防跨关卡假死）
			newFighter:SetAttribute("NeedsRebuild", true)
            
            -- 2. 如果配置了爆炸类型，死亡瞬间立刻引爆！
            if itemDetail.ExplosionType then
                PlantCombatAI.TriggerExplosion(newFighter, itemDetail, mutationLevel)
            end
		end
	end)

	local plotNum = tonumber(string.match(lawnPart.Parent.Parent.Name, "%d+")) or 1
	local yRotation = (plotNum &lt;= 4) and CFrame.Angles(0, math.rad(0), 0) or CFrame.Angles(0, math.rad(0), 0)
	local spawnCFrame = lawnPart.CFrame * CFrame.new(0, lawnPart.Size.Y/2 + (newFighter.PrimaryPart and newFighter.PrimaryPart.Size.Y/2 or 2), 0) * yRotation
	
	if newFighter:IsA("Model") then
		newFighter:PivotTo(spawnCFrame)
	else
		newFighter.CFrame = spawnCFrame
	end

	local MUTATION_TAGS = { Glow = true, Lightning = true, HolyLight = true }
	local hasAnyAnim = itemDetail.IdleAnimId or itemDetail.AttackAnimation or itemDetail.RiseAnimation

	for _, part in pairs(newFighter:GetDescendants()) do
		if part:IsA("BasePart") then 
			-- 记录原始透明度
			if not part:GetAttribute("OriginalTransparency") then
				part:SetAttribute("OriginalTransparency", part.Transparency)
			end
			-- 强制隐藏特效容器
			if MUTATION_TAGS[part.Name] then
				part.Transparency = 1
				part:SetAttribute("OriginalTransparency", 1)
			end
			part.CanCollide = false 
			part.CanQuery = true 
			part.Anchored = (not hasAnyAnim or part == newFighter.PrimaryPart)
		end
	end
	
	EffectUtil.ApplyMutationEffects(newFighter, mutationLevel)
	newFighter.Parent = lawnPart
	lawnPart:SetAttribute("OccupiedBy", plantId)

	local prompt = lawnPart:FindFirstChildOfClass("ProximityPrompt")
	if prompt then prompt.Enabled = false end

	local plot = lawnPart.Parent.Parent
    
	-- 动画统一交给 PlantCombatAI 管理，避免 CombatService 和 AI 重复 LoadAnimation。
	if itemDetail.CanAttack then
		PlantCombatAI.StartShooterAI(newFighter, itemDetail, mutationLevel, plot)
	else
		PlantCombatAI.StartIdleAnimation(newFighter, itemDetail)
	end

	return newFighter
end

local function SpawnCombatPlant(lawnPart, plantId, currentHP, maxHP, mutationLevel)
	return CombatService.SpawnCombatPlant(lawnPart, plantId, currentHP, maxHP, mutationLevel)
end

-- ==========================================
-- [🌟 延迟加载函数：专门对付循环依赖]
-- ==========================================
local function GetPlotService()
	return require(script.Parent.PlotService)
end

-- ==========================================
-- [导出的公共功能]
-- ==========================================

function CombatService.Init()
	if not ReplicatedStorage:FindFirstChild("ShowTipRE") then
		local showTipRE = Instance.new("RemoteEvent")
		showTipRE.Name = "ShowTipRE"
		showTipRE.Parent = ReplicatedStorage
	end
	local plotsFolder = Workspace:WaitForChild("Plots")

	Players.PlayerAdded:Connect(function(player)
		local data = PlayerDataManager.GetPlayerData(player)
		local waitLimit = 0
		while not data and waitLimit &lt; 20 do task.wait(0.5); waitLimit += 1; data = PlayerDataManager.GetPlayerData(player) end
		if not data then return end

		local plot = nil
		for i = 1, 20 do
			plot = GetPlotService().GetPlayerPlot(player) -- 使用延迟加载
			if plot then break end
			task.wait(0.5)
		end
		if not plot or not data.CombatPlants then return end

		local lawnFolder = plot:FindFirstChild("Lawn")
		if not lawnFolder then return end

		for gridName, plantInfo in pairs(data.CombatPlants) do
			local lawnPart = lawnFolder:FindFirstChild(gridName)
			if lawnPart then
				local itemDetail = ItemConfig.Plants[plantInfo.PlantId]
				if itemDetail then
					local baseMaxHP = itemDetail.HP or 300
					local mLevel = plantInfo.Mutation or 1
					local stats = ItemConfig.MutationStats[mLevel] or ItemConfig.MutationStats[1]
					local maxHP = math.floor(baseMaxHP * stats.HealthMul)
					SpawnCombatPlant(lawnPart, plantInfo.PlantId, maxHP, maxHP, mLevel)
				end
			end
		end
	end)

	-- 草坪部署逻辑
	for _, plot in ipairs(plotsFolder:GetChildren()) do
		if not string.match(plot.Name, "Plot") then continue end
		local lawnFolder = plot:FindFirstChild("Lawn")
		if not lawnFolder then continue end

		for _, lawnPart in ipairs(lawnFolder:GetChildren()) do
			if lawnPart:IsA("BasePart") then
				local prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "Deploy"; prompt.ObjectText = "Lawn"; prompt.KeyboardKeyCode = Enum.KeyCode.E
				prompt.RequiresLineOfSight = false; prompt.MaxActivationDistance = 8; prompt.Parent = lawnPart
				
				prompt.Triggered:Connect(function(player)
					local myPlot = GetPlotService().GetPlayerPlot(player)
					if myPlot ~= plot then return end
					if lawnPart:GetAttribute("OccupiedBy") then return end

					local character = player.Character
					local equippedCompositeId = character and character:GetAttribute("EquippedSeed")
					
					-- 如果没有装备物品，或者装备的不是战斗植物，则打开背包
					if not equippedCompositeId or string.split(equippedCompositeId, "_")[1] ~= "Plant" then 
						local openInvRE = ReplicatedStorage:FindFirstChild("OpenInventoryRE")
						if openInvRE then
							openInvRE:FireClient(player, "PlantPage")
						end
						return 
					end

					local parts = string.split(equippedCompositeId, "_")
					local plantId, targetMutation = parts[2], tonumber(parts[3]) or 1
					
					-- [🌟 修复] 拦截投掷类植物部署：樱桃炸弹不允许种在地上，只能丢！
					local itemDetailCheck = ItemConfig.Plants[plantId]
					if itemDetailCheck and itemDetailCheck.IsThrowable then
						local showTipRE = ReplicatedStorage:FindFirstChild("ShowTipRE")
						if showTipRE then showTipRE:FireClient(player, "Click to throw this plant!") end
						return
					end

					if PlayerDataManager.ConsumePlant(player, plantId, 1, targetMutation) then
						local AnalyticsService = game:GetService("AnalyticsService")
						local data = PlayerDataManager.GetPlayerData(player)
						local remainingQuantity = 0
						if data and data.Inventory and data.Inventory.Plants then
							for _, pInfo in ipairs(data.Inventory.Plants) do
								if pInfo.ID == plantId and (pInfo.Mutation or 1) == targetMutation then
									remainingQuantity = pInfo.Quantity
									break
								end
							end
						end
						
						-- 记录植物消耗
						AnalyticsService:LogEconomyEvent(
							player, Enum.AnalyticsEconomyFlowType.Sink, "Plants", 1, remainingQuantity,
							Enum.AnalyticsEconomyTransactionType.Gameplay.Name, plantId 
						)
											
						AnalyticsService:LogCustomEvent(player, "PlantDeployed_"..plantId, 1)
						local itemDetail = ItemConfig.Plants[plantId]
						local baseMaxHP = itemDetail.HP or 300
						local stats = ItemConfig.MutationStats[targetMutation] or ItemConfig.MutationStats[1]
						local maxHP = math.floor(baseMaxHP * stats.HealthMul)
						
						AnalyticsService:LogFunnelStepEvent(player, "Onboarding", nil, 2, "Step_2_First_Deploy")
						SpawnCombatPlant(lawnPart, plantId, maxHP, maxHP, targetMutation)
						PlayerDataManager.AddCombatPlant(player, lawnPart.Name, plantId, maxHP, targetMutation)
					end
				end)
			end
		end
	end


	-- ==========================================
	-- [接收教程部署指令]
	-- ==========================================
	local tutorialDeployRE = ReplicatedStorage:FindFirstChild("TutorialDeployRE") or Instance.new("RemoteEvent")
	tutorialDeployRE.Name = "TutorialDeployRE"
	tutorialDeployRE.Parent = ReplicatedStorage

	tutorialDeployRE.OnServerEvent:Connect(function(player, lawnName, plantId)
		local myPlot = GetPlotService().GetPlayerPlot(player)
		if not myPlot then return end
		
		local lawnFolder = myPlot:FindFirstChild("Lawn")
		local lawnPart = lawnFolder and lawnFolder:FindFirstChild(lawnName)
		if not lawnPart or lawnPart:GetAttribute("OccupiedBy") then return end
		
		local itemDetail = ItemConfig.Plants[plantId]
		if not itemDetail then return end
		
		local targetMutation = 1
		local baseMaxHP = itemDetail.HP or 300
		local stats = ItemConfig.MutationStats[targetMutation] or ItemConfig.MutationStats[1]
		local maxHP = math.floor(baseMaxHP * stats.HealthMul)

		SpawnCombatPlant(lawnPart, plantId, maxHP, maxHP, targetMutation)
		PlayerDataManager.AddCombatPlant(player, lawnPart.Name, plantId, maxHP, targetMutation)
	end)
end

-- [🌟 修复版：清场函数]
function CombatService.ClearAllCombatPlants(player)
	local plot = GetPlotService().GetPlayerPlot(player)
	if not plot then return end
	local lawnFolder = plot:FindFirstChild("Lawn")
	if not lawnFolder then return end
	
	for _, lawnPart in ipairs(lawnFolder:GetChildren()) do
		for _, child in ipairs(lawnPart:GetChildren()) do
			if child:GetAttribute("IsCombatPlant") then child:Destroy() end
		end
		lawnPart:SetAttribute("OccupiedBy", nil)
		local prompt = lawnPart:FindFirstChildOfClass("ProximityPrompt")
		if prompt then prompt.Enabled = true end
	end
end

-- [🌟 修复版：智能重新载入（彻底解决阵亡假死与被啃咬隐藏不恢复的问题）]
function CombatService.ReloadSavedPlants(player)
	local data = PlayerDataManager.GetPlayerData(player)
	if not data or not data.CombatPlants then return end
	
	local plot = GetPlotService().GetPlayerPlot(player)
	local lawnFolder = plot and plot:FindFirstChild("Lawn")
	if not lawnFolder then return end

	for gridName, plantInfo in pairs(data.CombatPlants) do
		local lawnPart = lawnFolder:FindFirstChild(gridName)
		if lawnPart then
			local existing = nil
            
			-- 1. 找出当前格子上的植物
			for _, c in ipairs(lawnPart:GetChildren()) do
				if c:GetAttribute("IsCombatPlant") then 
                    existing = c 
                    break 
                end
			end
			
			if existing and existing.Name == plantInfo.PlantId then 
				-- 2. 【核心判定】：植物是否已经“社会性死亡”？
                -- 如果已被标记重建、被引爆，或者血量归零，通通视作死亡！
				if existing:GetAttribute("NeedsRebuild") 
                or existing:GetAttribute("Exploded") 
                or (existing:GetAttribute("Health") or 1) &lt;= 0 then
					existing:Destroy()
					existing = nil
				else
					-- 3. 【状态清除】：植物还活着，但可能被啃咬得半透明了或残血了
					-- 强制恢复满血
					local maxHP = existing:GetAttribute("MaxHealth") or 300
					existing:SetAttribute("Health", maxHP)
					
					-- 强制恢复所有零件的原始可见度（解除啃咬隐藏状态）
					for _, part in ipairs(existing:GetDescendants()) do
						if part:IsA("BasePart") then
							local origTrans = part:GetAttribute("OriginalTransparency")
							if origTrans then
								part.Transparency = origTrans
							end
						end
					end
					
					-- 唤醒可能被意外关闭的特效（重新刷一遍等级特效）
					EffectUtil.ApplyMutationEffects(existing, plantInfo.Mutation or 1)
					
					-- 植物健康且恢复完毕，无需再重建，跳过并处理下一个格子
					continue 
				end
			end 

			-- 4. 如果植物名不符（比如占位不对），或者上面判定它死了（已被清空）
			if existing then existing:Destroy() end

            -- 5. 重新生成一个崭新、满血且正常的植物！
			local itemDetail = ItemConfig.Plants[plantInfo.PlantId]
			if itemDetail then
				local baseMaxHP = itemDetail.HP or 300
				local mLevel = plantInfo.Mutation or 1
				local stats = ItemConfig.MutationStats[mLevel] or ItemConfig.MutationStats[1]
				local maxHP = math.floor(baseMaxHP * stats.HealthMul)
				SpawnCombatPlant(lawnPart, plantInfo.PlantId, maxHP, maxHP, mLevel)
			end
		end
	end
end

return CombatService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">EquipmentService</string>
            <string name="Source">-- src/server/Services/EquipmentService.luau
local EquipmentService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

local holdTrackCache = setmetatable({}, { __mode = "k" })
local characterCleanupBound = setmetatable({}, { __mode = "k" })

local function stopAndDestroyHoldTrack(animator)
    local track = holdTrackCache[animator]
    if track then
        pcall(function()
            track:Stop(0.1)
            track:Destroy()
        end)
        holdTrackCache[animator] = nil
    end
end

local function getHoldTrack(animator, humanoid)
    local cached = holdTrackCache[animator]
    if cached then
        return cached
    end

    local holdAnim = Instance.new("Animation")
    holdAnim.AnimationId = (humanoid.RigType == Enum.HumanoidRigType.R15) and "rbxassetid://507768375" or "rbxassetid://128428514"

    local track = animator:LoadAnimation(holdAnim)
    track.Name = "CustomHoldAnim"
    track.Priority = Enum.AnimationPriority.Action
    holdTrackCache[animator] = track

    holdAnim:Destroy()
    return track
end

local function bindCharacterAnimationCleanup(character, humanoid, animator)
    if characterCleanupBound[character] then
        return
    end
    characterCleanupBound[character] = true

    humanoid.Died:Connect(function()
        stopAndDestroyHoldTrack(animator)
    end)

    character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            stopAndDestroyHoldTrack(animator)
        end
    end)
end

-- [🌟 终极特效控制系统：支持 Attachment 容器穿透]
local function ApplyMutationEffects(model, mutationLevel)
    mutationLevel = mutationLevel or 1
    local effectMap = { [2] = "Glow", [3] = "Lightning", [4] = "HolyLight" }
    
    for lvl, fxName in pairs(effectMap) do
        local shouldEnable = (mutationLevel == lvl)
        
        -- 遍历模型中所有元件
        for _, node in ipairs(model:GetDescendants()) do
            -- 如果找到了对应名字的元件（比如 Glow 附件）
            if node.Name == fxName then
                
         

                -- 2. [🌟 核心修复] 如果这个节点是附件(Attachment)或文件夹，遍历并开关它【里面】的所有特效！
                for _, child in ipairs(node:GetDescendants()) do
                    if child:IsA("ParticleEmitter") or child:IsA("Light") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("Trail") then
                        child.Enabled = shouldEnable
                    end
                end
                
            end
        end
    end
end
function EquipmentService.Init()
    local holdItemRE = Instance.new("RemoteEvent")
    holdItemRE.Name = "HoldItemRE"
    holdItemRE.Parent = ReplicatedStorage

    holdItemRE.OnServerEvent:Connect(function(player, compositeId)
        EquipmentService.UpdateHoldItem(player, compositeId)
    end)
end

-- [🌟 核心接口] 统一处理装备、卸下、物理锁定
function EquipmentService.UpdateHoldItem(player, compositeId)
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
    bindCharacterAnimationCleanup(character, humanoid, animator)

    -- 1. 清理旧模型和动画
    local oldItem = character:FindFirstChild("HeldItem_Custom")
    if oldItem then oldItem:Destroy() end

    local previousItem = character:GetAttribute("EquippedSeed")
    if previousItem ~= compositeId then
        stopAndDestroyHoldTrack(animator)
    end

    if not compositeId then 
        character:SetAttribute("EquippedSeed", nil)
        return 
    end

    -- 2. 播放动画
    local track = getHoldTrack(animator, humanoid)
    track:Play()

    -- 3. [🌟 核心原理：根据标签寻找对应模型，并解析变异等级]
    local parts = string.split(compositeId, "_")
    local itemType = parts[1]
    local realId = parts[2]
    local mutationLevel = tonumber(parts[3]) or 1 -- [🌟 提取变异等级]

    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    local realModel = nil

    if itemType == "Seed" then
        
        realModel = itemModelsFolder:FindFirstChild(realId .. "_Seed") or itemModelsFolder:FindFirstChild("Seed")

    elseif itemType == "Plant" then
        local itemDetail = ItemConfig.Plants[realId]
        if itemDetail then
            realModel = itemModelsFolder and (itemModelsFolder:FindFirstChild(realId .. "_Plant") or itemModelsFolder:FindFirstChild(realId))
        end
    elseif itemType == "Tool" then
        realModel = itemModelsFolder and itemModelsFolder:FindFirstChild(realId)
    end

    if realModel then
        local heldModel = realModel:Clone()
        heldModel.Name = "HeldItem_Custom"

        -- [🌟 核心新增：在手里拿着的时候，过滤掉多余的特效，只显示正确的变异光效]
        if itemType == "Plant" then
            ApplyMutationEffects(heldModel, mutationLevel)
        end

        -- [🌟 获取根节点]
        local modelRoot = heldModel
        if heldModel:IsA("Model") then
            modelRoot = heldModel.PrimaryPart or heldModel:FindFirstChildWhichIsA("BasePart")
        end
        
        if not modelRoot or not modelRoot:IsA("BasePart") then return end

        -- ==========================================
        -- [🌟 终极物理安全锁：防瘫痪 + 防碎裂]
        -- ==========================================
        for _, part in pairs(heldModel:GetDescendants()) do
            if part:IsA("BasePart") then
                -- 1. 变成无碰撞的幽灵，防止卡住人物
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.Massless = true 
                
                -- 2. 绝对不能锚定！
                part.Anchored = false 
                
                -- 3. 自动焊接内部零件
                if part ~= modelRoot then
                    local internalWeld = Instance.new("WeldConstraint")
                    internalWeld.Part0 = modelRoot
                    internalWeld.Part1 = part
                    internalWeld.Parent = modelRoot
                end
            end
        end

        heldModel.Parent = character
        character:SetAttribute("EquippedSeed", compositeId) 
        

        -- 焊接至右手
        local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
        if rightHand then
            local rotationOffset = CFrame.new() 
            if itemType == "Plant" then
                rotationOffset = CFrame.Angles(-90, 0, 0) 

            elseif itemType == "Seed" then
                -- 修改这里的 3 个数字 (X, Y, Z轴的旋转度数)
                -- 比如现在是 X轴转90度，如果你觉得不对，可以尝试改成 (0, math.rad(90), 0) 等等
                rotationOffset = CFrame.Angles(math.rad(-90), math.rad(0), math.rad(0))
            elseif itemType == "Tool" and realId == "WeaponBlock" then
                -- 如果角度不对，可以修改下面这三个数字 (X轴, Y轴, Z轴 的旋转度数)
                rotationOffset = CFrame.Angles(math.rad(-90), 0, 0)
                
            end
            
            heldModel:PivotTo(rightHand.CFrame * rotationOffset)
            
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = rightHand
            weld.Part1 = modelRoot
            weld.Parent = heldModel
        end
    end
end

return EquipmentService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">FreeRewardService</string>
            <string name="Source">-- src/server/Services/FreeRewardService.lua
local FreeRewardService = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- ==========================================
-- 🎁 奖励与群组配置区
-- ==========================================
local REWARD_PLANT = "Threepeater" 
local REWARD_AMOUNT = 1              
local GROUP_ID = 229662289        -- ⚠️⚠️⚠️ 请把这里换成你真正的 Roblox 群组 ID！

function FreeRewardService.Init()
    local claimRE = Instance.new("RemoteEvent")
    claimRE.Name = "ClaimFreeRewardRE"
    claimRE.Parent = ReplicatedStorage

    local PDManager = require(script.Parent.Parent.PlayerDataManager)

    Players.PlayerAdded:Connect(function(player)
        task.spawn(function()
            local data = nil
            while not data do
                data = PDManager.GetPlayerData(player)
                if not data then task.wait(0.5) end
            end
            
            if data.FreeRewardClaimed then
                player:SetAttribute("HasClaimedFreeReward", true)
            else
                player:SetAttribute("HasClaimedFreeReward", false)
            end
        end)
    end)

    claimRE.OnServerEvent:Connect(function(player)
        local data = PDManager.GetPlayerData(player)
        if not data then return end
        
        -- 防作弊 1：如果已经领取过，直接拦截
        if data.FreeRewardClaimed then return end
        
        -- 🛡️ 防作弊 2：真实验证玩家是否在群组中 (核心安全锁)
        if not player:IsInGroup(GROUP_ID) then
            -- 如果玩家用外挂强行发包，但在网页上没加群，服务端会直接拒绝给奖励
            return 
        end
        
        -- 发放奖励
        PDManager.GivePlant(player, REWARD_PLANT, REWARD_AMOUNT, 1)
        
        data.FreeRewardClaimed = true
        player:SetAttribute("HasClaimedFreeReward", true)
        
        claimRE:FireClient(player, true)
    end)
end

return FreeRewardService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">IAPService</string>
            <string name="Source">-- src/server/Services/IAPService.luau
local IAPService = {}

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))

local PRODUCT_NEWBIE_GIFT = 3594585526 -- 新手礼包 ID
local PRODUCT_SEVEN_DAY = 3582734340   -- 七天签到一键领取的内购 ID
local PRODUCT_RARE_ROLL_TICKET = 3599579545 -- 稀有抽奖次数 ID

local function GetConfiguredProductId(itemDetail)
    if type(itemDetail.ProductId) == "number" and itemDetail.ProductId &gt; 0 then
        return itemDetail.ProductId
    end
    if type(itemDetail.IAPProductId) == "number" and itemDetail.IAPProductId &gt; 0 then
        return itemDetail.IAPProductId
    end
    return nil
end

local function FindShopRewardByProductId(productId)
    for seedId, seedDetail in pairs(ItemConfig.Seeds or {}) do
        local configProductId = GetConfiguredProductId(seedDetail)
        if configProductId == productId then
            return {
                ItemType = "Seed",
                ItemId = seedId,
                Amount = seedDetail.IAPAmount or seedDetail.Amount or 1,
                Name = seedDetail.Name or seedId,
            }
        end
    end

    for plantId, plantDetail in pairs(ItemConfig.Plants or {}) do
        local configProductId = GetConfiguredProductId(plantDetail)
        if configProductId == productId then
            return {
                ItemType = "Plant",
                ItemId = plantId,
                Amount = plantDetail.IAPAmount or plantDetail.Amount or 1,
                Mutation = plantDetail.IAPMutation or plantDetail.Mutation or 1,
                Name = plantDetail.Name or plantId,
            }
        end
    end

    return nil
end

local function GrantShopReward(player, reward)
    if reward.ItemType == "Seed" then
        PlayerDataManager.GiveSeed(player, reward.ItemId, reward.Amount, true)
        return true
    elseif reward.ItemType == "Plant" then
        PlayerDataManager.GivePlant(player, reward.ItemId, reward.Amount, reward.Mutation or 1)
        return true
    end

    return false
end

function IAPService.Init()
    -- 1. 补偿弹窗事件
    local showPopupRE = ReplicatedStorage:FindFirstChild("ShowCompensationPopupRE")
    if not showPopupRE then
        showPopupRE = Instance.new("RemoteEvent")
        showPopupRE.Name = "ShowCompensationPopupRE"
        showPopupRE.Parent = ReplicatedStorage
    end

    -- 2. 🌟 新增：主动购买意向记录事件（用于精准区分新老订单）
    local markIntentRE = ReplicatedStorage:FindFirstChild("MarkPurchaseIntentRE")
    if not markIntentRE then
        markIntentRE = Instance.new("RemoteEvent")
        markIntentRE.Name = "MarkPurchaseIntentRE"
        markIntentRE.Parent = ReplicatedStorage
    end

    -- 记录玩家近期是否点过购买按钮
    local activePurchaseIntents = {}
    markIntentRE.OnServerEvent:Connect(function(player)
        activePurchaseIntents[player.UserId] = os.time()
    end)

    MarketplaceService.ProcessReceipt = function(receiptInfo)
        local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
        if not player then
            return Enum.ProductPurchaseDecision.NotProcessedYet
        end

        -- ==========================================
        -- [1] 判定是否购买了【新手限时礼包】
        -- ==========================================
        if receiptInfo.ProductId == PRODUCT_NEWBIE_GIFT then
            local data = PlayerDataManager.GetPlayerData(player)
            if data and not data.NewbieGiftPurchased then
                PlayerDataManager.GiveSeed(player, "CoconutTree", 6, true)
                data.NewbieGiftPurchased = true
                
                local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
                
                local playObtainEffectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
                if playObtainEffectRE then
                    playObtainEffectRE:FireClient(player, "Purchase Successful!\nObtained 6x CoconutTree!") 
                end
            end
            return Enum.ProductPurchaseDecision.PurchaseGranted
        end

        -- ==========================================
        -- [2] 判定是否购买了【七天签到一键领取】
        -- ==========================================
        if receiptInfo.ProductId == PRODUCT_SEVEN_DAY then
            local data = PlayerDataManager.GetPlayerData(player)
            if data then
                local currentDays = data.SignInDays or 0
                if currentDays &lt; 7 then
                    -- 无论新老订单，基础的 1-7 天奖励必须发
                    for day = currentDays + 1, 7 do
                        PlayerDataManager.GrantSignInReward(player, day)
                    end
                    
                    data.SignInDays = 7
                    data.LastSignInTime = os.time()
                    
                    local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                    if updateInventoryRE then updateInventoryRE:FireClient(player, data) end
                    
                    -- 🌟 核心判断：检查玩家在过去 5 分钟内是否主动点过“购买”按钮
                    local intentTime = activePurchaseIntents[player.UserId] or 0
                    local isNewPurchase = (os.time() - intentTime) &lt; 300 
                    
                    if not isNewPurchase then
                        -- 【情况 A：历史老订单】(系统上线自动触发，玩家没点按钮)
                        PlayerDataManager.GivePlant(player, "CobCannon", 1, 1)
                        
                        local popupRE = ReplicatedStorage:FindFirstChild("ShowCompensationPopupRE")
                        if popupRE then
                            popupRE:FireClient(player, "A bug occurred with the 7-Day Sign-In rewards.\nPlease accept this Cob Cannon as compensation.\nWe sincerely apologize for the inconvenience!")
                        end
                        print("【系统】玩家 " .. player.Name .. " 历史七天签到订单补发完成，已发加农炮补偿。")
                    else
                        -- 【情况 B：今天的新订单】(玩家刚刚自己点了购买按钮)
                        local playObtainEffectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
                        if playObtainEffectRE then
                            playObtainEffectRE:FireClient(player, "7-Day Rewards Unlocked!\nAll items sent to inventory.") 
                        end
                        print("【系统】玩家 " .. player.Name .. " 正常购买七天签到，无额外补偿。")
                        
                        -- 清除意向，防止重复判定
                        activePurchaseIntents[player.UserId] = nil
                    end
                end
            end
            
            return Enum.ProductPurchaseDecision.PurchaseGranted
        end

        -- ==========================================
        -- [3] 稀有抽奖次数 Developer Product
        -- ==========================================
        if receiptInfo.ProductId == PRODUCT_RARE_ROLL_TICKET then
            local data = PlayerDataManager.GetPlayerData(player)
            if not data then
                return Enum.ProductPurchaseDecision.NotProcessedYet
            end

            if type(data.RollTickets) ~= "table" then
                data.RollTickets = {0, 0}
            end
            data.RollTickets[2] = (tonumber(data.RollTickets[2]) or 0) + 1
            data.RollTickets["2"] = nil

            local updateInventoryRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
            if updateInventoryRE then updateInventoryRE:FireClient(player, data) end

            local playObtainEffectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
            if playObtainEffectRE then
                playObtainEffectRE:FireClient(player, "Purchase Successful!\nObtained 1x Rare Pull!")
            end

            return Enum.ProductPurchaseDecision.PurchaseGranted
        end

        -- ==========================================
        -- [4] 商店植物/种子 Developer Product 购买
        -- ==========================================
        local shopReward = FindShopRewardByProductId(receiptInfo.ProductId)
        if shopReward then
            local data = PlayerDataManager.GetPlayerData(player)
            if not data then
                return Enum.ProductPurchaseDecision.NotProcessedYet
            end

            local granted = GrantShopReward(player, shopReward)
            if not granted then
                warn("[IAPService] Unknown shop reward type for productId: " .. tostring(receiptInfo.ProductId))
                return Enum.ProductPurchaseDecision.NotProcessedYet
            end

            local playObtainEffectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
            if playObtainEffectRE then
                playObtainEffectRE:FireClient(
                    player,
                    "Purchase Successful!\nObtained " .. tostring(shopReward.Amount) .. "x " .. tostring(shopReward.Name) .. "!"
                )
            end

            return Enum.ProductPurchaseDecision.PurchaseGranted
        end

        return Enum.ProductPurchaseDecision.NotProcessedYet
    end
end

return IAPService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source">-- src/server/Services/InventoryService.luau
local InventoryService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local PlotService = require(script.Parent.PlotService)
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local CombatService = require(script.Parent.CombatService)
local pendingGiftRequests = {}
local playerPendingGiftRequest = {}
local nextGiftRequestId = 0

local function getDisplayItemName(itemType, realId)
    if itemType == "Seed" then
        local seedConfig = ItemConfig.Seeds[realId]
        return seedConfig and (seedConfig.Name or realId)
    elseif itemType == "Plant" then
        local plantConfig = ItemConfig.Plants[realId]
        return plantConfig and (plantConfig.Name or realId)
    end

    return nil
end

local function GetCombatEditCost(player)
    local plot = PlotService.GetPlayerPlot(player)
    local currentLevel = plot and plot:GetAttribute("CurrentLevel") or 1
    currentLevel = math.max(1, tonumber(currentLevel) or 1)
    return 100 + (currentLevel - 1) * 100
end

local function clearGiftRequest(requestId)
    local requestData = pendingGiftRequests[requestId]
    if not requestData then return nil end

    if playerPendingGiftRequest[requestData.sender] == requestId then
        playerPendingGiftRequest[requestData.sender] = nil
    end
    if playerPendingGiftRequest[requestData.target] == requestId then
        playerPendingGiftRequest[requestData.target] = nil
    end

    pendingGiftRequests[requestId] = nil
    return requestData
end


local function CleanUpGhostItems(data)
    if not data or not data.Hotbar then return false end
    local validHotbar = {}
    local changed = false
    
    for _, compositeId in ipairs(data.Hotbar) do
        local parts = string.split(compositeId, "_")
        local itemType = parts[1]
        local realId = parts[2]
        local mutLvl = tonumber(parts[3]) or 1
        
        local isValid = false
        if itemType == "Tool" or itemType == "System" then
            isValid = true 
        elseif itemType == "Seed" and data.Inventory.Seeds then
            for _, seedData in ipairs(data.Inventory.Seeds) do
                if seedData.ID == realId and seedData.Quantity &gt; 0 then 
                    isValid = true; break 
                end
            end
        elseif itemType == "Plant" and data.Inventory.Plants then
            for _, plantData in ipairs(data.Inventory.Plants) do
                if plantData.ID == realId and (plantData.Mutation or 1) == mutLvl and plantData.Quantity &gt; 0 then 
                    isValid = true; break 
                end
            end
        end
        
        if isValid then
            table.insert(validHotbar, compositeId)
        else
            changed = true 
        end
    end
    
    if changed then
        data.Hotbar = validHotbar
    end
    return changed
end

function InventoryService.Init()
    local equipItemRE = Instance.new("RemoteEvent")
    equipItemRE.Name = "EquipItemRE"
    equipItemRE.Parent = ReplicatedStorage

    local giftItemRE = ReplicatedStorage:FindFirstChild("GiftItemRE") or Instance.new("RemoteEvent")
    giftItemRE.Name = "GiftItemRE"
    giftItemRE.Parent = ReplicatedStorage

    local forceSelectRE = Instance.new("RemoteEvent")
    forceSelectRE.Name = "ForceSelectRE"
    forceSelectRE.Parent = ReplicatedStorage

    local removeHotbarRE = Instance.new("RemoteEvent")
    removeHotbarRE.Name = "RemoveHotbarRE"
    removeHotbarRE.Parent = ReplicatedStorage

    -- ==========================================
    -- [战斗植物交换引擎 (E键)]
    -- ==========================================
    local swapCombatPlantRE = Instance.new("RemoteEvent")
    swapCombatPlantRE.Name = "SwapCombatPlantRE"
    swapCombatPlantRE.Parent = ReplicatedStorage

    -- 👇 [🌟 核心修改：接受 isCombatSwap 参数判定是否需要扣钱]
    swapCombatPlantRE.OnServerEvent:Connect(function(player, oldPlantModel, equippedCompositeId, isCombatSwap)
        if not oldPlantModel or not oldPlantModel.Parent then return end
        if type(equippedCompositeId) ~= "string" then return end
        if not oldPlantModel:GetAttribute("IsCombatPlant") then return end

        local parts = string.split(equippedCompositeId, "_")
        if parts[1] ~= "Plant" then return end

        local newPlantId = parts[2]
        local newMutLevel = tonumber(parts[3]) or 1
        local newPlantConfig = ItemConfig.Plants[newPlantId]
        if not newPlantConfig or newPlantConfig.IsThrowable then return end

        local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
        local newTemplate = itemModelsFolder and (itemModelsFolder:FindFirstChild(newPlantId .. "_Plant") or itemModelsFolder:FindFirstChild(newPlantId))
        if not newTemplate then return end

        local gridPart = oldPlantModel.Parent
        if not gridPart or not gridPart:IsA("BasePart") then return end

        local myPlot = PlotService.GetPlayerPlot(player)
        local lawnFolder = myPlot and myPlot:FindFirstChild("Lawn")
        if not myPlot or not lawnFolder or gridPart.Parent ~= lawnFolder then return end

        local data = PlayerDataManager.GetPlayerData(player)
        if not data then return end

        local gridName = gridPart.Name
        local combatInfo = data.CombatPlants and data.CombatPlants[gridName]
        if not combatInfo then return end
        if gridPart:GetAttribute("OccupiedBy") ~= oldPlantModel.Name then return end

        local oldPlantId = combatInfo.PlantId or oldPlantModel.Name
        local oldMutLevel = combatInfo.Mutation or oldPlantModel:GetAttribute("MutationLevel") or 1
        if oldPlantModel.Name ~= oldPlantId then return end

        -- ==========================================
        -- Step 1: 按铲除/回收规则处理旧战斗植物
        -- ==========================================
        if myPlot:GetAttribute("IsLevelActive") then
            if not isCombatSwap then
                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                if showNotifRE then
                    showNotifRE:FireClient(player, "Notice", "Cannot replace plants during combat!")
                end
                return
            end

            local cost = GetCombatEditCost(player)
            if not PlayerDataManager.ConsumeCoins(player, cost) then
                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                if showNotifRE then
                    showNotifRE:FireClient(player, "Notice", "Not enough Sun! Need " .. tostring(cost) .. " Sun.")
                end
                return
            end
        end

        PlayerDataManager.GivePlant(player, oldPlantId, 1, oldMutLevel)
        PlayerDataManager.RemoveCombatPlant(player, gridName)
        gridPart:SetAttribute("OccupiedBy", nil)
        local prompt = gridPart:FindFirstChildOfClass("ProximityPrompt")
        if prompt then prompt.Enabled = true end
        oldPlantModel:Destroy()

        -- ==========================================
        -- Step 2: 按普通部署规则消耗手中新植物并统一生成
        -- ==========================================
        if not PlayerDataManager.ConsumePlant(player, newPlantId, 1, newMutLevel) then return end

        local baseMaxHP = newPlantConfig.HP or 300
        local stats = ItemConfig.MutationStats[newMutLevel] or ItemConfig.MutationStats[1]
        local maxHP = math.floor(baseMaxHP * stats.HealthMul)
        local newPlant = CombatService.SpawnCombatPlant(gridPart, newPlantId, maxHP, maxHP, newMutLevel)
        if not newPlant then return end

        PlayerDataManager.AddCombatPlant(player, gridName, newPlantId, maxHP, newMutLevel)
    end)


    removeHotbarRE.OnServerEvent:Connect(function(player, compositeId)
        local data = PlayerDataManager.GetPlayerData(player)
        if data and data.Hotbar then
            local found = false
            for i, id in ipairs(data.Hotbar) do
                if id == compositeId then
                    table.remove(data.Hotbar, i) 
                    found = true
                    break
                end
            end
            if CleanUpGhostItems(data) or found then
                ReplicatedStorage.UpdateInventoryRE:FireClient(player, data)
            end
        end
    end)

    giftItemRE.OnServerEvent:Connect(function(player, action, arg1, arg2)
        local showTipRE = ReplicatedStorage:FindFirstChild("ShowTipRE")

        if action == "CreateRequest" then
            local targetPlayer = arg1
            local compositeId = arg2

            if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then return end
            if targetPlayer == player then return end
            if type(compositeId) ~= "string" or compositeId == "" then return end
            if playerPendingGiftRequest[player] or playerPendingGiftRequest[targetPlayer] then
                if showTipRE then
                    showTipRE:FireClient(player, "Gift request is busy right now")
                end
                giftItemRE:FireClient(player, "ClosePopup", nil, "Gift request is busy right now")
                return
            end

            local senderData = PlayerDataManager.GetPlayerData(player)
            local receiverData = PlayerDataManager.GetPlayerData(targetPlayer)
            if not senderData or not receiverData then
                giftItemRE:FireClient(player, "ClosePopup", nil, "Gift failed")
                return
            end

            local parts = string.split(compositeId, "_")
            local itemType = parts[1]
            local realId = parts[2]
            local mutLvl = tonumber(parts[3]) or 1
            local itemName = realId and getDisplayItemName(itemType, realId)

            if not realId or (itemType ~= "Seed" and itemType ~= "Plant") or not itemName then
                giftItemRE:FireClient(player, "ClosePopup", nil, "Gift failed")
                return
            end

            nextGiftRequestId += 1
            local requestId = tostring(nextGiftRequestId)
            pendingGiftRequests[requestId] = {
                sender = player,
                target = targetPlayer,
                compositeId = compositeId,
                itemType = itemType,
                realId = realId,
                mutLvl = mutLvl,
                itemName = itemName,
            }
            playerPendingGiftRequest[player] = requestId
            playerPendingGiftRequest[targetPlayer] = requestId

            giftItemRE:FireClient(player, "RequesterWaiting", requestId, targetPlayer.Name, itemName)
            giftItemRE:FireClient(targetPlayer, "ReceiveRequest", requestId, player.Name, itemName)
        elseif action == "CancelRequest" then
            local requestId = arg1
            local requestData = pendingGiftRequests[requestId]
            if not requestData or requestData.sender ~= player then return end

            clearGiftRequest(requestId)
            giftItemRE:FireClient(player, "ClosePopup", requestId, "Gift cancelled")
            giftItemRE:FireClient(requestData.target, "ClosePopup", requestId, "Gift cancelled")
        elseif action == "RespondRequest" then
            local requestId = arg1
            local accepted = arg2
            local requestData = pendingGiftRequests[requestId]
            if not requestData or requestData.target ~= player then return end

            if not accepted then
                clearGiftRequest(requestId)
                giftItemRE:FireClient(requestData.sender, "ClosePopup", requestId, "The other player declined the gift")
                giftItemRE:FireClient(player, "ClosePopup", requestId, "Gift declined")
                return
            end

            local sender = requestData.sender
            local targetPlayer = requestData.target
            local senderData = PlayerDataManager.GetPlayerData(sender)
            local receiverData = PlayerDataManager.GetPlayerData(targetPlayer)
            if not senderData or not receiverData then
                clearGiftRequest(requestId)
                giftItemRE:FireClient(sender, "ClosePopup", requestId, "Gift failed")
                giftItemRE:FireClient(targetPlayer, "ClosePopup", requestId, "Gift failed")
                return
            end

            local success = false
            if requestData.itemType == "Seed" then
                success = PlayerDataManager.ConsumeSeed(sender, requestData.realId, 1)
                if success then
                    PlayerDataManager.GiveSeed(targetPlayer, requestData.realId, 1, true)
                end
            else
                success = PlayerDataManager.ConsumePlant(sender, requestData.realId, 1, requestData.mutLvl)
                if success then
                    PlayerDataManager.GivePlant(targetPlayer, requestData.realId, 1, requestData.mutLvl)
                end
            end

            clearGiftRequest(requestId)

            if success then
                giftItemRE:FireClient(sender, "ClosePopup", requestId, "You gifted 1x " .. requestData.itemName .. " to " .. targetPlayer.Name)
                giftItemRE:FireClient(targetPlayer, "ClosePopup", requestId, "You received 1x " .. requestData.itemName .. " from " .. sender.Name)
            else
                giftItemRE:FireClient(sender, "ClosePopup", requestId, "Gift failed: item not available")
                giftItemRE:FireClient(targetPlayer, "ClosePopup", requestId, "Gift failed")
            end
        end
    end)

    equipItemRE.OnServerEvent:Connect(function(player, compositeId)
        local data = PlayerDataManager.GetPlayerData(player)
        if not data then return end

        local cleaned = CleanUpGhostItems(data)
        if cleaned then
            ReplicatedStorage.UpdateInventoryRE:FireClient(player, data)
        end

        local parts = string.split(compositeId, "_")
        local itemType = parts[1]  
        local realId = parts[2]    
        local mutLvl = tonumber(parts[3]) or 1 

        local hasItem = false
        if itemType == "Seed" then
            if data.Inventory.Seeds then
                for _, seedData in ipairs(data.Inventory.Seeds) do
                    if seedData.ID == realId and seedData.Quantity &gt; 0 then 
                        hasItem = true 
                        break 
                    end
                end
            end
        elseif itemType == "Plant" then
            if data.Inventory.Plants then
                for _, plantData in ipairs(data.Inventory.Plants) do
                    if plantData.ID == realId and (plantData.Mutation or 1) == mutLvl and plantData.Quantity &gt; 0 then 
                        hasItem = true 
                        break 
                    end
                end
            end
        end

        if hasItem then
            if not data.Hotbar then data.Hotbar = {} end
                local inHotbar = false
                for _, id in ipairs(data.Hotbar) do
                    if id == compositeId then inHotbar = true 
                    break 
                end
            end

            if inHotbar then
                forceSelectRE:FireClient(player, compositeId) 
            else
                if #data.Hotbar &lt; 10 then
                    table.insert(data.Hotbar, compositeId) 
                    ReplicatedStorage.UpdateInventoryRE:FireClient(player, data)
                    forceSelectRE:FireClient(player, compositeId)
                 else
                    local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                    if showNotifRE then
                        showNotifRE:FireClient(player, "⚠️ Hotbar Full", "Please unequip some items from your hotbar first.")
                    end
                end
            end
        end
    end)

    print("服务端：InventoryService 加载完毕！无缝静默交换系统(SwapPlant)已上线！")
end

return InventoryService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LevelService</string>
            <string name="Source">-- src/server/Services/LevelService.luau
local LevelService = {}

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local AnalyticsService = game:GetService("AnalyticsService")

local PlotService = require(script.Parent.PlotService)
local ZombieService = require(script.Parent.ZombieService)



function LevelService.Init()
    local startBattleRE = ReplicatedStorage:FindFirstChild("StartBattleRE") or Instance.new("RemoteEvent")
    startBattleRE.Name = "StartBattleRE"
    startBattleRE.Parent = ReplicatedStorage

    local endBattleRE = ReplicatedStorage:FindFirstChild("EndBattleRE") or Instance.new("RemoteEvent")
    endBattleRE.Name = "EndBattleRE"
    endBattleRE.Parent = ReplicatedStorage

    local syncBattleUI_RE = ReplicatedStorage:FindFirstChild("SyncBattleUI_RE") or Instance.new("RemoteEvent")
    syncBattleUI_RE.Name = "SyncBattleUI_RE"
    syncBattleUI_RE.Parent = ReplicatedStorage

   -- 修改：增加对 targetLevel 的支持，并在开始前刷新植物
    -- 修改：增加对 targetLevel 的支持，并在开始前刷新植物
    startBattleRE.OnServerEvent:Connect(function(player, targetLevel)
        local plot = PlotService.GetPlayerPlot(player)
        if not plot or plot:GetAttribute("IsLevelActive") then return end

        -- 👇 【新增这一行核心修复代码】：强行清除上一局残留的撤退/结束标记
        plot:SetAttribute("IsGameOver", false)

        -- [🌟 优化方案]：不再先销毁后重连，而是执行原地复活逻辑
        local CombatService = require(script.Parent.CombatService)
        
        -- 1. 瞬间重置地块上已存在的植物（满血、变回可见）
        ZombieService.RestorePlotPlants(plot, player)
        
        -- 2. 同步存档中的新植物（如果有的话）
        CombatService.ReloadSavedPlants(player)

        local levelId = targetLevel or 1 
        print("【关卡系统】玩家 " .. player.Name .. " 战斗刷新：第 " .. levelId .. " 关")

        ZombieService.StartLevel(plot, levelId, player)
    end)

    endBattleRE.OnServerEvent:Connect(function(player)
        local plot = PlotService.GetPlayerPlot(player)
    
        -- 如果没在战斗中，直接无视
        if not plot or not plot:GetAttribute("IsLevelActive") then return end

        local currentLevel = plot:GetAttribute("CurrentLevel") or 1
        AnalyticsService:LogCustomEvent(player, "Manual_Retreat_Level_" .. tostring(currentLevel), 1)

        print("【关卡系统】玩家 " .. player.Name .. " 选择了手动撤退")

        -- 1. 标记游戏结束
        plot:SetAttribute("IsGameOver", true)
        
        -- 2. 强力清理专属场地的僵尸，加上 OwnerId 判断
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:GetAttribute("IsZombie") and obj:GetAttribute("OwnerId") == player.UserId then
                obj:Destroy()
            end
        end

        -- ==========================================
        -- 👇 [🌟 核心修复：第二步精确落位] 👇
        -- ==========================================
        -- 引入 CombatService (动态引入防止循环依赖)
        local CombatService = require(script.Parent.CombatService)
        
        -- 调用我们刚才写好的“超级恢复函数”
        -- 这一行代码会把隐身的、残血的、被炸掉的植物彻底满血复原！
        CombatService.ReloadSavedPlants(player)
        -- ==========================================
        
        -- 3. 强制触发结算
        ZombieService.FinalSettlement(player, plot, false)
    end)
    
    Players.PlayerAdded:Connect(function(player)
        task.spawn(function()
            local plot = nil
            while player.Parent do
                plot = PlotService.GetPlayerPlot(player)
                if plot then break end
                task.wait(1)
            end
            
            if plot then
                plot:GetAttributeChangedSignal("IsLevelActive"):Connect(function()
                    if not plot:GetAttribute("IsLevelActive") then
                        syncBattleUI_RE:FireClient(player, false, 1, 0, 0)
                    end
                end)
            end
        end)
    end)
    local analyticsRE = ReplicatedStorage:FindFirstChild("AnalyticsRE") or Instance.new("RemoteEvent")
    analyticsRE.Name = "AnalyticsRE"
    analyticsRE.Parent = ReplicatedStorage

    
end

return LevelService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">LuckyDropService</string>
            <string name="Source"><![CDATA[local LuckyDropService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local PlotService = require(script.Parent.PlotService) 

local QUALITY_WEIGHTS = { [1] = 45, [2] = 30, [3] = 15, [4] = 8, [5] = 2 }
local AIRDROP_DROP_DURATION = 20

function LuckyDropService.OnAirdropDelivered(player, dropPosition, luckyBox)
    print("【空投】" .. player.Name .. " 成功将空投运回基地！")
    
    -- 👇 [🌟 恢复 100% 正常移速]
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid:GetAttribute("WalkSpeedBeforeAirdrop") then
        humanoid.WalkSpeed = humanoid:GetAttribute("WalkSpeedBeforeAirdrop")
        humanoid:SetAttribute("WalkSpeedBeforeAirdrop", nil)
    end

    if luckyBox then luckyBox:Destroy() end

    local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
    if not itemModels then return end

    -- 👇 [🌟 获取玩家头顶的实时位置的函数]
    local function getOverheadCFrame()
        local currentChar = player.Character
        local head = currentChar and currentChar:FindFirstChild("Head")
        if head then
            -- 在玩家头部正上方 3.5 格处（留出一点空间防穿模）
            return CFrame.new(head.Position + Vector3.new(0, 3.5, 0))
        end
        -- 如果玩家突然死亡或找不到头，退回保底的基地中心上方
        return CFrame.new(dropPosition + Vector3.new(0, 3, 0))
    end

    local plantsByQuality = {}
    local allPlantIds = {} 
    for plantId, data in pairs(ItemConfig.Plants) do
        local q = data.Quality or 1
        if not plantsByQuality[q] then plantsByQuality[q] = {} end
        table.insert(plantsByQuality[q], plantId)
        table.insert(allPlantIds, plantId)
    end

    local totalWeight = 0
    for q, weight in pairs(QUALITY_WEIGHTS) do
        if plantsByQuality[q] and #plantsByQuality[q] > 0 then totalWeight += weight end
    end

    local randomRoll = math.random() * totalWeight
    local currentWeight = 0
    local targetQuality = 1
    for q, weight in pairs(QUALITY_WEIGHTS) do
        if plantsByQuality[q] and #plantsByQuality[q] > 0 then
            currentWeight += weight
            if randomRoll <= currentWeight then
                targetQuality = q
                break
            end
        end
    end

    local possiblePlants = plantsByQuality[targetQuality]
    local finalPlantId = possiblePlants[math.random(1, #possiblePlants)]

    local displayModel
    -- 👇 [🌟 修改盲盒抽奖时长]
    local totalDuration = 3.5 
    local interval = 0.15 
    local iterations = math.floor(totalDuration / interval)

    -- [🌟 滚动抽奖动画阶段]
    for i = 1, iterations do
        if displayModel then displayModel:Destroy() end
        local randomId = allPlantIds[math.random(1, #allPlantIds)]
        local template = itemModels:FindFirstChild(randomId .. "_Plant")
        if template then
            displayModel = template:Clone()
            for _, part in pairs(displayModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Color = Color3.new(0, 0, 0)
                    part.Material = Enum.Material.SmoothPlastic
                    if part:IsA("MeshPart") then part.TextureID = "" end
                    part.Anchored = true
                    part.CanCollide = false
                end
            end
            local highlight = Instance.new("Highlight")
            highlight.FillColor = Color3.new(0, 0, 0)
            highlight.FillTransparency = 0
            highlight.OutlineColor = Color3.new(1, 1, 1)
            highlight.Parent = displayModel

            if not displayModel.PrimaryPart then displayModel.PrimaryPart = displayModel:FindFirstChildWhichIsA("BasePart", true) end
            
            -- 👇 [🌟 改为在玩家头顶显示，每次循环获取最新位置]
            displayModel:PivotTo(getOverheadCFrame())
            displayModel.Parent = Workspace
        end
        task.wait(interval)
    end

    if displayModel then displayModel:Destroy() end
    local finalTemplate = itemModels:FindFirstChild(finalPlantId .. "_Plant")
    if not finalTemplate then return end

    -- [🌟 最终揭晓阶段]
    displayModel = finalTemplate:Clone()
    for _, part in pairs(displayModel:GetDescendants()) do
        if part:IsA("BasePart") then 
            part.Anchored = true 
            part.CanCollide = false
         end
    end
    -- 👇 [🌟 核心修复] 遍历并关闭最终模型上的 "Glow", "Lightning", "HolyLight" 变异特效
    for _, node in ipairs(displayModel:GetDescendants()) do
        if node.Name == "Glow" or node.Name == "Lightning" or node.Name == "HolyLight" then
            for _, child in ipairs(node:GetDescendants()) do
                if child:IsA("ParticleEmitter") or child:IsA("Light") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("Trail") then
                    child.Enabled = false
                end
            end
        end
    end

    if not displayModel.PrimaryPart then displayModel.PrimaryPart = displayModel:FindFirstChildWhichIsA("BasePart", true) end
    
    -- 👇 [🌟 最终开出的植物也锁定在玩家头顶]
    displayModel:PivotTo(getOverheadCFrame())
    displayModel.Parent = Workspace

    local glow = Instance.new("Highlight")
    glow.FillColor = ItemConfig.QualityColor[targetQuality] or Color3.new(1, 1, 1)
    glow.OutlineColor = Color3.new(1, 1, 1)
    glow.Parent = displayModel

    task.wait(0.5) 

    displayModel:Destroy()
    
    local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
    local EquipmentService = require(script.Parent.EquipmentService)
    
    -- 👇 1. 发放植物并刷新背包
    PlayerDataManager.GivePlant(player, finalPlantId, 1, 1)
    
    -- 👇 2. 直接拿在手里！
    local compositeId = "Plant_" .. finalPlantId .. "_1"
    EquipmentService.UpdateHoldItem(player, compositeId)

    local showTipRE = ReplicatedStorage:FindFirstChild("ShowTipRE")
    if showTipRE then
        local plantName = ItemConfig.Plants[finalPlantId] and ItemConfig.Plants[finalPlantId].Name or finalPlantId
        local broadcastMsg = player.Name .. " successfully claimed a " .. plantName .. " from the Airdrop!"
        showTipRE:FireAllClients(broadcastMsg)
    end
end

function LuckyDropService.SpawnDrop()
    local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
    local luckyTemplate = itemModels and itemModels:FindFirstChild("Lucky")
    if not luckyTemplate then return end

    local luckyBox = luckyTemplate:Clone()
    if not luckyBox.PrimaryPart then luckyBox.PrimaryPart = luckyBox:FindFirstChildWhichIsA("BasePart", true) end
    
    -- ==========================================
    -- [E 键拾取交互]
    -- ==========================================
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Pickup Airdrop"
    prompt.ObjectText = "Mystery Box"
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.HoldDuration = 0.5 
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 12
    prompt.Parent = luckyBox.PrimaryPart

    prompt.Triggered:Connect(function(player)
        -- 👇 [🌟 核心修复：防抢夺并发] 检查是否已经被别人抢先拿到了，如果有，立刻终止！
        if luckyBox:GetAttribute("Carrier") then 
            return 
        end
        prompt.Enabled = false
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid") 
        if not head or not hrp or not humanoid then prompt.Enabled = true return end

        local myPlot = PlotService.GetPlayerPlot(player)
        if not myPlot then prompt.Enabled = true return end
        local plotCenter = myPlot.PrimaryPart or myPlot:FindFirstChildWhichIsA("BasePart", true)
        if not plotCenter then prompt.Enabled = true return end

        -- 👇 [🌟 设置携带者属性，供客户端过滤 UI（保留原本的 AirdropBox 标签）]
        luckyBox:SetAttribute("Carrier", player.UserId) 

        -- ==========================================
        -- [在解除固定前，先把箱子内部的所有零件互相焊死]
        -- ==========================================
        local primary = luckyBox.PrimaryPart
        for _, p in pairs(luckyBox:GetDescendants()) do
            if p:IsA("BasePart") and p ~= primary then 
                local innerWeld = Instance.new("WeldConstraint")
                innerWeld.Part0 = primary
                innerWeld.Part1 = p
                innerWeld.Parent = primary
            end
        end

        -- ==========================================
        -- [彻底关闭箱子的碰撞和重力，解除空中固定]
        -- ==========================================
        for _, p in pairs(luckyBox:GetDescendants()) do
            if p:IsA("BasePart") then 
                p.CanCollide = false 
                p.Massless = true    
                p.Anchored = false   
            end
        end
        
        -- 移到玩家头顶
        luckyBox:PivotTo(head.CFrame * CFrame.new(0, (primary.Size.Y/2) + (head.Size.Y/2) + 0.5, 0))
        
        -- 👇 [🌟 将主零件焊接到玩家头上，并且把 Weld 放在 Head 下面并命名]
        local weld = Instance.new("WeldConstraint")
        weld.Name = "AirdropWeld"
        weld.Part0 = head
        weld.Part1 = primary
        weld.Parent = head

        -- ==========================================
        -- 👇 [🌟 记录当前移速并减速 10%]
        -- ==========================================
        if not humanoid:GetAttribute("WalkSpeedBeforeAirdrop") then
            humanoid:SetAttribute("WalkSpeedBeforeAirdrop", humanoid.WalkSpeed)
        end
        humanoid.WalkSpeed = humanoid:GetAttribute("WalkSpeedBeforeAirdrop") * 0.9

        -- ==========================================
        -- [引导光束代码]
        -- ==========================================
        local att0 = Instance.new("Attachment", hrp)
        local att1 = Instance.new("Attachment", plotCenter)
        att1.Position = Vector3.new(0, 3, 0) 

        local beam = Instance.new("Beam")
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Texture = "rbxassetid://6661208797" 
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 5 
        beam.TextureSpeed = 3  
        beam.Width0 = 3
        beam.Width1 = 3
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 0)) 
        beam.Parent = char

        -- ==========================================
        -- [🌟 循环检测是否到达基地或被抢夺]
        -- ==========================================
        task.spawn(function()
            while luckyBox and luckyBox.Parent and char and char.Parent do
                task.wait(0.5)
                
                -- 👇防抢夺检测：如果头上的 AirdropWeld 消失了，说明被别人打爆/抢走了，立刻中断并清理光线特效！
                if not head:FindFirstChild("AirdropWeld") then
                    break 
                end

                local dist = (hrp.Position - plotCenter.Position).Magnitude
                if dist <= 22 then
                    if beam then beam:Destroy() end
                    if att0 then att0:Destroy() end
                    if att1 then att1:Destroy() end
                    
                    LuckyDropService.OnAirdropDelivered(player, plotCenter.Position, luckyBox)
                    break
                end
            end
            
            -- 清理内存：防止玩家中途死亡或被抢导致特效残留
            if beam then beam:Destroy() end
            if att0 then att0:Destroy() end
            if att1 then att1:Destroy() end
        end)
    end)

    -- 落地位置计算
    local baseplate = Workspace:FindFirstChild("Baseplate1")
    local spawnY, targetY, dropX, dropZ = 150, 3, 0, 0
    if baseplate then
        local randomX = (math.random() - 0.5) * (baseplate.Size.X * 0.85)
        local randomZ = (math.random() - 0.5) * (baseplate.Size.Z * 0.85)
        local targetCFramePos = baseplate.CFrame * CFrame.new(randomX, 0, randomZ)
        dropX, dropZ = targetCFramePos.X, targetCFramePos.Z
        targetY = targetCFramePos.Y + (baseplate.Size.Y / 2) + (luckyBox.PrimaryPart.Size.Y / 2)
    end

    local startCFrame = CFrame.new(dropX, spawnY, dropZ)
    local targetCFrame = CFrame.new(dropX, targetY, dropZ)
    
    for _, part in pairs(luckyBox:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = true end
    end
    luckyBox:PivotTo(startCFrame)

    CollectionService:AddTag(luckyBox, "AirdropBox")
    luckyBox.Parent = Workspace

    local tweenValue = Instance.new("NumberValue")
    local dropTween = TweenService:Create(tweenValue, TweenInfo.new(AIRDROP_DROP_DURATION, Enum.EasingStyle.Linear), {Value = 1})
    
    tweenValue:GetPropertyChangedSignal("Value"):Connect(function()
        if luckyBox and luckyBox.Parent then luckyBox:PivotTo(startCFrame:Lerp(targetCFrame, tweenValue.Value)) end
    end)

    dropTween:Play()
    dropTween.Completed:Connect(function()
        if luckyBox and luckyBox.Parent then
            local balloons = luckyBox:FindFirstChild("Balloons")
            if balloons then balloons:Destroy() end

            local head = luckyBox:FindFirstChild("Head")
            local smoke = head and head:FindFirstChild("Smoke")
            if smoke then smoke.Enabled = true end
        end
        tweenValue:Destroy()
        Debris:AddItem(luckyBox, 300)
    end)
end

function LuckyDropService.Init()
    local showTipRE = ReplicatedStorage:WaitForChild("ShowTipRE", 10)
    task.spawn(function()
        while true do
            task.wait(120) 
            for timeLeft =10, 1, -1 do
                if showTipRE then showTipRE:FireAllClients("Mystery Random Plant Airdrop in " .. timeLeft .. "s") end
                task.wait(1)
            end
            LuckyDropService.SpawnDrop()
        end
    end)
end

return LuckyDropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PlantCombatAI</string>
            <string name="Source">-- src/server/Services/PlantCombatAI.luau
local PlantCombatAI = {}

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
-- 👇 [🌟 增加这一行，把特效工具箱拿过来]
local EffectUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EffectUtil"))

local function GetSafeGameSpeed(plot)
    local speedMult = plot and tonumber(plot:GetAttribute("GameSpeed")) or 1
    if speedMult ~= 1 and speedMult ~= 2 and speedMult ~= 4 then
        return 1
    end
    return speedMult
end

-- ==========================================
-- [🌟 新增：受击变红反馈逻辑]
-- ==========================================
local function FlashZombieRed(zombieModel)
    -- 如果僵尸已经处于变红状态，直接返回，不再记录颜色
    if zombieModel:GetAttribute("IsFlashing") then return end
    zombieModel:SetAttribute("IsFlashing", true)
    
    local originalColors = {}
    
    -- 记录并变红
    for _, p in pairs(zombieModel:GetDescendants()) do
        if p:IsA("BasePart") then
            originalColors[p] = p.Color
            p.Color = Color3.fromRGB(255, 80, 80) -- 明显的受击红
        end
    end
    
    -- 0.15秒后恢复原色
    task.delay(0.15, function()
        -- 核心防御：如果僵尸已被销毁，不再执行恢复逻辑
        if not zombieModel or not zombieModel.Parent then return end
        
        -- 👇 [🌟 核心修复]：检查僵尸是否在此期间被炸弹炸成了焦黑状态
        local isCharred = zombieModel:GetAttribute("IsCharred")
        
        for p, color in pairs(originalColors) do
            if p and p.Parent then
                -- 如果被炸黑了，强制保持焦黑色 (30,30,30)；否则正常恢复原色
                p.Color = isCharred and Color3.fromRGB(30, 30, 30) or color
            end
        end
        
        -- 解除状态锁
        zombieModel:SetAttribute("IsFlashing", false)
    end)
end

-- ==========================================
-- [1. 伤害文字与受击特效通用函数]
-- ==========================================
function PlantCombatAI.ShowDamageText(zombieModel, damage)
    local rootPart = zombieModel:FindFirstChild("HumanoidRootPart") or zombieModel.PrimaryPart
    local head = zombieModel:FindFirstChild("Head") or rootPart
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DamageText"
    billboard.Size = UDim2.new(0, 60, 0, 25)
    
    local rx = math.random(-10, 10) / 10
    local ry = math.random(5, 15) / 10
    local rz = math.random(-10, 10) / 10
    billboard.StudsOffset = Vector3.new(rx, 1.5 + ry, rz)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 150

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "-" .. tostring(damage)
    textLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.FredokaOne
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = billboard

    billboard.Parent = head

    local tweenInfo = TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(billboard, tweenInfo, { StudsOffset = billboard.StudsOffset + Vector3.new(0, 1.5, 0) })
    local textTween = TweenService:Create(textLabel, tweenInfo, { TextTransparency = 1, TextStrokeTransparency = 1 })

    tween:Play()
    textTween:Play()
    Debris:AddItem(billboard, 1.0) 
end

-- ==========================================
-- [🌟 极简特效函数：直接复制，原汁原味]
-- ==========================================
local function PlayHitEffect(hitPos, itemDetail)
    local effectPart = Instance.new("Part")
    effectPart.Size = Vector3.new(0.1, 0.1, 0.1)
    effectPart.Transparency = 1
    effectPart.Anchored = true
    effectPart.CanCollide = false
    effectPart.Position = hitPos
    effectPart.Parent = Workspace

    local hitEffectName = itemDetail and itemDetail.HitEffectTexture
    local hitFolder = ReplicatedStorage:FindFirstChild("Hit")
    local hitEffectPrefab = nil

    if typeof(hitEffectName) == "string" and hitEffectName ~= "" and hitFolder then
        local template = hitFolder:FindFirstChild(hitEffectName)
        if template and template:IsA("BasePart") then
            hitEffectPrefab = template
        end
    end

    if hitEffectPrefab then
        local clone = hitEffectPrefab:Clone()
        clone.Anchored = true
        clone.CanCollide = false
        clone.CFrame = CFrame.new(hitPos)
        clone.Parent = Workspace

        -- 等一瞬间让客户端先渲染出克隆体，避免 Roblox 吞掉瞬发 Emit
        task.wait(0.05)

        for _, child in ipairs(clone:GetDescendants()) do
            if child:IsA("ParticleEmitter") then
                local emitCount = child:GetAttribute("EmitCount")
                if not emitCount then
                    local countValueNode = child:FindFirstChild("EmitCount")
                    if countValueNode and (countValueNode:IsA("IntValue") or countValueNode:IsA("NumberValue")) then
                        emitCount = countValueNode.Value
                    end
                end

                emitCount = tonumber(emitCount)
                if not emitCount or emitCount &lt;= 0 then
                    emitCount = 15
                end

                child.Enabled = true
                child:Emit(emitCount)
                task.delay(0.15, function()
                    if child and child.Parent then
                        child.Enabled = false
                    end
                end)
            elseif child:IsA("Light") then
                child.Enabled = true
                task.delay(0.15, function()
                    if child and child.Parent then
                        child.Enabled = false
                    end
                end)
            end
        end

        Debris:AddItem(clone, 1.5)
    else
        local attachment = Instance.new("Attachment", effectPart)
        local particles = Instance.new("ParticleEmitter", attachment)
        particles.Texture = (itemDetail and itemDetail.HitEffectTexture) or "rbxassetid://243098098"
        particles.Color = ColorSequence.new((itemDetail and itemDetail.HitEffectColor) or Color3.fromRGB(255, 215, 0))
        particles.Size = NumberSequence.new(1, 0)
        particles.Rate = 0
        particles.Speed = NumberRange.new(5, 10)
        particles.Lifetime = NumberRange.new(0.1, 0.3)
        particles:Emit(15)
    end
    
    Debris:AddItem(effectPart, 1.5)
end

-- ==========================================
-- [2. 子弹开火与命中逻辑]
-- ==========================================
local function FireProjectile(plant, targetZombieModel, targetHum, itemDetail, attackDamage, plot)
    local rootPart = plant.PrimaryPart or plant:FindFirstChildWhichIsA("BasePart")
    local targetRoot = targetZombieModel:FindFirstChild("HumanoidRootPart") or targetZombieModel.PrimaryPart
    if not rootPart or not targetRoot then return end

    local projName = itemDetail.ProjectileName
    local ammoFolder = ReplicatedStorage:FindFirstChild("Ammo")
    local projTemplate = ammoFolder and ammoFolder:FindFirstChild(projName)
    if not projTemplate then return end

    local projectile = projTemplate:Clone()
    projectile.CanCollide = false 
    projectile.Anchored = true

    local fireCFrame = rootPart.CFrame * CFrame.new(0, 1.5, -1.5) 
    local posNode = plant:FindFirstChild("pos", true) or plant:FindFirstChild("Pos", true)
    if posNode then
        if posNode:IsA("Attachment") then fireCFrame = posNode.WorldCFrame
        elseif posNode:IsA("BasePart") then fireCFrame = posNode.CFrame end
    end
    
    projectile.CFrame = fireCFrame
    projectile.Parent = Workspace
    Debris:AddItem(projectile, 10) 

    task.spawn(function()
        local baseSpeed = 25 
        local hasHit = false
        local startPos = projectile.Position
        local initialTargetPos = targetRoot.Position + Vector3.new(0, 1, 0)
        local initialDist = (initialTargetPos - startPos).Magnitude
        local flightTime = initialDist / baseSpeed
        local elapsedTime = 0
        local arcHeight = itemDetail.ArcHeight or 0
        
        while projectile and projectile.Parent do
            if not targetZombieModel.Parent or targetHum.Health &lt;= 0 then
                projectile:Destroy()
                break
            end

            local currentSpeedMult = plot:GetAttribute("GameSpeed") or 1
            local dtLoop = task.wait() 
            local targetPos = targetRoot.Position + Vector3.new(0, 1, 0)
            
            if arcHeight &gt; 0 then
                elapsedTime += dtLoop * currentSpeedMult
                local t = math.clamp(elapsedTime / flightTime, 0, 1)
                local p0 = startPos
                local p2 = targetPos
                local p1 = p0:Lerp(p2, 0.5) + Vector3.new(0, arcHeight, 0)
                local currentPosUpdate = (1-t)^2 * p0 + 2*(1-t)*t * p1 + t^2 * p2
                
                if t &lt; 1 then
                    local nextT = math.clamp(t + 0.05, 0, 1)
                    local nextPos = (1-nextT)^2 * p0 + 2*(1-nextT)*nextT * p1 + nextT^2 * p2
                    if (nextPos - currentPosUpdate).Magnitude &gt; 0.001 then
                        projectile.CFrame = CFrame.lookAt(currentPosUpdate, nextPos)
                    else
                        projectile.Position = currentPosUpdate
                    end
                else
                    hasHit = true
                    break
                end
            else
                local currentPosUpdate = projectile.Position
                local direction = (targetPos - currentPosUpdate)
                local distanceToTarget = direction.Magnitude
                local moveStep = baseSpeed * currentSpeedMult * dtLoop
                
                if distanceToTarget &lt;= moveStep then
                    hasHit = true; break
                else
                    projectile.CFrame = CFrame.lookAt(currentPosUpdate + direction.Unit * moveStep, targetPos)
                end
            end
        end
        
        if projectile and projectile.Parent then projectile:Destroy() end
        
        -- [子弹命中处理]
        if hasHit and targetHum and targetHum.Health &gt; 0 then
            targetHum.Health = targetHum.Health - attackDamage
            
            -- [🌟 修复：呼叫变红反馈和伤害数字]
            FlashZombieRed(targetZombieModel)
            PlantCombatAI.ShowDamageText(targetZombieModel, attackDamage)
            
            local zombieChestPos = targetRoot.Position + Vector3.new(0, 1, 0) 
            local toPlantDir = (rootPart.Position - targetRoot.Position) 
            local flatDir = Vector3.new(toPlantDir.X, 0, toPlantDir.Z)
            
            if flatDir.Magnitude &gt; 0.001 then flatDir = flatDir.Unit else flatDir = Vector3.new(1, 0, 0) end
            local hitPos = zombieChestPos + flatDir * 1.2
            
            PlayHitEffect(hitPos, itemDetail)
        end
    end)
end

-- ==========================================
-- [3. 射手类植物 AI]
-- ==========================================
function PlantCombatAI.StartIdleAnimation(plant, itemDetail)
    if plant:GetAttribute("PlantCombatIdleStarted") then
        return
    end
    plant:SetAttribute("PlantCombatIdleStarted", true)

    task.spawn(function()
        local idleAnimTrack = nil
        local animController = plant:FindFirstChildOfClass("AnimationController") or plant:FindFirstChildOfClass("Humanoid")
        local animator = animController and (animController:FindFirstChildOfClass("Animator") or Instance.new("Animator", animController))

        if itemDetail.IdleAnimId and itemDetail.IdleAnimId ~= "" and animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = itemDetail.IdleAnimId
            idleAnimTrack = animator:LoadAnimation(anim)
            idleAnimTrack.Priority = Enum.AnimationPriority.Idle
            idleAnimTrack.Looped = true
            idleAnimTrack:Play(0.1)
            anim:Destroy()
        end

        while plant.Parent and (plant:GetAttribute("Health") or 1) &gt; 0 and not plant:GetAttribute("IsDead") do
            task.wait(1)
        end

        if idleAnimTrack then
            idleAnimTrack:Stop(0.1)
            idleAnimTrack:Destroy()
        end
        if plant then
            plant:SetAttribute("PlantCombatIdleStarted", nil)
        end
    end)
end

function PlantCombatAI.StartShooterAI(plant, itemDetail, mutationLevel, plot)
    if plant:GetAttribute("ShooterAIStarted") then
        return
    end
    plant:SetAttribute("ShooterAIStarted", true)

    task.spawn(function()
        local attackInterval = itemDetail.AttackInterval or 1.5
        local baseAttackDamage = itemDetail.Attack or 20
        local stats = ItemConfig.MutationStats[mutationLevel] or ItemConfig.MutationStats[1]
        local attackDamage = math.floor(baseAttackDamage * stats.DamageMul)
        
        local animController = plant:FindFirstChildOfClass("AnimationController") or plant:FindFirstChildOfClass("Humanoid")
        local animator = animController and animController:FindFirstChildOfClass("Animator")
        
        local attackAnimTrack = nil
        if itemDetail.AttackAnimation and itemDetail.AttackAnimation ~= "" and animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = itemDetail.AttackAnimation
            attackAnimTrack = animator:LoadAnimation(anim)
            attackAnimTrack.Priority = Enum.AnimationPriority.Action
            attackAnimTrack.Looped = false
            anim:Destroy()

            -- ==========================================
            -- 👇 [🌟 新增：在这里监听攻击动画打好的关键帧！]
            -- ==========================================
            attackAnimTrack:GetMarkerReachedSignal("VFX"):Connect(function()
             
                EffectUtil.PlayAttackVFX(plant)
            end)
            -- ==========================================
        end

        local idleAnimTrack = nil
        if itemDetail.IdleAnimId and itemDetail.IdleAnimId ~= "" and animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = itemDetail.IdleAnimId
            idleAnimTrack = animator:LoadAnimation(anim)
            idleAnimTrack.Priority = Enum.AnimationPriority.Idle
            idleAnimTrack.Looped = true
            anim:Destroy()
        end

        while plant.Parent do
            local hp = plant:GetAttribute("Health") or 0
            if hp &lt;= 0 or plant:GetAttribute("IsDead") then task.wait(0.5); continue end

            local speedMult = GetSafeGameSpeed(plot)
            local rootPart = plant.PrimaryPart or plant:FindFirstChildWhichIsA("BasePart")
            if not rootPart then task.wait(0.5); continue end

            local overlapParams = OverlapParams.new()
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
            overlapParams.FilterDescendantsInstances = {plant}
            
            local checkCFrame = rootPart.CFrame * CFrame.new(0, 0, -50)
            local checkSize = Vector3.new(4, 5, 100) 
            local hitParts = Workspace:GetPartBoundsInBox(checkCFrame, checkSize, overlapParams)
            
            local targetZombieModel, targetHum = nil, nil
            local minDistance = math.huge 

            for _, part in ipairs(hitParts) do
                if part.CollisionGroup == "Zombies" then
                    local zModel = part:FindFirstAncestorOfClass("Model")
                    if zModel then
                       -- ==========================================
                        -- 👇 [🌟 核心修复 1]：对比僵尸和地块的主人 ID
                        local zombieOwnerId = zModel:GetAttribute("OwnerId")
                        local plotOwnerId = plot and plot:GetAttribute("OwnerId")
                        
                        -- 如果僵尸有主人，地块也有主人，且两者不是同一个人，说明是别人家的僵尸！忽略！
                        if zombieOwnerId and plotOwnerId and zombieOwnerId ~= plotOwnerId then
                            continue 
                        end
                        -- ==========================================

                        local zHum = zModel:FindFirstChildOfClass("Humanoid")
                        local zRoot = zModel:FindFirstChild("HumanoidRootPart") or zModel.PrimaryPart
                       
                        if zHum and zHum.Health &gt; 0 and zRoot then
                            local dist = (zRoot.Position - rootPart.Position).Magnitude
                            if dist &lt; minDistance then
                                minDistance = dist
                                targetZombieModel = zModel
                                targetHum = zHum
                            end
                        end
                    end
                end
            end

            if targetZombieModel and targetHum then
                if attackAnimTrack then
                    if idleAnimTrack then idleAnimTrack:Stop(0.1) end
                    attackAnimTrack:Stop()
                    attackAnimTrack:Play(0.1)
                    attackAnimTrack:AdjustSpeed(speedMult)
                end

                local windUpTime = math.min(0.3, attackInterval * 0.2) / speedMult
                task.wait(windUpTime)

                if plant.Parent and (plant:GetAttribute("Health") or 0) &gt; 0 then
                    FireProjectile(plant, targetZombieModel, targetHum, itemDetail, attackDamage, plot)
                end
                
                local cooldown = math.max(0.1, attackInterval - windUpTime) / speedMult
                task.wait(cooldown)
                
                if idleAnimTrack and not idleAnimTrack.IsPlaying then
                    idleAnimTrack:Play(0.1)
                end
            else
                -- 【🌟修复2】：如果没有僵尸，立刻停止可能残留的攻击动作
                if attackAnimTrack and attackAnimTrack.IsPlaying then
                    attackAnimTrack:Stop(0.1)
                end

                if idleAnimTrack and not idleAnimTrack.IsPlaying then
                    idleAnimTrack:Play(0.1)
                end
                task.wait(0.1 / speedMult)
            end
        end

        if attackAnimTrack then
            attackAnimTrack:Stop(0.1)
            attackAnimTrack:Destroy()
        end
        if idleAnimTrack then
            idleAnimTrack:Stop(0.1)
            idleAnimTrack:Destroy()
        end
        if plant then
            plant:SetAttribute("ShooterAIStarted", nil)
        end
    end)
end

-- ==========================================
-- [4. 爆炸类植物 AI (🌟 已重构：纯起爆逻辑)]
-- ==========================================
function PlantCombatAI.TriggerExplosion(plant, itemDetail, mutationLevel)
    -- 防多次起爆锁
    if plant:GetAttribute("Exploded") then return end
    plant:SetAttribute("Exploded", true)
    
    local rootPart = plant.PrimaryPart or plant:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return end

    local checkCFrame = rootPart.CFrame
    local checkSize = Vector3.new(14, 10, 14)
    if itemDetail.ExplosionType == "Row" then checkSize = Vector3.new(4, 15, 100) end

    local overlapParams = OverlapParams.new()
    local hitParts = Workspace:GetPartBoundsInBox(checkCFrame, checkSize, overlapParams)
    local damagedZombies = {} 

    for _, part in ipairs(hitParts) do
        if part.CollisionGroup == "Zombies" then
            local zModel = part:FindFirstAncestorOfClass("Model")
            if zModel and not damagedZombies[zModel] then
                -- 不炸别人家的僵尸
                local myPlot = plant.Parent and plant.Parent.Parent and plant.Parent.Parent.Parent
                local plotOwnerId = myPlot and myPlot:GetAttribute("OwnerId")
                local zombieOwnerId = zModel:GetAttribute("OwnerId")

                if zombieOwnerId and plotOwnerId and zombieOwnerId ~= plotOwnerId then
                    continue 
                end

                damagedZombies[zModel] = true
                local zHum = zModel:FindFirstChildOfClass("Humanoid")
                
                if zHum and zHum.Health &gt; 0 then
                    local baseExplosionDamage = itemDetail.ExplosionDamage or 1800
                    local stats = ItemConfig.MutationStats[mutationLevel] or ItemConfig.MutationStats[1]
                    local explosionDamage = math.floor(baseExplosionDamage * stats.DamageMul)
                    
                    zHum.Health = zHum.Health - explosionDamage
                    
                    PlantCombatAI.ShowDamageText(zModel, explosionDamage)
                    
                    -- ==========================================
                    -- 👇 瞬间变黑，不再调用 FlashZombieRed
                    -- ==========================================
                    zModel:SetAttribute("IsCharred", true)
                    
                    for _, p in pairs(zModel:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.Color = Color3.fromRGB(30, 30, 30)
                            p.Material = Enum.Material.Slate -- 变成粗糙的焦炭质感
                        end
                        if p:IsA("MeshPart") then
                            p.TextureID = "" -- 剥离模型自带的彩色贴图
                        end
                        if p:IsA("Decal") or p:IsA("Texture") then
                            p.Transparency = 1 -- 隐藏脸部/表面贴图
                        end
                        if p:IsA("Clothing") or p:IsA("Shirt") or p:IsA("Pants") or p:IsA("ShirtGraphic") or p:IsA("CharacterMesh") then
                            p:Destroy() -- 把衣服瞬间烧光
                        end
                    end
                end
            end
        end
    end

    local effectPart = Instance.new("Part")
    effectPart.Anchored = true; effectPart.CanCollide = false; effectPart.Transparency = 1
    effectPart.Parent = Workspace

    if itemDetail.ExplosionType == "Row" then
        effectPart.Size = Vector3.new(6, 1, 100) 
        effectPart.Position = rootPart.Position - Vector3.new(0, 1.5, 0)
        local particles = Instance.new("ParticleEmitter", effectPart)
        particles.Texture = "rbxassetid://248625108" 
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 85, 0))
        particles.Lifetime = NumberRange.new(0.05, 0.12)
        particles.LightEmission = 1
        particles.EmissionDirection = Enum.NormalId.Top 
        particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 10)})
        particles.Rate = 2000
        particles.Speed = NumberRange.new(15, 30)
        task.delay(0.5, function() particles.Enabled = false end)
    else
        effectPart.Position = rootPart.Position
        local attachment = Instance.new("Attachment", effectPart)
        local particles = Instance.new("ParticleEmitter", attachment)
        particles.Texture = "rbxassetid://243098098"
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 100, 0))
        particles.Size = NumberSequence.new(1, 15)
        particles.Rate = 500
        particles.Speed = NumberRange.new(10, 20)
        particles.Lifetime = NumberRange.new(0.2, 0.4)
        particles.SpreadAngle = Vector2.new(180, 180)
        task.delay(0.2, function() particles.Enabled = false end)
    end

    Debris:AddItem(effectPart, 2)
    
    for _, p in pairs(plant:GetDescendants()) do
        if p:IsA("BasePart") then 
            p.Transparency = 1 
        elseif p:IsA("ParticleEmitter") or p:IsA("Light") or p:IsA("Beam") or p:IsA("Highlight") or p:IsA("Trail") then
            p.Enabled = false
        end
    end
    task.delay(1, function() if plant then plant:Destroy() end end)
end

return PlantCombatAI</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PlantGrowthService</string>
            <string name="Source">-- src/server/Services/PlantGrowthService.luau
-- 职责：纯粹负责植物的模型生成、生长表现、变异特效、成熟逻辑
local PlantGrowthService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local NumberFormatUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormatUtil"))
local PlotService = require(script.Parent.PlotService)
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local CoinDropService = require(script.Parent.CoinDropService)

-- [终极特效控制系统：支持 Attachment 容器穿透]
function PlantGrowthService.ApplyMutationEffects(model, mutationLevel)
    mutationLevel = mutationLevel or 1
    local effectMap = { [2] = "Glow", [3] = "Lightning", [4] = "HolyLight" }
    
    for lvl, fxName in pairs(effectMap) do
        local shouldEnable = (mutationLevel == lvl)
        for _, node in ipairs(model:GetDescendants()) do
            if node.Name == fxName then
                for _, child in ipairs(node:GetDescendants()) do
                    if child:IsA("ParticleEmitter") or child:IsA("Light") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("Trail") then
                        child.Enabled = shouldEnable
                    end
                end
            end
        end
    end
end

-- [生成成熟植物]
function PlantGrowthService.SpawnMaturePlant(soil, itemDetail, plot, plantsFolder, savedMutation)
    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    local matureModelName = itemDetail.YieldPlant .. "_Plant"
    local matureModel = itemModelsFolder:FindFirstChild(matureModelName) or itemModelsFolder:FindFirstChild(itemDetail.YieldPlant)
    if not matureModel then return nil end
    
    local plotNum = tonumber(string.match(plot.Name, "%d+")) or 1
    local yRotation = (plotNum &lt;= 4) and CFrame.Angles(0, math.rad(90), 0) or CFrame.Angles(0, math.rad(90), 0)
    
    local grownPlant = matureModel:Clone()
    grownPlant.Name = itemDetail.YieldPlant
    grownPlant:SetAttribute("IsMature", true)
    grownPlant:SetAttribute("PlantedOn", soil.Name)
    
    local maxYield = itemDetail.YieldCount or 1
    grownPlant:SetAttribute("MaxYield", maxYield)
    grownPlant:SetAttribute("YieldCount", maxYield)
    
    local mutationLevel = savedMutation or 1
    grownPlant:SetAttribute("MutationLevel", mutationLevel)
    local ownerId = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if PlotService.GetPlayerPlot(p) == plot then ownerId = p.UserId; break end
    end
    grownPlant:SetAttribute("OwnerId", ownerId)
    
    if grownPlant:IsA("Model") and grownPlant.PrimaryPart then
        grownPlant:PivotTo(soil.CFrame * CFrame.new(0, soil.Size.Y/2 + grownPlant.PrimaryPart.Size.Y/2, 0) * yRotation)
    elseif grownPlant:IsA("BasePart") then
        grownPlant.CFrame = soil.CFrame * CFrame.new(0, soil.Size.Y/2 + grownPlant.Size.Y/2, 0) * yRotation
    end
    
    local plantConfig = ItemConfig.Plants[itemDetail.YieldPlant]
    local targetAnimId = plantConfig and plantConfig.IdleAnimId
    for _, part in pairs(grownPlant:GetDescendants()) do
        if part:IsA("BasePart") then 
            part.CanCollide = false
            if targetAnimId and grownPlant.PrimaryPart and part == grownPlant.PrimaryPart then
                part.Anchored = true
            elseif part.Name == "Glow" or part.Name == "HolyLight" or part.Name == "Lightning" then
                part.Anchored = true
            else
                part.Anchored = not targetAnimId 
            end
        end
    end
    
    if targetAnimId then
        local animController = grownPlant:FindFirstChildOfClass("AnimationController") or grownPlant:FindFirstChildOfClass("Humanoid")
        if not animController then animController = Instance.new("AnimationController"); animController.Parent = grownPlant end
        local animator = animController:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = animController end
        local anim = Instance.new("Animation"); anim.AnimationId = targetAnimId
        local track = animator:LoadAnimation(anim); track.Priority = Enum.AnimationPriority.Idle; track.Looped = true; track:Play()
    end

    PlantGrowthService.ApplyMutationEffects(grownPlant, mutationLevel)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MatureUI"
    billboard.Size = UDim2.new(0, 160, 0, 55)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 50
    
    local bgFrame = Instance.new("Frame")
    bgFrame.Size = UDim2.new(1, 0, 1, 0)
    bgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bgFrame.BackgroundTransparency = 0.4
    local bgCorner = Instance.new("UICorner"); bgCorner.CornerRadius = UDim.new(0, 8); bgCorner.Parent = bgFrame
    bgFrame.Parent = billboard

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(1, 0, 0.45, 0)
    statusLabel.Position = UDim2.new(0, 0, 0.05, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusLabel.TextScaled = true
    statusLabel.Font = Enum.Font.FredokaOne
    
    local mutName = ItemConfig.MutationName and ItemConfig.MutationName[mutationLevel] or ""
    statusLabel.Text = (mutationLevel &gt; 1) and ("⭐" .. mutName) or "Loading..."
    statusLabel.Parent = bgFrame

    local barBg = Instance.new("Frame")
    barBg.Name = "BarBg"
    barBg.Size = UDim2.new(0.9, 0, 0.35, 0)
    barBg.Position = UDim2.new(0.05, 0, 0.55, 0)
    barBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    barBg.BackgroundTransparency = 0.5
    local barCorner = Instance.new("UICorner"); barCorner.CornerRadius = UDim.new(0, 4); barCorner.Parent = barBg
    barBg.Parent = bgFrame

    local barFill = Instance.new("Frame")
    barFill.Name = "BarFill"
    barFill.Size = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(255, 215, 0) 
    local fillCorner = Instance.new("UICorner"); fillCorner.CornerRadius = UDim.new(0, 4); fillCorner.Parent = barFill
    barFill.Parent = barBg

    local progressText = Instance.new("TextLabel")
    progressText.Name = "ProgressText"
    progressText.Size = UDim2.new(1, 0, 1, 0)
    progressText.BackgroundTransparency = 1
    progressText.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressText.TextStrokeTransparency = 0.2
    progressText.TextScaled = true
    progressText.Font = Enum.Font.SourceSansBold
    progressText.ZIndex = 2
    progressText.Text = maxYield .. " / " .. maxYield
    progressText.Parent = barBg

    grownPlant:GetAttributeChangedSignal("YieldCount"):Connect(function()
        local current = grownPlant:GetAttribute("YieldCount") or 0
        local max = grownPlant:GetAttribute("MaxYield") or 1
        local ratio = math.clamp(current / max, 0, 1)
        TweenService:Create(barFill, TweenInfo.new(0.3), {Size = UDim2.new(ratio, 0, 1, 0)}):Play()
        progressText.Text = current .. " / " .. max
    end)
    
    local rootPart = grownPlant:IsA("Model") and grownPlant.PrimaryPart or grownPlant
    billboard.Parent = rootPart
    grownPlant.Parent = plantsFolder
    if plantConfig and plantConfig.Quality and plantConfig.Quality &gt;= 5 then
        -- 1. 获取地块主人的名字用于广播
        local ownerName = "Unknown"
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId == ownerId then
                ownerName = p.Name
                break
            end
        end
        -- 【核心修复】：改用 ShowTipRE 触发全服 UIEffectUtil.ShowTip
        -- ==========================================
        local showTipRE = ReplicatedStorage:FindFirstChild("ShowTipRE")
        if showTipRE then
            local msg = "[" .. ownerName .. "]'s 5-Star rare plant [" .. plantConfig.Name .. "] has matured!"
            showTipRE:FireAllClients(msg) -- 触发全服广播
        end
        -- 3. 在 3D 场景中创建一个如同实体模型般的“Legendary”悬浮文字
        local legendaryBillboard = Instance.new("BillboardGui")
        legendaryBillboard.Name = "LegendaryTagUI"
        
        -- 【核心修复】：使用 Scale 也就是 3D 物理单位(Studs)，而不是像素。
        -- 这里的 4.5 和 1.2 代表它在场景中的实际物理宽高。它将和模型一样近大远小。
        legendaryBillboard.Size = UDim2.new(4.5, 0, 1.2, 0) 
        
        legendaryBillboard.StudsOffset = Vector3.new(0, 5.2, 0) 
        
        -- 【核心修复】：关闭 AlwaysOnTop，开启 LightInfluence，让它完全融入 3D 世界
        legendaryBillboard.AlwaysOnTop = false -- 开启真实空间遮挡，不再穿透模型
        legendaryBillboard.LightInfluence = 1 -- 接受场景的光照影响，就像真实模型一样
        legendaryBillboard.MaxDistance = 150 

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "Legendary"
        textLabel.TextColor3 = Color3.fromRGB(255, 170, 0) 
        textLabel.Font = Enum.Font.FredokaOne 
        textLabel.TextScaled = true 
        
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextStrokeTransparency = 0

        textLabel.Parent = legendaryBillboard
        legendaryBillboard.Parent = rootPart
    end

    return grownPlant -- [保留原有的这行返回]
end

-- [生成幼苗]
function PlantGrowthService.CreateSeedling(seedId, soil, itemDetail, plantedTime, plot, plantsFolder)
    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    local seedModelName = itemDetail.SeedId or "PlantSeed"
    local realModel = itemModelsFolder:FindFirstChild(seedModelName)

    if not realModel then return nil end

    local plotNum = tonumber(string.match(plot.Name, "%d+")) or 1
    local yRotation = (plotNum &lt;= 4) and CFrame.Angles(0, math.rad(90), 0) or CFrame.Angles(0, math.rad(-90), 0)

    local newPlant = realModel:Clone()
    newPlant.Name = seedId
    newPlant:SetAttribute("YieldPlant", itemDetail.YieldPlant)
    newPlant:SetAttribute("GrowthTime", itemDetail.GrowthTime)
    newPlant:SetAttribute("PlantedOn", soil.Name) 
    newPlant:SetAttribute("PlantedTime", plantedTime)

    if newPlant:IsA("Model") and newPlant.PrimaryPart then
        newPlant:PivotTo(soil.CFrame * CFrame.new(0, soil.Size.Y/2 + newPlant.PrimaryPart.Size.Y/2, 0) * yRotation)
    elseif newPlant:IsA("BasePart") then
        newPlant.CFrame = soil.CFrame * CFrame.new(0, soil.Size.Y/2 + newPlant.Size.Y/2, 0) * yRotation
    end

    for _, part in pairs(newPlant:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = true; part.CanCollide = true end
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "GrowthUI"
    billboard.Size = UDim2.new(0, 180, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 50
    
    local bgFrame = Instance.new("Frame")
    bgFrame.Size = UDim2.new(1, 0, 1, 0)
    bgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bgFrame.BackgroundTransparency = 0.4
    local bgCorner = Instance.new("UICorner"); bgCorner.CornerRadius = UDim.new(0, 8); bgCorner.Parent = bgFrame
    bgFrame.Parent = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0.45, 0)
    nameLabel.Position = UDim2.new(0, 0, 0.05, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.Text = itemDetail.Name
    nameLabel.Parent = bgFrame

    local barBg = Instance.new("Frame")
    barBg.Name = "BarBg"
    barBg.Size = UDim2.new(0.9, 0, 0.35, 0)
    barBg.Position = UDim2.new(0.05, 0, 0.55, 0)
    barBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    barBg.BackgroundTransparency = 0.5
    local barCorner = Instance.new("UICorner"); barCorner.CornerRadius = UDim.new(0, 4); barCorner.Parent = barBg
    barBg.Parent = bgFrame

    local barFill = Instance.new("Frame")
    barFill.Name = "BarFill"
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(85, 255, 127) 
    local fillCorner = Instance.new("UICorner"); fillCorner.CornerRadius = UDim.new(0, 4); fillCorner.Parent = barFill
    barFill.Parent = barBg

    local progressText = Instance.new("TextLabel")
    progressText.Name = "ProgressText"
    progressText.Size = UDim2.new(1, 0, 1, 0)
    progressText.BackgroundTransparency = 1
    progressText.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressText.TextStrokeTransparency = 0.2
    progressText.TextScaled = true
    progressText.Font = Enum.Font.SourceSansBold
    progressText.ZIndex = 2
    progressText.Text = "⏳ --s"
    progressText.Parent = barBg
    
    local rootPart = newPlant:IsA("Model") and newPlant.PrimaryPart or newPlant
    billboard.Parent = rootPart
    newPlant.Parent = plantsFolder
    return newPlant
end

-- [开始植物生长循环]
function PlantGrowthService.StartPlantGrowth(player, plot, soil, itemDetail, newPlant, prompt, plantsFolder)
    task.spawn(function()
        local growthTime = itemDetail.GrowthTime
        -- 👇 1. 获取该植物种子的购买原价（保底100）
        local buyPrice = itemDetail.BuyPrice or 100 

        while newPlant and newPlant.Parent do
            local elapsed = os.time() - (newPlant:GetAttribute("PlantedTime") or os.time())
            local remaining = math.max(0, growthTime - elapsed)
           
            -- 用于植物头顶进度条的比例
            local progressRatio = math.clamp(elapsed / growthTime, 0, 1)
            
            local currentCost = buyPrice * 2

            local billboard = newPlant:FindFirstChild("GrowthUI", true)
            if remaining &gt; 0 then
                if billboard then 
                    billboard.Enabled = true 
                    local barFill = billboard:FindFirstChild("BarFill", true)
                    local progressText = billboard:FindFirstChild("ProgressText", true)
                    
                    if barFill then barFill.Size = UDim2.new(progressRatio, 0, 1, 0) end
                    -- 头顶UI继续显示倒计时秒数
                    if progressText then progressText.Text = "⏳ " .. remaining .. "s" end
                end

                -- 👇 3. 🌟 核心修复：把原先显示的秒数，替换为真实阳光花费！
                if prompt and prompt.Parent then 
                    -- 你可以把 Coins 改成 ☀️ 或者 阳光，只要你喜欢
                    prompt.ActionText = "Speed up (" .. NumberFormatUtil.FormatNumber(currentCost) .. " Coins)" 
                end
            else
                -- ==========================================
                -- 以下为植物成熟的代码，保持原样不动
                -- ==========================================
                local seedId = newPlant.Name 
                local finalItemDetail = itemDetail
                local finalPlantId = seedId

                if seedId == "RandomSeed" then
                    local data = PlayerDataManager.GetPlayerData(player)
                    local maxLevel = data and data.UnlockedLevel or 1
                    local maxPossibleId = math.clamp(maxLevel + 1, 1, #ItemConfig.IdToSeedKey)
                    
                    local randomNum = math.random(1, maxPossibleId)
                    finalPlantId = ItemConfig.IdToSeedKey[randomNum]
                    finalItemDetail = ItemConfig.Seeds[finalPlantId]

                    if data and not data.UnlockedSeeds[finalPlantId] then
                        PlayerDataManager.UnlockSeed(player, finalPlantId)
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        if showNotifRE then
                           showNotifRE:FireClient(player, "📖 Collection Unlocked!", "The seed grew into [" .. finalItemDetail.Name .. "]!\nAvailable in Shop!")
                        end
                    end
                    
                    PlayerDataManager.UpdatePlantedPlant(player, soil.Name, finalPlantId, os.time() - growthTime)
                end

                if billboard then billboard.Enabled = false end
                if prompt then prompt.Enabled = false end

                local seedParts = {}
                for _, part in pairs(newPlant:GetDescendants()) do
                    if part:IsA("BasePart") and part.Transparency &lt; 1 then table.insert(seedParts, part) end
                end

                if #seedParts &gt; 0 then
                    local pulseInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true)
                    local lastTween = nil
                    for _, part in ipairs(seedParts) do
                        local tween = TweenService:Create(part, pulseInfo, { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.5 })
                        tween:Play()
                        lastTween = tween 
                    end
                    if lastTween then lastTween.Completed:Wait() end
                end

                if player and player.Parent then
                    local dropPos = soil.Position + Vector3.new(0, 3, 0)
                    local totalCoinValue = finalItemDetail.Output or 20 
                    CoinDropService.DropCoins(player, dropPos, 5, totalCoinValue)
                end

                PlayerDataManager.MarkPlantAsDropped(player, soil.Name)

                if newPlant:IsA("Model") and newPlant.PrimaryPart then newPlant:ScaleTo(3) end
                for _, part in pairs(newPlant:GetDescendants()) do
                    if part:IsA("BasePart") then part.Transparency = 1 end 
                end

                task.wait(0.2) 

                local pData = PlayerDataManager.GetPlayerData(player)
                local savedMutation = pData and pData.PlantedPlants[soil.Name] and pData.PlantedPlants[soil.Name].Mutation or 1
                PlantGrowthService.SpawnMaturePlant(soil, finalItemDetail, plot, plantsFolder, savedMutation)
                newPlant:Destroy() 
                  
                if prompt then 
                    prompt.ActionText = "Harvest"
                    prompt.HoldDuration = 15 -- 成熟后变15秒长按
                    prompt.Enabled = true 
                end
                break 
            end
            task.wait(0.2)
        end
    end)
end

return PlantGrowthService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">PlantService</string>
            <string name="Source">-- src/server/Services/PlantService.luau
-- 职责：纯粹负责玩家互动(ProximityPrompt)、偷菜防守判定、数据加载、埋点
local PlantService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local AnalyticsService = game:GetService("AnalyticsService")
local CollectionService = game:GetService("CollectionService") -- [🌟 新增：引入 CollectionService 用于雷达标签]

local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local PlotService = require(script.Parent.PlotService)
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local EquipmentService = require(script.Parent.EquipmentService)
local CoinDropService = require(script.Parent.CoinDropService)

-- 引入拆分出的生命周期服务
local PlantGrowthService = require(script.Parent.PlantGrowthService)

function PlantService.Init()
    if not ReplicatedStorage:FindFirstChild("ShowNotificationRE") then
        local re = Instance.new("RemoteEvent")
        re.Name = "ShowNotificationRE"
        re.Parent = ReplicatedStorage
    end

    if not ReplicatedStorage:FindFirstChild("OpenInventoryRE") then
        local openInvRE = Instance.new("RemoteEvent")
        openInvRE.Name = "OpenInventoryRE"
        openInvRE.Parent = ReplicatedStorage
    end

    local plotsFolder = Workspace:WaitForChild("Plots")

    -- [1] 处理玩家加入时的数据还原
    Players.PlayerAdded:Connect(function(player)
        local data = PlayerDataManager.GetPlayerData(player)
        local waitLimit = 0
        
        while not data and waitLimit &lt; 20 do 
            task.wait(0.5)
            waitLimit += 1
            data = PlayerDataManager.GetPlayerData(player)
        end
        
        if not data then 
            warn("【植物还原】等待玩家数据超时，终止还原！")
            return 
        end

        local plot = nil
        for i = 1, 20 do
            plot = PlotService.GetPlayerPlot(player)
            if plot then break end
            task.wait(0.5)
        end
        if not plot then return end

        if not data.PlantedPlants then return end

        local soilsFolder = plot:FindFirstChild("Soils")
        local plantsFolder = plot:FindFirstChild("Plants")
        if not soilsFolder or not plantsFolder then return end

        for soilName, plantData in pairs(data.PlantedPlants) do
            local soil = soilsFolder:FindFirstChild(soilName)
            local itemDetail = ItemConfig.Seeds[plantData.SeedId]
            
            if soil and itemDetail then
                local prompt = soil:FindFirstChildOfClass("ProximityPrompt")
                local elapsed = os.time() - plantData.PlantedTime
                
                if elapsed &gt;= itemDetail.GrowthTime then
                    if not plantData.HasDropped then
                        local dropPos = soil.Position + Vector3.new(0, 3, 0)
                        CoinDropService.DropCoins(player, dropPos, 5, itemDetail.Output or 20)
                        PlayerDataManager.MarkPlantAsDropped(player, soilName)
                    end
                   
                    PlantGrowthService.SpawnMaturePlant(soil, itemDetail, plot, plantsFolder, plantData.Mutation)
                    if prompt then 
                        prompt.Enabled = false
                              
                        prompt.ActionText = "Harvest"
                        prompt.HoldDuration = 15 -- 还原数据时，成熟的也是15秒长按
                        prompt.Enabled = true 

                         task.delay(0.05, function()
                            if prompt and prompt.Parent then
                                prompt.Enabled = true
                            end
                        end)
                    end
                else
                    local newPlant = PlantGrowthService.CreateSeedling(plantData.SeedId, soil, itemDetail, plantData.PlantedTime, plot, plantsFolder)
                    if prompt then prompt.ActionText = "Speed up"; prompt.Enabled = true end
                    PlantGrowthService.StartPlantGrowth(player, plot, soil, itemDetail, newPlant, prompt, plantsFolder)
                end
            end
        end
    end)

    -- [2] 初始化所有地块的交互按键
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if not string.match(plot.Name, "Plot") then continue end

        local soilsFolder = plot:FindFirstChild("Soils")
        local plantsFolder = plot:FindFirstChild("Plants")
        
        if not soilsFolder or not plantsFolder then continue end

        for _, soil in ipairs(soilsFolder:GetChildren()) do
            if string.find(soil.Name, "Soil") and soil:IsA("BasePart") then
                local prompt = Instance.new("ProximityPrompt")
                prompt.Name = "PlantPrompt"
                prompt.ActionText = "Plant"
                prompt.ObjectText = "Soil"
                prompt.KeyboardKeyCode = Enum.KeyCode.E
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 8
                prompt.Parent = soil
                prompt.HoldDuration = 0.5
                if soil:GetAttribute("IsUnlocked") ~= true then
                    prompt.Enabled = false
                end

                soil:GetAttributeChangedSignal("IsUnlocked"):Connect(function()
                    if soil:GetAttribute("IsUnlocked") == true then
                        local targetPlant = nil
                        for _, plant in ipairs(plantsFolder:GetChildren()) do
                            if plant:GetAttribute("PlantedOn") == soil.Name then targetPlant = plant; break end
                        end
                        if not targetPlant then
                            prompt.ActionText = "Plant"
                            prompt.Enabled = true
                        end
                    else
                        prompt.Enabled = false
                    end
                end)

                -- ==========================================
                -- [全新机制：基于原生 Prompt 的偷菜与防守系统]
                -- ==========================================
                
                -- 【事件 1】：手指按下的瞬间 (判定秒收与报警)
                prompt.PromptButtonHoldBegan:Connect(function(player)
                    if soil:GetAttribute("IsUnlocked") ~= true then return end
                    
                    local targetPlant = nil
                    for _, plant in ipairs(plantsFolder:GetChildren()) do
                        if plant:GetAttribute("PlantedOn") == soil.Name then targetPlant = plant; break end
                    end
                    
                    if targetPlant and targetPlant:GetAttribute("IsMature") then
                        local myPlot = PlotService.GetPlayerPlot(player)
                        local isOwner = (myPlot == plot)
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        
                        if isOwner then
                            -- [主人专属特权]：按下瞬间立刻秒收，不需要等15秒！
                            local plantId = targetPlant.Name
                            local currentYield = targetPlant:GetAttribute("YieldCount") or 1
                            local mutLevel = targetPlant:GetAttribute("MutationLevel") or 1
                            local plantConfig = ItemConfig.Plants[plantId]
                            local plantName = plantConfig and plantConfig.Name or plantId
                            local mutPrefix = (mutLevel &gt; 1) and ("[".. (ItemConfig.MutationName[mutLevel] or "Mutation") .."] ") or ""

                            PlayerDataManager.GivePlant(player, plantId, currentYield, mutLevel)
                            PlayerDataManager.UnlockMutation(player, plantId, mutLevel)
                            PlayerDataManager.RemovePlantedPlant(player, soil.Name)
                            targetPlant:Destroy()

                            -- 👇 [🌟 新增：收获后自动装备]
                            local compositeId = "Plant_" .. plantId .. "_" .. mutLevel
                            local playerData = PlayerDataManager.GetPlayerData(player)
                            if playerData then
                                if not playerData.Hotbar then playerData.Hotbar = {} end
                                local inHotbar = false
                                for _, id in ipairs(playerData.Hotbar) do
                                    if id == compositeId then inHotbar = true; break end
                                end
                                
                                if not inHotbar and #playerData.Hotbar &lt; 10 then
                                    table.insert(playerData.Hotbar, compositeId)
                                    local updateInvRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                                    if updateInvRE then updateInvRE:FireClient(player, playerData) end
                                end
                                
                                local forceSelectRE = ReplicatedStorage:FindFirstChild("ForceSelectRE")
                                if forceSelectRE then
                                    forceSelectRE:FireClient(player, compositeId)
                                end
                            end
                            -- 👆 新增结束

                            prompt.Enabled = false
                            prompt.ActionText = "Plant"
                            prompt.HoldDuration = 0.5 -- 地空了，种地时间恢复为0.5秒
                            
                            task.delay(0.05, function()
                                if prompt and prompt.Parent then
                                    prompt.Enabled = true
                                end
                            end)
                            
                            local playObtainEffectRE = ReplicatedStorage:FindFirstChild("PlayObtainEffectRE")
                            if playObtainEffectRE then 
                                -- 把多段文字合并成一句
                                local msg = "Gain: " .. currentYield .. "x " .. mutPrefix .. plantName
                                playObtainEffectRE:FireClient(player, msg)
                            end
                        else
                            -- 2. 小偷按下E，开始死死按住15秒！
                            if targetPlant:GetAttribute("IsBeingStolen") then
                                if showNotifRE then showNotifRE:FireClient(player, "Notice", "Someone is already stealing this plant!") end
                                return
                            end
                            
                            targetPlant:SetAttribute("IsBeingStolen", true)
                            -- [🌟 新增：给这颗植物打上被偷的专属标签，供客户端雷达扫描]
                            CollectionService:AddTag(targetPlant, "BeingStolen")
                            
                            if showNotifRE then showNotifRE:FireClient(player, "Notice", "Stealing started!\nHold E for 15 seconds.") end
                            
                        end
                    end
                end)

                -- 【事件 2】：松手或被物理击飞导致强制中断
                prompt.PromptButtonHoldEnded:Connect(function(player)
                    local targetPlant = nil
                    for _, plant in ipairs(plantsFolder:GetChildren()) do
                        if plant:GetAttribute("PlantedOn") == soil.Name then targetPlant = plant; break end
                    end
                    if targetPlant and targetPlant:GetAttribute("IsBeingStolen") then
                        local myPlot = PlotService.GetPlayerPlot(player)
                        if myPlot ~= plot then -- 小偷没扛住松手了，或者被击飞了！
                            
                            -- ==========================================
                            -- 🌟【核心修复】：延迟 0.1 秒判定，避开底层事件冲突
                            -- ==========================================
                            task.wait(0.1)
                            if not targetPlant or not targetPlant.Parent then return end 

                            targetPlant:SetAttribute("IsBeingStolen", false)
                            -- [🌟 新增：中断时移除被偷标签]
                            CollectionService:RemoveTag(targetPlant, "BeingStolen")
                            
                            local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                            if showNotifRE then showNotifRE:FireClient(player, "Notice", "Stealing canceled!") end
                        end
                    end
                end)

                -- 【事件 3】：读条圆圈转满完成！
                prompt.Triggered:Connect(function(player)
                    if soil:GetAttribute("IsUnlocked") ~= true then return end
                    
                    local myPlot = PlotService.GetPlayerPlot(player)
                    local isOwner = (myPlot == plot)

                    local targetPlant = nil
                    for _, plant in ipairs(plantsFolder:GetChildren()) do
                        if plant:GetAttribute("PlantedOn") == soil.Name then targetPlant = plant; break end
                    end
                    
                    if targetPlant then
                        if targetPlant:GetAttribute("IsMature") then
                            -- 【成熟逻辑】：因为主人在按下瞬间就已经拿到了，所以能熬过 15 秒走到这里的只能是小偷！
                            if not isOwner and targetPlant:GetAttribute("IsBeingStolen") then
                                targetPlant:SetAttribute("IsBeingStolen", false)
                                -- [🌟 新增：成功得手时移除被偷标签]
                                CollectionService:RemoveTag(targetPlant, "BeingStolen")
                                
                                local plantId = targetPlant.Name
                                local currentYield = targetPlant:GetAttribute("YieldCount") or 1
                                local mutLevel = targetPlant:GetAttribute("MutationLevel") or 1
                                local plantConfig = ItemConfig.Plants[plantId]
                                local plantName = plantConfig and plantConfig.Name or plantId
                                local mutPrefix = (mutLevel &gt; 1) and ("[".. (ItemConfig.MutationName[mutLevel] or "Mutation") .."] ") or ""

                                -- 发放奖励给小偷
                                PlayerDataManager.GivePlant(player, plantId, currentYield, mutLevel)
                                PlayerDataManager.UnlockMutation(player, plantId, mutLevel)
                                
                                -- 扣除主人植物
                                local ownerId = targetPlant:GetAttribute("OwnerId") or 0
                                local ownerPlayer = nil
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if p.UserId == ownerId then ownerPlayer = p; break end
                                end
                                if ownerPlayer then
                                    PlayerDataManager.RemovePlantedPlant(ownerPlayer, soil.Name)
                                    local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                                    if showNotifRE then
                                        showNotifRE:FireClient(ownerPlayer, "Notice", "Your " .. plantName .. " was stolen by " .. player.Name .. "!")
                                    end
                                end
                                
                                targetPlant:Destroy()
                                
                                -- 👇 [🌟 新增：小偷得手后自动装备]
                                local compositeId = "Plant_" .. plantId .. "_" .. mutLevel
                                local playerData = PlayerDataManager.GetPlayerData(player)
                                if playerData then
                                    if not playerData.Hotbar then playerData.Hotbar = {} end
                                    local inHotbar = false
                                    for _, id in ipairs(playerData.Hotbar) do
                                        if id == compositeId then inHotbar = true; break end
                                    end
                                    
                                    if not inHotbar and #playerData.Hotbar &lt; 10 then
                                        table.insert(playerData.Hotbar, compositeId)
                                        local updateInvRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
                                        if updateInvRE then updateInvRE:FireClient(player, playerData) end
                                    end
                                    
                                    local forceSelectRE = ReplicatedStorage:FindFirstChild("ForceSelectRE")
                                    if forceSelectRE then
                                        forceSelectRE:FireClient(player, compositeId)
                                    end
                                end
                                -- 👆 新增结束

                                prompt.Enabled = false
                                prompt.ActionText = "Plant"
                                prompt.HoldDuration = 0.5

                                task.delay(0.05, function()
                                    if prompt and prompt.Parent then
                                        prompt.Enabled = true
                                    end
                                end)
                                                   
                                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                                if showNotifRE then 
                                    showNotifRE:FireClient(player, "Notice", "Steal Successful!\nYou stole: " .. currentYield .. "x " .. mutPrefix .. plantName)
                                end
                            end
                            return
                        else
                            -- 【未成熟加速逻辑】 
                            if not isOwner then
                                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                                if showNotifRE then showNotifRE:FireClient(player, "Notice", "You cannot speed up other players' plants!") end
                                return
                            end

                            local currentPlantedTime = targetPlant:GetAttribute("PlantedTime") or os.time()
                            local growthTime = targetPlant:GetAttribute("GrowthTime")
                            local remaining = math.max(0, growthTime - (os.time() - currentPlantedTime))
                            if remaining &gt; 0 then
                                local seedId = targetPlant.Name
                                local seedDetail = ItemConfig.Seeds[seedId]
                                local buyPrice = seedDetail and seedDetail.BuyPrice or 100

                                local cost = buyPrice * 2
                                
                                if PlayerDataManager.ConsumeCoins(player, cost) then
                                    local data = PlayerDataManager.GetPlayerData(player)
                                    AnalyticsService:LogEconomyEvent(player, Enum.AnalyticsEconomyFlowType.Sink, "Coins", cost, data and data.Coins or 0, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, "SpeedUpPlant_" .. tostring(targetPlant.Name))
                                   
                                    local newTime = os.time() - growthTime - 1
                                    targetPlant:SetAttribute("PlantedTime", newTime)
                                    PlayerDataManager.UpdatePlantedPlant(player, soil.Name, targetPlant.Name, newTime)
                                end
                            end
                            return
                        end
                    end

                    -- 【种植物的逻辑】 
                    if not isOwner then
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        if showNotifRE then showNotifRE:FireClient(player, "Notice", "This is someone else's plot.\nYou cannot plant here!") end
                        return
                    end

                    local character = player.Character; if not character then return end
                    local equippedCompositeId = character:GetAttribute("EquippedSeed")

                    if not equippedCompositeId then 
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        if showNotifRE then showNotifRE:FireClient(player, "Notice", "Please select a seed!") end
                        local openInvRE = ReplicatedStorage:FindFirstChild("OpenInventoryRE")
                        if openInvRE then openInvRE:FireClient(player) end
                        return 
                    end

                    local parts = string.split(equippedCompositeId, "_")
                    local itemType = parts[1]
                    local realId = parts[2]

                    if itemType ~= "Seed" then
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        if showNotifRE then showNotifRE:FireClient(player, "Notice", "Mature plants cannot be planted directly!") end
                        return
                    end

                    if PlayerDataManager.ConsumeSeed(player, realId, 1) then
                        local data = PlayerDataManager.GetPlayerData(player)
                        local remainingQuantity = 0
                        if data and data.Inventory and data.Inventory.Seeds then
                            for _, s in ipairs(data.Inventory.Seeds) do
                                if s.ID == realId then remainingQuantity = s.Quantity; break end
                            end
                        end
                        AnalyticsService:LogEconomyEvent(player, Enum.AnalyticsEconomyFlowType.Sink, "Seeds", 1, remainingQuantity, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, "FarmPlanting_" .. tostring(realId))
               
                        local hasStock = false
                        if data and data.Inventory.Seeds then
                            for _, seedData in ipairs(data.Inventory.Seeds) do
                                if seedData.ID == realId and seedData.Quantity &gt; 0 then hasStock = true; break end
                            end
                        end

                        if not hasStock then
                            EquipmentService.UpdateHoldItem(player, nil)
                            local holdItemRE = ReplicatedStorage:FindFirstChild("HoldItemRE")
                            if holdItemRE then holdItemRE:FireClient(player, nil) end
                        end

                        local itemDetail = ItemConfig.Seeds[realId]
                        if not itemDetail then return end
                       
                        local plantedTime = os.time()
                        PlayerDataManager.UpdatePlantedPlant(player, soil.Name, realId, plantedTime)

                        local newPlant = PlantGrowthService.CreateSeedling(realId, soil, itemDetail, plantedTime, plot, plantsFolder)
                        if newPlant then
                            prompt.ActionText = "Speed up"
                            prompt.Enabled = true
                            PlantGrowthService.StartPlantGrowth(player, plot, soil, itemDetail, newPlant, prompt, plantsFolder)
                        end
                    end
                end)
            end
        end
    end

    -- [3] 专门用于新手教程强制种植的 RemoteEvent
    local tutorialPlantRE = ReplicatedStorage:FindFirstChild("TutorialPlantRE") or Instance.new("RemoteEvent")
    tutorialPlantRE.Name = "TutorialPlantRE"
    tutorialPlantRE.Parent = ReplicatedStorage

    tutorialPlantRE.OnServerEvent:Connect(function(player, lawnName, plantId)
        local plot = PlotService.GetPlayerPlot(player)
        if not plot then return end

        local lawnFolder = plot:FindFirstChild("Lawn")
        local plantsFolder = plot:FindFirstChild("Plants")
        local targetLawn = lawnFolder and lawnFolder:FindFirstChild(lawnName)
        
        local itemDetail = ItemConfig.Seeds[plantId] or ItemConfig.Seeds["Peashooter"]
        
        if targetLawn and itemDetail then
            local plantedTime = os.time()
            PlayerDataManager.UpdatePlantedPlant(player, lawnName, plantId, plantedTime)

            local newPlant = PlantGrowthService.CreateSeedling(plantId, targetLawn, itemDetail, plantedTime, plot, plantsFolder)
            if newPlant then
                local prompt = targetLawn:FindFirstChildOfClass("ProximityPrompt")
                PlantGrowthService.StartPlantGrowth(player, plot, targetLawn, itemDetail, newPlant, prompt, plantsFolder)
            end
        end
    end)
end

return PlantService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source">-- src/server/Services/PlotService.luau
local PlotService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnalyticsService = game:GetService("AnalyticsService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local PlotUnlockConfig = require(ReplicatedStorage.Shared.PlotUnlockConfig)
local NumberFormatUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormatUtil"))
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)

local playerPlots = {}
local MAX_LEVEL_PART_NAME = "PlayerMaxLevelPart"

local function ClearMaxLevelPart(plot)
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj.Name == MAX_LEVEL_PART_NAME then
            obj:Destroy()
        end
    end
end

local function SpawnMaxLevelPart(plot, data)
    ClearMaxLevelPart(plot)

    local maxPos = plot:FindFirstChild("MAXPos", true)
    if not maxPos or not maxPos:IsA("BasePart") then
        warn("服务端：地块 " .. plot.Name .. " 中未找到 MAXPos，无法生成 Max Level 展示牌！")
        return
    end

    local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
    local template = itemModels and itemModels:FindFirstChild("ShowLevelPart")
    if not template then
        warn("服务端：ReplicatedStorage.ItemModels.ShowLevelPart 不存在，无法生成 Max Level 展示牌！")
        return
    end

    local showLevelPart = template:Clone()
    showLevelPart.Name = MAX_LEVEL_PART_NAME

    local billboardGui = showLevelPart:FindFirstChild("BillboardGui", true)
    local textLabel = billboardGui and billboardGui:FindFirstChild("TextLabel")
    if textLabel and textLabel:IsA("TextLabel") then
        textLabel.Text = "Max Lv." .. tostring(data and data.UnlockedLevel or 1)
    end

    if showLevelPart:IsA("Model") then
        local _, size = showLevelPart:GetBoundingBox()
        showLevelPart:PivotTo(maxPos.CFrame * CFrame.new(0, (maxPos.Size.Y / 2) + (size.Y / 2), 0))
    elseif showLevelPart:IsA("BasePart") then
        showLevelPart.CFrame = maxPos.CFrame * CFrame.new(0, (maxPos.Size.Y / 2) + (showLevelPart.Size.Y / 2), 0)
    end

    for _, part in ipairs(showLevelPart:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end
    if showLevelPart:IsA("BasePart") then
        showLevelPart.Anchored = true
    end

    showLevelPart.Parent = plot
end

local function ResetPlotForNextOwner(plot)
    local soilsFolder = plot:FindFirstChild("Soils")
    if soilsFolder then
        for _, soil in ipairs(soilsFolder:GetChildren()) do
            if soil:IsA("BasePart") and string.find(soil.Name, "Soil") then
                soil:SetAttribute("IsUnlocked", false)

                local unlockPrompt = soil:FindFirstChild("UnlockPrompt")
                if unlockPrompt then
                    unlockPrompt:Destroy()
                end

                -- 👇 [🌟 新增：玩家退出时清理木牌]
                local woodenSign = soil:FindFirstChild("WoodenSign")
                if woodenSign then
                    woodenSign:Destroy()
                end
                -- 👆 新增结束

                local plantPrompt = soil:FindFirstChild("PlantPrompt")
                if plantPrompt and plantPrompt:IsA("ProximityPrompt") then
                    plantPrompt.ActionText = "Plant"
                    plantPrompt.ObjectText = "Soil"
                    plantPrompt.Enabled = false
                    plantPrompt.HoldDuration = 0.5
                end
            end
        end
    end

    local lawnFolder = plot:FindFirstChild("Lawn")
    if lawnFolder then
        for _, lawnPart in ipairs(lawnFolder:GetChildren()) do
            if lawnPart:IsA("BasePart") then
                lawnPart:SetAttribute("OccupiedBy", nil)
                local prompt = lawnPart:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    prompt.Enabled = true
                end
            end
        end
    end

    local dave = plot:FindFirstChild("CrazyDave")
    if dave then
        local targetPart = dave.PrimaryPart or dave:FindFirstChildWhichIsA("BasePart")
        if targetPart then
            local prompt = targetPart:FindFirstChild("ShopPrompt")
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt.ActionText = "Open Shop"
                prompt.ObjectText = "Crazy Dave"
                prompt.Enabled = true
            end
        end
    end
end

function PlotService.AssignPlot(player)
    if playerPlots[player.UserId] then return playerPlots[player.UserId] end

    local data = PlayerDataManager.WaitForPlayerData(player)

    local plotsFolder = Workspace:WaitForChild("Plots")
    local chosenPlot = nil

    -- 寻找空闲地块
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if not plot:GetAttribute("OwnerId") and string.match(plot.Name, "Plot") then
            plot:SetAttribute("OwnerId", player.UserId)
            chosenPlot = plot
            playerPlots[player.UserId] = plot
            break
        end
    end

    if chosenPlot then
       chosenPlot:SetAttribute("GameSpeed", 1) 
        chosenPlot:SetAttribute("IsGameOver", false)
        chosenPlot:SetAttribute("IsLevelActive", false)

        ResetPlotForNextOwner(chosenPlot)

        SpawnMaxLevelPart(chosenPlot, data)
        
        -- 生成基地向日葵
        local BaseSunflowerService = require(script.Parent.BaseSunflowerService)
        BaseSunflowerService.SpawnSunflower(player, chosenPlot)

        -- 初始化并刷新这块基地里的泥土状态
        PlotService.UpdateSoilVisuals(player, chosenPlot)

        -- ==========================================
        -- [🌟 新增：生成玩家领地身份牌 (所有人可见)]
        -- ==========================================
      task.spawn(function()
        
            -- 获取头像数据
            local avatarUrl = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)

            -- ---------- 功能 A：恢复旧版的基地上方悬浮牌 (BillboardGui) ----------
           -- ---------- 功能 A：恢复旧版的基地上方悬浮牌 (BillboardGui) ----------
            -- 🚀 1. 改为查找基地内名为 "NameTag" 的模型或零件
            local nameTagObj = chosenPlot:FindFirstChild("NameTag", true)

            print("【排错】系统分配给玩家的地块是: " .. chosenPlot.Name .. " | 是否找到 NameTag: " .. tostring(nameTagObj ~= nil))
            local targetPart = nil
            
            if nameTagObj then
                if nameTagObj:IsA("Model") then
                    -- 【修改这里】：在找 BasePart 的时候加上 true，开启递归深度查找
                    targetPart = nameTagObj.PrimaryPart or nameTagObj:FindFirstChildWhichIsA("BasePart", true)
                elseif nameTagObj:IsA("BasePart") then
                    targetPart = nameTagObj
                end
            end

            -- 如果没有找到 NameTag，兜底使用原本的出生点
            if not targetPart then
                targetPart = chosenPlot:FindFirstChild("SpawnPoint") or chosenPlot:FindFirstChild("SpawnLocation") or chosenPlot:FindFirstChildWhichIsA("BasePart", true)
            end
            
            if targetPart then
                -- 清理可能残留的旧悬浮牌
                local existingBillboard = targetPart:FindFirstChild("OwnerBillboard")
                if existingBillboard then existingBillboard:Destroy() end

                local billboard = Instance.new("BillboardGui")
                billboard.Name = "OwnerBillboard"
                billboard.Size = UDim2.new(24, 0, 6, 0) 
                
                -- 🚀 2. 位置修改：悬浮在 NameTag 正上方 (可微调中间的 8 来改变高度)
                billboard.StudsOffset = Vector3.new(0, 20, 0) 
                
                billboard.AlwaysOnTop = true
                billboard.MaxDistance = 250 

                -- 1. 背景框
                local bgFrame = Instance.new("Frame")
                bgFrame.Size = UDim2.new(1, 0, 1, 0)
                bgFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                bgFrame.BackgroundTransparency = 0.5
                local bgCorner = Instance.new("UICorner")
                bgCorner.CornerRadius = UDim.new(0.2, 0)
                bgCorner.Parent = bgFrame
                bgFrame.Parent = billboard

                -- 2. 玩家头像
                local avatarImg = Instance.new("ImageLabel")
                avatarImg.Size = UDim2.new(0.2, 0, 0.8, 0)
                avatarImg.Position = UDim2.new(0.05, 0, 0.1, 0)
                avatarImg.BackgroundTransparency = 1
                avatarImg.Image = avatarUrl
                local avatarCorner = Instance.new("UICorner")
                avatarCorner.CornerRadius = UDim.new(1, 0)
                avatarCorner.Parent = avatarImg
                avatarImg.Parent = bgFrame

                -- 3. 装饰小图标
                local decIcon = Instance.new("ImageLabel")
                decIcon.Size = UDim2.new(0.1, 0, 0.4, 0)
                decIcon.Position = UDim2.new(0.28, 0, 0.3, 0)
                decIcon.BackgroundTransparency = 1
                decIcon.Image = "rbxassetid://10886326447"
                decIcon.Parent = bgFrame

               -- 4. 玩家昵称
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(0.55, 0, 1, 0)
                nameLabel.Position = UDim2.new(0.4, 0, 0, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = player.DisplayName 
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLabel.TextStrokeTransparency = 0.4
                nameLabel.Font = Enum.Font.FredokaOne
                nameLabel.TextScaled = true
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = bgFrame

                -- 👇 ============= 这里是关键修改区 ============= 👇
                
                -- 🚀 3. 显式指定 UI 要挂载的实体零件 (必须加这一句)
                billboard.Adornee = targetPart 
                
                billboard.Parent = targetPart
                
                -- 顺便打印一下到底挂在了哪个零件上，方便排错
                print("【UI生成】成功！已挂载至目标: " .. tostring(targetPart.Name))
            end

            -- ---------- 功能 B：额外功能 - 木牌上的表面显示 (SurfaceGui) ----------
            local paiModel = chosenPlot:FindFirstChild("pai", true)
            local targetPart = paiModel and paiModel:FindFirstChild("Text")


            
            if targetPart and targetPart:IsA("BasePart") then
                -- 清理旧的木牌 GUI
                if targetPart:FindFirstChild("PlayerIdentitySurfaceGui") then
                    targetPart.PlayerIdentitySurfaceGui:Destroy()
                end

                local surfaceGui = Instance.new("SurfaceGui")
                surfaceGui.Name = "PlayerIdentitySurfaceGui"
                surfaceGui.Face = Enum.NormalId.Front 
                surfaceGui.MaxDistance = 300 -- 您要求的300米可见
                surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                surfaceGui.PixelsPerStud = 50

                -- 木牌头像 (70% 高度)
                local sImg = Instance.new("ImageLabel")
                sImg.Size = UDim2.new(1, 0, 0.7, 0)
                sImg.BackgroundTransparency = 1
                sImg.Image = avatarUrl
                sImg.ScaleType = Enum.ScaleType.Fit
                sImg.Parent = surfaceGui

                -- 木牌名称 (30% 高度)
                local sText = Instance.new("TextLabel")
                sText.Size = UDim2.new(1, 0, 0.3, 0)
                sText.Position = UDim2.new(0, 0, 0.7, 0)
                sText.BackgroundTransparency = 1
                sText.Text = player.DisplayName
                sText.TextColor3 = Color3.new(1, 1, 1)
                sText.TextScaled = true
                sText.Font = Enum.Font.FredokaOne
                sText.TextStrokeTransparency = 0.5
                sText.Parent = surfaceGui

                surfaceGui.Parent = targetPart
                print("【UI生成】头像获取完毕，开始创建牌子...2222222222222222222222222222")
            end
        end)
        local dave = chosenPlot:FindFirstChild("CrazyDave")
        if dave then
            -- 寻找 Dave 身上的主零件来挂载提示符
            local targetPart = dave.PrimaryPart or dave:FindFirstChildWhichIsA("BasePart")
            if targetPart then
                -- 如果已经有了就不重复添加
                local existingPrompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt")
                if not existingPrompt then
                    local prompt = Instance.new("ProximityPrompt")
                    prompt.Name = "ShopPrompt"
                    prompt.ActionText = "Open Shop"
                    prompt.ObjectText = "Crazy Dave"
                    prompt.KeyboardKeyCode = Enum.KeyCode.E -- 绑定按键 E
                    prompt.RequiresLineOfSight = false
                    prompt.MaxActivationDistance = 10 -- 触发距离
                    prompt.HoldDuration = 0 -- 瞬间触发，不需要长按
                    prompt.Parent = targetPart
                end
                
                -- 同理，如果想要点击也能打开，就加个 ClickDetector
                local existingClick = targetPart:FindFirstChildWhichIsA("ClickDetector")
                if not existingClick then
                    local clicker = Instance.new("ClickDetector")
                    clicker.MaxActivationDistance = 15
                    clicker.Parent = targetPart
                end
            else
                warn("服务端：CrazyDave 模型内找不到任何 BasePart，无法挂载交互组件！")
            end
        else
            warn("服务端：在地块 " .. chosenPlot.Name .. " 中未找到 CrazyDave！")
        end

        -- 设置玩家位置逻辑 (保持不变)
        local function teleportToPlot(character)
            task.wait(0.1)
            local rootPart = character:WaitForChild("HumanoidRootPart", 5)
            if not rootPart then return end

            local spawnPart = chosenPlot:FindFirstChild("SpawnPoint") or chosenPlot:FindFirstChild("SpawnLocation")
            
            if spawnPart and spawnPart:IsA("BasePart") then
                character:PivotTo(spawnPart.CFrame * CFrame.new(0, 4, 0))
            else
                character:PivotTo(chosenPlot:GetPivot() * CFrame.new(0, 5, 20))
            end
        end

        if player.Character then teleportToPlot(player.Character) end
        player.CharacterAdded:Connect(teleportToPlot)
    end
    
    return chosenPlot
end

function PlotService.GetPlayerPlot(player) 
    return playerPlots[player.UserId] 
end

function PlotService.Init()
    Players.PlayerAdded:Connect(function(player)
        PlotService.AssignPlot(player)
    end)
    Players.PlayerRemoving:Connect(function(player)
        PlotService.ReleasePlot(player)
    end)
    
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(function()
            PlotService.AssignPlot(player)
        end)
    end

    local MarketplaceService = game:GetService("MarketplaceService")
    local SPEED_PASS_ID = 1811835638 
    
    local setSpeedRE = ReplicatedStorage:FindFirstChild("SetSpeedRE") or Instance.new("RemoteEvent")
    setSpeedRE.Name = "SetSpeedRE"
    setSpeedRE.Parent = ReplicatedStorage
    setSpeedRE.OnServerEvent:Connect(function(player, speed)
        local plot = PlotService.GetPlayerPlot(player)
        if plot then
            -- [🌟 服务端防作弊拦截]
            if speed == 4 then
                local hasPass = false
                pcall(function()
                    hasPass = MarketplaceService:UserOwnsGamePassAsync(player.UserId, SPEED_PASS_ID)
                end)
                
                -- 如果服务端查明该玩家没付过钱，直接 return 拦截请求！
                if not hasPass then
                    warn("玩家 " .. player.Name .. " 未购买通行证，尝试非法开启 4 倍速！")
                    return
                end
            end

            plot:SetAttribute("GameSpeed", speed)
            setSpeedRE:FireClient(player, speed)
        end
    end)
    
    print("服务端：PlotService 戴夫交互组件配置完毕！")
end

-- [🌟 核心逻辑：刷新泥土状态与视觉效果]
function PlotService.UpdateSoilVisuals(player, plot)
    local unlockedCount = PlayerDataManager.GetUnlockedPlots(player)
    local targetUnlockId = unlockedCount + 1 -- 玩家当前只能解锁这块地（循序渐进）

    -- 遍历地块内所有的零件，找到泥土
    for _, soil in ipairs(plot:GetDescendants()) do
        if soil:IsA("BasePart") then
            -- 提取泥土名字中的数字 (假设你的泥土名叫 Soil1, Soil2...)
            local soilId = tonumber(string.match(soil.Name, "%d+"))
            
            if soilId and string.find(soil.Name, "Soil") then
                -- 如果是第一次运行，把泥土原来的材质/颜色保存下来，方便解锁后恢复
                if not soil:GetAttribute("OriginalColor") then
                    soil:SetAttribute("OriginalColor", soil.Color)
                end

                local prompt = soil:FindFirstChild("UnlockPrompt")
                local woodenSign = soil:FindFirstChild("WoodenSign")

                if soilId &lt;= unlockedCount then
                    -- 🟢 情况1：已解锁
                    soil:SetAttribute("IsUnlocked", true)
                    soil.Color = soil:GetAttribute("OriginalColor") -- 恢复原本颜色
                    if prompt then prompt:Destroy() end -- 移除购买提示
                    if woodenSign then woodenSign:Destroy() end -- 解锁后销毁木牌

                elseif soilId == targetUnlockId then
                    -- 🟡 情况2：当前可解锁的下一块地
                    soil:SetAttribute("IsUnlocked", false)
                    soil.Color = Color3.fromRGB(218, 179, 51) -- 变成黄色

                    -- 生成待解锁提示木牌
                    if not woodenSign then
                        local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
                        local signTemplate = itemModels and itemModels:FindFirstChild("WoodenSign")
                        
                        if signTemplate then
                            woodenSign = signTemplate:Clone()
                            woodenSign.Name = "WoodenSign"
                            
                            -- 坐标计算
                            if woodenSign:IsA("Model") then
                                local _, size = woodenSign:GetBoundingBox()
                                local yOffset = (soil.Size.Y / 2) + (size.Y / 2)
                                woodenSign:PivotTo(soil.CFrame * CFrame.new(0, yOffset, 0))
                            elseif woodenSign:IsA("BasePart") then
                                local yOffset = (soil.Size.Y / 2) + (woodenSign.Size.Y / 2)
                                woodenSign.CFrame = soil.CFrame * CFrame.new(0, yOffset, 0)
                            end
                            
                            -- 取消碰撞并焊死
                            for _, part in ipairs(woodenSign:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = false
                                    part.Anchored = true
                                end
                            end
            
                            -- 在 NegativePart 上生成 Unlock 文本
                            local negativePart = woodenSign:FindFirstChild("NegativePart", true)
                            if negativePart and negativePart:IsA("BasePart") then
                                if negativePart:FindFirstChild("UnlockTextGui") then
                                    negativePart.UnlockTextGui:Destroy()
                                end

                                local surfaceGui = Instance.new("SurfaceGui")
                                surfaceGui.Name = "UnlockTextGui"
                                surfaceGui.Face = Enum.NormalId.Front
                                surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                                surfaceGui.PixelsPerStud = 50
                                surfaceGui.AlwaysOnTop = false 

                                local textLabel = Instance.new("TextLabel")
                                textLabel.Size = UDim2.new(1, 0, 1, 0)
                                textLabel.BackgroundTransparency = 1
                                textLabel.Text = "Unlock"
                                textLabel.TextColor3 = Color3.new(1, 1, 1)
                                textLabel.TextScaled = true
                                textLabel.Font = Enum.Font.FredokaOne
                                textLabel.TextStrokeTransparency = 0.5
                                textLabel.Parent = surfaceGui

                                surfaceGui.Parent = negativePart
                            end
                            woodenSign.Parent = soil
                        end
                    end

                    -- 👇 [🌟 核心修复区：挂载购买提示，且仅对目标地块生效]
                    if not prompt then
                        prompt = Instance.new("ProximityPrompt")
                        prompt.Name = "UnlockPrompt"
                        prompt.ActionText = "Unlock Plot"
                        prompt.KeyboardKeyCode = Enum.KeyCode.E
                        prompt.RequiresLineOfSight = false
                        prompt.MaxActivationDistance = 8
                        prompt.HoldDuration = 0.5 -- [🌟 修复2] 必须长按0.5秒，杜绝按键连发穿透多块地！
                        prompt.Parent = soil

                        -- 当玩家长按 E 键时触发购买
                        prompt.Triggered:Connect(function(triggerPlayer)
                            if triggerPlayer ~= player then return end -- 只有地块主人能买
                            local price = PlotUnlockConfig.UnlockPrices[soilId]
                            
                            -- 扣除金币，如果成功则解锁
                            if price and PlayerDataManager.ConsumeCoins(player, price) then
                                local data = PlayerDataManager.GetPlayerData(player)
                                AnalyticsService:LogEconomyEvent(
                                    player,
                                    Enum.AnalyticsEconomyFlowType.Sink,
                                    "Coins",
                                    price,
                                    data and data.Coins or 0,
                                    Enum.AnalyticsEconomyTransactionType.Gameplay.Name,
                                    "UnlockPlot_Soil_" .. tostring(soilId)
                                )
                                PlayerDataManager.IncrementUnlockedPlots(player)
                                PlotService.UpdateSoilVisuals(player, plot) -- 刷新所有土地状态
                            else
                                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                                if showNotifRE then 
                                    showNotifRE:FireClient(player, "Notice", "Not enough coins!") 
                                end
                            end
                        end)
                    end
                    -- 更新提示框上显示的价格
                    prompt.ObjectText = "Price:" .. NumberFormatUtil.FormatNumber(PlotUnlockConfig.UnlockPrices[soilId])
                    -- 👆 [核心修复区结束]

                else
                    -- 🔴 情况3：未来才能解锁的地（跳级的地）
                    soil:SetAttribute("IsUnlocked", false)
                    soil.Color = Color3.fromRGB(163, 124, 18) -- 变成绿色
                    if prompt then prompt:Destroy() end -- 没有任何交互
                    if woodenSign then woodenSign:Destroy() end -- 兜底销毁
                end
            end
        end
    end
end
-- [🌟 新增：玩家退出时彻底清理地块]
function PlotService.ReleasePlot(player)
    local userId = player.UserId
    local plot = playerPlots[userId]
    
    if plot then
        print("【地块系统】玩家 " .. player.Name .. " 已退出，正在回收地块: " .. plot.Name)
        
        -- 0. 先停止战斗状态，避免后台刷怪协程继续运行
        plot:SetAttribute("IsGameOver", true)
        plot:SetAttribute("IsLevelActive", false)

        local okZombie, ZombieService = pcall(function()
            return require(script.Parent.ZombieService)
        end)
        if okZombie and ZombieService and ZombieService.CleanupPlayerBattle then
            ZombieService.CleanupPlayerBattle(player)
        end
        
        -- 1. 彻底销毁地块上的所有植物
        local plantsFolder = plot:FindFirstChild("Plants")
        if plantsFolder then
            for _, plant in ipairs(plantsFolder:GetChildren()) do
                plant:Destroy()
            end
        end

        -- 1.5 彻底销毁草坪上的战斗植物
        local lawnFolder = plot:FindFirstChild("Lawn")
        if lawnFolder then
            for _, lawnPart in ipairs(lawnFolder:GetChildren()) do
                if lawnPart:IsA("BasePart") then
                    for _, child in ipairs(lawnPart:GetChildren()) do
                        if child:GetAttribute("IsCombatPlant") then
                            child:Destroy()
                        end
                    end
                end
            end
        end
        -- 2.1 销毁悬浮牌 (OwnerBillboard)
        local spawnPart = plot:FindFirstChild("SpawnPoint") or plot:FindFirstChild("SpawnLocation") or plot:FindFirstChildWhichIsA("BasePart", true)
        if spawnPart then
            local billboard = spawnPart:FindFirstChild("OwnerBillboard")
            if billboard then billboard:Destroy() end
        end

       -- 2. 销毁身份名牌 (PlayerIdentitySurfaceGui)
        local paiModel = plot:FindFirstChild("pai", true)
        local targetPart = paiModel and paiModel:FindFirstChild("Text")
        
        if targetPart then
            local identityGui = targetPart:FindFirstChild("PlayerIdentitySurfaceGui")
            if identityGui then identityGui:Destroy() end
            
            -- 兜底清理旧版的纯名字名牌
            local oldNameGui = targetPart:FindFirstChild("PlayerNameSurfaceGui")
            if oldNameGui then oldNameGui:Destroy() end
        end

        local collectSunPart = plot:FindFirstChild("CollectSun", true)
        if collectSunPart then
            local harvestPrompt = collectSunPart:FindFirstChild("HarvestPrompt")
            if harvestPrompt then
                harvestPrompt:Destroy()
            end
        end

        -- 2.5 销毁 Max Level 展示牌
        ClearMaxLevelPart(plot)

        -- 3. 兜底销毁场上的 OwnerId 关联对象（僵尸、基地向日葵、其他专属模型）
        for _, obj in pairs(game.Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:GetAttribute("OwnerId") == userId then
                obj:Destroy()
            end
        end

        for _, obj in ipairs(plot:GetChildren()) do
            if obj:IsA("Model") and obj:GetAttribute("OwnerId") == userId then
                obj:Destroy()
            end
        end

        -- 4. 重置地块交互与视觉状态，让下一个玩家接手时是干净的
        ResetPlotForNextOwner(plot)

        -- 5. 重置地块属性，让其他新玩家可以占用
        plot:SetAttribute("OwnerId", nil)
        plot:SetAttribute("IsLevelActive", false)
        plot:SetAttribute("IsGameOver", false)
        plot:SetAttribute("CurrentLevel", 1)
        plot:SetAttribute("ActiveZombies", 0)
        plot:SetAttribute("ZombiesDefeated", 0)
        plot:SetAttribute("GameSpeed", 1)
        
        -- 6. 从缓存中移除
        playerPlots[userId] = nil
    end
end

return PlotService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">RankingService</string>
            <string name="Source">-- src/server/Services/RankingService.luau
local RankingService = {}

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RankingStore = DataStoreService:GetOrderedDataStore("LevelRanking_v1")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)

local EntryTemplate = ReplicatedStorage:WaitForChild("UITemplates"):WaitForChild("EntryTemplate")

-- 配置
local UPDATE_INTERVAL = 60 -- 每分钟刷新一次显示
local TOP_COUNT = 60 -- 显示前10名

local function GetRankingLists()
    local lists = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.sub(obj.Name, 1, #"Ranking_Level") == "Ranking_Level" then
            local rankingGui = obj:FindFirstChild("RankingGui", true)
            local list = rankingGui and rankingGui:FindFirstChild("List", true)
            if list then
                table.insert(lists, list)
            end
        end
    end

    return lists
end

local function ClearList(list)
    -- 清理旧列表 (保留 UIListLayout 等非 Frame UI 组件)
    for _, child in pairs(list:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
end

local function PopulateList(list, rankingData)
    ClearList(list)
    
    for rank, entry in ipairs(rankingData) do
        local userId = tonumber(entry.key)
        local level = entry.value
        
        -- 克隆模板并设置基础信息
        local item = EntryTemplate:Clone()
        item.Name = "Rank_" .. rank
        item.RankLabel.Text = "#" .. rank
        item.ValueLabel.Text = "Lv." .. level
        
        -- 获取并设置玩家名称与头像
        task.spawn(function()
            local successName, name = pcall(function()
                return Players:GetNameFromUserIdAsync(userId)
            end)
            item.NameLabel.Text = successName and name or "Unknown"

            -- 获取头像 URL (420x420, 头像特写)
            local successAvatar, content = pcall(function()
                return Players:GetUserThumbnailAsync(
                    userId, 
                    Enum.ThumbnailType.HeadShot, 
                    Enum.ThumbnailSize.Size420x420
                )
            end)
            if successAvatar then
                item.Avatar.Image = content
            end
        end)

        -- 样式美化：前三名特殊背景色
        if rank == 1 then
            item.BackgroundColor3 = Color3.fromRGB(255, 215, 0) -- 金色
        elseif rank == 2 then
            item.BackgroundColor3 = Color3.fromRGB(192, 192, 192) -- 银色
        elseif rank == 3 then
            item.BackgroundColor3 = Color3.fromRGB(205, 127, 50) -- 铜色
        end

        item.Parent = list
    end
end

-- [核心功能] 刷新排行榜显示
local function RefreshDisplay()
    -- 1. 从数据库获取排行榜数据
    local success, pages = pcall(function()
        return RankingStore:GetSortedAsync(false, TOP_COUNT) -- false 为降序
    end)

    if not success or not pages then return end

    local data = pages:GetCurrentPage()

    -- 2. 每次刷新时重新遍历 Workspace，找到所有 Ranking_Level* 排行榜对象
    local lists = GetRankingLists()

    -- 3. 对每个 RankingGui.List 都清空，并克隆同一份排行榜数据进行显示
    for _, list in ipairs(lists) do
        PopulateList(list, data)
    end
end

-- [核心功能] 同步在线玩家数据
function RankingService.SyncData(player)
    local pData = PlayerDataManager.GetPlayerData(player)
    if pData and pData.UnlockedLevel then
        pcall(function()
            RankingStore:SetAsync(tostring(player.UserId), pData.UnlockedLevel)
        end)
    end
end

function RankingService.Init()
    -- 定时刷新循环
    task.spawn(function()
        while true do
            RefreshDisplay()
            task.wait(UPDATE_INTERVAL)
        end
    end)

    -- 玩家离开时保存
    Players.PlayerRemoving:Connect(function(player)
        RankingService.SyncData(player)
    end)
    
    -- 定期为在线玩家自动保存 (每5分钟)
    task.spawn(function()
        while true do
            task.wait(300)
            for _, player in ipairs(Players:GetPlayers()) do
                RankingService.SyncData(player)
            end
        end
    end)

    print("服务端：排行榜系统 (带头像版) 已激活！")
end

return RankingService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source">-- src/server/Services/ShopService.luau
local ShopService = {}
local AnalyticsService = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
   
local REFRESH_INTERVAL = 300 -- 5分钟补货一次

local currentShopItems = {} 
local playerSpecificStock = {} 
local nextRefreshTime = 0

function ShopService.RefreshStock()
    currentShopItems = {}
    playerSpecificStock = {} 

    for _, seedId in ipairs(ItemConfig.IdToSeedKey or {}) do
        if seedId then
            local itemDetail = ItemConfig.Seeds[seedId]
            if itemDetail and itemDetail.IsSellable ~= false then
                local restockById = {
                    [1] = 20, 
                    [2] = 15, 
                    [3] = 10,
                    [4] = 6,
                    [5] = 6,
                    [6] = 6,
                    [7] = 20,
                    [8] = 6,
                    [9] = 6,
                    [10] = 6,
                    [11] = 6,
                    [12] = 6, 
                    [13] = 6, 
                    [14] = 6, 
                    [15] = 6, 
                    [16] = 3, 
                    [17] = 3, 
                    [18] = 2,
                    [19] = 1,

                }

                local restockAmount = restockById[itemDetail.Id] or 1
                table.insert(currentShopItems, { SeedId = seedId, MaxStock = restockAmount })
            end
        end
    end
    
    nextRefreshTime = os.time() + REFRESH_INTERVAL
    ShopService.BroadcastStockUpdate()
end

local function GetPlayerStockData(player)
    if not playerSpecificStock[player.UserId] then
        local personal = {}
        for i, item in ipairs(currentShopItems) do
            table.insert(personal, { SeedId = item.SeedId, Stock = item.MaxStock })
        end
        playerSpecificStock[player.UserId] = personal
    end
    return playerSpecificStock[player.UserId]
end

function ShopService.BroadcastStockUpdate()
    local updateShopRE = ReplicatedStorage:FindFirstChild("UpdateShopRE")
    if not updateShopRE then return end
    
    for _, player in ipairs(game.Players:GetPlayers()) do
        updateShopRE:FireClient(player, GetPlayerStockData(player), nextRefreshTime)
    end
end

-- 🌟 新增：服务端校验价格计算器 (防止外挂篡改价格)
local function CalculateItemPrice(compositeId)
    if not compositeId or compositeId == "" then return 0 end
    
    local parts = string.split(compositeId, "_")
    local itemType = parts[1]
    local realId = parts[2]
    local mutLvl = tonumber(parts[3]) or 1

    if itemType ~= "Seed" and itemType ~= "Plant" then return 0 end

    local seedDetail = ItemConfig.Seeds[realId]
    if not seedDetail then return 0 end

    local baseBuyPrice = seedDetail.BuyPrice or 0

    if itemType == "Seed" then
        return math.floor(baseBuyPrice * 0.3)
    elseif itemType == "Plant" then
        local price = baseBuyPrice * 0.4
        if mutLvl == 2 then price = price * 2
        elseif mutLvl == 3 then price = price * 3
        elseif mutLvl == 4 then price = price * 4
        end
        return math.floor(price)
    end
    return 0
end


function ShopService.Init()
    local updateShopRE = ReplicatedStorage:FindFirstChild("UpdateShopRE") or Instance.new("RemoteEvent")
    updateShopRE.Name = "UpdateShopRE"; updateShopRE.Parent = ReplicatedStorage

    local getShopDataRF = ReplicatedStorage:FindFirstChild("GetShopDataRF") or Instance.new("RemoteFunction")
    getShopDataRF.Name = "GetShopDataRF"; getShopDataRF.Parent = ReplicatedStorage
    getShopDataRF.OnServerInvoke = function(player) return GetPlayerStockData(player), nextRefreshTime end

    local buyItemRF = ReplicatedStorage:FindFirstChild("BuyItemRF") or Instance.new("RemoteFunction")
    buyItemRF.Name = "BuyItemRF"; buyItemRF.Parent = ReplicatedStorage

    buyItemRF.OnServerInvoke = function(player, slotIndex, amount)
        amount = amount or 1
        local personalStock = GetPlayerStockData(player)
        local slotData = personalStock[slotIndex]
        
        if not slotData or not slotData.SeedId then return false, "Invalid item" end
        
        local itemDetail = ItemConfig.Seeds[slotData.SeedId]
        local data = PlayerDataManager.GetPlayerData(player)
        if not data then return false, "Data loading..." end

        if data.UnlockedLevel &lt; (itemDetail.UnlockLevel or 1) then return false, "Level too low!" end
        if slotData.Stock &lt; amount then return false, "Out of stock!" end

        local totalCost = itemDetail.BuyPrice * amount
        if data.Coins &gt;= totalCost then
            data.Coins = data.Coins - totalCost
            slotData.Stock = slotData.Stock - amount
            
            PlayerDataManager.GiveSeed(player, slotData.SeedId, amount)
            
            local shopSessionId = player:GetAttribute("CurrentShopSessionId")
            if shopSessionId then
                AnalyticsService:LogFunnelStepEvent(player, "Shop_Purchase_Flow", shopSessionId, 2, "Step_2_Buy_Success")
                player:SetAttribute("CurrentShopSessionId", nil) 
            end

            AnalyticsService:LogEconomyEvent(
                player,
                Enum.AnalyticsEconomyFlowType.Sink,  
                "Coins",                             
                totalCost,                            
                data.Coins,                           
                Enum.AnalyticsEconomyTransactionType.Shop.Name, 
                tostring(slotData.SeedId)             
            )
  
            updateShopRE:FireClient(player, personalStock, nextRefreshTime) 

            local updateInvRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
            if updateInvRE then 
                updateInvRE:FireClient(player, data) 
            end
            
            return true, "Purchase successful!"
        else
            return false, "Not enough coins"
        end
    end

    -- 🌟 新增：处理单件出售逻辑
    local sellEquippedRF = Instance.new("RemoteFunction")
    sellEquippedRF.Name = "SellEquippedRF"
    sellEquippedRF.Parent = ReplicatedStorage
    sellEquippedRF.OnServerInvoke = function(player)
        local char = player.Character
        local equippedId = char and char:GetAttribute("EquippedSeed")
        
        if not equippedId or equippedId == "" then 
            return false, "Please equip a plant or seed" 
        end

        local price = CalculateItemPrice(equippedId)
        if price &lt;= 0 then return false, "This item cannot be sold" end

        local parts = string.split(equippedId, "_")
        local itemType = parts[1]
        local realId = parts[2]
        local mutLvl = tonumber(parts[3]) or 1

        -- 调用你已经写好的 Consume 函数（会自动清理 Hotbar 如果用光）
        local consumeSuccess = false
        if itemType == "Seed" then
            consumeSuccess = PlayerDataManager.ConsumeSeed(player, realId, 1)
        elseif itemType == "Plant" then
            consumeSuccess = PlayerDataManager.ConsumePlant(player, realId, 1, mutLvl)
        end

        if consumeSuccess then
            PlayerDataManager.GiveCoinsRaw(player, price)
            
            AnalyticsService:LogEconomyEvent(
                player, Enum.AnalyticsEconomyFlowType.Source, "Coins", price, 
                PlayerDataManager.GetPlayerData(player).Coins,
                Enum.AnalyticsEconomyTransactionType.Shop.Name, "Sell_" .. equippedId
            )
            return true, "Earned $" .. tostring(price)
        else
            return false, "Item not found in inventory"
        end
    end

    -- 🌟 新增：处理批量出售快捷栏所有物品逻辑
    local sellAllHotbarRF = Instance.new("RemoteFunction")
    sellAllHotbarRF.Name = "SellAllHotbarRF"
    sellAllHotbarRF.Parent = ReplicatedStorage
    sellAllHotbarRF.OnServerInvoke = function(player)
        local data = PlayerDataManager.GetPlayerData(player)
        if not data or not data.Hotbar then return false, "Data loading..." end

        local totalEarned = 0
        local soldCount = 0
        local newHotbar = {} -- 保存不可出售的工具

        -- 遍历快捷栏
        for _, compositeId in ipairs(data.Hotbar) do
            local parts = string.split(compositeId, "_")
            local itemType = parts[1]
            local realId = parts[2]
            local mutLvl = tonumber(parts[3]) or 1

            local unitPrice = CalculateItemPrice(compositeId)
            
            if unitPrice &gt; 0 then
                -- 在背包中寻找这个物品，并将所有的存量一次性全部卖出
                if itemType == "Seed" and data.Inventory.Seeds then
                    for i = #data.Inventory.Seeds, 1, -1 do
                        local seedData = data.Inventory.Seeds[i]
                        if seedData.ID == realId then
                            totalEarned = totalEarned + (unitPrice * seedData.Quantity)
                            table.remove(data.Inventory.Seeds, i)
                            soldCount = soldCount + 1
                            break
                        end
                    end
                elseif itemType == "Plant" and data.Inventory.Plants then
                    for i = #data.Inventory.Plants, 1, -1 do
                        local plantData = data.Inventory.Plants[i]
                        if plantData.ID == realId and (plantData.Mutation or 1) == mutLvl then
                            totalEarned = totalEarned + (unitPrice * plantData.Quantity)
                            table.remove(data.Inventory.Plants, i)
                            soldCount = soldCount + 1
                            break
                        end
                    end
                end
            else
                -- 不可出售的物品（如铲子 Tool_Shovel）保留在快捷栏中
                table.insert(newHotbar, compositeId)
            end
        end

        if soldCount &gt; 0 then
            data.Hotbar = newHotbar
            
            -- 清空手上的装备，防止拿着幽灵物品
            local char = player.Character
            if char then
                local currentEq = char:GetAttribute("EquippedSeed")
                if currentEq and not string.find(currentEq, "Tool") then
                    ReplicatedStorage:WaitForChild("HoldItemRE"):FireClient(player, nil) -- 告诉客户端放下
                end
            end

            PlayerDataManager.GiveCoinsRaw(player, totalEarned)

            AnalyticsService:LogEconomyEvent(
                player, Enum.AnalyticsEconomyFlowType.Source, "Coins", totalEarned, 
                data.Coins, Enum.AnalyticsEconomyTransactionType.Shop.Name, "Sell_All_Hotbar"
            )

            local updateInvRE = ReplicatedStorage:FindFirstChild("UpdateInventoryRE")
            if updateInvRE then updateInvRE:FireClient(player, data) end

            return true, "Earned $" .. tostring(totalEarned)
        else
            return false, "No items to sell in Hotbar"
        end
    end

    task.spawn(function()
        ShopService.RefreshStock() 
        while true do
            task.wait(1)
            if os.time() &gt;= nextRefreshTime then ShopService.RefreshStock() end
        end
    end)
end

return ShopService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source">-- src/server/Services/ToolService.luau
local ToolService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local PlotService = require(script.Parent.PlotService)
local PlantCombatAI = require(script.Parent.PlantCombatAI)
local CollectionService = game:GetService("CollectionService") 
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local function GetCombatEditCost(player)
    local plot = PlotService.GetPlayerPlot(player)
    local currentLevel = plot and plot:GetAttribute("CurrentLevel") or 1
    currentLevel = math.max(1, tonumber(currentLevel) or 1)
    return 100 + (currentLevel - 1) * 100
end

local function ApplyKnockback(targetCharacter, attackerCharacter)
    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
    local attackerRoot = attackerCharacter:FindFirstChild("HumanoidRootPart")
    local targetHum = targetCharacter:FindFirstChildOfClass("Humanoid")
    
    if not targetRoot or not attackerRoot or not targetHum then return end

    local oldVelocity = targetRoot:FindFirstChild("KnockbackVelocity")
    local oldAttachment = targetRoot:FindFirstChild("KnockbackAttachment")
    
    if oldVelocity then oldVelocity:Destroy() end
    if oldAttachment then oldAttachment:Destroy() end

    local direction = (targetRoot.Position - attackerRoot.Position).Unit
    local flatDirection = Vector3.new(direction.X, 0, direction.Z).Unit
    
    local horizontalForce = 50 
    local verticalForce = 35   
    local duration = 0.15      
    
    local knockbackVector = (flatDirection * horizontalForce) + Vector3.new(0, verticalForce, 0)

    local attachment = Instance.new("Attachment")
    attachment.Name = "KnockbackAttachment"
    attachment.Parent = targetRoot

    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "KnockbackVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.MaxForce = 999999 
    linearVelocity.VectorVelocity = knockbackVector
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.Parent = targetRoot

    targetHum.PlatformStand = true
    
    local mass = targetRoot.AssemblyMass
    local spinForce = mass * math.random(30, 50) 
    local randomAxis = Vector3.new(
        math.random(-10, 10), 
        math.random(-10, 10), 
        math.random(-10, 10)
    ).Unit
    
    targetRoot:ApplyAngularImpulse(randomAxis * spinForce)

    task.delay(duration, function()
        if linearVelocity then linearVelocity:Destroy() end
        if attachment then attachment:Destroy() end
    end)
    
    task.delay(1, function()
        if targetHum and targetHum.Parent and targetHum.Health &gt; 0 then
            targetHum.PlatformStand = false
        end
    end)
end

function ToolService.Init()
    local shovelRE = Instance.new("RemoteEvent")
    shovelRE.Name = "ShovelActionRE"
    shovelRE.Parent = ReplicatedStorage

    shovelRE.OnServerEvent:Connect(function(player, targetObj, isCombatRecycle)
        if not targetObj or not targetObj.Parent then return end
        
        local character = player.Character
        if not character or character:GetAttribute("EquippedSeed") ~= "Tool_Shovel" then return end
        
        local targetPos = targetObj:IsA("Model") and (targetObj.PrimaryPart and targetObj.PrimaryPart.Position or targetObj:GetPivot().Position) or targetObj.Position
        local charPos = character.PrimaryPart and character.PrimaryPart.Position
        if not charPos then return end
        
        if (charPos - targetPos).Magnitude &gt; 35 then return end 

        -- ==========================================
        -- 【分支 1：回收战斗植物】
        -- ==========================================
        if targetObj:GetAttribute("IsCombatPlant") then
            local lawnPart = targetObj.Parent
            if lawnPart and string.match(lawnPart.Name, "Lawn") then
                local gridName = lawnPart.Name
                local myPlot = PlotService.GetPlayerPlot(player)
                if myPlot ~= lawnPart.Parent.Parent then return end

                if myPlot:GetAttribute("IsLevelActive") then
                    -- 👇 [🌟 新增：战斗中铲除扣费校验]
                    if isCombatRecycle then
                        local cost = GetCombatEditCost(player)
                        if not PlayerDataManager.ConsumeCoins(player, cost) then
                            local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                            if showNotifRE then 
                                showNotifRE:FireClient(player, "Notice", "Not enough Sun! Need " .. tostring(cost) .. " Sun.") 
                            end
                            return -- 直接拦截回收操作
                        end
                    else
                        -- 兜底拦截：如果客户端恶意绕过弹窗
                        local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                        if showNotifRE then 
                            showNotifRE:FireClient(player, "Notice", "Cannot remove plants during combat!") 
                        end
                        return
                    end
                end

                local pData = PlayerDataManager.GetPlayerData(player)
                local combatInfo = pData.CombatPlants and pData.CombatPlants[gridName]
                local plantIdToReturn = combatInfo and combatInfo.PlantId or targetObj.Name
                local mutationLvl = (combatInfo and combatInfo.Mutation) or targetObj:GetAttribute("MutationLevel") or 1
                
                -- 静默发奖：战斗植物退回背包
                PlayerDataManager.GivePlant(player, plantIdToReturn, 1, mutationLvl) 
                PlayerDataManager.RemoveCombatPlant(player, gridName)
                
                lawnPart:SetAttribute("OccupiedBy", nil)
                local prompt = lawnPart:FindFirstChildOfClass("ProximityPrompt")
                if prompt then prompt.Enabled = true end
                
                targetObj:Destroy()
            end
            return
        end

        -- ==========================================
        -- 【分支 2：回收农田植物/种子】
        -- ==========================================
        local plantedOnSoilName = targetObj:GetAttribute("PlantedOn")
        if plantedOnSoilName then
            if targetObj:GetAttribute("IsMature") then 
                local showNotifRE = ReplicatedStorage:FindFirstChild("ShowNotificationRE")
                if showNotifRE then showNotifRE:FireClient(player, "Notice", "Harvest mature plants directly. Cannot use shovel!") end
                return 
            end

            local plot = targetObj.Parent and targetObj.Parent.Parent
            if not plot or PlotService.GetPlayerPlot(player) ~= plot then return end

            local soilsFolder = plot:FindFirstChild("Soils")
            local soilPart = soilsFolder and soilsFolder:FindFirstChild(plantedOnSoilName)
            
            if soilPart then
                local pData = PlayerDataManager.GetPlayerData(player)
                local plantedInfo = pData.PlantedPlants and pData.PlantedPlants[plantedOnSoilName]
                local seedIdToReturn = plantedInfo and plantedInfo.SeedId or string.gsub(targetObj.Name, "_Plant", "")
                
                -- 追加传入了参数 `true`，抑制全屏的获得横幅提示和礼花
                PlayerDataManager.GiveSeed(player, seedIdToReturn, 1, true) 
                PlayerDataManager.RemovePlantedPlant(player, plantedOnSoilName)
                
                local prompt = soilPart:FindFirstChildOfClass("ProximityPrompt")
                if prompt then 
                    prompt.ActionText ="Plant"
                    prompt.Enabled = true 
                end
                targetObj:Destroy()
            end
        end
    end)
 
    -- ==========================================
    -- [武器近战攻击判定]
    -- ==========================================
    local weaponAttackRE = Instance.new("RemoteEvent")
    weaponAttackRE.Name = "WeaponAttackRE"
    weaponAttackRE.Parent = ReplicatedStorage

   weaponAttackRE.OnServerEvent:Connect(function(player, hitTargets)
        local character = player.Character
        if not character or character:GetAttribute("EquippedSeed") ~= "Tool_WeaponBlock" then return end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        if type(hitTargets) ~= "table" then return end

        local damagedZombies = {} 
        local damagedPlayers = {} 

        for _, targetModel in ipairs(hitTargets) do
            if typeof(targetModel) ~= "Instance" or not targetModel:IsA("Model") then continue end
            
            local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
            
            if not targetHum or targetHum.Health &lt;= 0 or not targetRoot then continue end

            local distance = (rootPart.Position - targetRoot.Position).Magnitude
            if distance &gt; 16 then 
                continue 
            end

            -- ==========================================
            -- [僵尸受击判定]
            -- ==========================================
            if targetModel:GetAttribute("IsZombie") and targetModel:GetAttribute("OwnerId") == player.UserId then
                if not damagedZombies[targetModel] then
                    damagedZombies[targetModel] = true
                    
                    targetHum.Health = math.max(0, targetHum.Health - 25)

                    if PlantCombatAI.ShowDamageText then
                        PlantCombatAI.ShowDamageText(targetModel, 25)
                    end

                    if not targetModel:GetAttribute("IsFlashing") then
                        targetModel:SetAttribute("IsFlashing", true)
                        local originalColors = {}
                        for _, p in pairs(targetModel:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalColors[p] = p.Color
                                p.Color = Color3.fromRGB(255, 80, 80)
                            end
                        end
                        task.delay(0.15, function()
                            if targetModel and targetModel.Parent then
                                for p, color in pairs(originalColors) do
                                    if p and p.Parent then p.Color = color end
                                end
                                targetModel:SetAttribute("IsFlashing", false)
                            end
                        end)
                    end

                    if targetRoot then
                        local effectPart = Instance.new("Part")
                        effectPart.Size = Vector3.new(0.1, 0.1, 0.1)
                        effectPart.Transparency = 1
                        effectPart.Anchored = true
                        effectPart.CanCollide = false
                        effectPart.Position = targetRoot.Position + Vector3.new(0, 1, 0)
                        effectPart.Parent = Workspace
                        
                        local attachment = Instance.new("Attachment", effectPart)
                        local particles = Instance.new("ParticleEmitter", attachment)
                        particles.Texture = "rbxassetid://243098098" 
                        particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
                        particles.Size = NumberSequence.new(1, 0)
                        particles.Rate = 0
                        particles.Speed = NumberRange.new(5, 10)
                        particles.Lifetime = NumberRange.new(0.1, 0.3)
                        particles:Emit(15) 
                        
                        game:GetService("Debris"):AddItem(effectPart, 1.5)
                    end
                end

            -- ==========================================
            -- [玩家 PVP 受击击飞判定]
            -- ==========================================
            elseif targetModel ~= character then
                local enemyPlayer = Players:GetPlayerFromCharacter(targetModel)
                local isDummy = (targetModel.Name == "Dummy")
                
                if (enemyPlayer or isDummy) and not damagedPlayers[targetModel] then
                    damagedPlayers[targetModel] = true
                    
                    if not targetModel:GetAttribute("IsFlashing") then
                        targetModel:SetAttribute("IsFlashing", true)
                        local originalColors = {}
                        for _, p in pairs(targetModel:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalColors[p] = p.Color
                                p.Color = Color3.fromRGB(255, 80, 80) 
                            end
                        end
                        task.delay(0.15, function()
                            if targetModel and targetModel.Parent then
                                for p, color in pairs(originalColors) do
                                    if p and p.Parent then p.Color = color end
                                end
                                targetModel:SetAttribute("IsFlashing", false)
                            end
                        end)
                    end

                    local effectPart = Instance.new("Part")
                    effectPart.Size = Vector3.new(0.1, 0.1, 0.1)
                    effectPart.Transparency = 1
                    effectPart.Anchored = true
                    effectPart.CanCollide = false
                    effectPart.Position = targetRoot.Position + Vector3.new(0, 1, 0)
                    effectPart.Parent = Workspace
                    
                    local attachment = Instance.new("Attachment", effectPart)
                    local particles = Instance.new("ParticleEmitter", attachment)
                    particles.Texture = "rbxassetid://243098098" 
                    particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
                    particles.Size = NumberSequence.new(1.5, 0) 
                    particles.Rate = 0
                    particles.Speed = NumberRange.new(10, 20) 
                    particles.Lifetime = NumberRange.new(0.2, 0.4)
                    particles:Emit(20) 
                    
                    game:GetService("Debris"):AddItem(effectPart, 1.5)

                    ApplyKnockback(targetModel, character)

                    local enemyHead = targetModel:FindFirstChild("Head")
                    if enemyHead then
                        local airdropWeld = enemyHead:FindFirstChild("AirdropWeld")
                        if airdropWeld and airdropWeld.Part1 then
                            local airdropBox = airdropWeld.Part1.Parent
                            while airdropBox and airdropBox ~= Workspace do
                                if airdropBox:GetAttribute("Carrier") then break end
                                airdropBox = airdropBox.Parent
                            end
                            
                            if not airdropBox or not airdropBox:IsA("Model") then
                                airdropBox = airdropWeld.Part1:FindFirstAncestorOfClass("Model")
                            end

                            if airdropBox then
                                airdropWeld:Destroy()

                                if targetHum and targetHum:GetAttribute("WalkSpeedBeforeAirdrop") then
                                    targetHum.WalkSpeed = targetHum:GetAttribute("WalkSpeedBeforeAirdrop")
                                    targetHum:SetAttribute("WalkSpeedBeforeAirdrop", nil)
                                end
                                
                                for _, p in pairs(airdropBox:GetDescendants()) do
                                    if p:IsA("BasePart") then
                                        p.CanCollide = true
                                        p.Massless = false
                                    end
                                end
                                
                                if airdropBox.PrimaryPart then
                                    airdropBox.PrimaryPart:SetNetworkOwner(nil)
                                    airdropBox.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0, 50, 0)
                                    airdropBox.PrimaryPart.AssemblyAngularVelocity = Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
                                    
                                    local prompt = airdropBox.PrimaryPart:FindFirstChildOfClass("ProximityPrompt")
                                    if prompt then 
                                        prompt.Enabled = true 
                                    end
                                end
                                
                                airdropBox:SetAttribute("Carrier", nil)
                                if not CollectionService:HasTag(airdropBox, "AirdropBox") then
                                    CollectionService:AddTag(airdropBox, "AirdropBox")
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    -- ==========================================
    -- [🌟 樱桃炸弹：服务端接收投掷请求、生成特效与范围伤害]
    -- ==========================================
    -- ==========================================
    -- [🌟 樱桃炸弹：空中抛物线动画与范围爆炸]
    -- ==========================================
    local throwBombRE = ReplicatedStorage:FindFirstChild("ThrowBombRE")
    if not throwBombRE then
        throwBombRE = Instance.new("RemoteEvent")
        throwBombRE.Name = "ThrowBombRE"
        throwBombRE.Parent = ReplicatedStorage
    end

   throwBombRE.OnServerEvent:Connect(function(player, equippedItem, targetPosition)
        local character = player.Character
        if not character then return end
        if character:GetAttribute("EquippedSeed") ~= equippedItem then return end
        
       -- ==========================================
        -- 【修复关键点：解析真正的物品 ID 和 变异等级】
        -- 客户端传来的 equippedItem 格式通常是 "Plant_CherryBomb_1"
        -- ==========================================
        local plantId = "CherryBomb"
        local mutationLevel = 1
        
        local parts = string.split(equippedItem, "_")
        if parts[1] == "Plant" and parts[2] then
            plantId = parts[2]
            mutationLevel = tonumber(parts[3]) or 1
        elseif equippedItem == "CherryBomb" then
            plantId = "CherryBomb"
        end
        
        local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
        local plantConfig = ItemConfig.Plants[plantId]
        if not plantConfig then return end
        
        -- 使用解析出的 plantId 和 mutationLevel 进行扣除
        if not PlayerDataManager.ConsumePlant(player, plantId, 1, mutationLevel) then
            return -- 如果库存不足扣除失败，则不扔炸弹
        end
        
        -- ==========================================
        -- 扣除成功，继续执行投掷动画和爆炸伤害
        -- ==========================================
        
        -- 如果扣除成功，继续执行投掷动画和爆炸伤害
        task.spawn(function()
            local startPos = character.PrimaryPart.Position + Vector3.new(0, 2, 0)
            local height = 15
            local duration = 0.5
            local steps = 20
            local stepTime = duration / steps
            
            -- [后续的抛物线投掷和爆炸逻辑保持不变...]
            local bombModel = nil
            pcall(function()
                local modelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
                local template = modelsFolder and (modelsFolder:FindFirstChild("CherryBomb_Plant") or modelsFolder:FindFirstChild("CherryBomb"))
                if template then
                    bombModel = template:Clone()
                    for _, p in pairs(bombModel:GetDescendants()) do
                        if p:IsA("BasePart") then p.Anchored = true p.CanCollide = false end
                    end
                    bombModel:PivotTo(CFrame.new(startPos))
                    bombModel.Parent = Workspace
                end
            end)
            
            -- 2. 抛物线运动
            for i = 1, steps do
                local t = i / steps
                local currentPos = startPos:Lerp(targetPosition, t) + Vector3.new(0, math.sin(t * math.pi) * height, 0)
                if bombModel then
                    bombModel:PivotTo(CFrame.new(currentPos) * CFrame.Angles(math.rad(t * 360), 0, 0))
                end
                task.wait(stepTime)
            end
            
            if bombModel then bombModel:Destroy() end

            -- 3. 落地瞬间：召唤爆炸特效
            local effectName = plantConfig.ExplosionEffect 
            local hitFolder = ReplicatedStorage:FindFirstChild("Hit")
            
            if hitFolder and effectName then
                local effectTemplate = hitFolder:FindFirstChild(effectName)
                if effectTemplate then
                    local newEffect = effectTemplate:Clone()
                    
                    -- 1. 判断并设置位置 (🌟稍微抬高一点，防止粒子被埋在地板下面)
                    if newEffect:IsA("Model") then
                        newEffect:PivotTo(CFrame.new(targetPosition + Vector3.new(0, 1.5, 0)))
                    elseif newEffect:IsA("BasePart") then
                        newEffect.Position = targetPosition + Vector3.new(0, 1.5, 0)
                    end
                    
                    newEffect.Parent = Workspace
                    
                    -- 👇 [🌟 核心修复：解决 Roblox 引擎吞特效的 BUG！]
                    -- 必须等一瞬间，让玩家的客户端先把特效零件渲染出来，然后再触发爆炸！
                    task.wait(0.05) 
                    
                    local emitCount = 0
                    for _, particle in pairs(newEffect:GetDescendants()) do
                        if particle:IsA("ParticleEmitter") then 
                            local customCount = particle:GetAttribute("EmitCount")
                            
                            if customCount and type(customCount) == "number" then
                                particle:Emit(customCount)
                            else
                                particle:Emit(20) 
                            end
                            
                            emitCount += 1
                        end
                    end
                    
                    game:GetService("Debris"):AddItem(newEffect, 2)
                else
                    warn("❌【樱桃炸弹】找不到特效：在 ReplicatedStorage -&gt; Hit 里面没有找到名字叫 [" .. tostring(effectName) .. "] 的东西！")
                end
            else
                warn("❌【樱桃炸弹】配置错误：找不到 ReplicatedStorage.Hit 文件夹，或者 ItemConfig 里没写 ExplosionEffect！")
            end

            -- 4. 落地瞬间：群体范围扣血
            local radius = plantConfig.ExplosionRadius or 18
            local damage = plantConfig.ExplosionDamage or 2500
            
            local overlapParams = OverlapParams.new()
            local hitParts = Workspace:GetPartBoundsInRadius(targetPosition, radius, overlapParams)
            local processedZombies = {} 

            for _, part in ipairs(hitParts) do
                local targetModel = part:FindFirstAncestorOfClass("Model")
                if targetModel and targetModel:GetAttribute("IsZombie") and not processedZombies[targetModel] then
                    processedZombies[targetModel] = true
                    local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
                    if targetHum and targetHum.Health &gt; 0 then
                        targetHum.Health = math.max(0, targetHum.Health - damage)
                        
                        -- 伤害飘字
                        pcall(function()
                            local PlantCombatAI = require(script.Parent.PlantCombatAI)
                            if PlantCombatAI and PlantCombatAI.ShowDamageText then
                                PlantCombatAI.ShowDamageText(targetModel, damage)
                            end
                        end)
                    end
                end
            end
        end)
    end)
    
    print("服务端：ToolService 加载完毕！回收提示强制静默功能已上线！")
end

return ToolService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ZombieBoxService</string>
            <string name="Source">-- src/server/Services/ZombieBoxService.luau
local ZombieBoxService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local ItemConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig"))
local itemModels = ReplicatedStorage:WaitForChild("ItemModels")

-- ✅ 修复了双端死等的 Bug：使用 FindFirstChild，如果没有再创建
local zombieBoxRE = ReplicatedStorage:FindFirstChild("ZombieBoxRE")
if not zombieBoxRE then
    zombieBoxRE = Instance.new("RemoteEvent")
    zombieBoxRE.Name = "ZombieBoxRE"
    zombieBoxRE.Parent = ReplicatedStorage
end

local pendingBoxes = {}
local ACTIVE_BOX_LIFETIME = 60
local AUTO_OPEN_DISTANCE = 8
local PICKUP_ENABLE_DELAY = 0.9

-- ==========================================
-- 🌟 1. 盲盒大类概率配置 (权重制)
-- ==========================================
local TYPE_WEIGHTS = {
    Seed = 90,      -- 种子权重 65
    Plant = 10,     -- 植物权重 20
    -- 以后想加新类型，只需解开注释并加上权重
    -- Prop = 10,   
    -- Currency = 5 
}

-- 品质权重配置 (1星~5星)
local QUALITY_WEIGHTS = { [1] = 70, [2] = 20, [3] = 8, [4] = 2 }

-- 监听客户端动画播完后发来的“给我发奖”请求
zombieBoxRE.OnServerEvent:Connect(function(player, action, finalItem)
    if action == "GiveReward" then
        if pendingBoxes[player.UserId] and pendingBoxes[player.UserId] &gt; 0 then
            pendingBoxes[player.UserId] -= 1

            -- ==========================================
            -- 🌟 2. 真实发奖逻辑扩展
            -- ==========================================
            if finalItem.type == "Plant" then
                PlayerDataManager.GivePlant(player, finalItem.id, 1, 1)
                
            elseif finalItem.type == "Seed" then
                PlayerDataManager.GiveSeed(player, finalItem.id, 1)
                
            elseif finalItem.type == "Prop" then
                -- 预留的道具发放接口
                -- PlayerDataManager.GiveItem(player, finalItem.id, 1)
                
            elseif finalItem.type == "Currency" then
                if finalItem.id == "CoinBox" then
                    PlayerDataManager.GiveCoins(player, finalItem.amount or 500)
                end
            end
        end
    end
end)

-- ✅ 这个就是你报错丢失的函数，必须确保它完整存在！
function ZombieBoxService.SpawnBox(player, dropPos)
    local categorizedPool = {}

    local function buildPool(configDict, typeName)
        if not configDict then return end
        categorizedPool[typeName] = {}
        for id, data in pairs(configDict) do
            local q = data.Quality or 1
            if not categorizedPool[typeName][q] then
                categorizedPool[typeName][q] = {}
            end
            table.insert(categorizedPool[typeName][q], {type = typeName, id = id})
        end
    end

    -- 初始化池子
    buildPool(ItemConfig.Plants, "Plant")
    buildPool(ItemConfig.Seeds, "Seed")

    -- 货币这种不需要星级的特殊物品，手动插入池子
    categorizedPool["Currency"] = {
        [1] = { {type = "Currency", id = "CoinBox", amount = 500} }
    }

    local function rollItem()
        -- 1. 先抽大类
        local totalTypeWeight = 0
        for _, weight in pairs(TYPE_WEIGHTS) do totalTypeWeight += weight end
        
        local typeRoll = math.random(1, totalTypeWeight)
        local targetType = "Seed" 
        local currentTypeWeight = 0
        
        for t, weight in pairs(TYPE_WEIGHTS) do
            currentTypeWeight += weight
            if typeRoll &lt;= currentTypeWeight then
                targetType = t
                break
            end
        end

        -- 2. 再抽品质 
        local totalQualityWeight = 0
        for _, weight in pairs(QUALITY_WEIGHTS) do totalQualityWeight += weight end
        
        local qRoll = math.random(1, totalQualityWeight)
        local targetQuality = 1
        local currentQWeight = 0

        for q = 1, 5 do
            currentQWeight += (QUALITY_WEIGHTS[q] or 0)
            if qRoll &lt;= currentQWeight then
                targetQuality = q
                break
            end
        end

        -- 3. 从对应大类和品质中随机选一个具体物品
        local typePool = categorizedPool[targetType]
        if typePool then
            local qualityPool = typePool[targetQuality]
            if qualityPool and #qualityPool &gt; 0 then 
                return qualityPool[math.random(1, #qualityPool)] 
            end
            
            -- 降级拿1星保底
            local fallbackPool = typePool[1]
            if fallbackPool and #fallbackPool &gt; 0 then 
                return fallbackPool[math.random(1, #fallbackPool)] 
            end
        end
        
        -- 极致兜底
        return {type = "Seed", id = "Peashooter"}
    end

    local finalItem = rollItem()

    local boxTemplate = itemModels:FindFirstChild("Box")
    if not boxTemplate then
        warn("【ZombieBoxService】ReplicatedStorage.ItemModels.Box 不存在，无法生成场景盲盒")
        return
    end

    local box = boxTemplate:Clone()
    box.Name = "ZombieRewardBox_" .. tostring(player.UserId)
    box:SetAttribute("OwnerId", player.UserId)
    box:SetAttribute("IsZombieRewardBox", true)

    local promptPart = nil
    if box:IsA("BasePart") then
        promptPart = box
        box.CFrame = CFrame.new(dropPos)
    elseif box:IsA("Model") then
        promptPart = box.PrimaryPart or box:FindFirstChildWhichIsA("BasePart", true)
        if promptPart and not box.PrimaryPart then
            box.PrimaryPart = promptPart
        end
        box:PivotTo(CFrame.new(dropPos))
    end

    if not promptPart then
        warn("【ZombieBoxService】Box 模型内没有 BasePart，无法生成可交互盲盒")
        box:Destroy()
        return
    end

    local function weldToPromptPart(part)
        if part == promptPart then return end

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = promptPart
        weld.Part1 = part
        weld.Parent = promptPart
    end

    for _, descendant in ipairs(box:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = false
            descendant.CanCollide = true
            descendant.CanTouch = true
            descendant.CanQuery = true
            weldToPromptPart(descendant)
        end
    end

    promptPart.Anchored = false

    local opened = false
    local canOpen = false

    local function openBox(triggeringPlayer)
        if opened then return end
        if triggeringPlayer ~= player then return end
        if not triggeringPlayer.Parent then return end

        opened = true

        local boxPos = box:IsA("Model") and box:GetPivot().Position or promptPart.Position

        if not pendingBoxes[player.UserId] then pendingBoxes[player.UserId] = 0 end
        pendingBoxes[player.UserId] += 1

        zombieBoxRE:FireClient(player, "SpawnBox", boxPos, finalItem)

        if box and box.Parent then
            box:Destroy()
        end
    end

    box.Parent = Workspace

    -- 像阳光/金币一样，先给盲盒一个向外向上的初速度，让它以抛物线落到地上。
    promptPart.AssemblyLinearVelocity = Vector3.new(
        math.random(-18, 18),
        math.random(18, 32),
        math.random(-18, 18)
    )
    promptPart.AssemblyAngularVelocity = Vector3.new(
        math.random(-6, 6),
        math.random(-8, 8),
        math.random(-6, 6)
    )

    task.delay(PICKUP_ENABLE_DELAY, function()
        if opened or not box or not box.Parent then return end

        canOpen = true

        -- 落地后固定，避免持续滚动导致玩家难以靠近自动拾取。
        for _, descendant in ipairs(box:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
            end
        end
    end)

    task.spawn(function()
        local expireAt = os.clock() + ACTIVE_BOX_LIFETIME
        while not opened and box and box.Parent and os.clock() &lt; expireAt do
            if canOpen then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")

                if humanoid and humanoid.Health &gt; 0 and rootPart then
                    local boxPos = box:IsA("Model") and box:GetPivot().Position or promptPart.Position
                    if (rootPart.Position - boxPos).Magnitude &lt;= AUTO_OPEN_DISTANCE then
                        openBox(player)
                        break
                    end
                end
            end

            task.wait(0.15)
        end
    end)

    Debris:AddItem(box, ACTIVE_BOX_LIFETIME)
end

-- ✅ return 必须在最底部
return ZombieBoxService</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ZombieService</string>
            <string name="Source">-- src/server/Services/ZombieService.luau
local ZombieService = {}

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService") 
local PhysicsService = game:GetService("PhysicsService")
local AnalyticsService = game:GetService("AnalyticsService")


local ZombieConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ZombieConfig"))
local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
local CoinDropService = require(script.Parent.CoinDropService)

local activeSessions = {}
local LevelConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("LevelConfig"))

ZombieService.AnimationCache = {}

local function GetSyncBattleUIRemote()
    return ReplicatedStorage:FindFirstChild("SyncBattleUI_RE")
end

local function CountLevelZombies(levelData)
    local totalZombies = 0
    if levelData and levelData.Waves then
        for _, wave in ipairs(levelData.Waves) do
            if wave.Zombies then
                for _, zombieGroup in ipairs(wave.Zombies) do
                    totalZombies += zombieGroup.Count or 0
                end
            end
        end
    end
    return totalZombies
end

local function SyncBattleProgress(player, plot, isActive, levelId)
    local syncBattleUI_RE = GetSyncBattleUIRemote()
    if not syncBattleUI_RE then return end

    syncBattleUI_RE:FireClient(
        player,
        isActive,
        levelId or plot:GetAttribute("CurrentLevel") or 1,
        plot:GetAttribute("TotalZombies") or 0,
        plot:GetAttribute("ZombiesDefeated") or 0
    )
end

local function IsBattleCancelled(plot, player)
    if not plot then return true end
    if plot:GetAttribute("IsGameOver") then return true end
    if not player or not player.Parent then return true end
    if plot:GetAttribute("OwnerId") ~= player.UserId then return true end
    return false
end

-- ==========================================
-- [战斗结束，复活所有隐藏的植物]
-- ==========================================
function ZombieService.RestorePlotPlants(plot, player)
    local lawnFolder = plot:FindFirstChild("Lawn")
    if not lawnFolder then return end
    
    local MUTATION_TAGS = { Glow = true, Lightning = true, HolyLight = true }

    for _, lawnPart in ipairs(lawnFolder:GetChildren()) do
        if lawnPart:IsA("BasePart") then
            for _, child in pairs(lawnPart:GetChildren()) do
                if child:IsA("Model") and child:GetAttribute("IsCombatPlant") then
                    
                    -- 1. 恢复基础状态
                    local maxHP = child:GetAttribute("MaxHealth") or 300
                    child:SetAttribute("Health", maxHP)
                    child:SetAttribute("IsDead", false)
                    child:SetAttribute("Exploded", false)
                    
                    -- 2. 核心透明度恢复
                    for _, p in pairs(child:GetDescendants()) do
                        if p:IsA("BasePart") then
                            -- [🌟 规则1：如果名字是特效标签，强制 Transparency 为 1]
                            if MUTATION_TAGS[p.Name] then
                                p.Transparency = 1
                            else
                                -- [🌟 规则2：其他零件，严格按照出生时记录的状态恢复]
                                local origT = p:GetAttribute("OriginalTransparency")
                                -- 如果 origT 还是 nil，则根据它当前是否可见来决定（防止意外显示）
                                p.Transparency = origT or p.Transparency
                            end
                        elseif p:IsA("ParticleEmitter") or p:IsA("Light") or p:IsA("Beam") or p:IsA("Highlight") or p:IsA("Trail") then
                            -- 恢复特效开启状态
                            local origE = p:GetAttribute("OriginalEnabled")
                            if origE ~= nil then
                                p.Enabled = origE
                            end
                        end
                    end
                end
            end
        end
    end
end

function ZombieService.TriggerGameOver(plot, player)
    if plot:GetAttribute("IsGameOver") then return end
    plot:SetAttribute("IsGameOver", true)
    plot:SetAttribute("IsLevelActive", false)

    print("【关卡系统】防守失败！僵尸进入了房间！")

    ZombieService.RestorePlotPlants(plot, player)
    ZombieService.FinalSettlement(player, plot, false)

    -- 👇【修改这里】增加对 OwnerId 的判断
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:GetAttribute("IsZombie") and obj:GetAttribute("OwnerId") == player.UserId then
            obj:Destroy()
        end
    end
end

-- ==========================================
-- [核心：僵尸生成与 AI]
-- ==========================================
function ZombieService.SpawnZombie(plot, rowNum, zombieId, player)
    local lawnFolder = plot:FindFirstChild("Lawn")
    local tombstonesFolder = plot:FindFirstChild("Tombstones") 
    local homeBlock = plot:FindFirstChild("Home") 
    local houseEndFolder = plot:FindFirstChild("HouseEnd")
    local houseEndBlock = houseEndFolder and houseEndFolder:FindFirstChild("HouseEnd" .. rowNum)
    
    if not lawnFolder then return end

    local startBlock = lawnFolder:FindFirstChild("Lawn" .. rowNum .. "_9")
    local endBlock = lawnFolder:FindFirstChild("Lawn" .. rowNum .. "_1")
    if not startBlock or not endBlock then return end

    local tombstone = tombstonesFolder and tombstonesFolder:FindFirstChild("Tombstone" .. rowNum)
    local spawnX, spawnZ
    
    if tombstone then
        spawnX = tombstone.Position.X
        spawnZ = tombstone.Position.Z
        for _, part in pairs(tombstone:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if tombstone:IsA("BasePart") then tombstone.CanCollide = false end
    else
        local directionVector = (startBlock.Position - endBlock.Position).Unit
        local fallbackPos = startBlock.Position + directionVector * 8
        spawnX = fallbackPos.X
        spawnZ = fallbackPos.Z
    end

    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    local zombieTemplate = itemModelsFolder:FindFirstChild(zombieId) 
    if not zombieTemplate then return end

    plot:SetAttribute("ActiveZombies", (plot:GetAttribute("ActiveZombies") or 0) + 1)

    local zombie = zombieTemplate:Clone()
    zombie:SetAttribute("IsZombie", true) 

    if player then
        zombie:SetAttribute("OwnerId", player.UserId)
    end
    
    for _, part in pairs(zombie:GetDescendants()) do
        if part:IsA("BasePart") then 
            part.CollisionGroup = "Default" 
            part:SetAttribute("OriginalCanCollide", part.CanCollide)
            part.CanCollide = false
        end
        if part:IsA("Sound") then part:Destroy() end
    end
    
    local rootPart = zombie:FindFirstChild("HumanoidRootPart") or zombie.PrimaryPart
    local humanoid = zombie:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end

    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Flying, false)

    local groundY = startBlock.Position.Y + rootPart.Size.Y/2 + 1.5
    local targetPos = Vector3.new(spawnX, groundY, spawnZ)
    local startPos = targetPos - Vector3.new(0, 4.5, 0) 
    local lookPos = Vector3.new(endBlock.Position.X, groundY, endBlock.Position.Z)

    local targetCFrame = CFrame.lookAt(targetPos, lookPos)
    local startCFrame = CFrame.lookAt(startPos, lookPos)

    rootPart.Anchored = true 
    zombie:PivotTo(startCFrame)

    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local animTracks = {}
    
    local function loadAnimation(name, id)
        if not ZombieService.AnimationCache[id] then
            local anim = Instance.new("Animation")
            anim.AnimationId = id
            ZombieService.AnimationCache[id] = anim
        end
        local track = animator:LoadAnimation(ZombieService.AnimationCache[id])
        track.Priority = Enum.AnimationPriority.Movement
        track.Looped = true
        animTracks[name] = track
    end

   local config = ZombieConfig[zombieId]
    
    -- 获取当前关卡数，如果没有则默认为1
    local currentLevel = plot:GetAttribute("CurrentLevel") or 1
    
    -- 动态血量计算：从第11关开始（无尽模式），每关增加 15% 的最大生命值
    -- [🌟 究极加强版：僵尸成长倍率] 从第21关开始，每关增加 38% 的最大生命值和攻击力
    local hpMultiplier = 1
    local atkMultiplier = 1
    if currentLevel &gt; 20 then
        hpMultiplier = 1 + (currentLevel - 20) * 0.38 
        atkMultiplier = 1 + (currentLevel - 20) * 0.38 
    end
    
    local finalHP = math.floor(config.HP * hpMultiplier)
    local finalAttack = math.floor(config.Attack * atkMultiplier)
    
    loadAnimation("Walk", config.Anims.Walk)
    loadAnimation("Eat", config.Anims.Eat)
    
    humanoid.MaxHealth = finalHP
    humanoid.Health = finalHP
    humanoid.WalkSpeed = 0
    -- [动态血条与防具逻辑]
    local dropPart = zombie:FindFirstChild("Drop", true)
    local baseZombieHP = 270 
    local hasDropped = false

    local hpBillboard = Instance.new("BillboardGui")
    hpBillboard.Name = "HPBar"
    hpBillboard.Size = UDim2.new(0, 50, 0, 6) 
    hpBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
    hpBillboard.AlwaysOnTop = true
    hpBillboard.MaxDistance = 80
    hpBillboard.Enabled = false 
    
    local bgFrame = Instance.new("Frame")
    bgFrame.Size = UDim2.new(1, 0, 1, 0)
    bgFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    bgFrame.BackgroundTransparency = 0.5
    Instance.new("UICorner", bgFrame).CornerRadius = UDim.new(0, 4)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 0, 0) 
    stroke.Thickness = 1.5 
    stroke.Parent = bgFrame
    bgFrame.Parent = hpBillboard

    local fillFrame = Instance.new("Frame")
    fillFrame.Size = UDim2.new(1, 0, 1, 0)
    fillFrame.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    Instance.new("UICorner", fillFrame).CornerRadius = UDim.new(0, 4)
    fillFrame.Parent = bgFrame
    
    hpBillboard.Parent = zombie:FindFirstChild("Head") or rootPart

    humanoid.HealthChanged:Connect(function(newHealth)
        if newHealth &lt; finalHP and newHealth &gt; 0 then
            hpBillboard.Enabled = true
            local ratio = math.clamp(newHealth / finalHP, 0, 1)
            fillFrame.Size = UDim2.new(ratio, 0, 1, 0)
            
            if finalHP &gt; baseZombieHP and newHealth &gt; baseZombieHP then
                fillFrame.BackgroundColor3 = Color3.fromRGB(200, 200, 200) 
            else
                fillFrame.BackgroundColor3 = Color3.fromRGB(255, 60, 60) 
            end
        else
            hpBillboard.Enabled = false
        end

        if dropPart and finalHP &gt; baseZombieHP then
            if not hasDropped and newHealth &lt;= baseZombieHP and newHealth &gt; 0 then
                hasDropped = true
                dropPart.Anchored = false
                dropPart.CanCollide = true
                
                for _, joint in pairs(zombie:GetDescendants()) do
                    if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                        if joint.Part0 == dropPart or joint.Part1 == dropPart then
                            joint:Destroy()
                        end
                    end
                end
                
                local randomX = math.random(-8, 8)
                local randomZ = math.random(-8, 8)
                dropPart.AssemblyLinearVelocity = Vector3.new(randomX, 15, randomZ)
                
                task.delay(1, function()
                    if dropPart then dropPart:Destroy() end
                end)
            end
        end
    end)
    
    local currentState = "None"
    local function switchState(newState)
        if currentState == newState then return end
        if animTracks[currentState] then animTracks[currentState]:Stop() end
        if animTracks[newState] then 
            animTracks[newState]:Play() 
            local speedMult = plot:GetAttribute("GameSpeed") or 1
            if newState == "Walk" then
                animTracks[newState]:AdjustSpeed(1.5 * speedMult) 
            else
                animTracks[newState]:AdjustSpeed(1.0 * speedMult)
            end
        end
        currentState = newState
    end

    zombie.Parent = Workspace

    task.spawn(function()
        switchState("Walk")
        task.wait() 
 
        local riseTime = 2.5
        local currentRiseTime = 0
        while currentRiseTime &lt; riseTime do
            if IsBattleCancelled(plot, player) then 
                if zombie then zombie:Destroy() end
                return 
            end
            
            local speedMult = plot:GetAttribute("GameSpeed") or 1
            local dt = task.wait(0.03) 
            currentRiseTime += (dt * speedMult)
            
            local alpha = math.clamp(currentRiseTime / riseTime, 0, 1)
            rootPart.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        end
        
        for _, part in pairs(zombie:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" then
                    part.CanCollide = true
                else
                    part.CanCollide = false
                end
            end
        end

        rootPart.Anchored = false
        
        pcall(function()
            rootPart:SetNetworkOwner(nil)
        end)
        
        local landWaitTime = 0
        while humanoid.FloorMaterial == Enum.Material.Air and landWaitTime &lt; 1 do
            if IsBattleCancelled(plot, player) then 
                if zombie then zombie:Destroy() end
                return 
            end
            landWaitTime += task.wait(0.07)
        end
        task.wait(0.2) 

        for _, part in pairs(zombie:GetDescendants()) do
            if part:IsA("BasePart") then 
                part.CollisionGroup = "Zombies" 
            end
        end

        humanoid.WalkSpeed = config.Speed

        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        overlapParams.FilterDescendantsInstances = {zombie}

        local currentTargetPos = endBlock.Position 
        local hasReachedEndBlock = false 
        local hasReachedHouseEnd = false 

        local timeAccumulated = config.AttackInterval 
        
        while zombie and zombie.Parent and humanoid and humanoid.Health &gt; 0 do
            if IsBattleCancelled(plot, player) then 
                if zombie then zombie:Destroy() end
                break 
            end
            
            local speedMult = plot:GetAttribute("GameSpeed") or 1
            local dt = task.wait(0.1 / speedMult)
            timeAccumulated += (dt * speedMult)

            if currentState == "Walk" then
                if animTracks["Walk"] then animTracks["Walk"]:AdjustSpeed(1.5 * speedMult) end
                humanoid.WalkSpeed = config.Speed * speedMult 
            elseif currentState == "Eat" then
                if animTracks["Eat"] then animTracks["Eat"]:AdjustSpeed(1.0 * speedMult) end
                humanoid.WalkSpeed = 0
            end
            
            local flatRootPos = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
            
            if not hasReachedEndBlock then
                local flatEndPos = Vector3.new(endBlock.Position.X, 0, endBlock.Position.Z)
                if (flatRootPos - flatEndPos).Magnitude &lt; 1 then hasReachedEndBlock = true end
            end

            if hasReachedEndBlock and not hasReachedHouseEnd then
                 if houseEndBlock then
                    currentTargetPos = houseEndBlock.Position
                    local flatHouseEndPos = Vector3.new(houseEndBlock.Position.X, 0, houseEndBlock.Position.Z)
                    if (flatRootPos - flatHouseEndPos).Magnitude &lt; 1 then hasReachedHouseEnd = true end
                else
                    hasReachedHouseEnd = true 
                end
            end

            if hasReachedHouseEnd and homeBlock then
                currentTargetPos = homeBlock.Position
                local flatHomePos = Vector3.new(homeBlock.Position.X, 0, homeBlock.Position.Z)
                if (flatRootPos - flatHomePos).Magnitude &lt; 1 then
                    ZombieService.TriggerGameOver(plot, player) 
                    break
                end
            end

            local checkCFrame = rootPart.CFrame * CFrame.new(0, 0, -2)
            local checkSize = Vector3.new(4, 5, 4) 
            local hitParts = Workspace:GetPartBoundsInBox(checkCFrame, checkSize, overlapParams)
            
            local isFacingPlant = false
            local targetPlant = nil 

            for _, part in ipairs(hitParts) do
               local hitModel = part:FindFirstAncestorOfClass("Model")
                if hitModel and hitModel:GetAttribute("IsCombatPlant") and not hitModel:GetAttribute("IsDead") then
                    isFacingPlant = true
                    targetPlant = hitModel
                    break 
                end
            end

            if isFacingPlant and targetPlant then
                humanoid.WalkSpeed = 0 
                switchState("Eat")

                if timeAccumulated &gt;= config.AttackInterval then
                    timeAccumulated = 0 
                    
                    local currentPlantHP = targetPlant:GetAttribute("Health") or 0
                    -- [🌟 修改：使用经过 38% 倍率放大的最终攻击力]
                    currentPlantHP = currentPlantHP - finalAttack
                    targetPlant:SetAttribute("Health", currentPlantHP)
                    
                    local gridName = targetPlant:GetAttribute("GridName")
                    if gridName and player then
                        PlayerDataManager.UpdateCombatPlantHP(player, gridName, currentPlantHP)
                    end
                    
                    for _, p in pairs(targetPlant:GetDescendants()) do
                        if p:IsA("BasePart") then
                            if not p:GetAttribute("OriginalColor") then
                                p:SetAttribute("OriginalColor", p.Color)
                            end
                            p.Color = Color3.fromRGB(255, 50, 50)
                            
                            task.delay(0.15, function() 
                                if p and p.Parent then 
                                    p.Color = p:GetAttribute("OriginalColor") 
                                end 
                            end)
                        end
                    end

                    if currentPlantHP &lt;= 0 then
                        targetPlant:SetAttribute("IsDead", true)
                        
                        for _, p in pairs(targetPlant:GetDescendants()) do
                            if p:IsA("BasePart") then
                                -- [🌟 修复：只有在没有初始记录的情况下才记录，防止把受击过程中的中间状态记下来]
                                if p:GetAttribute("OriginalTransparency") == nil then
                                    p:SetAttribute("OriginalTransparency", p.Transparency)
                                end
                                p.Transparency = 1 -- 死亡消失
                            elseif p:IsA("ParticleEmitter") or p:IsA("Light") or p:IsA("Beam") or p:IsA("Highlight") or p:IsA("Trail") then
                                if p:GetAttribute("OriginalEnabled") == nil then
                                    p:SetAttribute("OriginalEnabled", p.Enabled)
                                end
                                p.Enabled = false
                            end
                        end
                    end
                end
            else
                humanoid.WalkSpeed = config.Speed * speedMult 
                humanoid:MoveTo(currentTargetPos) 
                switchState("Walk")
            end
        end
        
        -- [🌟 修复]：由于手动撤退会调用 obj:Destroy()，在此处增加安全判断，防止访问已销毁的实例
        if zombie and zombie.Parent and humanoid and humanoid.Parent and humanoid.Health &lt;= 0 then
            plot:SetAttribute("ZombiesDefeated", (plot:GetAttribute("ZombiesDefeated") or 0) + 1)
            SyncBattleProgress(player, plot, true)
            
            if activeSessions[player.UserId] then
                activeSessions[player.UserId].TotalKills += 1
            end
            
            local dropPos = rootPart.Position + Vector3.new(0, 3, 0)
            
            plot:SetAttribute("LastZombieDeathPos", rootPart.Position)
            -- [🌟 新增：动态掉落逻辑]
            -- 以 200 血（普通僵尸基础血量）为 1 倍掉落基准
            local dropMultiplier = math.max(1, finalHP / 200)
            
            -- 计算掉落数量和单价
            local coinCount = math.random(1, 2) + math.floor(dropMultiplier / 5) 
            local coinValue = math.floor(math.random(10, 20) * dropMultiplier)   
            
            if coinCount &gt; 5 then
                coinValue = math.floor(coinValue * (coinCount / 5))
                coinCount = 5
            end
            
            CoinDropService.DropCoins(player, dropPos, coinCount, coinValue)

            -- 👇 =================【新增：1% 概率掉落盲盒宝箱】================= 👇
            if math.random(1, 100) == 1 then
                local ZombieBoxService = require(script.Parent.ZombieBoxService)
                ZombieBoxService.SpawnBox(player, dropPos)
            end
            -- 👆 =============================================================== 👆


            humanoid:Destroy() 
            rootPart.Anchored = false 

            for _, p in pairs(zombie:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = true  
                    p.CanTouch = false   
                    p.CanQuery = false   
                    p.CollisionGroup = "Corpses" 
                end
            end
            
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) 
            rootPart.AssemblyAngularVelocity = rootPart.CFrame.RightVector * -8 
            
            task.spawn(function()
                local dieTime = 1.5
                local currentDieTime = 0
                while currentDieTime &lt; dieTime do
                    local sm = plot:GetAttribute("GameSpeed") or 1
                    currentDieTime += task.wait(0.1) * sm
                end

                if zombie and zombie.Parent then
                    local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
                    for _, p in pairs(zombie:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.Color = Color3.fromRGB(50, 50, 50) 
                            TweenService:Create(p, fadeInfo, {Transparency = 1}):Play()
                        end
                    end
                    
                    task.wait(0.5) 
                    if zombie and zombie.Parent then
                        zombie:Destroy()
                    end
                end
            end)
        end
        
        plot:SetAttribute("ActiveZombies", (plot:GetAttribute("ActiveZombies") or 0) - 1)
    end)
end

function ZombieService.StartLevel(plot, levelId, player)
    if IsBattleCancelled(plot, player) then return end

    local levelData = LevelConfig[levelId] or ZombieService.GenerateInfiniteLevel(levelId)
    local totalZombies = CountLevelZombies(levelData)

    if not activeSessions[player.UserId] or levelId == 1 then
        activeSessions[player.UserId] = { TotalCoins = 0, TotalSeeds = 0, TotalKills = 0 }
    end
    local session = activeSessions[player.UserId]

    plot:SetAttribute("IsLevelActive", true)
    plot:SetAttribute("IsGameOver", false)
    plot:SetAttribute("CurrentLevel", levelId)
    plot:SetAttribute("ActiveZombies", 0) 
    plot:SetAttribute("TotalZombies", totalZombies)
    plot:SetAttribute("ZombiesDefeated", 0)

    SyncBattleProgress(player, plot, true, levelId)
    local MAX_ACTIVE_ZOMBIES = 30 
    
    if levelData and levelData.Waves then
        for waveIndex, wave in ipairs(levelData.Waves) do
            -- [🌟 修复]：如果手动点击了撤退，立即跳出波次生成循环
            if IsBattleCancelled(plot, player) then break end
            
            task.spawn(function()
                if wave.Zombies then
                    for _, zombieGroup in ipairs(wave.Zombies) do
                        for i = 1, zombieGroup.Count do
                            if IsBattleCancelled(plot, player) then break end
                            
                            while (plot:GetAttribute("ActiveZombies") or 0) &gt;= MAX_ACTIVE_ZOMBIES do
                                if IsBattleCancelled(plot, player) then return end
                                task.wait(0.5) 
                            end

                            if IsBattleCancelled(plot, player) then return end
                            
                            local randomRow = math.random(1, 6)
                            ZombieService.SpawnZombie(plot, randomRow, zombieGroup.Type, player)
                            
                            local speedMult = plot:GetAttribute("GameSpeed") or 1
                            task.wait(math.random(10, 25) / 10 / speedMult) 
                        end
                    end
                end
            end)
            
            if wave.NextWaveTime and wave.NextWaveTime &gt; 0 then
                local currentWait = 0
                while currentWait &lt; wave.NextWaveTime do
                    if IsBattleCancelled(plot, player) then break end
                    local speedMult = plot:GetAttribute("GameSpeed") or 1
                    currentWait += task.wait(0.5) * speedMult
                end
            end
        end
    end

    repeat
        task.wait(1)
    until (plot:GetAttribute("ActiveZombies") &lt;= 0) or IsBattleCancelled(plot, player)

    -- [🌟 修复核心逻辑]：确保无论是手动结束还是正常递归，状态都能被正确清理
    if IsBattleCancelled(plot, player) then
        -- 这里不需要重复调用 FinalSettlement，因为 LevelService 已经调过了
        -- 但我们需要确保 activeSessions 即使在手动结束时也能被清理
        return 
    end

    -- 正常通关逻辑
    local waveCoins = 100 + (levelId * 20)
    local waveSeeds = (levelId % 3 == 0) and 1 or 0
    
    session.TotalCoins += waveCoins
    session.TotalSeeds += waveSeeds

    PlayerDataManager.UnlockNextLevel(player, levelId)

   local AnalyticsService = game:GetService("AnalyticsService")
    local data = PlayerDataManager.GetPlayerData(player)
    local currentCoins = data and data.Coins or 0
    -- 👇 [修复] 正确获取 RandomSeed 的最新库存
    local currentSeeds = 0
    if data and data.Inventory and data.Inventory.Seeds then
        for _, sInfo in ipairs(data.Inventory.Seeds) do
            if sInfo.ID == "RandomSeed" then
                currentSeeds = sInfo.Quantity
                break
            end
        end
    end

    -- 记录金币获取 (Source)
    AnalyticsService:LogEconomyEvent(
        player, 
        Enum.AnalyticsEconomyFlowType.Source, -- 表示获取/产出
        "Coins", -- 货币名称
        waveCoins, -- 本次增加的数量
        currentCoins, -- 变动后的余额
        Enum.AnalyticsEconomyTransactionType.Gameplay.Name, -- 交易场景 (转为字符串)
        "LevelClearReward_Level_" .. tostring(levelId) -- 物品/明细
    )

    -- 记录种子获取 (Source)
    if waveSeeds &gt; 0 then
        AnalyticsService:LogEconomyEvent(
            player, 
            Enum.AnalyticsEconomyFlowType.Source, 
            "Seeds", 
            waveSeeds, 
            currentSeeds, 
            Enum.AnalyticsEconomyTransactionType.Gameplay.Name, 
            "LevelClearReward_Level_" .. tostring(levelId)
        )
    end

   -- 👇 =================【修改：在最后一个僵尸死亡的地方掉落盲盒宝箱】================= 👇
    local ZombieBoxService = require(script.Parent.ZombieBoxService)
    
    -- 读取刚才记录的坐标。如果因为某种意外没记录到，给一个地块中心的保底坐标
    local lastDeathPos = plot:GetAttribute("LastZombieDeathPos")
    local dropPos = plot:GetPivot().Position + Vector3.new(0, 5, 0) 
    
    if lastDeathPos then
        -- 在死亡坐标的正上方 5 格处生成，方便它稳稳地落到地上
        dropPos = lastDeathPos + Vector3.new(0, 5, 0)
    end
    
    ZombieBoxService.SpawnBox(player, dropPos)
    -- 👆 =============================================================== 👆

    local nextLevelId = levelId + 1
    print("【关卡连战】第 "..levelId.." 关清理完毕，2秒后开始下一关...")
    task.wait(2)
    ZombieService.StartLevel(plot, nextLevelId, player)
end

function ZombieService.FinalSettlement(player, plot, isVictory)
    local session = activeSessions[player.UserId]
    local lastLevel = plot:GetAttribute("CurrentLevel") or 1

    if not session then 
        -- 如果 session 已经没了，说明已经结算过了，直接重置状态
        plot:SetAttribute("IsLevelActive", false)
        SyncBattleProgress(player, plot, false, lastLevel)
        return 
    end

    local PlayerDataManager = require(script.Parent.Parent.PlayerDataManager)
    local data = PlayerDataManager.GetPlayerData(player)
    
    local isNewRecord = data and lastLevel &gt; (data.UnlockedLevel or 1)
    -- 👇 【新增埋点代码】
    if isVictory and isNewRecord then
        if lastLevel == 1 then
            AnalyticsService:LogFunnelStepEvent(player, "Progression", nil, 1, "Cleared_Level_1")
            AnalyticsService:LogFunnelStepEvent(player, "Onboarding", nil, 3, "Step_3_First_Victory") 
        elseif lastLevel == 5 then
            AnalyticsService:LogFunnelStepEvent(player, "Progression", nil, 5, "Cleared_Level_5")
        elseif lastLevel == 10 then
            AnalyticsService:LogFunnelStepEvent(player, "Progression", nil, 10, "Cleared_Level_10")
        end
    end
    local showResultRE = ReplicatedStorage:FindFirstChild("ShowBattleResultRE")
    
    if showResultRE then
        showResultRE:FireClient(player, isVictory, lastLevel, isNewRecord, session.TotalKills, session.TotalCoins, session.TotalSeeds)
    end
    -- 👇 【新增埋点代码】：带数值的事件，记录单局击杀数
    if session.TotalKills &gt; 0 then
        AnalyticsService:LogCustomEvent(player, "Level_Kill_Efficiency", session.TotalKills)
    end
        
    -- 清理缓存并释放锁定
    activeSessions[player.UserId] = nil 
    plot:SetAttribute("IsLevelActive", false)
    SyncBattleProgress(player, plot, false, lastLevel)
end

function ZombieService.Init()
    pcall(function() PhysicsService:RegisterCollisionGroup("Zombies") end)
    pcall(function() PhysicsService:RegisterCollisionGroup("Corpses") end) 
    pcall(function() PhysicsService:RegisterCollisionGroup("Players") end) 
    
    pcall(function()
        PhysicsService:CollisionGroupSetCollidable("Zombies", "Zombies", false)
        PhysicsService:CollisionGroupSetCollidable("Zombies", "Corpses", false)
        PhysicsService:CollisionGroupSetCollidable("Corpses", "Corpses", false)
        PhysicsService:CollisionGroupSetCollidable("Players", "Zombies", false)
        PhysicsService:CollisionGroupSetCollidable("Players", "Corpses", false)
    end)
    
    if not ReplicatedStorage:FindFirstChild("ShowBattleResultRE") then
        local re = Instance.new("RemoteEvent")
        re.Name = "ShowBattleResultRE"
        re.Parent = ReplicatedStorage
    end
    
    local itemModelsFolder = ReplicatedStorage:FindFirstChild("ItemModels")
    if itemModelsFolder then
        for zombieId, config in pairs(ZombieConfig) do
            local template = itemModelsFolder:FindFirstChild(zombieId)
            if template then
                local dummy = template:Clone()
                local humanoid = dummy:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
                    for animName, animId in pairs(config.Anims) do
                        if not ZombieService.AnimationCache[animId] then
                            local anim = Instance.new("Animation")
                            anim.AnimationId = animId
                            ZombieService.AnimationCache[animId] = anim
                        end
                        animator:LoadAnimation(ZombieService.AnimationCache[animId])
                    end
                end

                local rootPart = dummy:FindFirstChild("HumanoidRootPart") or dummy.PrimaryPart
                if rootPart then
                    rootPart.Anchored = true 
                    dummy:PivotTo(CFrame.new(0, 50000, 0))
                end
                
                dummy.Parent = Workspace
                for _, p in pairs(dummy:GetDescendants()) do
                    if p:IsA("BasePart") then p.Transparency = 0.5 end
                end
                
                task.delay(0.2, function()
                    if dummy and dummy.Parent then dummy:Destroy() end
                end)
            end
        end
    end
end
function ZombieService.GenerateInfiniteLevel(levelId)
    -- [🌟 修改：无尽模式固定阵容] 直接复制第 20 关的配置，数量和种类不再随机
    local baseLevelConfig = LevelConfig[20]

    return { 
        LevelName = "Infinite Challenge Level " .. levelId, 
        Waves = baseLevelConfig.Waves 
    }
end
-- [🌟 准确功能：玩家退出时强制清理战斗会话与僵尸]
function ZombieService.CleanupPlayerBattle(player)
    local userId = player.UserId
    
    -- 1. 清理战斗会话记录，防止内存泄漏
    if activeSessions[userId] then
        activeSessions[userId] = nil
    end

    -- 2. 强力销毁该玩家地块关联的所有僵尸
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:GetAttribute("IsZombie") and obj:GetAttribute("OwnerId") == userId then
            obj:Destroy()
        end
    end
end
return ZombieService</string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="35">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- src/client/init.client.luau
print("客户端启动：沉浸式 UI 系统（层级适配修复版）激活...")

local InventoryController = require(script.UI.InventoryController)
local HotbarController = require(script.UI.HotbarController) 
local ShopController = require(script.UI.ShopController)
local CoinDropController = require(script.Services.CoinDropController)
local PlantUIController = require(script.Services.PlantUIController)
local HighlightController = require(script.Services.HighlightController)
local PlantHoverController = require(script.UI.PlantHoverController)
local ToolController = require(script.Services.ToolController)
local EncyclopediaController = require(script.UI.EncyclopediaController)
local UnlockAnimController = require(script.UI.UnlockAnimController)
local TutorialController = require(script.UI.TutorialController)
local EventUIManager = require(script.UI.EventUI.EventUIManager)

local ReplicatedStorage = game:GetService("ReplicatedStorage") 
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local MarketplaceService = game:GetService("MarketplaceService")
local AnalyticsRE = ReplicatedStorage:WaitForChild("AnalyticsRE")
local X2_SUN_GAME_PASS_ID = 1856661235
local localPlayer = game:GetService("Players").LocalPlayer
local initialCameraMaxZoomDistance = localPlayer.CameraMaxZoomDistance
localPlayer.CameraMaxZoomDistance = initialCameraMaxZoomDistance

local function restoreInitialCameraMaxZoomDistance()
    localPlayer.CameraMaxZoomDistance = initialCameraMaxZoomDistance
end

local function pullCameraUp()
    -- 必须稍微等待一下，确保 Roblox 的默认相机系统已经绑定到了玩家角色上
    task.wait(0.5) 
    
    -- 强行将相机拉远到 45 的距离
    localPlayer.CameraMinZoomDistance = 45
    localPlayer.CameraMaxZoomDistance = 45
    
    -- 给相机 0.1 秒的反应时间把镜头推出去，然后再解除最小距离限制；最大距离恢复到玩家进入游戏时的初始值
    task.wait(0.1)
    localPlayer.CameraMinZoomDistance = 0.5
    restoreInitialCameraMaxZoomDistance()
end

-- 监听玩家角色生成（每次进入游戏或死亡重生时都会触发）
localPlayer.CharacterAdded:Connect(function()
    pullCameraUp()
end)

-- 如果脚本运行的瞬间角色已经存在，直接执行一次
if localPlayer.Character then
    pullCameraUp()
end


task.spawn(function()
    local player = game:GetService("Players").LocalPlayer

    local playerGui = player:WaitForChild("PlayerGui")
    local basicGui = playerGui:WaitForChild("BasicGui")
    for _, gui in pairs(basicGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            gui.ResetOnSpawn = false
            print("已为 UI 锁定防重置保护: " .. gui.Name)
        end
    end

    basicGui:WaitForChild("InventoryGui")
    basicGui:WaitForChild("ShopGui")
    basicGui:WaitForChild("Codex")
    basicGui:WaitForChild("PlayProperty")
    
    local TWEEN_TIME = 0.4
    local POS_CENTER = UDim2.new(0.5, 0, 0.5, 0)
    local POS_BOTTOM = UDim2.new(0.5, 0, 1.5, 0)

    local function applyGlobalButtonEffect(button)
        if button:IsA("TextButton") or button:IsA("ImageButton") then
            if button:GetAttribute("HoverAnimBound") then return end
            button:SetAttribute("HoverAnimBound", true)
            button.AutoButtonColor = false

            if (button.AnchorPoint - Vector2.new(0.5, 0.5)).Magnitude > 0.01 then
                local oldAnchor = button.AnchorPoint
                local size = button.Size
                button.AnchorPoint = Vector2.new(0.5, 0.5)
                button.Position = UDim2.new(
                    button.Position.X.Scale + (size.X.Scale * (0.5 - oldAnchor.X)),
                    button.Position.X.Offset + (size.X.Offset * (0.5 - oldAnchor.X)),
                    button.Position.Y.Scale + (size.Y.Scale * (0.5 - oldAnchor.Y)),
                    button.Position.Y.Offset + (size.Y.Offset * (0.5 - oldAnchor.Y))
                )
            end

            local uiScale = button:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", button)
            button.MouseEnter:Connect(function() TweenService:Create(uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1.12}):Play() end)
            button.MouseLeave:Connect(function() TweenService:Create(uiScale, TweenInfo.new(0.15), {Scale = 1}):Play() end)
            button.MouseButton1Down:Connect(function() TweenService:Create(uiScale, TweenInfo.new(0.1), {Scale = 0.9}):Play() end)
            button.MouseButton1Up:Connect(function() TweenService:Create(uiScale, TweenInfo.new(0.1), {Scale = 1.12}):Play() end)
        end
    end

    for _, uiNode in pairs(playerGui:GetDescendants()) do applyGlobalButtonEffect(uiNode) end
    playerGui.DescendantAdded:Connect(applyGlobalButtonEffect)

    local blurEffect = Lighting:FindFirstChild("GlobalUIBlur") or Instance.new("BlurEffect", Lighting)
    blurEffect.Name = "GlobalUIBlur"
    blurEffect.Size = 0

    local camera = Workspace.CurrentCamera
    local defaultFOV = 70

    local overlayGui = Instance.new("ScreenGui")
    overlayGui.Name = "GlobalOverlayGui"
    overlayGui.ResetOnSpawn = false
    overlayGui.DisplayOrder = 90
    overlayGui.IgnoreGuiInset = true 
    overlayGui.Parent = playerGui

    local bgOverlay = Instance.new("Frame")
    bgOverlay.Name = "BlackMask"
    bgOverlay.Size = UDim2.new(1, 0, 1, 0)
    bgOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bgOverlay.BackgroundTransparency = 1
    bgOverlay.Active = true 
    bgOverlay.Visible = false
    bgOverlay.Parent = overlayGui

    local inventoryGui = basicGui:WaitForChild("InventoryGui")
    local shopGui = basicGui:WaitForChild("ShopGui")
    local codexGui = basicGui:WaitForChild("Codex")
    local playProperty = basicGui:WaitForChild("PlayProperty")

    local x2SunBtn = playProperty:FindFirstChild("X2Sun")
    if x2SunBtn and not x2SunBtn:GetAttribute("IAPBound") then
        x2SunBtn:SetAttribute("IAPBound", true)
        local function refreshX2SunButton()
            local ownsPass = false
            pcall(function()
                ownsPass = MarketplaceService:UserOwnsGamePassAsync(player.UserId, X2_SUN_GAME_PASS_ID)
            end)
            x2SunBtn.Visible = not ownsPass
            x2SunBtn.Active = not ownsPass
        end

        refreshX2SunButton()
        x2SunBtn.Activated:Connect(function()
            MarketplaceService:PromptGamePassPurchase(player, X2_SUN_GAME_PASS_ID)
        end)

        MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(purchasingPlayer, passId, wasPurchased)
            if purchasingPlayer == player and passId == X2_SUN_GAME_PASS_ID and wasPurchased then
                refreshX2SunButton()
            end
        end)
    end

    local panels = {
        { gui = inventoryGui, frame = inventoryGui:WaitForChild("MainFrame", 5) },
        { gui = shopGui, frame = shopGui:FindFirstChild("ShopFrame") or shopGui:WaitForChild("MainFrame", 5) },
        { gui = codexGui, frame = codexGui:WaitForChild("MainFrame", 5) } 
    }

    local isAnyOpen = false

    local function setBackgroundEffects(enabled)
        if enabled then
            bgOverlay.Visible = true
            if playProperty:IsA("ScreenGui") then playProperty.DisplayOrder = 1 end
            TweenService:Create(bgOverlay, TweenInfo.new(TWEEN_TIME), {BackgroundTransparency = 0.8}):Play()
            TweenService:Create(blurEffect, TweenInfo.new(TWEEN_TIME), {Size = 24}):Play()
            TweenService:Create(camera, TweenInfo.new(TWEEN_TIME), {FieldOfView = 60}):Play()
        else
            if playProperty:IsA("ScreenGui") then playProperty.DisplayOrder = 50 end
            TweenService:Create(bgOverlay, TweenInfo.new(TWEEN_TIME), {BackgroundTransparency = 1}):Play()
            TweenService:Create(blurEffect, TweenInfo.new(TWEEN_TIME), {Size = 0}):Play()
            TweenService:Create(camera, TweenInfo.new(TWEEN_TIME), {FieldOfView = defaultFOV}):Play()
            task.delay(TWEEN_TIME, function() 
                if not isAnyOpen then bgOverlay.Visible = false end 
            end)
        end
    end

    local function initiateClose(p)
        if not p.gui.Enabled then return end
        if p.frame then
            local tween = TweenService:Create(p.frame, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = POS_BOTTOM})
            tween:Play()
            tween.Completed:Wait()
        end
        p.gui.Enabled = false
        local stillOpen = false
        for _, item in ipairs(panels) do 
            if item.gui.Enabled then 
                stillOpen = true 
                break 
            end 
        end
        if not stillOpen then
            isAnyOpen = false
            setBackgroundEffects(false)
        end
    end

    for _, p in ipairs(panels) do
        p.gui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if p.gui.Enabled then
                if p.gui == shopGui then
                    -- 生成一个简单的随机 SessionId 区分每一次打开商店的行为
                    local shopSessionId = "ShopSession_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
                    player:SetAttribute("CurrentShopSessionId", shopSessionId)
                    -- 👇 【新增埋点】：商店漏斗第一步
                    AnalyticsRE:FireServer("Funnel", "Shop_Purchase_Flow", {StepIndex = 1, StepName = "Step_1_Open_Shop", SessionId = shopSessionId})
                end
                for _, other in ipairs(panels) do
                    if other.gui ~= p.gui and other.gui.Enabled then other.gui.Enabled = false end
                end
                
                p.gui.DisplayOrder = 100
                isAnyOpen = true
                setBackgroundEffects(true)

                if p.frame then
                    p.frame.AnchorPoint = Vector2.new(0.5, 0.5)
                    p.frame.Position = POS_BOTTOM
                    if p.gui.Name == "Codex" then
                        TweenService:Create(p.frame, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.4, 0)}):Play()
                    else
                        TweenService:Create(p.frame, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = POS_CENTER}):Play()
                    end

                   
                end

                local closeBtn = p.frame and (
                    p.frame:FindFirstChild("CloseBtn", true) or 
                    p.frame:FindFirstChild("CloseButton", true) or 
                    p.frame:FindFirstChild("Close", true)
                )
                if closeBtn and not closeBtn:GetAttribute("CustomCloseBound") then
                    closeBtn:SetAttribute("CustomCloseBound", true)
                    closeBtn.Activated:Connect(function() initiateClose(p) end)
                end
            else
                local stillOpen = false
                for _, item in ipairs(panels) do 
                    if item.gui.Enabled then 
                        stillOpen = true 
                        break 
                    end 
                end
                if not stillOpen and isAnyOpen then
                    isAnyOpen = false
                    setBackgroundEffects(false)
                end
            end
        end)
    end

    -- ==========================================
    -- [🌟 系统三：战斗控制逻辑]
    -- ==========================================
    local startBattleBtn = playProperty:WaitForChild("StartBattle", 5)
    local inBattleFrame = playProperty:WaitForChild("InBattle", 5)
    local endBattleBtn = inBattleFrame and inBattleFrame:WaitForChild("EndBattle", 5)
    local levelText = inBattleFrame and inBattleFrame:WaitForChild("LevelText", 5)
    local battleProgress = inBattleFrame and inBattleFrame:WaitForChild("Progress", 5)
    local currentTotalZombies = 0
    local currentZombiesDefeated = 0
    local battleProgressFill = nil

    local function setupBattleProgressBar()
        if not battleProgress then return end

        battleProgress.ClipsDescendants = true

        battleProgressFill = battleProgress:FindFirstChild("BattleProgressFill")
            or battleProgress:FindFirstChild("Fill", true)
            or battleProgress:FindFirstChild("BarFill", true)
            or battleProgress:FindFirstChild("ProgressFill", true)

        if not battleProgressFill then
            battleProgressFill = Instance.new("Frame")
            battleProgressFill.Name = "BattleProgressFill"
            battleProgressFill.AnchorPoint = Vector2.new(0, 0)
            battleProgressFill.Position = UDim2.new(0, 0, 0, 0)
            battleProgressFill.Size = UDim2.new(0, 0, 1, 0)
            battleProgressFill.BackgroundColor3 = Color3.fromRGB(90, 255, 90)
            battleProgressFill.BackgroundTransparency = 0.15
            battleProgressFill.BorderSizePixel = 0
            battleProgressFill.ZIndex = battleProgress.ZIndex + 1

            local fillGradient = Instance.new("UIGradient")
            fillGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 255, 120)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 190, 50)),
            })
            fillGradient.Parent = battleProgressFill

            battleProgressFill.Parent = battleProgress
        end
    end

    local function updateBattleProgress(defeated, totalZombies)
        if not battleProgress then return end
        setupBattleProgressBar()

        currentZombiesDefeated = defeated or currentZombiesDefeated or 0
        currentTotalZombies = totalZombies or currentTotalZombies or 0

        local displayTotal = math.max(currentTotalZombies, 0)
        local displayDefeated = math.clamp(currentZombiesDefeated, 0, displayTotal)
        local ratio = displayTotal > 0 and math.clamp(displayDefeated / displayTotal, 0, 1) or 0

        local fill = battleProgressFill
            or battleProgress:FindFirstChild("Fill", true)
            or battleProgress:FindFirstChild("BarFill", true)
            or battleProgress:FindFirstChild("ProgressFill", true)
        if fill and (fill:IsA("Frame") or fill:IsA("ImageLabel") or fill:IsA("ImageButton")) then
            fill.Size = UDim2.new(ratio, 0, fill.Size.Y.Scale, fill.Size.Y.Offset)
        end
    end

    if battleProgress then
        battleProgress.Visible = false
        updateBattleProgress(0, 0)
    end
    local btnSpeed1_5 = inBattleFrame and inBattleFrame:WaitForChild("SpeedButton*1.5", 5)
    local btnSpeed4 = inBattleFrame and inBattleFrame:WaitForChild("SpeedButton*4", 5)
    local btnAutoBattle = inBattleFrame and inBattleFrame:WaitForChild("AutoBattle", 5)
    local homeBtn = playProperty:WaitForChild("Home", 5)
    if homeBtn then
        homeBtn.MouseButton1Click:Connect(function()
            local character = player.Character
            if not character then return end
            
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then return end

            local plotsFolder = Workspace:FindFirstChild("Plots")
            if plotsFolder then
                -- 遍历寻找属于本地玩家的基地
                for _, plot in ipairs(plotsFolder:GetChildren()) do
                    if plot:GetAttribute("OwnerId") == player.UserId then
                        -- 找到基地后，优先找出生点零件
                        local spawnPart = plot:FindFirstChild("SpawnPoint") or plot:FindFirstChild("SpawnLocation")
                        
                        -- 执行传送逻辑（与服务端的生成逻辑保持一致）
                        if spawnPart and spawnPart:IsA("BasePart") then
                            character:PivotTo(spawnPart.CFrame * CFrame.new(0, 4, 0))
                        else
                            character:PivotTo(plot:GetPivot() * CFrame.new(0, 5, 20))
                        end
                        
                        break
                    end
                end
            end
        end)
    end

    if startBattleBtn and inBattleFrame then
        startBattleBtn.Visible = true
        inBattleFrame.Visible = false

        local autoRed = ColorSequence.new(Color3.fromRGB(249, 0, 0), Color3.fromRGB(180, 0, 0))
        local autoGreen = ColorSequence.new(Color3.fromRGB(90, 255, 90), Color3.fromRGB(0, 180, 0))

        local autoLabel = btnAutoBattle:FindFirstChild("TextLabel")
        local autoGrad = btnAutoBattle:FindFirstChild("UIGradient")
        
        player:SetAttribute("AutoBattle", false)
        if autoGrad then autoGrad.Color = autoRed end

        startBattleBtn.MouseButton1Click:Connect(function()
            ReplicatedStorage:WaitForChild("StartBattleRE"):FireServer()
            
        end)

        if endBattleBtn then
            endBattleBtn.MouseButton1Click:Connect(function()
                -- 【修复1】：玩家手动点击停止战斗时，强制OffAuto Battle状态
                if player:GetAttribute("AutoBattle") then
                    player:SetAttribute("AutoBattle", false)
                    
                    local autoLabel = btnAutoBattle:FindFirstChild("TextLabel")
                    local autoGrad = btnAutoBattle:FindFirstChild("UIGradient")
                    
                    if autoLabel then autoLabel.Text = "Auto Battle(Off)" end
                    if autoGrad then autoGrad.Color = ColorSequence.new(Color3.fromRGB(249, 0, 0), Color3.fromRGB(180, 0, 0)) end
                end

                ReplicatedStorage:WaitForChild("EndBattleRE"):FireServer()
            end)
        end

        btnAutoBattle.MouseButton1Click:Connect(function()
            local isAuto = not player:GetAttribute("AutoBattle")
            -- 👇 【新增埋点】
            if isAuto then
                AnalyticsRE:FireServer("Custom", "UI_Click_AutoBattle_On")
            end
            player:SetAttribute("AutoBattle", isAuto)
            if autoLabel then autoLabel.Text = isAuto and "Auto Battle(On)" or "Auto Battle(Off)" end
            if autoGrad then autoGrad.Color = isAuto and autoGreen or autoRed end
            if isAuto and startBattleBtn.Visible then ReplicatedStorage.StartBattleRE:FireServer() end
        end)

        local setSpeedRE = ReplicatedStorage:WaitForChild("SetSpeedRE")
        local currentSpeed = 1
        local grad4RotationConn = nil
        -- 获取文字组件
        local label1_5 = btnSpeed1_5:FindFirstChildWhichIsA("TextLabel")
        local label4 = btnSpeed4:FindFirstChildWhichIsA("TextLabel")

        local function updateSpeedUI(activeSpeed)
            currentSpeed = activeSpeed
            
            -- [🌟 仅修改 2 Speed文字]
            local is1_5 = (activeSpeed == 2)
            if label1_5 then 
                label1_5.Text = is1_5 and "Back 1 Speed" or "X2 Speed" 
            elseif btnSpeed1_5:IsA("TextLabel") or btnSpeed1_5:IsA("TextButton") then
                btnSpeed1_5.Text = is1_5 and "Back 1 Speed" or "X2 Speed" 
            end

            -- [🌟 仅修改 4 Speed文字]
            local is4 = (activeSpeed == 4)
            if label4 then 
                label4.Text = is4 and "Back 1 Speed" or "X4 Speed" 
            elseif btnSpeed4:IsA("TextLabel") or btnSpeed4:IsA("TextButton") then
                btnSpeed4.Text = is4 and "Back 1 Speed" or "X4 Speed" 
            end
            local grad4 = btnSpeed4:FindFirstChild("UIGradient")
            if grad4RotationConn then grad4RotationConn:Disconnect(); grad4RotationConn = nil end
            if grad4 then grad4.Rotation = 0 end
            if activeSpeed == 4 and grad4 then

                local currentAngle = 0
                grad4RotationConn = game:GetService("RunService").RenderStepped:Connect(function(dt)
                    currentAngle = (currentAngle + dt * 120) % 360
                    grad4.Rotation = currentAngle
                end)
            else

            end
        end
        -- [🌟 新增：内购服务与你的通行证ID]
        local MarketplaceService = game:GetService("MarketplaceService")
        local SPEED_PASS_ID = 1811835638 -- ⚠️⚠️⚠️ 请把这串数字替换成你刚才复制的 Game Pass ID！

        btnSpeed1_5.MouseButton1Click:Connect(function() 
            AnalyticsRE:FireServer("Custom", "UI_Click_Speed_1_5")
            setSpeedRE:FireServer(currentSpeed == 2 and 1 or 2) 
        end)
        btnSpeed4.MouseButton1Click:Connect(function()
            AnalyticsRE:FireServer("Custom", "UI_Click_Speed_4")
            
            -- 检查玩家是否已经拥有该通行证
            local hasPass = false
            pcall(function()
                hasPass = MarketplaceService:UserOwnsGamePassAsync(player.UserId, SPEED_PASS_ID)
            end)

            if hasPass then
                -- 如果已经购买，正常切换倍速
                setSpeedRE:FireServer(currentSpeed == 4 and 1 or 4) 
            else
                -- 如果没有购买，在屏幕中央弹出 299 Robux 的购买确认框！
                MarketplaceService:PromptGamePassPurchase(player, SPEED_PASS_ID)
            end
        end)

        -- [🌟 新增：监听玩家付钱成功]
        MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(purchasingPlayer, passId, wasPurchased)
            if purchasingPlayer == player and passId == SPEED_PASS_ID and wasPurchased then
                -- 购买成功后，直接帮玩家自动开启 4 倍速
                setSpeedRE:FireServer(4)
                
                -- 屏幕右下角弹一个原生的成功提示框
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "🎉 Success!",
                        Text = "4X Speed is now Unlocked!",
                        Duration = 4,
                    })
                end)
            end
        end)

        setSpeedRE.OnClientEvent:Connect(updateSpeedUI)
        ReplicatedStorage:WaitForChild("SyncBattleUI_RE").OnClientEvent:Connect(function(isActive, currentLevelId, totalZombies, zombiesDefeated)
            if isActive then
                startBattleBtn.Visible = false
                inBattleFrame.Visible = true
                if battleProgress then battleProgress.Visible = true end
                updateBattleProgress(zombiesDefeated or 0, totalZombies or currentTotalZombies)
                
                if levelText then levelText.Text = "Level " .. currentLevelId end 
                
            else
                if battleProgress then
                    battleProgress.Visible = false
                    updateBattleProgress(0, 0)
                end

                -- 战斗结束逻辑保持不变...
                if player:GetAttribute("AutoBattle") then
                    levelText.Text = "Restarting..."
                    
                    -- 【修复2】：延迟 1 秒后真正触发下一场战斗，防止卡死
                    task.delay(1, function()
                        -- 再次检查确认玩家没有在此期间取消Auto Battle
                        if player:GetAttribute("AutoBattle") then
                            ReplicatedStorage:WaitForChild("StartBattleRE"):FireServer()
                        end
                    end)
                else
                    -- 如果没有OnAuto Battle（或者已被手动停止Off），则正常返回非战斗 UI
                    startBattleBtn.Visible = true
                    inBattleFrame.Visible = false
                end
            end
        end)
    end
end)

local UIEffectUtil = require(script.Utils.UIEffectUtil) -- 请确保路径匹配你的实际结构

local showTipRE = ReplicatedStorage:WaitForChild("ShowTipRE")

-- 监听服务端的提示请求，并调用封装好的 ShowTip
showTipRE.OnClientEvent:Connect(function(message)
    UIEffectUtil.ShowTip(message)
end)


showTipRE.OnClientEvent:Connect(function(message)
    UIEffectUtil.ShowTip(message)
end)

-- ==========================================
-- 🌟 新增：监听补偿弹窗指令并显示 UI
-- ==========================================
local PopupUtil = require(script.Utils.PopupUtil)
local showCompensationPopupRE = ReplicatedStorage:WaitForChild("ShowCompensationPopupRE", 10)
if showCompensationPopupRE then
    showCompensationPopupRE.OnClientEvent:Connect(function(message)
        -- 使用现有的弹窗组件，点击确定后自动关闭
        PopupUtil.ShowConfirm(message, function()
            -- 留空即可，弹窗会自动消失
        end)
    end)
end

InventoryController.Init()
HotbarController.Init()
ShopController.Init()
CoinDropController.Init()
PlantUIController.Init()
HighlightController.Init()
PlantHoverController.Init()
ToolController.Init()
EncyclopediaController.Init()
EventUIManager.Init()
UnlockAnimController.Init()
TutorialController.Init()
local AirdropUIController = require(script.Services.AirdropUIController)
AirdropUIController.Init()
local StealWarningUIController = require(script.Services.StealWarningUIController)
StealWarningUIController.Init()
local GroupJoinPromptController = require(script.Services.GroupJoinPromptController)
GroupJoinPromptController.Init()
local ZombieBoxController = require(script.Services.ZombieBoxController)
ZombieBoxController.Init()
local RollController = require(script.UI.RollController)
RollController.Init()
local StealablePointerUIController = require(script.Services.StealablePointerUIController)
StealablePointerUIController.Init()
require(script.UI.EventUI.NewbieGiftController).Init()
local FreeRewardClientController = require(script.Services.FreeRewardClientController)
FreeRewardClientController.Init()
]]></string>
